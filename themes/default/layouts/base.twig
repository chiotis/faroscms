<!doctype html>
{% set meta = item is defined ? item.meta : {} %}
{% set current_language = lang|default(site.languages.default) %}
{% set is_home_page = item is defined and item.type == 'pages' and item.slug == site.home_page|default('index') %}
{# Templates may set document_title (archives, search) before extending this layout. #}
{% set base_title = meta.title ?? document_title ?? '' %}
{# The title, the description and the picture of a page come from its own SEO settings first, then from Admin > SEO (the title format, the site's defaults). #}
{% set page_title = seo_title(meta.seo.title|default(''), base_title, is_home_page, item is defined and item ? item.type : '') %}
{% set page_description = seo_description(meta.seo.description|default(''), meta.excerpt|default(''), document_description|default(''), is_home_page) %}
{% set og_title = meta.seo.og_title ?? meta.seo.title ?? (base_title ?: site.title) %}
{% set og_description = meta.seo.og_description ?? page_description %}
{% set brand = theme_settings.brand|default({}) %}
{% set og_image = meta.seo.og_image|default('') ?: meta.main_image|default('') ?: (page_blocks.image ?? '') ?: seo_share_image() ?: brand.share_image|default('') %}
{% set appearance = theme_settings.appearance|default({}) %}
{% set palette = appearance.palette|default('slate') %}
{% set mode = appearance.mode|default('system') %}
{% set font = appearance.font|default('sans') %}
{% set shape = appearance.shape|default('soft') %}
{% set glow = appearance.glow|default('soft') == 'solid' ? 'solid' : 'soft' %}
{# The header sits over an opening hero (a Hero block, or the title area of the page) when the entry, its content type, or Theme settings > Header ask for it. #}
{% import 'components/hero-layout.twig' as opening %}
{% set header_settings = theme_settings.header|default({}) %}
{% set lead_block = page_blocks.lead ?? null %}
{# Templates that show the title area set title_header; the layout is then the entry's own or its type's. #}
{% set title_layout = title_header|default(false) and item is defined and item ? opening.layout(item, theme_settings)|trim : '' %}
{% set wants_transparent = (item is defined and item ? opening.transparent(item, theme_settings)|trim : (header_settings.transparent|default(false) ? '1' : '')) != '' %}
{# What opens the page under the header: the title area, a Hero block, or a Slider block that runs edge to edge. #}
{% set slider_opens = page_blocks.opens_with_slider|default(false) %}
{# A template with an opening section of its own (the book page) sets opens_under_header. #}
{% set opens_under = title_layout != '' or (lead_block and lead_block.type == 'hero') or slider_opens or opens_under_header|default(false) %}
{% set transparent_header = wants_transparent and opens_under %}
{# A floating header over such a section floats over it from the start: it takes no space of its own, and keeps its background. #}
{% set header_overlay = transparent_header or (header_settings.shape|default('full') == 'floating' and (opens_under or header_floats_over|default(false))) %}
{% if title_layout != '' %}
  {% set title_image = opening.image(item, theme_settings)|trim %}
  {% set transparent_on_dark = transparent_header and (title_layout == 'cover' or (title_layout == 'default' and title_image)) %}
{% else %}
  {% set transparent_on_dark = transparent_header and (slider_opens or lead_block.variant in ['cover', 'steps'] or lead_block.tone in ['contrast', 'accent'] or opens_on_dark|default(false)) %}
{% endif %}
{% set og_locales = {'el': 'el_GR', 'en': 'en_US', 'de': 'de_DE', 'fr': 'fr_FR', 'it': 'it_IT', 'es': 'es_ES'} %}
<html lang="{{ current_language }}" data-theme="{{ palette }}" data-mode="{{ mode }}" data-font="{{ font }}" data-shape="{{ shape }}" data-glow="{{ glow }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  {% set robots_content = seo_robots((meta.seo.noindex ?? false) or (noindex_page ?? false), seo_kind|default(item is defined and item ? item.type : (type|default('')))) %}
  {% if robots_content %}
  <meta name="robots" content="{{ robots_content }}">
  {% endif %}
  {% if canonical_url is defined and canonical_url %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% endif %}
  {% if alternate_urls is defined and alternate_urls %}
  {% for code, link in alternate_urls %}
  <link rel="alternate" hreflang="{{ code }}" href="{{ link }}">
  {% endfor %}
  {% if alternate_default is defined and alternate_default %}
  <link rel="alternate" hreflang="x-default" href="{{ alternate_default }}">
  {% endif %}
  {% endif %}
  <meta property="og:type" content="{{ og_type|default('website') }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ og_title }}">
  <meta property="og:description" content="{{ og_description }}">
  <meta property="og:locale" content="{{ og_locales[current_language] ?? current_language }}">
  {% if alternate_urls is defined and alternate_urls %}
  {% for code, link in alternate_urls %}{% if code != current_language %}
  <meta property="og:locale:alternate" content="{{ og_locales[code] ?? code }}">
  {% endif %}{% endfor %}
  {% endif %}
  {% if canonical_url is defined and canonical_url %}
  <meta property="og:url" content="{{ canonical_url }}">
  {% endif %}
  {% if og_image %}
  <meta property="og:image" content="{{ absolute_url(og_image) }}">
  <meta property="og:image:alt" content="{{ og_title }}">
  {% endif %}
  {% if og_type|default('') == 'article' and meta.date is defined and meta.date %}
  <meta property="article:published_time" content="{{ meta.date|date('c') }}">
  {% endif %}
  <meta name="twitter:card" content="{{ seo_twitter_card(og_image ? true : false) }}">
  <meta name="twitter:title" content="{{ og_title }}">
  <meta name="twitter:description" content="{{ og_description }}">
  {% if og_image %}
  <meta name="twitter:image" content="{{ absolute_url(og_image) }}">
  {% endif %}
  {{ seo_head() }}
  {# Apply a remembered colour mode before first paint to avoid a light/dark flash. #}
  <script>
    (function () {
      try {
        var mode = localStorage.getItem('faroscms-mode');
        if (mode === 'light' || mode === 'dark') {
          document.documentElement.dataset.mode = mode;
          document.documentElement.classList.toggle('dark', mode === 'dark');
        }
      } catch (e) {}
    })();
  </script>
  {% if font in ['sans', 'display'] %}
  {# Preload the Inter subsets the page language needs (Greek text also uses the Latin subset for digits and punctuation). #}
  <link rel="preload" href="{{ theme_asset('fonts/inter/inter-latin.woff2')|split('?')|first }}?v=4.1" as="font" type="font/woff2" crossorigin>
  {% if current_language == 'el' %}
  <link rel="preload" href="{{ theme_asset('fonts/inter/inter-greek.woff2')|split('?')|first }}?v=4.1" as="font" type="font/woff2" crossorigin>
  {% endif %}
  {% endif %}
  <link rel="stylesheet" href="{{ theme_asset('css/site.css') }}">
  {% for href in block_styles|default([]) %}
  <link rel="stylesheet" href="{{ href }}">
  {% endfor %}
  {# The blocks above the footer (Theme > Footer Blocks) need their styles on every page. #}
  {% for href in footer_blocks().styles|filter(h => h not in block_styles|default([])) %}
  <link rel="stylesheet" href="{{ href }}">
  {% endfor %}
  {# The choices of Theme > Branding (colours, type, spacing, buttons, logo sizes) come after the theme's styles and before the site's own. #}
  {% set branding_style = branding_css() %}
  {% if branding_style %}
  <style id="faros-branding">{{ branding_style|raw }}</style>
  {% endif %}
  {{ branding_head() }}
  {% set custom_css = custom_asset('css/custom.css') %}
  {% if custom_css %}
  <link rel="stylesheet" href="{{ custom_css }}">
  {% endif %}
  {% block structured_data %}{{ json_ld(structured_data|default([])) }}{% endblock %}
  {{ analytics_head(asset('js/faros-analytics.js'), url('_a/collect')) }}
  {% block head %}{% endblock %}
</head>

<body class="theme-body{% if transparent_header %} has-transparent-header{% endif %}{% if header_overlay %} has-header-overlay{% endif %}{% if header_settings.mobile_bar|default(false) %} has-mobile-bar{% endif %}">
  {{ analytics_body() }}
  {% set prefix = lang_prefix|default('') %}
  <a class="skip-link" href="#main">{{ t('a11y.skip_to_content', 'Skip to content') }}</a>
  <div class="app-shell">
    {% block header %}{% include 'components/header.twig' %}{% endblock %}
    <div class="header-spacer" data-header-spacer aria-hidden="true"></div>

    <main class="main-shell" id="main" tabindex="-1">
      {% block content %}{% endblock %}
    </main>

    {% block footer %}{% include 'components/footer.twig' %}{% endblock %}
  </div>

  {% block scripts %}
  <script src="{{ theme_asset('js/site.js') }}"></script>
  {% for src in block_scripts|default([]) %}
  <script src="{{ src }}" defer></script>
  {% endfor %}
  {% for src in footer_blocks().scripts|filter(h => h not in block_scripts|default([])) %}
  <script src="{{ src }}" defer></script>
  {% endfor %}
  {% set custom_js = custom_asset('js/custom.js') %}
  {% if custom_js %}
  <script src="{{ custom_js }}"></script>
  {% endif %}
  {% endblock %}
</body>

</html>
