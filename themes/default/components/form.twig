{#
  Frontend form. Every control has a label; help text and errors are tied to the control with
  aria-describedby, invalid controls carry aria-invalid, and the status message is announced.
#}
{% set form_id = 'form-' ~ form.slug %}
{% set autocomplete_by_type = {'email': 'email', 'tel': 'tel', 'url': 'url'} %}
{% set autocomplete_by_name = {'name': 'name', 'full_name': 'name', 'first_name': 'given-name', 'last_name': 'family-name', 'company': 'organization', 'phone': 'tel', 'email': 'email', 'address': 'street-address', 'city': 'address-level2', 'zip': 'postal-code', 'postcode': 'postal-code', 'country': 'country-name'} %}
<div class="form-section">
  {% if form_success %}
    <p class="form-success" role="status">{{ form_message }}</p>
  {% endif %}
  {% if form_errors is defined and form_errors._form is defined %}
    <p class="form-error" role="alert">{{ form_errors._form }}</p>
  {% elseif form_errors is defined and form_errors is not empty %}
    <p class="form-error" role="alert">{{ t('form.fix_errors', 'Please check the highlighted fields.') }}</p>
  {% endif %}

  <form method="post" action="{{ url(form_action) }}" class="form-grid" id="{{ form_id }}" novalidate>
    <input type="hidden" name="form_slug" value="{{ form.slug }}">
    <input type="hidden" name="form_lang" value="{{ form.lang }}">
    {% if form_redirect is defined and form_redirect %}
      <input type="hidden" name="redirect_url" value="{{ form_redirect }}">
    {% endif %}
    {% if form_honeypot is defined and form_honeypot %}
      <div class="form-honeypot" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="{{ form_honeypot }}" tabindex="-1" autocomplete="off"></label>
      </div>
    {% endif %}

    {% for field in form_fields %}
      {% set value = form_values[field.name]|default(field.default) %}
      {% set field_id = form_id ~ '-' ~ field.name %}
      {% set has_error = form_errors[field.name] is defined %}
      {% set described = [] %}
      {% if field.help %}{% set described = described|merge([field_id ~ '-help']) %}{% endif %}
      {% if has_error %}{% set described = described|merge([field_id ~ '-error']) %}{% endif %}
      {% set describedby = described|join(' ') %}
      {% set required_mark %}{% if field.required %} <span class="form-required" aria-hidden="true">*</span>{% endif %}{% endset %}
      {% set messages %}
        {% if field.help %}<small id="{{ field_id }}-help">{{ field.help }}</small>{% endif %}
        {% if has_error %}<small class="form-error" id="{{ field_id }}-error">{{ form_errors[field.name] }}</small>{% endif %}
      {% endset %}

      {% if field.type == 'hidden' %}
        <input type="hidden" name="{{ field.name }}" value="{{ value }}">
      {% elseif field.type == 'textarea' %}
        <div class="form-field">
          <label for="{{ field_id }}"><span>{{ field.label }}{{ required_mark }}</span></label>
          <textarea id="{{ field_id }}" name="{{ field.name }}" rows="{{ field.rows|default(5) }}" placeholder="{{ field.placeholder }}"{% if field.required %} required aria-required="true"{% endif %}{% if has_error %} aria-invalid="true"{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}>{{ value }}</textarea>
          {{ messages }}
        </div>
      {% elseif field.type == 'select' %}
        <div class="form-field">
          <label for="{{ field_id }}"><span>{{ field.label }}{{ required_mark }}</span></label>
          <select id="{{ field_id }}" name="{{ field.name }}"{% if field.required %} required aria-required="true"{% endif %}{% if has_error %} aria-invalid="true"{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}>
            <option value="">{{ t('form.select', 'Select') }}</option>
            {% for option in field.options %}
              <option value="{{ option.value }}" {% if option.value == value %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
          </select>
          {{ messages }}
        </div>
      {% elseif field.type == 'radio' or field.type == 'checkboxes' %}
        {% set selected = value is iterable ? value : [value] %}
        <fieldset{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}{% if field.required and field.type == 'radio' %} aria-required="true"{% endif %}>
          <legend>{{ field.label }}{{ required_mark }}</legend>
          {% for option in field.options %}
            <label class="inline">
              {% if field.type == 'radio' %}
                <input type="radio" name="{{ field.name }}" value="{{ option.value }}" {% if option.value == value %}checked{% endif %}{% if field.required %} required{% endif %}>
              {% else %}
                <input type="checkbox" name="{{ field.name }}[]" value="{{ option.value }}" {% if option.value in selected %}checked{% endif %}>
              {% endif %}
              <span>{{ option.label }}</span>
            </label>
          {% endfor %}
          {{ messages }}
        </fieldset>
      {% elseif field.type == 'checkbox' %}
        {% set checked = value == '1' or value == true %}
        <div class="form-field">
          <label class="inline" for="{{ field_id }}">
            <input type="checkbox" id="{{ field_id }}" name="{{ field.name }}" value="1" {% if checked %}checked{% endif %}{% if field.required %} required aria-required="true"{% endif %}{% if has_error %} aria-invalid="true"{% endif %}{% if describedby %} aria-describedby="{{ describedby }}"{% endif %}>
            <span>{{ field.label }}{{ required_mark }}</span>
          </label>
          {{ messages }}
        </div>
      {% else %}
        {% set autocomplete = autocomplete_by_name[field.name] ?? autocomplete_by_type[field.type] ?? '' %}
        <div class="form-field">
          <label for="{{ field_id }}"><span>{{ field.label }}{{ required_mark }}</span></label>
          <input type="{{ field.type }}" id="{{ field_id }}" name="{{ field.name }}" value="{{ value }}" placeholder="{{ field.placeholder }}"
            {%- if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}
            {%- if field.required %} required aria-required="true"{% endif %}
            {%- if has_error %} aria-invalid="true"{% endif %}
            {%- if describedby %} aria-describedby="{{ describedby }}"{% endif %}
            {%- if field.min %} min="{{ field.min }}"{% endif %}
            {%- if field.max %} max="{{ field.max }}"{% endif %}
            {%- if field.step %} step="{{ field.step }}"{% endif %}>
          {{ messages }}
        </div>
      {% endif %}
    {% endfor %}

    <button type="submit">{{ form.meta.submit_label is defined and form.meta.submit_label ? form.meta.submit_label : t('form.submit', 'Submit') }}</button>
  </form>
</div>
