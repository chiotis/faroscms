{#
  Site header. Theme settings > Header chooses the layout (classic, menu left, split, centered, stacked with a
  navigation bar underneath, minimal and minimal centered), its shape (full width or floating), width, height, edge and
  background, the style of the menu links, stickiness (always, smart, on scroll), a CTA button, a top bar, the search,
  the language and dark mode switches, a fixed bottom bar on phones, and how the phone menu opens (mobile_menu). The layout
  sets transparent_header / transparent_on_dark.
#}
{% import 'components/menu-macros.twig' as menu_macros %}
{% set menu = theme_menus.header ?? [] %}
{% set hs = theme_settings.header|default({}) %}
{# Texts typed in Theme > Header may have a version for each language; the page uses its own. #}
{% set hs = hs|merge({cta_label: hs.cta_label|default('')|localized, topbar_text: hs.topbar_text|default('')|localized, bar_items: hs.bar_items|default([])|map(i => i|merge({label: i.label|default('')|localized}))}) %}
{% set layout = hs.layout|default('classic') %}
{% set contact = theme_settings.footer|default({}) %}
{% set cta_href = link_url(hs.cta_url|default(''), prefix) %}
{% set has_cta = hs.cta_label|default('') != '' and cta_href != '' %}
{% set show_topbar_contacts = hs.topbar_contacts|default(false) and (contact.phone|default('') or contact.email|default('')) %}
{% set brand_logo = theme_settings.brand.logo|default('') %}
{% set brand_logo_dark = theme_settings.brand.logo_dark|default('') %}
{% set brand_show_name = theme_settings.brand.show_name|default(false) %}
{% set mobile_menu = hs.mobile_menu|default('drawer') in ['drawer', 'drawer_right', 'fullscreen', 'top_sheet', 'bottom_sheet'] ? hs.mobile_menu|default('drawer') : 'drawer' %}

{% set nav_markup %}
  <nav id="site-menu" class="site-nav" aria-label="{{ t('nav.main_label', 'Main') }}">
    {% if menu is empty %}
      <ul class="nav-list nav-list-1">
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
      </ul>
    {% else %}
      {{ menu_macros.header_menu(menu, prefix, 1) }}
    {% endif %}
  </nav>
{% endset %}

{% set contact_links %}
  {% if contact.phone|default('') %}<a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ icon('phone') }}<span>{{ contact.phone }}</span></a>{% endif %}
  {% if contact.email|default('') %}<a href="mailto:{{ contact.email }}">{{ icon('mail') }}<span>{{ contact.email }}</span></a>{% endif %}
{% endset %}

{% set row_tone = hs.row_tone|default('default') in ['muted', 'soft', 'contrast', 'accent'] ? hs.row_tone : 'default' %}
{% set search_mode = hs.search|default('icon') in ['field', 'none'] ? hs.search : 'icon' %}
{% set search_field = search_mode == 'field' %}
{# A switch that is off is false, which Twig's default() would turn back into its default. #}
{% set show_language = hs.show_language is defined ? hs.show_language : true %}
{% set show_mode = hs.show_mode is defined ? hs.show_mode : true %}
{% set shape = hs.shape|default('full') == 'floating' ? 'floating' : 'full' %}
{% set size = hs.size|default('regular') in ['compact', 'tall'] ? hs.size : 'regular' %}
{% set edge = hs.border|default('line') in ['none', 'shadow'] ? hs.border : 'line' %}
{% set nav_style = hs.nav_style|default('soft') in ['underline', 'plain'] ? hs.nav_style : 'soft' %}
{% set sticky_mode = hs.sticky|default('on_scroll') in ['always', 'smart', 'off'] ? hs.sticky|default('on_scroll') : 'on_scroll' %}
{% set topbar_tone = hs.topbar_tone|default('muted') in ['contrast', 'accent'] ? hs.topbar_tone : 'muted' %}
{% set cta_class = hs.cta_style|default('solid') == 'outline' ? 'btn' : 'btn btn-primary' %}
{% set topbar_href = link_url(hs.topbar_url|default(''), prefix) %}
{% set show_topbar_social = hs.topbar_social|default(false) and theme_settings.social|default({})|filter(v => v)|length > 0 %}
<header class="site-header header--{{ layout }} size-{{ size }} edge-{{ edge }} nav-{{ nav_style }}{% if shape == 'floating' %} is-floating{% endif %}{% if hs.width|default('contained') == 'wide' %} width-wide{% endif %}{% if hs.shrink|default(false) %} is-shrinking{% endif %}{% if row_tone != 'default' %} row-{{ row_tone }}{% endif %}{% if row_tone in ['contrast', 'accent'] %} tone-{{ row_tone }}{% endif %}{% if search_field %} has-search-field{% endif %}{% if transparent_header|default(false) %} is-transparent{% endif %}{% if transparent_on_dark|default(false) %} is-on-dark{% endif %}" data-sticky="{{ sticky_mode == 'smart' ? 'always' : sticky_mode }}"{% if sticky_mode == 'smart' %} data-smart{% endif %}>
  {% if hs.topbar_text|default('') or show_topbar_contacts or show_topbar_social %}
    <div class="topbar tone-{{ topbar_tone }}">
      <div class="site-wrap topbar-row">
        {% if hs.topbar_text|default('') %}<p class="topbar-text">{% if topbar_href %}<a href="{{ topbar_href }}">{{ hs.topbar_text }}</a>{% else %}{{ hs.topbar_text }}{% endif %}</p>{% endif %}
        {% if show_topbar_contacts %}<p class="topbar-contacts">{{ contact_links }}</p>{% endif %}
        {% if show_topbar_social %}{% include 'components/social-links.twig' with {list_class: 'topbar-icons'} %}{% endif %}
      </div>
    </div>
  {% endif %}

  <div class="site-wrap header-row">
    <button type="button" class="mobile-menu-button" data-mobile-open aria-controls="mobile-drawer" aria-expanded="false" aria-label="{{ t('nav.open', 'Open menu') }}">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <a class="site-brand" href="{{ url(prefix) }}"{% if brand_logo and not brand_show_name %} aria-label="{{ site.title }}"{% endif %}>
      {% if brand_logo %}
        {# With a logo for dark backgrounds both are drawn and the style sheet shows the one that suits (dark mode, a dark header). #}
        {{ image(brand_logo, {alt: '', class: brand_logo_dark ? 'site-brand-logo logo-on-light' : 'site-brand-logo', loading: 'eager', sizes: '12rem'}) }}
        {% if brand_logo_dark %}{{ image(brand_logo_dark, {alt: '', class: 'site-brand-logo logo-on-dark', loading: 'eager', sizes: '12rem'}) }}{% endif %}
        {% if brand_show_name %}<span class="site-brand-title">{{ site.title }}</span>{% endif %}
      {% else %}
        <span class="site-brand-title">{{ site.title }}</span>
      {% endif %}
    </a>

    {% if layout in ['classic', 'menu_left', 'split'] %}{{ nav_markup }}{% endif %}

    {% if layout == 'stacked' and not show_topbar_contacts and (contact.phone|default('') or contact.email|default('')) %}
      <p class="header-contacts">{{ contact_links }}</p>
    {% endif %}

    <div class="header-tools">
      {% if search_field %}
        <form class="header-search" role="search" action="{{ url(prefix ~ 'search') }}" method="get">
          <label class="visually-hidden" for="header-search-q">{{ t('search.title', 'Search') }}</label>
          <input type="search" id="header-search-q" name="q" placeholder="{{ t('search.placeholder') }}">
          <button class="btn btn-primary" type="submit">{{ t('search.title', 'Search') }}</button>
        </form>
      {% endif %}
      {% if search_mode != 'none' %}
        <a class="search-link" href="{{ url(prefix ~ 'search') }}" aria-label="{{ t('search.title', 'Search') }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M10.5 3a7.5 7.5 0 105.01 13.08l4.2 4.2 1.41-1.41-4.2-4.2A7.5 7.5 0 0010.5 3zm0 2a5.5 5.5 0 110 11 5.5 5.5 0 010-11z"></path>
          </svg>
        </a>
      {% endif %}
      {% if show_language %}{% include 'components/language-links.twig' with {links_class: 'lang-switcher'} %}{% endif %}
      {% if show_mode %}
        <button type="button" class="mode-switch" data-theme-toggle role="switch" aria-checked="false" aria-label="{{ t('theme.switch_mode', 'Dark mode') }}">
          <span class="mode-switch-track" aria-hidden="true">
            <span class="mode-switch-thumb"></span>
          </span>
        </button>
      {% endif %}
      {% if has_cta %}<a class="{{ cta_class }} header-cta" href="{{ cta_href }}">{{ hs.cta_label }}</a>{% endif %}
    </div>
  </div>

  {% if layout == 'centered' or layout == 'stacked' %}
    <div class="header-bar tone-{{ layout == 'stacked' ? hs.bar_tone|default('default') : 'default' }}">
      <div class="site-wrap">{{ nav_markup }}</div>
    </div>
  {% endif %}
</header>

{# The menu panel sits outside the header: a sticky or blurred header would otherwise become its frame, and a header over a dark hero would hand it light-on-dark colours. #}
<div class="mobile-drawer-overlay" data-mobile-overlay aria-hidden="true"></div>
<div class="mobile-drawer mobile-drawer--{{ mobile_menu }}" id="mobile-drawer" data-mobile-drawer role="dialog" aria-modal="true" aria-label="{{ t('nav.menu', 'Menu') }}" aria-hidden="true" tabindex="-1">
  <div class="mobile-drawer-header">
    <span class="mobile-drawer-title">{{ site.title }}</span>
    <button type="button" class="mobile-drawer-close" data-mobile-close aria-label="{{ t('nav.close', 'Close menu') }}"><span aria-hidden="true">×</span></button>
  </div>

  <nav class="mobile-drawer-nav" aria-label="{{ t('nav.main_label', 'Main') }}">
    {% if menu is empty %}
      <ul class="mobile-menu mobile-menu-1">
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
        <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
      </ul>
    {% else %}
      {{ menu_macros.mobile_menu(menu, prefix, 1, 3) }}
    {% endif %}
    {% if has_cta %}<a class="btn btn-primary drawer-cta" href="{{ cta_href }}">{{ hs.cta_label }}</a>{% endif %}
  </nav>

  <div class="drawer-tools">
    {% if search_mode != 'none' %}<a class="text-link" href="{{ url(prefix ~ 'search') }}">{{ t('search.title', 'Search') }}</a>{% endif %}
    {% if show_language %}{% include 'components/language-links.twig' with {links_class: 'lang-switcher'} %}{% endif %}
  </div>

  <div class="drawer-icons-wrap">
    {% include 'components/social-links.twig' with {list_class: 'drawer-icons'} %}
  </div>
</div>

{% if hs.mobile_bar|default(false) %}
  {# The Menu button is always first (the header's own button is hidden on phones while this bar is on); the rest is the list chosen in Theme settings, or call, email, and the header button when none is chosen. #}
  {% set bar_items = hs.bar_items|default([])|filter(i => i.url and (i.label or i.icon)) %}
  <nav class="mobile-bar" aria-label="{{ t('nav.quick', 'Quick actions') }}">
    <button type="button" class="mobile-bar-item" data-mobile-open aria-controls="mobile-drawer" aria-expanded="false">{{ icon('menu') }}<span>{{ t('nav.menu', 'Menu') }}</span></button>
    {% if bar_items is not empty %}
      {% for bar_item in bar_items %}
        {% set bar_href = link_url(bar_item.url, prefix) %}
        {% if bar_href %}
          <a class="mobile-bar-item" href="{{ bar_href }}">{{ icon(bar_item.icon|default('') ?: 'arrow-right') }}<span>{{ bar_item.label }}</span></a>
        {% endif %}
      {% endfor %}
    {% else %}
      {% if contact.phone|default('') %}
        <a class="mobile-bar-item" href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ icon('phone') }}<span>{{ t('nav.call', 'Call') }}</span></a>
      {% endif %}
      {% if contact.email|default('') %}
        <a class="mobile-bar-item" href="mailto:{{ contact.email }}">{{ icon('mail') }}<span>Email</span></a>
      {% endif %}
      {% if has_cta %}
        <a class="mobile-bar-item is-primary" href="{{ cta_href }}">{{ icon('arrow-right') }}<span>{{ hs.cta_label }}</span></a>
      {% endif %}
    {% endif %}
  </nav>
{% endif %}
