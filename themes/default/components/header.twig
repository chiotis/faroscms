{#
  Site header. Theme settings > Header chooses the layout (classic, centered, minimal, stacked with a
  navigation bar underneath), transparency over an opening hero, stickiness, a CTA button, a top bar,
  and a fixed bottom bar on phones. The layout sets transparent_header / transparent_on_dark.
#}
{% import 'components/menu-macros.twig' as menu_macros %}
{% set menu = theme_menus.header ?? [] %}
{% set hs = theme_settings.header|default({}) %}
{% set layout = hs.layout|default('classic') %}
{% set contact = theme_settings.footer|default({}) %}
{% set cta_href = link_url(hs.cta_url|default(''), prefix) %}
{% set has_cta = hs.cta_label|default('') != '' and cta_href != '' %}
{% set show_topbar_contacts = hs.topbar_contacts|default(false) and (contact.phone|default('') or contact.email|default('')) %}
{% set brand_logo = theme_settings.brand.logo|default('') %}

{% set nav_markup %}
  <nav id="site-menu" class="site-nav" aria-label="{{ t('nav.main_label', 'Main') }}">
    {% if menu is empty %}
      <ul class="nav-list nav-list-1">
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
      </ul>
    {% else %}
      {{ menu_macros.header_menu(menu, prefix, 1) }}
    {% endif %}
  </nav>
{% endset %}

{% set contact_links %}
  {% if contact.phone|default('') %}<a href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ icon('phone') }}<span>{{ contact.phone }}</span></a>{% endif %}
  {% if contact.email|default('') %}<a href="mailto:{{ contact.email }}">{{ icon('mail') }}<span>{{ contact.email }}</span></a>{% endif %}
{% endset %}

<header class="site-header header--{{ layout }}{% if transparent_header|default(false) %} is-transparent{% endif %}{% if transparent_on_dark|default(false) %} is-on-dark{% endif %}" data-sticky="{{ hs.sticky|default('on_scroll') }}">
  {% if hs.topbar_text|default('') or show_topbar_contacts %}
    <div class="topbar">
      <div class="site-wrap topbar-row">
        {% if hs.topbar_text|default('') %}<p class="topbar-text">{{ hs.topbar_text }}</p>{% endif %}
        {% if show_topbar_contacts %}<p class="topbar-contacts">{{ contact_links }}</p>{% endif %}
      </div>
    </div>
  {% endif %}

  <div class="site-wrap header-row">
    <button type="button" class="mobile-menu-button" data-mobile-open aria-controls="mobile-drawer" aria-expanded="false" aria-label="{{ t('nav.open', 'Open menu') }}">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <a class="site-brand" href="{{ url(prefix) }}"{% if brand_logo %} aria-label="{{ site.title }}"{% endif %}>
      {% if brand_logo %}
        {{ image(brand_logo, {alt: '', class: 'site-brand-logo', loading: 'eager', sizes: '12rem'}) }}
      {% else %}
        <span class="site-brand-title">{{ site.title }}</span>
      {% endif %}
    </a>

    {% if layout == 'classic' %}{{ nav_markup }}{% endif %}

    {% if layout == 'stacked' and not show_topbar_contacts and (contact.phone|default('') or contact.email|default('')) %}
      <p class="header-contacts">{{ contact_links }}</p>
    {% endif %}

    <div class="header-tools">
      <a class="search-link" href="{{ url(prefix ~ 'search') }}" aria-label="{{ t('search.title', 'Search') }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M10.5 3a7.5 7.5 0 105.01 13.08l4.2 4.2 1.41-1.41-4.2-4.2A7.5 7.5 0 0010.5 3zm0 2a5.5 5.5 0 110 11 5.5 5.5 0 010-11z"></path>
        </svg>
      </a>
      {% include 'components/language-links.twig' with {links_class: 'lang-switcher'} %}
      <button type="button" class="mode-switch" data-theme-toggle role="switch" aria-checked="false" aria-label="{{ t('theme.switch_mode', 'Dark mode') }}">
        <span class="mode-switch-track" aria-hidden="true">
          <span class="mode-switch-thumb"></span>
        </span>
      </button>
      {% if has_cta %}<a class="btn btn-primary header-cta" href="{{ cta_href }}">{{ hs.cta_label }}</a>{% endif %}
    </div>
  </div>

  {% if layout == 'centered' or layout == 'stacked' %}
    <div class="header-bar tone-{{ layout == 'stacked' ? hs.bar_tone|default('default') : 'default' }}">
      <div class="site-wrap">{{ nav_markup }}</div>
    </div>
  {% endif %}

  <div class="mobile-drawer-overlay" data-mobile-overlay aria-hidden="true"></div>
  <div class="mobile-drawer" id="mobile-drawer" data-mobile-drawer role="dialog" aria-modal="true" aria-label="{{ t('nav.menu', 'Menu') }}" aria-hidden="true" tabindex="-1">
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">{{ site.title }}</span>
      <button type="button" class="mobile-drawer-close" data-mobile-close aria-label="{{ t('nav.close', 'Close menu') }}"><span aria-hidden="true">×</span></button>
    </div>

    <nav class="mobile-drawer-nav" aria-label="{{ t('nav.main_label', 'Main') }}">
      {% if menu is empty %}
        <ul class="mobile-menu mobile-menu-1">
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
        </ul>
      {% else %}
        {{ menu_macros.mobile_menu(menu, prefix, 1, 3) }}
      {% endif %}
      {% if has_cta %}<a class="btn btn-primary drawer-cta" href="{{ cta_href }}">{{ hs.cta_label }}</a>{% endif %}
    </nav>

    <div class="drawer-tools">
      <a class="text-link" href="{{ url(prefix ~ 'search') }}">{{ t('search.title', 'Search') }}</a>
      {% include 'components/language-links.twig' with {links_class: 'lang-switcher'} %}
    </div>

    <div class="drawer-icons-wrap">
      {% include 'components/social-links.twig' with {list_class: 'drawer-icons'} %}
    </div>
  </div>
</header>

{% if hs.mobile_bar|default(false) %}
  <nav class="mobile-bar" aria-label="{{ t('nav.quick', 'Quick actions') }}">
    <button type="button" class="mobile-bar-item" data-mobile-open aria-controls="mobile-drawer" aria-expanded="false">{{ icon('menu') }}<span>{{ t('nav.menu', 'Menu') }}</span></button>
    {% if contact.phone|default('') %}
      <a class="mobile-bar-item" href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ icon('phone') }}<span>{{ t('nav.call', 'Call') }}</span></a>
    {% endif %}
    {% if contact.email|default('') %}
      <a class="mobile-bar-item" href="mailto:{{ contact.email }}">{{ icon('mail') }}<span>Email</span></a>
    {% endif %}
    {% if has_cta %}
      <a class="mobile-bar-item is-primary" href="{{ cta_href }}">{{ icon('arrow-right') }}<span>{{ hs.cta_label }}</span></a>
    {% endif %}
  </nav>
{% endif %}
