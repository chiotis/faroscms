{#
  How a page opens, decided in one place so the header, the layout, and the title area agree.
    layout(item, settings)       the title layout: default, centered, split, cover, minimal
    transparent(item, settings)  "1" when the header sits over the opening hero, otherwise empty
  Each answers from the entry's own choice (front matter hero_layout / header_transparent), then the
  setting for its content type (Theme settings > Hero Layouts / Transparent Header), then the site default.
#}
{% macro layout(item, settings) -%}
  {%- set layouts = settings.hero_layouts|default({}) -%}
  {%- set own = item.meta.hero_layout|default('') -%}
  {%- set layout = own in ['default', 'centered', 'split', 'cover', 'minimal'] ? own : (layouts[item.type|default('pages')]|default(layouts.default|default('default'))) -%}
  {%- set image = item.meta.hero_image|default(item.meta.main_image|default('')) -%}
  {#- A cover needs a picture; without one the title area is the plain one. -#}
  {{- layout == 'cover' and not image ? 'default' : layout -}}
{%- endmacro %}

{% macro transparent(item, settings) -%}
  {%- set own = item.meta.header_transparent|default('') -%}
  {%- set own = own is same as(true) ? 'on' : (own is same as(false) ? 'off' : own) -%}
  {%- set per_type = settings.transparent_header|default({}) -%}
  {%- set by_type = per_type[item.type|default('pages')]|default(per_type.default|default('site')) -%}
  {%- set choice = own in ['on', 'off'] ? own : (by_type in ['on', 'off'] ? by_type : 'site') -%}
  {{- choice == 'on' or (choice == 'site' and settings.header.transparent|default(false)) ? '1' : '' -}}
{%- endmacro %}
