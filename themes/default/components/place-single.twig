{#
  The page of one point of interest, route or business: a title band (with the picture behind it), the facts, a map, the text and
  the blocks, and what is near. The three templates (single-point, single-route, single-business) only say which one it is, so a
  site can change this one file, or one template, and leave the rest.
  Variables: item, kind ('point', 'route' or 'business').
  The Single Layouts card of the type chooses the map's height, whether to show the facts, the height profile (routes), the download
  button (routes) and what is near, and how far counts as near.
#}
{% set single = single_layout(item.type) %}
{% set opt = single.options|default({}) %}
{% set prefix = lang_prefix|default('') %}
{% set fields = item.meta.custom_fields|default({}) %}
{% set cover = item.meta.main_image|default('') %}
{% set decimal = current_language == 'el' ? ',' : '.' %}
{% set thousands = current_language == 'el' ? '.' : ',' %}
{% set is_route = kind == 'route' %}
{% set route = is_route ? route_facts(item) : null %}
{% set entries = content_fields(item) %}
{% set position = geo_position(item) %}
{% set nearby_radius = opt.nearby_radius|default(is_route ? 2 : 5) %}
{% set near_types = is_route ? ['points', 'businesses'] : (kind == 'business' ? ['routes', 'points', 'businesses'] : ['routes', 'businesses', 'points']) %}
{% set near = (opt.show_nearby ?? true) ? geo_nearby(item, near_types, nearby_radius, 18) : [] %}
{% set show_map = (opt.show_map ?? true) and position %}
{% set map_height = opt.map_height|default(is_route ? 'large' : 'medium') %}
{% set booking = link_url(fields.booking_url ?? '', prefix) %}
{% set website = fields.website ?? '' %}
{% set track_url = is_route ? link_url(fields.track ?? '', prefix) : '' %}
{% set icons = {area: 'map-pin', address: 'map-pin', phone: 'phone', email: 'mail', website: 'globe', opening_hours: 'clock', admission: 'info', season: 'clock', trailhead: 'map-pin', altitude: 'compass'} %}

<section class="place-hero{% if cover %} has-cover{% endif %}">
  {% if cover %}<div class="place-hero-media">{{ image(cover, {alt: '', priority: true, sizes: '100vw', max_width: 2000}) }}</div>{% endif %}
  <div class="site-wrap place-hero-inner">
    {% set categories = item.meta.categories|default([]) %}
    {% if fields.area|default('') or categories %}
      <p class="place-kicker">
        {% if fields.area|default('') %}<span class="place-area">{{ icon('map-pin', 'place-kicker-icon') }}{{ fields.area }}</span>{% endif %}
        {% for term in categories %}<a class="place-term" href="{{ taxonomy_url('categories', term, prefix) }}">{{ taxonomy_label('categories', term) }}</a>{% endfor %}
      </p>
    {% endif %}
    <h1 class="place-title">{{ item.meta.title }}</h1>
    {% if item.meta.excerpt|default('') %}<p class="place-lead">{{ item.meta.excerpt }}</p>{% endif %}
    {% if booking or (is_route and track_url and (opt.show_download ?? true)) %}
      <p class="place-actions">
        {% if booking %}<a class="btn btn-primary" href="{{ booking }}" rel="noopener">{{ fields.booking_label|default('') ?: t('place.book', 'Book now') }}{{ icon('arrow-right', 'btn-icon') }}</a>{% endif %}
        {% if is_route and track_url and (opt.show_download ?? true) %}<a class="btn btn-secondary place-download" href="{{ track_url }}" download>{{ icon('download', 'btn-icon') }}{{ t('route.download', 'Download the route') }} ({{ (fields.track|split('?')|first|split('.')|last)|upper }})</a>{% endif %}
      </p>
    {% endif %}
  </div>
</section>

{% if route %}
  {% set stats = [] %}
  {% if route.distance_km is not null %}{% set stats = stats|merge([{label: t('route.length', 'Length'), value: route.distance_km|number_format(1, decimal, thousands) ~ ' km'}]) %}{% endif %}
  {% if fields.duration|default('') %}{% set stats = stats|merge([{label: t('route.duration', 'Duration'), value: fields.duration}]) %}{% endif %}
  {% if route.ascent_m is not null and route.ascent_m > 0 %}{% set stats = stats|merge([{label: t('route.ascent', 'Climb'), value: '↑ ' ~ route.ascent_m|number_format(0, decimal, thousands) ~ ' m'}]) %}{% endif %}
  {% if route.descent_m is not null and route.descent_m > 0 %}{% set stats = stats|merge([{label: t('route.descent', 'Descent'), value: '↓ ' ~ route.descent_m|number_format(0, decimal, thousands) ~ ' m'}]) %}{% endif %}
  {% if route.max_m is not null %}{% set stats = stats|merge([{label: t('route.highest', 'Highest point'), value: route.max_m|number_format(0, decimal, thousands) ~ ' m'}]) %}{% endif %}
  {% if fields.difficulty|default('') %}{% set stats = stats|merge([{label: t('route.difficulty', 'Difficulty'), value: (content_type(item.type).fields.difficulty is defined ? content_type(item.type).fields.difficulty.options[fields.difficulty]|default(fields.difficulty) : fields.difficulty)}]) %}{% endif %}
  {% if fields.route_type|default('') or route.loop %}{% set stats = stats|merge([{label: t('route.type', 'Type'), value: (content_type(item.type).fields.route_type is defined ? content_type(item.type).fields.route_type.options[fields.route_type|default('loop')]|default(t('route.loop', 'Loop')) : t('route.loop', 'Loop'))}]) %}{% endif %}
  {% if stats %}
    <div class="site-wrap">
      <dl class="route-stats">
        {% for stat in stats %}<div class="route-stat"><dt>{{ stat.label }}</dt><dd>{{ stat.value }}</dd></div>{% endfor %}
      </dl>
    </div>
  {% endif %}
{% endif %}

{% if is_route and show_map %}
  <section class="site-wrap place-map-wide" aria-label="{{ t('map.title', 'Map') }}">
    {% include 'components/geo-map.twig' with {geo: geo_single(item, {types: near_types, radius: nearby_radius, limit: 18}), height: map_height, list: 'none', cluster: false, label: item.meta.title ~ ' — ' ~ t('map.title', 'Map')} only %}
    {% if route and route.profile|length > 1 and (opt.show_profile ?? true) %}
      <figure class="route-profile-figure">
        <figcaption>{{ t('route.profile', 'Height profile') }}{% if route.min_m is not null %} <span>{{ route.min_m }}–{{ route.max_m }} m</span>{% endif %}</figcaption>
        {{ elevation_profile(route.profile, t('route.profile', 'Height profile') ~ ': ' ~ route.min_m ~ '–' ~ route.max_m ~ ' m, ' ~ route.distance_km|number_format(1, decimal, thousands) ~ ' km') }}
        <div class="route-profile-scale" aria-hidden="true"><span>0 km</span><span>{{ route.profile|last|first|number_format(1, decimal, thousands) }} km</span></div>
      </figure>
    {% endif %}
  </section>
{% endif %}

<div class="site-wrap place-layout">
  <article class="place-main prose-block">
    {{ item.html|raw }}
  </article>
  <aside class="place-aside" aria-label="{{ t('sidebar.label', 'More on this topic') }}">
    {% if (opt.show_facts ?? true) and (entries or categories) %}
      <section class="place-card place-info">
        <h2 class="place-card-title">{{ t('place.info.' ~ kind, kind == 'business' ? 'Business information' : (kind == 'route' ? 'About the route' : 'Information')) }}</h2>
        <ul class="place-facts" role="list">
          {% if categories and kind == 'business' %}
            <li>{{ icon('star', 'place-fact-icon') }}<span><strong>{{ t('place.type', 'Type') }}:</strong> {% for term in categories %}{{ taxonomy_label('categories', term) }}{% if not loop.last %}, {% endif %}{% endfor %}</span></li>
          {% endif %}
          {% for entry in entries|filter(e => not (is_route and e.key in ['difficulty', 'duration', 'route_type'])) %}
            <li>
              {{ icon(icons[entry.key]|default('info'), 'place-fact-icon') }}
              <span>
                {%- if entry.type == 'url' -%}<a href="{{ entry.value }}" rel="noopener">{{ entry.display }}</a>
                {%- elseif entry.type == 'email' -%}<a href="mailto:{{ entry.value }}">{{ entry.value }}</a>
                {%- elseif entry.type == 'link' -%}{% set href = link_url(entry.value, prefix) %}{% if href %}<a href="{{ href }}">{{ entry.display }}</a>{% else %}{{ entry.display }}{% endif %}
                {%- elseif entry.type == 'toggle' -%}<strong>{{ entry.label }}</strong>
                {%- elseif entry.key == 'phone' -%}<strong>{{ entry.label }}:</strong> <a href="tel:{{ entry.value|replace({' ': '', '-': ''}) }}">{{ entry.value }}</a>
                {%- else -%}<strong>{{ entry.label }}:</strong> {{ entry.display }}
                {%- endif -%}
              </span>
            </li>
          {% endfor %}
          {% if fields.facebook|default('') %}<li>{{ icon('users', 'place-fact-icon') }}<span><a href="{{ fields.facebook }}" rel="noopener">Facebook</a></span></li>{% endif %}
          {% if fields.instagram|default('') %}<li>{{ icon('heart', 'place-fact-icon') }}<span><a href="{{ fields.instagram }}" rel="noopener">Instagram</a></span></li>{% endif %}
        </ul>
      </section>
    {% endif %}
    {% if not is_route and show_map %}
      <section class="place-card place-map-card" aria-label="{{ t('map.title', 'Map') }}">
        {% include 'components/geo-map.twig' with {geo: geo_single(item, {types: near_types, radius: nearby_radius, limit: 18}), height: map_height, list: 'none', cluster: false, label: item.meta.title ~ ' — ' ~ t('map.title', 'Map')} only %}
        {% if position %}<p class="place-map-links"><a class="text-link" href="https://www.openstreetmap.org/?mlat={{ position.lat }}&amp;mlon={{ position.lng }}#map=16/{{ position.lat }}/{{ position.lng }}" rel="noopener">{{ t('map.open', 'Open in OpenStreetMap') }}{{ icon('arrow-up-right', 'btn-icon') }}</a> <a class="text-link" href="https://www.openstreetmap.org/directions?route=%3B{{ position.lat }}%2C{{ position.lng }}" rel="noopener">{{ t('map.directions', 'Directions') }}{{ icon('arrow-up-right', 'btn-icon') }}</a></p>{% endif %}
      </section>
    {% endif %}
    {% for group in near_types %}
      {% set found = near|filter(n => n.item.type == group) %}
      {% if found %}
        <section class="place-card place-near">
          <h2 class="place-card-title">{{ t('place.near.' ~ group, group == 'routes' ? 'Routes and trails nearby' : (group == 'businesses' ? 'Businesses nearby' : 'Places nearby')) }}</h2>
          <ul class="place-near-list" role="list">
            {% for entry in found|slice(0, 6) %}
              {% set other = entry.item %}
              <li>
                <a class="place-near-item" href="{{ url(item_path(other, prefix)) }}">
                  <span class="place-near-media">{% if other.meta.main_image|default('') %}{{ image(other.meta.main_image, {alt: '', sizes: '96px', max_width: 240}) }}{% endif %}</span>
                  <span class="place-near-body">
                    <span class="place-near-title">{{ other.meta.title }}</span>
                    <span class="place-near-meta">{% if other.meta.custom_fields.area|default('') %}{{ other.meta.custom_fields.area }} · {% endif %}{{ entry.km < 1 ? (entry.km * 1000)|round(-1)|number_format(0, decimal, thousands) ~ ' m' : entry.km|number_format(1, decimal, thousands) ~ ' km' }}</span>
                  </span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    {% endfor %}
  </aside>
</div>
{% if page_blocks|default(null) %}
  {{ page_blocks.html|raw }}
{% endif %}
