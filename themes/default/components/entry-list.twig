{#
  Content entries in one of the latest-content layouts. Used by the "Latest content" block and by archives.
  Variables: entries, variant, columns, show_image, show_excerpt, show_meta, show_date (default: like show_meta), prefix, lang, heading_tag, label.
#}
{% set view = {show_image: show_image, show_excerpt: show_excerpt, show_meta: show_meta, show_date: show_date ?? show_meta, prefix: prefix, lang: lang, heading_tag: heading_tag, variant: variant} %}
{% set tile_sizes = columns == '2' ? '(min-width: 900px) 46vw, 92vw' : (columns == '4' ? '(min-width: 1100px) 23vw, (min-width: 700px) 45vw, 92vw' : '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw') %}
{% if variant in ['featured', 'magazine'] %}
  <div class="latest-{{ variant }}">
    <div class="latest-lead">
      {% include 'blocks/latest/item.twig' with view|merge({item: entries|first, lead: true, sizes: variant == 'magazine' ? '(min-width: 1100px) 1100px, 94vw' : '(min-width: 1000px) 640px, 94vw'}) only %}
    </div>
    {% if entries|length > 1 %}
      <ul class="latest-rest" role="list">
        {% for entry in entries|slice(1) %}
          <li>{% include 'blocks/latest/item.twig' with view|merge({item: entry, lead: false, sizes: variant == 'magazine' ? '(min-width: 1000px) 30vw, (min-width: 700px) 45vw, 92vw' : '160px'}) only %}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% else %}
  {% set sizes = variant == 'editorial' ? '(min-width: 900px) 50vw, 92vw' : (variant in ['list', 'compact'] ? '160px' : (variant == 'strip' ? '(min-width: 900px) 30vw, 80vw' : tile_sizes)) %}
  <ul class="latest-list cols-{{ columns }}" role="list"{% if variant == 'strip' %} tabindex="0" aria-label="{{ label }}"{% endif %}>
    {% for entry in entries %}
      <li>{% include 'blocks/latest/item.twig' with view|merge({item: entry, lead: false, sizes: sizes, index: loop.index}) only %}</li>
    {% endfor %}
  </ul>
{% endif %}
