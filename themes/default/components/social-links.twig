  youtube: ['YouTube', 'M21.6 8.2s-.2-1.6-.8-2.3c-.8-.9-1.7-.9-2.1-1C15.8 4.6 12 4.6 12 4.6h0s-3.8 0-6.7.3c-.4.1-1.3.1-2.1 1-.6.7-.8 2.3-.8 2.3S2 10.1 2 12v1.8c0 1.9.4 3.8.4 3.8s.2 1.6.8 2.3c.8.9 1.9.8 2.4 1 1.7.2 6.4.3 6.4.3s3.8 0 6.7-.3c.4-.1 1.3-.1 2.1-1 .6-.7.8-2.3.8-2.3s.4-1.9.4-3.8V12c0-1.9-.4-3.8-.4-3.8zM9.8 15.7V8.9l6 3.4-6 3.4z'],
