} %}
{% set has_links = false %}
{% for key, network in networks %}{% if social[key] ?? '' %}{% set has_links = true %}{% endif %}{% endfor %}
{% if has_links %}
  <ul class="{{ list_class|default('footer-icons') }}" role="list">
    {% for key, network in networks %}
      {% if social[key] ?? '' %}
        <li><a href="{{ social[key] }}" rel="me noopener" aria-label="{{ network[0] }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ network[1] }}"></path></svg>
        </a></li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}
