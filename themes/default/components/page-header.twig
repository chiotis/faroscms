{# Title header for a page (layout from Theme settings > Hero Layouts; image and colour from front matter). #}
{% set hero_layouts = theme_settings.hero_layouts|default({}) %}
{% set hero_layout = hero_layouts[item.type|default('pages')]|default(hero_layouts.default|default('default')) %}
{% set is_centered_hero = hero_layout == 'centered' %}
{% set hero_image = item.meta.hero_image ?? item.meta.main_image ?? '' %}
{% set hero_bg = item.meta.hero_background ?? item.meta.hero_color ?? '' %}
{% if is_centered_hero %}
  <section class="single-hero single-hero-centered"{% if hero_bg %} style="--hero-bg:{{ hero_bg|e('html_attr') }};"{% endif %}>
    <div class="site-wrap single-hero-inner">
      <h1>{{ item.meta.title }}</h1>
      {% if item.meta.excerpt is defined and item.meta.excerpt %}
        <p class="single-hero-subtitle">{{ item.meta.excerpt }}</p>
      {% elseif site.tagline %}
        <p class="single-hero-subtitle">{{ site.tagline }}</p>
      {% endif %}
      {% if hero_image %}
        <div class="single-hero-media">
          {{ image(hero_image, {priority: true, sizes: '(min-width: 1280px) 1216px, 92vw'}) }}
        </div>
      {% endif %}
    </div>
  </section>
{% else %}
  <section class="single-hero{% if hero_image %} has-image{% endif %}"{% if hero_image or hero_bg %} style="{% if hero_image %}--hero-image:url('{{ hero_image|e('html_attr') }}');{% endif %}{% if hero_bg %}--hero-bg:{{ hero_bg|e('html_attr') }};{% endif %}"{% endif %}>
    <div class="site-wrap single-hero-inner">
      <h1>{{ item.meta.title }}</h1>
      <p class="single-hero-subtitle">{{ item.meta.excerpt ?? site.tagline }}</p>
    </div>
  </section>
{% endif %}
