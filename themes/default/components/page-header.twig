{#
  Title header for a page, post, project or form. The layout is the entry's own choice or the one from
  Theme settings > Single Layouts (see hero-layout.twig) and follows the Hero block: default, centered, split,
  cover, minimal. The same place switches the image, the excerpt and the line above the title on or off for a
  content type. Image and colour come from front matter. A template can pass:
    hero_subtitle  text under the title (default: the excerpt; nothing when there is none)
    hero_meta      small line above the title, as HTML
    hero_meta_inline  the same line worded for the centred layouts (default: hero_meta)
#}
{% import 'components/hero-layout.twig' as opening %}
{% set layout = opening.layout(item, theme_settings)|trim %}
{% set single = single_layout(item.type|default('pages')) %}
{% set hero_image = opening.image(item, theme_settings)|trim %}
{% set hero_parallax = opening.parallax(item, theme_settings)|trim != '' %}
{% set hero_bg = item.meta.hero_background ?? item.meta.hero_color ?? '' %}
{% set hero_text = single.excerpt is same as(false) ? '' : (hero_subtitle is defined ? hero_subtitle : item.meta.excerpt|default('')) %}
{% set meta_html = single.byline is same as(false) ? '' : hero_meta|default('') %}
{% set meta_inline = single.byline is same as(false) ? '' : (hero_meta_inline|default('')|trim ? hero_meta_inline : meta_html) %}
{% include 'components/title-area.twig' with {layout: layout, title: item.meta.title, hero_text: hero_text, meta_html: meta_html, meta_inline: meta_inline, hero_image: hero_image, hero_bg: hero_bg, hero_parallax: hero_parallax} only %}
