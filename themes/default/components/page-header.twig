{#
  Title header for a page, post, project or form. The layout comes from Theme settings > Hero Layouts and
  follows the Hero block: default, centered, split, cover, minimal. Image and colour come from front matter.
  A template can pass:
    hero_type      content type to look the layout up for (default: the item's own type)
    hero_subtitle  text under the title (default: the excerpt, then the site tagline)
    hero_meta      small line above the title, as HTML
    hero_meta_inline  the same line worded for the centred layouts (default: hero_meta)
#}
{% set hero_layouts = theme_settings.hero_layouts|default({}) %}
{% set hero_layout = hero_layouts[hero_type|default(item.type|default('pages'))]|default(hero_layouts.default|default('default')) %}
{% set hero_image = item.meta.hero_image ?? item.meta.main_image ?? '' %}
{% set hero_bg = item.meta.hero_background ?? item.meta.hero_color ?? '' %}
{% set hero_text = hero_subtitle is defined ? hero_subtitle : (item.meta.excerpt|default('') ?: site.tagline|default('')) %}
{% set meta_html = hero_meta|default('') %}
{% set meta_inline = hero_meta_inline|default('')|trim ? hero_meta_inline : meta_html %}
{# A cover needs a picture, and a minimal header is text only; without one they fall back to the default look. #}
{% set layout = hero_layout == 'cover' and not hero_image ? 'default' : hero_layout %}
{% set bg_style = hero_bg ? ' style="--hero-bg:' ~ hero_bg|e('html_attr') ~ ';"' : '' %}
{% if layout == 'centered' %}
  <section class="single-hero single-hero-centered"{{ bg_style|raw }}>
    <div class="site-wrap single-hero-inner">
      {% if meta_inline|trim %}<p class="single-hero-meta single-hero-meta-inline">{{ meta_inline }}</p>{% endif %}
      <h1>{{ item.meta.title }}</h1>
      {% if hero_text %}<p class="single-hero-subtitle">{{ hero_text }}</p>{% endif %}
      {% if hero_image %}
        <div class="single-hero-media">
          {{ image(hero_image, {priority: true, sizes: '(min-width: 1280px) 1216px, 92vw'}) }}
        </div>
      {% endif %}
    </div>
  </section>
{% elseif layout == 'split' %}
  <section class="single-hero single-hero-split{% if not hero_image %} no-media{% endif %}"{{ bg_style|raw }}>
    <div class="site-wrap single-hero-inner">
      <div class="single-hero-content">
        {% if meta_inline|trim %}<p class="single-hero-meta single-hero-meta-inline">{{ meta_inline }}</p>{% endif %}
        <h1>{{ item.meta.title }}</h1>
        {% if hero_text %}<p class="single-hero-subtitle">{{ hero_text }}</p>{% endif %}
      </div>
      {% if hero_image %}
        <div class="single-hero-media">
          {{ image(hero_image, {priority: true, sizes: '(min-width: 960px) 46vw, 92vw'}) }}
        </div>
      {% endif %}
    </div>
  </section>
{% elseif layout == 'cover' %}
  <section class="single-hero single-hero-cover"{{ bg_style|raw }}>
    <div class="single-hero-cover-media">
      {{ image(hero_image, {priority: true, sizes: '100vw'}) }}
    </div>
    <div class="site-wrap single-hero-inner">
      {% if meta_inline|trim %}<p class="single-hero-meta single-hero-meta-inline">{{ meta_inline }}</p>{% endif %}
      <h1>{{ item.meta.title }}</h1>
      {% if hero_text %}<p class="single-hero-subtitle">{{ hero_text }}</p>{% endif %}
    </div>
  </section>
{% elseif layout == 'minimal' %}
  <section class="single-hero single-hero-minimal"{{ bg_style|raw }}>
    <div class="site-wrap single-hero-inner">
      {% if meta_inline|trim %}<p class="single-hero-meta single-hero-meta-inline">{{ meta_inline }}</p>{% endif %}
      <h1>{{ item.meta.title }}</h1>
      {% if hero_text %}<p class="single-hero-subtitle">{{ hero_text }}</p>{% endif %}
    </div>
  </section>
{% else %}
  <section class="single-hero{% if hero_image %} has-image{% endif %}"{% if hero_image or hero_bg %} style="{% if hero_image %}--hero-image:url('{{ hero_image|e('html_attr') }}');{% endif %}{% if hero_bg %}--hero-bg:{{ hero_bg|e('html_attr') }};{% endif %}"{% endif %}>
    <div class="site-wrap single-hero-inner">
      {% if meta_html|trim %}<p class="single-hero-meta">{{ meta_html }}</p>{% endif %}
      <h1>{{ item.meta.title }}</h1>
      {% if hero_text %}<p class="single-hero-subtitle">{{ hero_text }}</p>{% endif %}
    </div>
  </section>
{% endif %}
