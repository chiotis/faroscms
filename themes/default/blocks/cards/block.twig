{% import 'components/ui.twig' as ui %}
{% set prefix = lang_prefix|default('') %}
{% set all_href = link_url(block.link_url, prefix) %}
<div class="container">
  <div class="cards-head">
    {{ ui.section_header(block, heading_tag, block_uid, 'left') }}
    {% if all_href and block.link_label %}
      <a class="text-link cards-all" href="{{ all_href }}">{{ block.link_label }}{{ icon('arrow-right', 'btn-icon') }}</a>
    {% endif %}
  </div>
  {% set card_sizes = block.columns == '2' ? '(min-width: 900px) 45vw, 92vw' : '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw' %}
  {% set manual_cards = block.items|default([])|filter(c => c.title) %}
  {# No empty list: a list with nothing in it is announced as a list by screen readers. #}
  {% if block.source != 'manual' ? block.entries|default([]) is not empty : manual_cards is not empty %}
  <ul class="content-grid cards-grid cols-{{ block.columns }}" role="list">
    {% if block.source != 'manual' %}
      {% for entry in block.entries|default([]) %}
        <li>{% include 'components/card.twig' with {item: entry, prefix: prefix, card_heading_tag: item_heading_tag, card_sizes: card_sizes} only %}</li>
      {% endfor %}
    {% else %}
      {% for card in manual_cards %}
        {% set href = link_url(card.url, prefix) %}
        <li>
          <article class="content-item">
            {% if card.image %}
              <div class="content-item-media">{{ image(card.image, {alt: '', sizes: card_sizes, max_width: 1280}) }}</div>
            {% endif %}
            <div class="content-item-body">
              {% if card.meta %}<p class="content-meta"><span class="content-type">{{ card.meta }}</span></p>{% endif %}
              <{{ item_heading_tag }} class="content-item-title">
                {% if href %}<a href="{{ href }}">{{ card.title }}</a>{% else %}{{ card.title }}{% endif %}
              </{{ item_heading_tag }}>
              {% if card.text %}<p>{{ card.text }}</p>{% endif %}
            </div>
          </article>
        </li>
      {% endfor %}
    {% endif %}
  </ul>
  {% endif %}
</div>
