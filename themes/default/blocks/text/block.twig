{% import 'components/ui.twig' as ui %}
{% if block.variant == 'split' %}
  <div class="container text-split">
    <div class="text-split-head">
      {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
      {% if block.heading %}<{{ heading_tag }} class="section-title" id="{{ block_uid }}-title">{{ block.heading }}</{{ heading_tag }}>{% endif %}
    </div>
    <div class="text-split-body">
      <div class="prose">{{ block.body_html|raw }}</div>
      {{ ui.actions(block.actions, lang_prefix|default('')) }}
    </div>
  </div>
{% elseif block.variant == 'contents' %}
  {# The ## headings of the text become a list of links beside it, as in a legal page or a long guide. #}
  {% set contents = toc(block.body_html) %}
  {% set entries = contents.items|filter(i => i.level == 2) %}
  <div class="container">
    {% if block.eyebrow or block.heading %}
      <header class="section-header">
        {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
        {% if block.heading %}<{{ heading_tag }} class="section-title" id="{{ block_uid }}-title">{{ block.heading }}</{{ heading_tag }}>{% endif %}
      </header>
    {% endif %}
    <div class="text-contents{% if entries|length < 2 %} has-no-list{% endif %}">
      {% if entries|length >= 2 %}
        <nav class="sidebar-card sidebar-toc text-contents-list" aria-label="{{ t('sidebar.on_this_page', 'On this page') }}">
          <p class="sidebar-title">{{ t('sidebar.on_this_page', 'On this page') }}</p>
          <ol class="sidebar-links">
            {% for entry in entries %}<li><a href="#{{ entry.id }}">{{ entry.text }}</a></li>{% endfor %}
          </ol>
        </nav>
      {% endif %}
      <div class="prose text-contents-body">{{ contents.html|raw }}</div>
    </div>
    {{ ui.actions(block.actions, lang_prefix|default('')) }}
  </div>
{% else %}
  <div class="container-narrow text-single{% if block.align == 'center' %} is-center{% endif %}">
    {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
    {% if block.heading %}<{{ heading_tag }} class="section-title" id="{{ block_uid }}-title">{{ block.heading }}</{{ heading_tag }}>{% endif %}
    <div class="prose{% if block.variant == 'lead' %} is-lead{% endif %}">{{ block.body_html|raw }}</div>
    {{ ui.actions(block.actions, lang_prefix|default(''), block.align == 'center' ? 'is-center' : '') }}
  </div>
{% endif %}
