{% import 'components/ui.twig' as ui %}
{% set prefix = lang_prefix|default('') %}
{% set slides = block.items %}
{% set total = slides|length %}
{% set autoplay = block.autoplay in ['5', '8'] ? block.autoplay : '' %}
{% set sizes = block.variant in ['full', 'banner'] ? '(min-width: 1100px) 1100px, 94vw' : (block.per_view == '2' ? '(min-width: 900px) 46vw, 88vw' : '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 88vw') %}
{% set label = block.heading ?: t('slider.label', 'Slides') %}
<div class="container">
  {{ ui.section_header(block, heading_tag, block_uid, 'left') }}
  {# The block's own section is already the landmark; the slider is a group inside it. #}
  <div class="slider slider-{{ block.variant }} per-{{ block.per_view }}" data-slider{% if autoplay %} data-autoplay="{{ autoplay }}"{% endif %}
       role="group" aria-roledescription="{{ t('slider.carousel', 'carousel') }}" aria-label="{{ label }}"
       data-label-prev="{{ t('slider.previous', 'Previous slide') }}" data-label-next="{{ t('slider.next', 'Next slide') }}"
       data-label-pause="{{ t('slider.pause', 'Pause automatic movement') }}" data-label-play="{{ t('slider.play', 'Start automatic movement') }}"
       data-label-goto="{{ t('slider.goto', 'Go to slide') }}">
    <div class="slider-track" role="group" tabindex="0" aria-label="{{ label }}">
      {% for slide in slides %}
        {% set href = link_url(slide.url, prefix) %}
        <div class="slider-slide{% if not slide.image %} no-image{% endif %}" role="group" aria-roledescription="{{ t('slider.slide', 'slide') }}" aria-label="{{ loop.index }} / {{ total }}">
          <article class="slide">
            {% if slide.image %}
              <div class="slide-media">{{ image(slide.image, {alt: '', sizes: sizes, max_width: block.variant in ['full', 'banner'] ? 2000 : 1100, loading: loop.first and block_first ? 'eager' : null}) }}</div>
            {% endif %}
            <div class="slide-body">
              {% if slide.eyebrow %}<p class="slide-label">{{ slide.eyebrow }}</p>{% endif %}
              {% if slide.title %}
                <{{ item_heading_tag }} class="slide-title">
                  {%- if href and not slide.link_label %}<a href="{{ href }}">{{ slide.title }}</a>{% else %}{{ slide.title }}{% endif -%}
                </{{ item_heading_tag }}>
              {% endif %}
              {% if slide.text %}<p class="slide-text">{{ slide.text|nl2br }}</p>{% endif %}
              {% if href and slide.link_label %}
                <a class="slide-link" href="{{ href }}">{{ slide.link_label }}{{ icon('arrow-right', 'btn-icon') }}</a>
              {% endif %}
              {{ ui.actions(slide.actions, prefix) }}
            </div>
          </article>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
