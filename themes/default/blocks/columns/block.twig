{% import 'components/ui.twig' as ui %}
{% set prefix = lang_prefix|default('') %}
{% set columns = block.items|filter(c => c.title or c.text or c.image) %}
<div class="container">
  {{ ui.section_header(block, heading_tag, block_uid, 'left') }}
  <div class="cols cols-{{ columns|length }}">
    {% for col in columns %}
      {% set href = link_url(col.url, prefix) %}
      <article class="col{% if col.image %} has-image{% endif %}">
        {% if col.eyebrow or col.title %}
          <header class="col-head">
            {% if col.eyebrow %}<p class="eyebrow">{{ col.eyebrow }}</p>{% endif %}
            {% if col.title %}
              <{{ item_heading_tag }} class="col-title">{% if href %}<a href="{{ href }}">{{ col.title }}</a>{% else %}{{ col.title }}{% endif %}</{{ item_heading_tag }}>
            {% endif %}
          </header>
        {% endif %}
        <div class="col-main">
          {% if col.image %}
            <div class="col-media">{{ image(col.image, {alt: col.image_alt, sizes: block.variant == 'image-side' ? '(min-width: 900px) 15vw, 40vw' : '(min-width: 900px) 30vw, 92vw', max_width: 800}) }}</div>
          {% endif %}
          <div class="col-body">
            {% if col.text_html %}<div class="prose">{{ col.text_html|raw }}</div>{% endif %}
            {% if href and col.link_label %}<a class="text-link" href="{{ href }}">{{ col.link_label }}{{ icon('arrow-right', 'btn-icon') }}</a>{% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</div>
