{% import 'components/ui.twig' as ui %}
<div class="container">
  <div class="cta-inner">
    <div class="cta-text">
      {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
      <{{ heading_tag }} class="cta-title" id="{{ block_uid }}-title">{{ block.heading }}</{{ heading_tag }}>
      {% if block.text %}<p class="cta-copy">{{ block.text|nl2br }}</p>{% endif %}
    </div>
    {{ ui.actions(block.actions, lang_prefix|default(''), 'cta-actions') }}
  </div>
</div>
