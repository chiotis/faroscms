{% import 'components/ui.twig' as ui %}
{% set entries = block.items|filter(i => i.title and i.content_html) %}
<div class="container accordion-layout">
  {{ ui.section_header(block, heading_tag, block_uid, 'left') }}
  <div class="accordion-list accordion-{{ block.style }} accordion-icon-{{ block.icon }}" data-accordion{% if not block.multiple %} data-single{% endif %}>
    {% for entry in entries %}
      <details class="accordion-item"{% if loop.first and block.initial == 'first' %} open{% endif %}{% if not block.multiple %} name="{{ block_uid }}-items"{% endif %}>
        <summary class="accordion-summary">
          <{{ item_heading_tag }} class="accordion-title">{{ entry.title }}</{{ item_heading_tag }}>
          {% if block.icon == 'plus' %}<span class="accordion-icon accordion-plus" aria-hidden="true"></span>{% else %}{{ icon('chevron-right', 'accordion-icon') }}{% endif %}
        </summary>
        <div class="accordion-panel">
          <div class="accordion-content prose">{{ entry.content_html|raw }}</div>
        </div>
      </details>
    {% endfor %}
  </div>
</div>
