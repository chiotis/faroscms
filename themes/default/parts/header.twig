{% import 'parts/menu-macros.twig' as menu_macros %}
{% set menu = theme_menus.header ?? [] %}
<header class="site-header">
  <div class="site-wrap header-row">
    <button type="button" class="mobile-menu-button" data-mobile-open aria-label="{{ t('nav.toggle', 'Toggle navigation') }}">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="site-brand" href="{{ url(prefix) }}">
      <span class="site-brand-title">{{ site.title }}</span>
    </a>

    <nav id="site-menu" class="site-nav" data-nav-panel>
      {% if menu is empty %}
        <ul class="nav-list nav-list-1">
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
        </ul>
      {% else %}
        {{ menu_macros.header_menu(menu, prefix, 1) }}
      {% endif %}
    </nav>

    <div class="header-tools">
      <a class="search-link" href="{{ url(prefix ~ 'search') }}" aria-label="{{ t('search.title', 'Search') }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10.5 3a7.5 7.5 0 105.01 13.08l4.2 4.2 1.41-1.41-4.2-4.2A7.5 7.5 0 0010.5 3zm0 2a5.5 5.5 0 110 11 5.5 5.5 0 010-11z"></path>
        </svg>
      </a>
      <div class="lang-switcher">
        {% set current = current_lang|default(site.languages.default) %}
        {% set default_lang = site.languages.default %}
        {% set path = path_no_lang|default('') %}
        {% set links = language_links|default({}) %}
        {% set use_links = links is not empty %}
        {% for l in site.languages.available|default([default_lang]) %}
          {% if l != current %}
            {% if use_links and links[l] is defined %}
              <a href="{{ url(links[l]) }}">{{ l|upper }}</a>
            {% elseif not use_links %}
              {% set prefix_lang = l == default_lang ? '' : l ~ '/' %}
              {% set path_part = path == '' ? '' : path|trim('/') %}
              <a href="{{ url(prefix_lang ~ path_part) }}">{{ l|upper }}</a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      <button type="button" class="mode-switch" data-theme-toggle role="switch" aria-checked="false" aria-label="{{ t('theme.switch_mode', 'Switch color mode') }}">
        <span class="mode-switch-track" aria-hidden="true">
          <span class="mode-switch-thumb"></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-drawer-overlay" data-mobile-overlay></div>
  <aside class="mobile-drawer" data-mobile-drawer aria-hidden="true">
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">{{ site.title }}</span>
      <button type="button" class="mobile-drawer-close" data-mobile-close aria-label="{{ t('nav.close', 'Close menu') }}">×</button>
    </div>

    <nav class="mobile-drawer-nav" aria-label="{{ t('nav.main', 'Main navigation') }}">
      {% if menu is empty %}
        <ul class="mobile-menu mobile-menu-1">
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix) }}">{{ t('nav.main.home') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'about') }}">{{ t('nav.main.about') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'services') }}">{{ t('nav.main.services') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'projects') }}">{{ t('nav.main.projects') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'category/news') }}">{{ t('nav.main.news') }}</a></li>
          <li class="mobile-item"><a class="mobile-link" href="{{ url(prefix ~ 'contact') }}">{{ t('nav.main.contact') }}</a></li>
        </ul>
      {% else %}
        {{ menu_macros.mobile_menu(menu, prefix, 1, 3) }}
      {% endif %}
    </nav>

    <div class="drawer-icons">
      <a href="#" aria-label="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1z"></path></svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zm5.25-3a1.25 1.25 0 1 1-1.25 1.25 1.25 1.25 0 0 1 1.25-1.25z"></path></svg>
      </a>
      <a href="#" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8A1.5 1.5 0 1 1 5 6.5 1.5 1.5 0 0 1 6.5 8zM5 10h3v9H5zm5 0h2.9v1.3h.1A3.2 3.2 0 0 1 15.9 10c3 0 3.6 2 3.6 4.6V19h-3v-3.8c0-.9 0-2.1-1.3-2.1s-1.5 1-1.5 2v3.9h-3z"></path></svg>
      </a>
      <a href="#" aria-label="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 8.2s-.2-1.6-.8-2.3c-.8-.9-1.7-.9-2.1-1C15.8 4.6 12 4.6 12 4.6h0s-3.8 0-6.7.3c-.4.1-1.3.1-2.1 1-.6.7-.8 2.3-.8 2.3S2 10.1 2 12v1.8c0 1.9.4 3.8.4 3.8s.2 1.6.8 2.3c.8.9 1.9.8 2.4 1 1.7.2 6.4.3 6.4.3s3.8 0 6.7-.3c.4-.1 1.3-.1 2.1-1 .6-.7.8-2.3.8-2.3s.4-1.9.4-3.8V12c0-1.9-.4-3.8-.4-3.8zM9.8 15.7V8.9l6 3.4-6 3.4z"></path></svg>
      </a>
    </div>
  </aside>
</header>
