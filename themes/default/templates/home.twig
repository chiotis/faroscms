{% extends 'layouts/base.twig' %}

{% block content %}
  {% set prefix = lang_prefix|default('') %}
  {% if page_blocks|default(null) %}
    {% if not page_blocks.leads_with_hero %}<h1 class="visually-hidden">{{ item.meta.title }}</h1>{% endif %}
    {{ page_blocks.html|raw }}
  {% else %}
  <article class="site-wrap section-stack">
    <section>
      <p>{{ t('home.kicker', 'Business Website Starter') }}</p>
      <h1>{{ item.meta.title }}</h1>
      <p>{{ item.meta.excerpt ?? site.tagline }}</p>
      <p>
        <a href="{{ url(prefix ~ 'contact') }}">{{ t('home.cta_primary', 'Start a Project') }}</a>
        <a href="{{ url(prefix ~ 'projects') }}">{{ t('home.cta_secondary', 'View Projects') }}</a>
      </p>
      {% if item.meta.main_image is defined and item.meta.main_image %}
        <div class="media-frame">{{ image(item.meta.main_image, {priority: true, sizes: '(min-width: 1280px) 1216px, 92vw'}) }}</div>
      {% endif %}
    </section>

    <section class="prose-block">
      {{ item.html|raw }}
    </section>
  </article>
  {% endif %}
{% endblock %}
