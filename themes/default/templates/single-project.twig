{% extends 'layouts/base.twig' %}

{% block content %}
  {% set prefix = lang_prefix|default('') %}
  {% set tags = (item.meta.tags is iterable) ? item.meta.tags : (item.meta.tags is defined ? [item.meta.tags] : []) %}
  {% set hero_layouts = theme_settings.hero_layouts|default({}) %}
  {% set hero_layout = hero_layouts[item.type|default('projects')]|default(hero_layouts.default|default('default')) %}
  {% set is_centered_hero = hero_layout == 'centered' %}
  {% set hero_image = item.meta.hero_image ?? item.meta.main_image ?? '' %}
  {% set hero_bg = item.meta.hero_background ?? item.meta.hero_color ?? '' %}
  {% if is_centered_hero %}
    <section class="single-hero single-hero-centered"{% if hero_bg %} style="--hero-bg:{{ hero_bg|e('html_attr') }};"{% endif %}>
      <div class="site-wrap single-hero-inner">
        <p class="single-hero-meta single-hero-meta-inline">
          <span>{{ format_date(item.meta.date ?? '') }}</span>
          {% if tags is not empty %}
            <span>{{ t('post.tags') }}:
              {% for tag in tags %}
                <a href="{{ taxonomy_url('tags', tag, prefix) }}">{{ taxonomy_label('tags', tag) }}</a>{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </p>
        <h1>{{ item.meta.title }}</h1>
        {% if item.meta.excerpt is defined or item.meta.summary is defined %}
          <p class="single-hero-subtitle">{{ item.meta.excerpt ?? item.meta.summary }}</p>
        {% endif %}
        {% if hero_image %}
          <div class="single-hero-media">
            {{ image(hero_image, {priority: true, sizes: '(min-width: 1280px) 1216px, 92vw'}) }}
          </div>
        {% endif %}
        <p class="single-hero-meta single-hero-meta-inline">
          {% if item.meta.custom_fields.client is defined %}
            <span><strong>{{ t('project.client') }}:</strong> {{ item.meta.custom_fields.client }}</span>
          {% endif %}
          {% if item.meta.custom_fields.location is defined %}
            <span><strong>{{ t('project.location') }}:</strong> {{ item.meta.custom_fields.location }}</span>
          {% endif %}
          {% if item.meta.custom_fields.duration is defined %}
            <span><strong>{{ t('project.duration') }}:</strong> {{ item.meta.custom_fields.duration }}</span>
          {% endif %}
        </p>
      </div>
    </section>
  {% else %}
    <section class="single-hero{% if hero_image %} has-image{% endif %}"{% if hero_image or hero_bg %} style="{% if hero_image %}--hero-image:url('{{ hero_image|e('html_attr') }}');{% endif %}{% if hero_bg %}--hero-bg:{{ hero_bg|e('html_attr') }};{% endif %}"{% endif %}>
      <div class="site-wrap single-hero-inner">
        <p class="single-hero-meta">
          <span>{{ format_date(item.meta.date ?? '') }}</span>
          {% if tags is not empty %}
            <span>{{ t('post.tags') }}:
              {% for tag in tags %}
                <a href="{{ taxonomy_url('tags', tag, prefix) }}">{{ taxonomy_label('tags', tag) }}</a>{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </p>
        <h1>{{ item.meta.title }}</h1>
        {% if item.meta.excerpt is defined or item.meta.summary is defined %}
          <p class="single-hero-subtitle">{{ item.meta.excerpt ?? item.meta.summary }}</p>
        {% endif %}
        <p class="single-hero-meta">
          {% if item.meta.custom_fields.client is defined %}
            <span><strong>{{ t('project.client') }}:</strong> {{ item.meta.custom_fields.client }}</span>
          {% endif %}
          {% if item.meta.custom_fields.location is defined %}
            <span><strong>{{ t('project.location') }}:</strong> {{ item.meta.custom_fields.location }}</span>
          {% endif %}
          {% if item.meta.custom_fields.duration is defined %}
            <span><strong>{{ t('project.duration') }}:</strong> {{ item.meta.custom_fields.duration }}</span>
          {% endif %}
        </p>
      </div>
    </section>
  {% endif %}
  {% include 'components/page-body.twig' %}
{% endblock %}
