{% extends 'layouts/base.twig' %}
{% set title_header = true %}

{% block content %}
  {% set prefix = lang_prefix|default('') %}
  {% set tags = (item.meta.tags is iterable) ? item.meta.tags : (item.meta.tags is defined ? [item.meta.tags] : []) %}
  {% set hero_meta %}
    <span>{{ format_date(item.meta.date ?? '') }}</span>
    {% if tags is not empty %}
      <span>{{ t('post.tags') }}:
        {% for tag in tags %}
          <a href="{{ taxonomy_url('tags', tag, prefix) }}">{{ taxonomy_label('tags', tag) }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </span>
    {% endif %}
    {% for group in item_terms(item, prefix) %}
      <span>{{ group.title }}:
        {% for term in group.terms %}<a href="{{ term.url }}">{{ term.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
      </span>
    {% endfor %}
  {% endset %}
  {% include 'components/page-header.twig' with {hero_subtitle: item.meta.excerpt ?? item.meta.summary ?? '', hero_meta: hero_meta} %}
  {% include 'components/page-body.twig' %}
{% endblock %}
