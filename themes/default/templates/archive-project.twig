{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="single-hero">
    <div class="site-wrap single-hero-inner">
      <h1>{{ t('projects.archive_title') }}</h1>
      <p class="single-hero-subtitle">{{ t('projects.archive_subtitle') }}</p>
    </div>
  </section>

  <section class="site-wrap section-stack single-body">
    {% if items is empty %}
      <p>{{ t('projects.archive_empty') }}</p>
    {% else %}
      <div class="content-grid">
        {% for item in items %}
          {% include 'components/card.twig' %}
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endblock %}
