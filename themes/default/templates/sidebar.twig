{#
  With sidebar: title header, then the text beside a sidebar (contents, related pages, contact card).
  Blocks follow below at full width; the text is not repeated by a Page content block.
#}
{% extends 'layouts/base.twig' %}
{% import 'components/hero-layout.twig' as opening %}
{# The page opens with its first block when that is a Hero, or an edge-to-edge Slider under a transparent header: no title area then. #}
{% set page_opens = page_blocks|default(null) and (page_blocks.leads_with_hero or (page_blocks.opens_with_slider and opening.transparent(item, theme_settings)|trim != '')) %}
{% set title_header = not page_opens %}

{% block content %}
  {% if not page_opens %}
    {% include 'components/page-header.twig' %}
  {% elseif not page_blocks.leads_with_hero %}
    <h1 class="visually-hidden">{{ item.meta.title }}</h1>
  {% endif %}
  {% set contents = toc(item.html) %}
  {# Which side the sidebar is on, and what it holds, is chosen per content type in Theme settings > Single Layouts. #}
  <div class="site-wrap with-sidebar{% if single_layout(item.type).sidebar == 'left' %} is-left{% endif %}">
    <article class="with-sidebar-main prose-block">
      {{ contents.html|raw }}
    </article>
    <aside class="with-sidebar-aside" aria-label="{{ t('sidebar.label', 'More on this topic') }}">
      {% include 'components/sidebar.twig' with {toc_items: contents.items} %}
    </aside>
  </div>
  {% if page_blocks|default(null) %}
    {{ page_blocks.html|raw }}
  {% endif %}
{% endblock %}
