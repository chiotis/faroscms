{% extends 'layouts/base.twig' %}

{% block content %}
  {% set prefix = lang_prefix|default('') %}
  {% set title_text = archive_title ?? (t('type.' ~ type, type|title) ~ ' ' ~ t('archive.suffix')) %}
  {% set subtitle_text = archive_subtitle is defined ? archive_subtitle : t('archive.subtitle') %}
  <section class="single-hero">
    <div class="site-wrap single-hero-inner">
      <h1>{{ title_text }}</h1>
      {% if subtitle_text %}
        <p class="single-hero-subtitle">{{ subtitle_text }}</p>
      {% endif %}
    </div>
  </section>

  <section class="site-wrap section-stack single-body">
    {% if items is empty %}
      <p>{{ t('archive.empty') }}</p>
    {% else %}
      <div class="content-grid">
        {% for item in items %}
          {% include 'components/card.twig' %}
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endblock %}
