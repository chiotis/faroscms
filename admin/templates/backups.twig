{% extends '@admin/base.twig' %}

{% block content %}
  {% set primary_button = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set secondary_button = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set icon_button = 'inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}
  {% set danger_icon_button = 'inline-flex h-8 w-8 items-center justify-center rounded-md text-red-500 hover:bg-red-50 hover:text-red-600' %}

  {% if backup_status == 'ok' %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-sm text-emerald-800 shadow-sm">
      <span class="mt-px flex-1">{{ backup_message ?: 'Backup created.' }}</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% elseif backup_status == 'warn' %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-sm text-amber-800 shadow-sm">
      <span class="mt-px flex-1">{{ backup_message ?: 'Backup saved locally, but the remote upload failed.' }}</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% elseif backup_status == 'fail' %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-800 shadow-sm">
      <span class="mt-px flex-1">{{ backup_message ?: 'Backup action failed.' }}</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% elseif delete_status == 'ok' %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-sm text-emerald-800 shadow-sm">
      <span class="mt-px flex-1">{{ backup_message ?: 'Backup deleted.' }}</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% elseif delete_status == 'fail' %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-800 shadow-sm">
      <span class="mt-px flex-1">{{ backup_message ?: 'Backup delete failed.' }}</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% endif %}

  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Backups</h1>
      <p class="mt-1 text-sm text-slate-500">Local snapshots, database backups, and backup run history.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <form method="post" action="{{ url('admin/backups') }}">
        {{ csrf_field() }}
        <input type="hidden" name="backup_action" value="create_database">
        <button type="submit" class="{{ secondary_button }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3zM4 7v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7"/></svg>
          Database backup
        </button>
      </form>
      <form method="post" action="{{ url('admin/backups') }}">
        {{ csrf_field() }}
        <input type="hidden" name="backup_action" value="create_full">
        <button type="submit" class="{{ primary_button }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
          Create full backup
        </button>
      </form>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Total backups</p>
      <div class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ backup_total }}</div>
      <p class="mt-1 text-xs text-slate-400">Local archives</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Storage used</p>
      <div class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ backup_storage_human }}</div>
      <p class="mt-1 text-xs text-slate-400">Backup directory</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Last backup</p>
      <div class="mt-1.5 truncate text-2xl font-semibold tracking-tight text-slate-900">{{ last_backup ? last_backup.created_at : 'Never' }}</div>
      <p class="mt-1 text-xs text-slate-400">{{ last_backup ? last_backup.size_human : 'No snapshots yet' }}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Schedule</p>
      <div class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ backup_schedule.enabled ? backup_schedule.frequency|title : 'Off' }}</div>
      <p class="mt-1 text-xs text-slate-400">Keep {{ backup_schedule.keep }} local</p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white xl:col-span-2">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-2.5">
        <h2 class="text-sm font-semibold text-slate-900">Local backups</h2>
        <span class="text-xs text-slate-400">{{ backup_total }} files</span>
      </div>
      {% if backup_snapshots is empty %}
        <div class="px-4 py-12 text-center text-sm text-slate-400">No local backups yet.</div>
      {% else %}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
                <th class="px-4 py-2 font-medium">Filename</th>
                <th class="px-4 py-2 font-medium">Type</th>
                <th class="px-4 py-2 font-medium">Size</th>
                <th class="px-4 py-2 font-medium">Created</th>
                <th class="px-4 py-2 text-right font-medium">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              {% for snapshot in backup_snapshots %}
                {% set is_database = 'database-backup' in snapshot.filename %}
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-2.5"><span class="font-mono text-xs text-slate-700">{{ snapshot.filename }}</span></td>
                  <td class="px-4 py-2.5">
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ is_database ? 'bg-violet-50 text-violet-700 ring-violet-200' : 'bg-blue-50 text-blue-700 ring-blue-200' }}">{{ is_database ? 'Database' : 'Full' }}</span>
                  </td>
                  <td class="px-4 py-2.5 text-slate-600">{{ snapshot.size_human }}</td>
                  <td class="px-4 py-2.5 text-slate-400">{{ snapshot.created_at }}</td>
                  <td class="px-4 py-2.5">
                    <div class="flex items-center justify-end gap-0.5">
                      <a href="{{ url('admin/backups?download=' ~ snapshot.filename) }}" class="{{ icon_button }}" title="Download" aria-label="Download {{ snapshot.filename }}">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"/></svg>
                      </a>
                      <button type="button" class="{{ icon_button }} cursor-not-allowed opacity-50" title="Restore flow pending" aria-label="Restore flow pending" disabled>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 9a8 8 0 00-14.93-3M4 15a8 8 0 0014.93 3"/></svg>
                      </button>
                      <form method="post" action="{{ url('admin/backups') }}" onsubmit="return confirm('Delete this backup file?');">
                        {{ csrf_field() }}
                        <input type="hidden" name="backup_action" value="delete">
                        <input type="hidden" name="filename" value="{{ snapshot.filename }}">
                        <button type="submit" class="{{ danger_icon_button }}" title="Delete" aria-label="Delete {{ snapshot.filename }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    <div class="space-y-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">Policy</h2>
          <a href="{{ url('admin/settings?tab=backup') }}" class="text-xs font-medium text-blue-600 hover:text-blue-700">Edit</a>
        </div>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Automatic</dt><dd class="font-medium text-slate-900">{{ backup_schedule.enabled ? 'Enabled' : 'Disabled' }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Frequency</dt><dd class="font-medium text-slate-900">{{ backup_schedule.frequency|title }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Retention</dt><dd class="font-medium text-slate-900">{{ backup_schedule.keep }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Last auto run</dt><dd class="max-w-40 truncate text-right font-medium text-slate-900">{{ backup_schedule.last_run ?: 'Never' }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Remote</dt><dd class="font-medium text-slate-900">{{ backup_remote.enabled ? 'Enabled' : 'Disabled' }}</dd></div>
          {% if backup_remote.enabled %}
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Provider</dt><dd class="font-medium text-slate-900">{{ backup_remote.provider|replace({'_': ' '})|title }}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Bucket</dt><dd class="max-w-40 truncate text-right font-medium text-slate-900">{{ backup_remote.bucket ?: 'Not set' }}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Remote keep</dt><dd class="font-medium text-slate-900">{{ backup_remote.keep }}</dd></div>
          {% endif %}
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Recent runs</h2>
        </div>
        {% if backup_runs is empty %}
          <div class="px-4 py-8 text-center text-sm text-slate-400">No backup run history yet.</div>
        {% else %}
          <ul class="divide-y divide-slate-50">
            {% for run in backup_runs|slice(0, 6) %}
              {% set run_tone = run.status == 'success' ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : (run.status == 'warning' ? 'bg-amber-50 text-amber-700 ring-amber-200' : 'bg-red-50 text-red-700 ring-red-200') %}
              <li class="px-4 py-2.5">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-slate-800">{{ run.filename ?: 'No file' }}</p>
                    <p class="mt-0.5 truncate text-xs text-slate-400">{{ run.message ?: 'Backup run' }}</p>
                    <p class="mt-0.5 text-[11px] text-slate-400">{{ run.created_at }}</p>
                  </div>
                  <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ run_tone }}">{{ run.status }}</span>
                </div>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
        <h2 class="text-sm font-semibold text-amber-900">Restore guidance</h2>
        <p class="mt-1 text-xs leading-relaxed text-amber-800">Restore is intentionally disabled until the safety flow is designed: pre-restore snapshot, explicit confirmation, rollback path, and file permission checks.</p>
      </div>
    </div>
  </div>
{% endblock %}
