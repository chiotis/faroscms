{% extends '@admin/base.twig' %}
{% set page_heading = definition.label %}

{#
  Admin > Content types > one type: its names, how its list looks (a pointer to Theme), and its fields, one compact row each. The
  form posts fields[i][key|label|type|options|help|filterable|card|show|retired] as ContentTypeAdmin::definitionFromInput reads them;
  a field of the site that is removed is left out of the post (its inputs are disabled), and its stored values stay in the content.
  admin-content-types.js adds rows, removes and restores them, and shows the parts that belong to the kind of field.
#}
{% block content %}
  {% import '@admin/partials/ui.twig' as ui %}

  {% set archive = definition.archive %}
  {% set card = 'lc-card rounded-xl border border-slate-200 bg-white' %}
  {% set card_title = 'm-0 text-sm font-semibold text-slate-900' %}
  {% set btn = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}

  <header class="mb-3 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="m-0 text-xs text-slate-500"><a class="font-medium text-blue-700 hover:underline" href="{{ url('admin/content-types') }}">Content types</a> / <code class="rounded bg-slate-100 px-1 py-0.5">/{{ type }}</code> · {{ item_count }} {{ item_count == 1 ? 'entry' : 'entries' }}</p>
      <p class="m-0 mt-0.5 text-xs text-slate-500">Changes are saved as differences from the theme in <code class="rounded bg-slate-100 px-1 py-0.5">{{ custom_file }}{{ type }}.yaml</code>.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="{{ btn }}" href="{{ url('admin/content?type=' ~ type) }}">Entries</a>
      <a class="{{ btn }}" href="{{ url(type) }}" target="_blank" rel="noopener">View archive</a>
    </div>
  </header>

  {{ ui.flash(saved ? 'Saved.' : '', 'success') }}
  {% if error == 'write' %}{{ ui.flash('Could not write to the custom/ folder. Check that it is writable.', 'error') }}{% endif %}

  <form method="post" data-content-type-form autocomplete="off">
    {{ csrf_field() }}
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="type" value="{{ type }}">

    <div class="grid items-start gap-3 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <div class="space-y-3">
        <section class="{{ card }} pb-3" aria-labelledby="ct-h-names">
          <h2 id="ct-h-names" class="{{ card_title }} px-3 pt-3">Names</h2>
          <div class="space-y-2.5 p-3 pb-0">
            <div class="seo-row ct-row"><label class="seo-label" for="ct-label">Title (plural)</label><input id="ct-label" type="text" name="label" value="{{ definition.label }}" class="lc-input"></div>
            <div class="seo-row ct-row"><label class="seo-label" for="ct-singular">Singular</label><input id="ct-singular" type="text" name="singular" value="{{ definition.singular }}" class="lc-input"></div>
            <div class="seo-row ct-row"><label class="seo-label" for="ct-description">Description</label><input id="ct-description" type="text" name="description" value="{{ definition.description }}" class="lc-input"></div>
          </div>
          <p class="seo-help px-3 pt-2">Shown in the default language. Translations the theme provides stay in place unless you change the text here.</p>
        </section>

        <section class="{{ card }} pb-3" aria-labelledby="ct-h-list">
          <h2 id="ct-h-list" class="{{ card_title }} px-3 pt-3">How it is shown</h2>
          <p class="ct-facts m-0 px-3 pt-2">
            <span>{{ layouts[archive.layout] ?? archive.layout }}</span>
            <span>{{ archive.columns }} columns</span>
            <span>{{ archive.per_page == 0 ? 'all on one page' : archive.per_page ~ ' per page' }}</span>
          </p>
          <p class="seo-help px-3 pt-1">The list page and the page of one entry are set with the other layouts, in Theme.</p>
          <div class="flex flex-wrap gap-2 px-3 pt-2">
            <a class="ct-pill" href="{{ url('admin/theme?tab=archive_layouts') }}">Archive Layouts</a>
            <a class="ct-pill" href="{{ url('admin/theme?tab=single_layouts') }}">Single Layouts</a>
          </div>
        </section>
      </div>

      <section class="{{ card }} pb-3" aria-labelledby="ct-h-fields">
        <div class="flex flex-wrap items-start justify-between gap-2 px-3 pt-3">
          <div class="min-w-0">
            <h2 id="ct-h-fields" class="{{ card_title }}">Fields <span class="ct-count">{{ rows|length }}</span></h2>
            <p class="seo-help m-0">Shown in the editor's “{{ definition.singular }} details” tab and stored under <code>custom_fields</code>. A key is never renamed: content refers to it.</p>
          </div>
          <button type="button" class="ct-add" data-add-field><span aria-hidden="true">+</span> Add field</button>
        </div>

        <div class="ct-fields" data-field-rows>
          {% for row in rows %}
            {% set i = loop.index0 %}
            <div class="ct-field{{ row.retired ? ' is-retired' : '' }}" data-field data-kind="{{ row.type }}">
              <div class="ct-main">
                <div class="ct-key">
                  <input type="hidden" name="fields[{{ i }}][key]" value="{{ row.key }}">
                  <code>{{ row.key }}</code>
                  {% if row.from_theme %}<span class="ct-chip">Theme</span>{% endif %}
                </div>
                {% if row.from_theme %}
                  <div class="ct-label-static"><strong>{{ row.label }}</strong><span>{{ row.type }}</span></div>
                {% else %}
                  <input type="text" name="fields[{{ i }}][label]" value="{{ row.label }}" class="lc-input" placeholder="Label" aria-label="Label of {{ row.key }}">
                  <select name="fields[{{ i }}][type]" class="lc-input lc-select" aria-label="Kind of {{ row.key }}" data-kind-select>
                    {% for t in field_types %}<option value="{{ t }}"{% if row.type == t %} selected{% endif %}>{{ t }}</option>{% endfor %}
                  </select>
                {% endif %}
              </div>
              <div class="ct-flags" role="group" aria-label="How {{ row.key }} is used">
                <label class="lc-chip" data-only-kind="select"{% if row.type != 'select' %} hidden{% endif %} title="Offer as a filter in the archive"><input type="checkbox" name="fields[{{ i }}][filterable]" value="1"{% if row.filterable %} checked{% endif %}><span>Filter</span></label>
                <label class="lc-chip" title="Show on the item's card"><input type="checkbox" name="fields[{{ i }}][card]" value="1"{% if row.card %} checked{% endif %}><span>Card</span></label>
                <label class="lc-chip" title="Show on the item's own page"><input type="checkbox" name="fields[{{ i }}][show]" value="1"{% if row.show %} checked{% endif %}><span>Page</span></label>
                <label class="lc-chip is-warn" title="Stop using the field; stored values are kept"><input type="checkbox" name="fields[{{ i }}][retired]" value="1"{% if row.retired %} checked{% endif %}><span>Retired</span></label>
                {% if not row.from_theme %}<button type="button" class="ct-remove" data-remove-field title="Take the field out of the type; the values already saved in content are kept">Remove</button>{% endif %}
              </div>
              {% if not row.from_theme %}
                <div class="ct-extra">
                  <input type="text" name="fields[{{ i }}][help]" value="{{ row.help }}" class="lc-input" placeholder="Help text shown under the field (optional)" aria-label="Help text of {{ row.key }}">
                  <textarea name="fields[{{ i }}][options]" rows="3" class="lc-input" placeholder="office|Office&#10;retail|Retail" aria-label="Options of {{ row.key }}" data-only-kind="select"{% if row.type != 'select' %} hidden{% endif %}>{{ row.options }}</textarea>
                </div>
              {% elseif row.type == 'select' and row.options %}
                <div class="ct-extra"><p class="seo-help m-0">Options: {{ row.options|split("\n")|map(o => o|split('|')|last)|join(', ') }}</p></div>
              {% endif %}
            </div>
          {% endfor %}
          {% if rows is empty %}<p class="ct-empty" data-empty>No fields yet. Add one to have more to fill in on each {{ definition.singular|lower }}.</p>{% endif %}
        </div>
        <p class="seo-help px-3 pt-2">Fields from the theme can be retired or used differently but not renamed. A field you added can be removed: the values already saved in content are kept and appear under Custom Fields.</p>
      </section>
    </div>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
        <a class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" href="{{ url('admin/content-types') }}">Back to list</a>
      {% endblock %}
      {% block actions %}
        <button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save content type
        </button>
      {% endblock %}
    {% endembed %}
  </form>

  <template id="field-row-template">
    <div class="ct-field" data-field data-kind="text" data-new-row>
      <div class="ct-main">
        <div class="ct-key"><input type="text" name="fields[__i__][key]" required pattern="[a-z][a-z0-9_]*" maxlength="40" placeholder="key_name" class="lc-input font-mono" aria-label="Key of the new field"></div>
        <input type="text" name="fields[__i__][label]" class="lc-input" placeholder="Label" aria-label="Label of the new field">
        <select name="fields[__i__][type]" class="lc-input lc-select" aria-label="Kind of the new field" data-kind-select>
          {% for t in field_types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="ct-flags" role="group" aria-label="How the new field is used">
        <label class="lc-chip" data-only-kind="select" hidden title="Offer as a filter in the archive"><input type="checkbox" name="fields[__i__][filterable]" value="1"><span>Filter</span></label>
        <label class="lc-chip" title="Show on the item's card"><input type="checkbox" name="fields[__i__][card]" value="1"><span>Card</span></label>
        <label class="lc-chip" title="Show on the item's own page"><input type="checkbox" name="fields[__i__][show]" value="1" checked><span>Page</span></label>
        <label class="lc-chip is-warn" title="Stop using the field; stored values are kept"><input type="checkbox" name="fields[__i__][retired]" value="1"><span>Retired</span></label>
        <button type="button" class="ct-remove" data-remove-field>Remove</button>
      </div>
      <div class="ct-extra">
        <input type="text" name="fields[__i__][help]" class="lc-input" placeholder="Help text shown under the field (optional)" aria-label="Help text of the new field">
        <textarea name="fields[__i__][options]" rows="3" class="lc-input" placeholder="For a select field, one option a line:&#10;office|Office&#10;retail|Retail" aria-label="Options of the new field" data-only-kind="select" hidden></textarea>
      </div>
    </div>
  </template>
  <script src="{{ asset('js/admin-content-types.js') }}" defer></script>
{% endblock %}
