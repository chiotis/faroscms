{% extends '@admin/base.twig' %}

{% block content %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set input_soft = 'w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20' %}
  {% set section_class = 'mb-4 rounded-lg border border-slate-200 bg-white p-4' %}
  {% set archive = definition.archive %}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <p class="text-xs text-slate-400"><a class="hover:text-slate-700" href="{{ url('admin/content-types') }}">Content types</a> /</p>
      <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">{{ definition.label }} <code class="ml-1 text-xs font-normal text-slate-400">{{ type }}</code></h1>
      <p class="text-xs text-slate-400">{{ item_count }} {{ item_count == 1 ? 'entry' : 'entries' }}. Changes are saved as differences from the theme in <code>{{ custom_file }}{{ type }}.yaml</code>.</p>
    </div>
    <a class="{{ btn_secondary }}" href="{{ url(type) }}" target="_blank" rel="noopener">View archive</a>
  </header>

  {% if saved %}<template data-flash data-type="success">Saved.</template>{% endif %}
  {% if error == 'write' %}<template data-flash data-type="error">Could not write to the custom/ folder. Check that it is writable.</template>{% endif %}

  <form method="post" data-content-type-form>
    {{ csrf_field() }}
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="type" value="{{ type }}">

    <div class="{{ section_class }}">
      <h2 class="mb-3 text-sm font-semibold text-slate-900">Names</h2>
      <div class="grid gap-3 md:grid-cols-3">
        <label class="grid gap-1 text-sm font-medium text-slate-700">Title (plural)
          <input type="text" name="label" value="{{ definition.label }}" class="{{ input_soft }}">
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">Singular
          <input type="text" name="singular" value="{{ definition.singular }}" class="{{ input_soft }}">
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">Description
          <input type="text" name="description" value="{{ definition.description }}" class="{{ input_soft }}">
        </label>
      </div>
      <p class="mt-2 text-xs text-slate-400">Shown in the default language. Translations the theme provides stay in place unless you change the text here.</p>
    </div>

    <div class="{{ section_class }}">
      <h2 class="mb-3 text-sm font-semibold text-slate-900">Archive page</h2>
      <div class="grid gap-3 md:grid-cols-4">
        <label class="grid gap-1 text-sm font-medium text-slate-700">Layout
          <select name="archive[layout]" class="{{ input_soft }}">
            {% for value, label in layouts %}<option value="{{ value }}"{% if archive.layout == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">Columns (cards and tiles)
          <select name="archive[columns]" class="{{ input_soft }}">
            {% for value in ['2', '3', '4'] %}<option value="{{ value }}"{% if archive.columns == value %} selected{% endif %}>{{ value }}</option>{% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">Order
          <select name="archive[order]" class="{{ input_soft }}">
            {% for value, label in orders %}<option value="{{ value }}"{% if archive.order == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">Items per page
          <input type="number" name="archive[per_page]" min="0" max="60" value="{{ archive.per_page }}" class="{{ input_soft }}">
          <span class="text-xs font-normal text-slate-400">0 shows everything on one page.</span>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700 md:col-span-2">Page title
          <input type="text" name="archive[title]" value="{{ archive.title }}" placeholder="Default: the theme's text" class="{{ input_soft }}">
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700 md:col-span-2">Subtitle
          <input type="text" name="archive[subtitle]" value="{{ archive.subtitle }}" class="{{ input_soft }}">
        </label>
      </div>
      <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700">
        <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[show_image]" value="1"{% if archive.show_image %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> Show images</label>
        <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[show_excerpt]" value="1"{% if archive.show_excerpt %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> Show the excerpt</label>
        <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[show_date]" value="1"{% if archive.show_date %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> Show the date</label>
        <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[show_meta]" value="1"{% if archive.show_meta %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> Show category and card fields</label>
      </div>
      {% if taxonomy_names %}
        <fieldset class="mt-3">
          <legend class="text-sm font-medium text-slate-700">Filters from taxonomies</legend>
          <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700">
            {% for name in taxonomy_names %}
              <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[taxonomies][]" value="{{ name }}"{% if name in archive.taxonomies %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> {{ name|capitalize }}</label>
            {% endfor %}
          </div>
          <p class="mt-1 text-xs text-slate-400">Visitors can narrow the archive by these. Select fields marked "filter" below appear as filters too.</p>
        </fieldset>
      {% endif %}
    </div>

    <div class="{{ section_class }}">
      <div class="mb-3 flex items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Fields</h2>
          <p class="text-xs text-slate-400">Shown in the editor's "{{ definition.singular }} details" tab. Values are stored under <code>custom_fields</code>. Never rename a field: content refers to it by its key.</p>
        </div>
        <button type="button" class="{{ btn_secondary }}" data-add-field>Add field</button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[56rem] text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left text-xs font-medium text-slate-400">
              <th class="px-2 py-2 font-medium">Key</th>
              <th class="px-2 py-2 font-medium">Label</th>
              <th class="px-2 py-2 font-medium">Type</th>
              <th class="px-2 py-2 font-medium">Options (select)</th>
              <th class="px-2 py-2 text-center font-medium" title="Offer as a filter in the archive (select fields)">Filter</th>
              <th class="px-2 py-2 text-center font-medium" title="Show on the item's card">Card</th>
              <th class="px-2 py-2 text-center font-medium" title="Show on the item's own page">Page</th>
              <th class="px-2 py-2 text-center font-medium" title="Stop using the field; stored values are kept">Retired</th>
            </tr>
          </thead>
          <tbody data-field-rows class="divide-y divide-slate-50">
            {% for row in rows %}
              {% set i = loop.index0 %}
              <tr class="align-top">
                <td class="px-2 py-2">
                  <input type="hidden" name="fields[{{ i }}][key]" value="{{ row.key }}">
                  <code class="text-xs text-slate-700">{{ row.key }}</code>
                  {% if row.from_theme %}<span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500">theme</span>{% endif %}
                </td>
                <td class="px-2 py-2">
                  {% if row.from_theme %}
                    <span class="text-slate-700">{{ row.label }}</span>
                  {% else %}
                    <input type="text" name="fields[{{ i }}][label]" value="{{ row.label }}" class="{{ input_soft }}">
                  {% endif %}
                </td>
                <td class="px-2 py-2">
                  {% if row.from_theme %}
                    <span class="text-slate-500">{{ row.type }}</span>
                  {% else %}
                    <select name="fields[{{ i }}][type]" class="{{ input_soft }}">
                      {% for t in field_types %}<option value="{{ t }}"{% if row.type == t %} selected{% endif %}>{{ t }}</option>{% endfor %}
                    </select>
                  {% endif %}
                </td>
                <td class="px-2 py-2">
                  {% if row.type == 'select' %}
                    {% if row.from_theme %}
                      <span class="text-xs text-slate-500">{{ row.options|split("\n")|map(o => o|split('|')|last)|join(', ') }}</span>
                    {% else %}
                      <textarea name="fields[{{ i }}][options]" rows="3" placeholder="office|Office&#10;retail|Retail" class="{{ input_soft }}">{{ row.options }}</textarea>
                    {% endif %}
                  {% endif %}
                </td>
                <td class="px-2 py-2 text-center">{% if row.type == 'select' %}<input type="checkbox" name="fields[{{ i }}][filterable]" value="1"{% if row.filterable %} checked{% endif %} class="h-4 w-4 rounded border-slate-300">{% endif %}</td>
                <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[{{ i }}][card]" value="1"{% if row.card %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"></td>
                <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[{{ i }}][show]" value="1"{% if row.show %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"></td>
                <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[{{ i }}][retired]" value="1"{% if row.retired %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Fields from the theme can be retired or reused differently but not renamed. To remove a field you added, delete its row: the values already saved in content are kept and appear under Custom Fields.</p>
    </div>

    <div class="flex items-center gap-3">
      <button type="submit" class="{{ btn_primary }}">Save content type</button>
      <a class="text-sm text-slate-500 hover:text-slate-800" href="{{ url('admin/content-types') }}">Back to list</a>
    </div>
  </form>

  <template id="field-row-template">
    <tr class="align-top" data-new-row>
      <td class="px-2 py-2"><input type="text" name="fields[__i__][key]" required pattern="[a-z][a-z0-9_]*" maxlength="40" placeholder="key_name" class="w-32 rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-sm text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"></td>
      <td class="px-2 py-2"><input type="text" name="fields[__i__][label]" placeholder="Label" class="{{ input_soft }}"></td>
      <td class="px-2 py-2">
        <select name="fields[__i__][type]" class="{{ input_soft }}">
          {% for t in field_types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
        </select>
      </td>
      <td class="px-2 py-2"><textarea name="fields[__i__][options]" rows="3" placeholder="For select fields:&#10;office|Office&#10;retail|Retail" class="{{ input_soft }}"></textarea></td>
      <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[__i__][filterable]" value="1" class="h-4 w-4 rounded border-slate-300"></td>
      <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[__i__][card]" value="1" class="h-4 w-4 rounded border-slate-300"></td>
      <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[__i__][show]" value="1" checked class="h-4 w-4 rounded border-slate-300"></td>
      <td class="px-2 py-2 text-center"><input type="checkbox" name="fields[__i__][retired]" value="1" class="h-4 w-4 rounded border-slate-300"></td>
    </tr>
  </template>

  <script>
    (() => {
      const rows = document.querySelector('[data-field-rows]');
      const template = document.getElementById('field-row-template');
      const add = document.querySelector('[data-add-field]');
      if (!rows || !template || !add) return;
      let next = rows.children.length;
      add.addEventListener('click', () => {
        const html = template.innerHTML.replace(/__i__/g, String(next++));
        rows.insertAdjacentHTML('beforeend', html);
        const last = rows.lastElementChild;
        const key = last && last.querySelector('input[type="text"]');
        if (key) key.focus();
      });
    })();
  </script>
{% endblock %}
