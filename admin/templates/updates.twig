{% extends '@admin/base.twig' %}
{% set page_heading = 'Updates' %}

{% block content %}
  {% set primary_button = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set secondary_button = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set disabled_button = 'inline-flex cursor-not-allowed items-center gap-1.5 rounded-md bg-slate-200 px-3 py-1.5 text-sm font-medium text-slate-500' %}

  {% if checked %}
    <template data-flash data-type="success">Update status refreshed from {{ update_repository }}.</template>
  {% endif %}

  {% if install_status %}
    <template data-flash data-type="{{ install_status == 'installed' ? 'success' : 'error' }}">{{ install_message }}</template>
  {% endif %}

  {% if pre_backup_status %}
    <template data-flash data-type="{{ pre_backup_status == 'ok' ? 'success' : 'error' }}">{{ pre_backup_message ?: (pre_backup_status == 'ok' ? 'Pre-update backup created.' : 'Pre-update backup failed.') }}</template>
  {% endif %}

  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="mt-1 text-sm text-slate-500">System version, release notes, and safe update readiness.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="{{ url('admin/backups') }}" class="{{ secondary_button }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3zM4 7v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7"/></svg>
        Backups
      </a>
      <form method="post" action="{{ url('admin/updates') }}">
        {{ csrf_field() }}
        <input type="hidden" name="updates_action" value="check">
        <button type="submit" class="{{ primary_button }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 9A8 8 0 006.2 5.3M4 15a8 8 0 0013.8 3.7M20 20v-6h-6"/></svg>
          Check status
        </button>
      </form>
    </div>
  </div>

  {% if has_update or install_available %}
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-100">
            <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"/></svg>
          </span>
          <div>
            <p class="text-sm font-semibold text-amber-900">Update available: {{ install_available ? release.version : latest_version }}</p>
            {% if install_available %}
              <p class="text-xs text-amber-800">Only the code is replaced. Your pages, posts, media, custom files and settings are not touched, and if the new version does not start the current one is put back.</p>
            {% else %}
              <p class="text-xs text-amber-800">The package of this version is not published yet. Check again in a few minutes.</p>
            {% endif %}
          </div>
        </div>
        {% if install_ready %}
          <form method="post" action="{{ url('admin/updates') }}" data-confirm="Install version {{ release.version }}? The public site is closed for a minute while the code is replaced. Your pages, media and settings are not touched, and if the new version does not start the current one is put back." data-confirm-button="Install {{ release.version }}">
            {{ csrf_field() }}
            <input type="hidden" name="updates_action" value="install">
            <button type="submit" class="{{ primary_button }}">Install {{ release.version }}</button>
          </form>
        {% else %}
          <button type="button" class="{{ disabled_button }}" disabled>Install {{ install_available ? release.version : '' }}</button>
        {% endif %}
      </div>
      {% if install_available and install_blockers %}
        <ul class="mt-3 space-y-1 border-t border-amber-200 pt-3 text-xs text-amber-900">
          {% for blocker in install_blockers %}
            <li class="flex gap-2"><span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-amber-500"></span><span>{{ blocker }}</span></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% elseif update_source_status == 'unreachable' %}
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold text-amber-900">GitHub source configured, but remote version is not reachable yet</p>
          <p class="mt-0.5 text-xs text-amber-700">{{ update_source }}</p>
          <p class="mt-1 text-xs text-amber-700">If this repository is private, add a GitHub token in Settings -> APIs.</p>
        </div>
        <span class="inline-flex w-fit rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-700 ring-1 ring-inset ring-amber-200">Remote pending</span>
      </div>
    </div>
  {% else %}
    <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
      <p class="text-sm font-semibold text-emerald-900">FarosCMS is up to date</p>
      <p class="mt-0.5 text-xs text-emerald-700">GitHub source: {{ update_repository }} / {{ update_branch }}</p>
    </div>
  {% endif %}

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="space-y-4 xl:col-span-2">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Current version</p>
          <p class="mt-1.5 truncate text-2xl font-semibold tracking-tight text-slate-900">{{ current_version }}</p>
          <p class="mt-1 truncate text-xs text-slate-400">{{ current_commit ? 'Commit ' ~ current_commit : 'No git commit detected' }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Latest known</p>
          <p class="mt-1.5 truncate text-2xl font-semibold tracking-tight {{ has_update ? 'text-amber-700' : 'text-slate-900' }}">{{ latest_version }}</p>
          <p class="mt-1 text-xs text-slate-400">{{ remote_version ? 'GitHub remote' : update_channel|title ~ ' fallback' }}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Backups</p>
          <p class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ backup_total }}</p>
          <p class="mt-1 truncate text-xs text-slate-400">{{ latest_backup ? latest_backup.created_at : 'No local backup yet' }}</p>
        </div>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Release notes</h2>
          <span class="text-xs text-slate-400">{{ changelog_source == 'remote' ? 'GitHub changelog' : 'Local changelog' }}</span>
        </div>
        {% if changelog_entries is empty %}
          <div class="px-4 py-10 text-center text-sm text-slate-400">No changelog entries found.</div>
        {% else %}
          <div class="divide-y divide-slate-100">
            {% for entry in changelog_entries %}
              <div class="p-4">
                <div class="mb-2 flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-slate-900">{{ entry.version }}</h3>
                  {% if loop.first %}
                    <span class="rounded-full bg-blue-50 px-2 py-0.5 text-[11px] font-medium text-blue-700 ring-1 ring-inset ring-blue-200">{{ changelog_source == 'remote' ? 'latest' : 'latest local' }}</span>
                  {% endif %}
                </div>
                {% if entry.items is empty %}
                  <p class="text-sm text-slate-400">No summary items.</p>
                {% else %}
                  <ul class="space-y-1 text-sm text-slate-600">
                    {% for item in entry.items %}
                      <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-slate-300"></span><span>{{ item }}</span></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">Update status</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Mode</dt><dd class="font-medium text-slate-900">Install from release package</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Repository</dt><dd class="max-w-40 truncate text-right font-medium text-slate-900">{{ update_repository }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Branch</dt><dd class="font-medium text-slate-900">{{ update_branch }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Remote version</dt><dd class="font-medium text-slate-900">{{ remote_version ?: 'Unavailable' }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Last checked</dt><dd class="max-w-44 truncate text-right font-medium text-slate-900" title="{{ update_checked_at }}">{{ update_checked_at ? update_checked_at|date('Y-m-d H:i') : 'Never' }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Auto check</dt><dd class="font-medium text-slate-900">Every 12 hours</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Install</dt><dd class="font-medium text-slate-900">{{ install_ready ? 'Ready' : (install_available ? 'Needs attention' : 'Nothing to install') }}</dd></div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">GitHub source</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-slate-500">VERSION</dt><dd class="max-w-44 truncate text-right font-medium text-slate-900"><a href="{{ update_source }}" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700">raw file</a></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">CHANGELOG</dt><dd class="max-w-44 truncate text-right font-medium text-slate-900"><a href="{{ update_changelog_url }}" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700">raw file</a></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Package</dt><dd class="max-w-44 truncate text-right font-medium text-slate-900"><a href="{{ update_package_url }}" target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700">zip source</a></dd></div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Preflight checks</h2>
        </div>
        <ul class="divide-y divide-slate-50">
          {% for check in preflight_checks %}
            {% set tone = check.status == 'ok'
              ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
              : (check.status == 'warning' ? 'bg-amber-50 text-amber-700 ring-amber-200' : 'bg-red-50 text-red-700 ring-red-200')
            %}
            <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
              <span class="text-slate-600">{{ check.label }}</span>
              <span class="inline-flex max-w-36 truncate rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ tone }}">{{ check.value }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>

      {% set pre_ready = pre_update_backup and pre_update_backup.verified and pre_update_backup.version == current_version and (date().timestamp - pre_update_backup.created_at|date('U')) < 86400 %}
      <div class="rounded-lg border {{ pre_ready ? 'border-emerald-200' : 'border-slate-200' }} bg-white p-4">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-slate-900">Pre-update backup</h2>
          <span class="rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ pre_ready ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-amber-50 text-amber-700 ring-amber-200' }}">{{ pre_ready ? 'Ready' : 'Needed' }}</span>
        </div>
        {% if pre_update_backup %}
          <p class="mt-2 truncate font-mono text-xs text-slate-600" title="{{ pre_update_backup.filename }}">{{ pre_update_backup.filename }}</p>
          <p class="mt-0.5 text-xs text-slate-400">{{ pre_update_backup.created_at|date('Y-m-d H:i') }} · {{ pre_update_backup.verified ? 'checksums verified' : 'not verified' }} · v{{ pre_update_backup.version }}</p>
        {% else %}
          <p class="mt-2 text-xs text-slate-500">No verified full backup has been taken for an update yet.</p>
        {% endif %}
        <p class="mt-2 text-xs text-slate-500">Take one right before updating. It must be verified, less than 24 hours old, and made on the version you are updating from.</p>
        {% if can('backups.manage') %}
          <form method="post" action="{{ url('admin/updates') }}" class="mt-3">
            {{ csrf_field() }}
            <input type="hidden" name="updates_action" value="pre_update_backup">
            <button type="submit" class="{{ secondary_button }} w-full justify-center">Create verified backup</button>
          </form>
        {% endif %}
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">Install</h2>
        {% if release %}
          <dl class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Package</dt><dd class="font-medium text-slate-900">{{ release.version }}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Size</dt><dd class="font-medium text-slate-900">{{ (release.size / 1048576)|number_format(1) }} MB</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Needs PHP</dt><dd class="font-medium text-slate-900">{{ release.min_php }}+</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">SHA-256</dt><dd class="max-w-40 truncate font-mono text-xs text-slate-900" title="{{ release.sha256 }}">{{ release.sha256|slice(0, 16) }}…</dd></div>
          </dl>
        {% else %}
          <p class="mt-2 text-xs text-slate-500">No release package was found at the source, so there is nothing to install. Use <strong>Check status</strong> to look again.</p>
        {% endif %}
        {% if install_checks %}
          <ul class="mt-3 divide-y divide-slate-50 border-t border-slate-100">
            {% for check in install_checks %}
              <li class="flex items-center justify-between gap-3 py-2 text-sm">
                <span class="text-slate-600">{{ check.label }}</span>
                <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ check.ok ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-red-50 text-red-700 ring-red-200' }}">{{ check.ok ? 'ok' : 'blocked' }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        <p class="mt-3 text-xs leading-relaxed text-slate-500">The package is checked against its published checksum before anything changes. The public site is closed while the code is swapped, the new version is asked whether it starts, and if it does not the old one is put back.</p>
        {% if last_install %}
          <p class="mt-3 border-t border-slate-100 pt-3 text-xs text-slate-500">Last time: {{ last_install.message }} <span class="text-slate-400">({{ last_install.at|date('Y-m-d H:i') }})</span></p>
        {% endif %}
        {% if rollback_target %}
          <form method="post" action="{{ url('admin/updates') }}" class="mt-3" data-confirm="Put version {{ rollback_target }} back? Only the code changes; your pages, media and settings stay as they are." data-confirm-button="Put {{ rollback_target }} back">
            {{ csrf_field() }}
            <input type="hidden" name="updates_action" value="rollback">
            <button type="submit" class="{{ secondary_button }} w-full justify-center">Put version {{ rollback_target }} back</button>
          </form>
        {% endif %}
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">Safe update guide</h2>
        {% if update_guide is empty %}
          <p class="mt-2 text-sm text-slate-400">No local update guide found.</p>
        {% else %}
          <ul class="mt-3 space-y-2 text-sm text-slate-600">
            {% for item in update_guide %}
              <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-slate-300"></span><span>{{ item }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
