{% extends '@admin/base.twig' %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  <header class="mb-4 border-b border-slate-200 pb-4">
    <h1 class="text-[15px] font-semibold leading-tight text-slate-900">Search content</h1>
    <p class="text-xs text-slate-400">Titles, slugs, excerpts, tags, and body text across every content type and language.</p>
  </header>

  <form method="get" action="{{ url('admin/search') }}" class="mb-4 flex gap-2">
    <input type="search" name="q" value="{{ query }}" placeholder="Search content…" autofocus class="{{ input_class }}">
    <button type="submit" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700">Search</button>
  </form>

  {% if query %}
    <div class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700">{{ results|length }} result{{ results|length == 1 ? '' : 's' }} for “{{ query }}”</div>
      {% if results is empty %}
        {{ ui.empty_state('No matches', 'Try a shorter word or a different spelling.') }}
      {% else %}
        <div class="overflow-x-auto">
          <table class="w-full text-sm" data-sortable>
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
                <th class="px-4 py-2 font-medium" data-sort="text">Title</th>
                <th class="px-4 py-2 font-medium" data-sort="text">Type</th>
                <th class="px-4 py-2 font-medium" data-sort="text">Language</th>
                <th class="px-4 py-2 font-medium" data-sort="text">Status</th>
                <th class="px-4 py-2 font-medium" data-sort="number">Updated</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              {% for row in results %}
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-2.5" data-sort-value="{{ row.title }}">
                    <a href="{{ url(row.edit_url) }}" class="font-medium text-slate-900 hover:text-blue-600">{{ row.title }}</a>
                    <div class="text-xs text-slate-400">/{{ row.slug }}</div>
                  </td>
                  <td class="px-4 py-2.5 text-slate-600">{{ row.type|title }}</td>
                  <td class="px-4 py-2.5"><span class="inline-flex h-5 min-w-7 items-center justify-center rounded bg-slate-100 px-1 text-[10px] font-semibold text-slate-600">{{ row.lang|upper }}</span></td>
                  <td class="px-4 py-2.5" data-sort-value="{{ row.status }}">{{ ui.status_badge(row.status) }}</td>
                  <td class="px-4 py-2.5 text-slate-400" data-sort-value="{{ row.mtime }}">{{ row.mtime ? row.mtime|date('Y-m-d H:i') : '' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
