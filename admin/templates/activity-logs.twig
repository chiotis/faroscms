{% extends '@admin/base.twig' %}
{% set page_heading = 'Logs' %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  {% include '@admin/partials/logs-tabs.twig' with {current: 'activity'} %}
  {% set filters_active = filters|filter(v => v != '')|length > 0 %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <p class="truncate text-xs text-slate-400">Audit trail for admin access and content changes.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {{ ui.filter_button('activityLogFilter', filters_active) }}
    </div>
  </header>

  <div id="activityLogFilter" class="mb-4 rounded-lg border border-slate-200 bg-white p-4 {{ filters_active ? '' : 'hidden' }}">
    <form method="get" class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Level</span>
        <select name="level" class="{{ select_class }}">
          <option value="">All levels</option>
          {% for level in ['info', 'warning', 'error'] %}
            <option value="{{ level }}" {% if filters.level == level %}selected{% endif %}>{{ level|title }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Action</span>
        <select name="action" class="{{ select_class }}">
          <option value="">All actions</option>
          {% for action in actions %}
            <option value="{{ action }}" {% if filters.action == action %}selected{% endif %}>{{ action }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Actor</span>
        <input type="text" name="actor" value="{{ filters.actor }}" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Subject</span>
        <select name="subject_type" class="{{ select_class }}">
          <option value="">All subjects</option>
          {% for subject_type in subject_types %}
            <option value="{{ subject_type }}" {% if filters.subject_type == subject_type %}selected{% endif %}>{{ subject_type }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">From</span>
        <input type="date" name="date_from" value="{{ filters.date_from }}" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">To</span>
        <input type="date" name="date_to" value="{{ filters.date_to }}" class="{{ input_class }}">
      </label>
      <label class="block xl:col-span-2">
        <span class="mb-1 block text-sm font-medium text-slate-700">Search</span>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Message, subject id, context..." class="{{ input_class }}">
      </label>
      <div class="flex items-end justify-end gap-2 sm:col-span-2 xl:col-span-4">
        <a href="{{ url('admin/activity-logs') }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a>
        <button type="submit" class="{{ btn_primary }}">Apply filters</button>
      </div>
    </form>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
      <span class="text-sm font-medium text-slate-700">{{ total_logs }} log entries</span>
      <form method="get" class="flex items-center gap-2 text-xs text-slate-500">
        {% for key, value in filters %}
          {% if value %}
            <input type="hidden" name="{{ key }}" value="{{ value }}">
          {% endif %}
        {% endfor %}
        <span>Rows</span>
        <select name="per_page" aria-label="Rows per page" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-600 focus:border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900/5" onchange="this.form.submit()">
          {% for option in per_page_options %}
            <option value="{{ option }}" {% if per_page == option %}selected{% endif %}>{{ option }}</option>
          {% endfor %}
        </select>
      </form>
    </div>

    {% if logs is empty %}
      {{ filters_active
        ? ui.empty_state('No log entries match these filters', 'Reset the filters to see the full audit trail.')
        : ui.empty_state('No activity yet', 'New admin events will appear here after users take action.') }}
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium" data-sort="text">Time</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Level</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Action</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Actor</th>
              <th class="px-4 py-2 font-medium">Subject</th>
              <th class="px-4 py-2 font-medium">Message</th>
              <th class="px-4 py-2 text-right font-medium">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for log in logs %}
              <tr class="hover:bg-slate-50">
                <td class="whitespace-nowrap px-4 py-2.5 text-slate-500">{{ log.created_at }}</td>
                <td class="px-4 py-2.5">{{ ui.status_badge(log.level) }}</td>
                <td class="px-4 py-2.5"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{ log.action }}</code></td>
                <td class="px-4 py-2.5">
                  <div class="font-medium text-slate-700">{{ log.actor_username ?: 'system' }}</div>
                  <div class="text-xs text-slate-400">{{ log.actor_role ?: 'system' }}</div>
                </td>
                <td class="px-4 py-2.5 text-slate-600">
                  <div>{{ log.subject_type ?: '—' }}</div>
                  <div class="max-w-40 truncate text-xs text-slate-400">{{ log.subject_id ?: '' }}</div>
                </td>
                <td class="max-w-md px-4 py-2.5 text-slate-600">
                  <div class="truncate">{{ log.message ?: '—' }}</div>
                </td>
                <td class="px-4 py-2.5 text-right">
                  <button type="button" class="{{ icon_button }}" data-offcanvas-open="activity-log-{{ log.id }}" title="View details" aria-label="View details">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {% if total_pages > 1 %}
    <div class="mt-4 flex items-center justify-between text-sm text-slate-500">
      <span>Page {{ page }} of {{ total_pages }}</span>
      <div class="flex gap-2">
        {% set base_query = filters|merge({'per_page': per_page}) %}
        {% if page > 1 %}
          <a class="{{ btn_secondary }}" href="{{ url('admin/activity-logs?' ~ (base_query|merge({'page': page - 1})|url_encode)) }}">Previous</a>
        {% endif %}
        {% if page < total_pages %}
          <a class="{{ btn_secondary }}" href="{{ url('admin/activity-logs?' ~ (base_query|merge({'page': page + 1})|url_encode)) }}">Next</a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% for log in logs %}
    <div id="activity-log-{{ log.id }}" data-offcanvas-root hidden>
      <div data-offcanvas-backdrop class="fixed inset-0 z-40 bg-slate-900/40"></div>
      <aside data-offcanvas class="fixed right-0 top-0 z-50 h-full w-full max-w-lg translate-x-full overflow-y-auto bg-white shadow-xl transition-transform duration-300">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <div>
            <h2 class="text-sm font-semibold text-slate-900">{{ log.action }}</h2>
            <p class="mt-0.5 text-xs text-slate-400">{{ log.created_at }}</p>
          </div>
          <button type="button" data-offcanvas-close class="rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="space-y-4 p-5 text-sm">
          <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div><dt class="text-xs font-medium uppercase text-slate-400">Level</dt><dd class="mt-1 text-slate-700">{{ log.level }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">Actor</dt><dd class="mt-1 text-slate-700">{{ log.actor_username ?: 'system' }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">Role</dt><dd class="mt-1 text-slate-700">{{ log.actor_role ?: 'system' }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">IP</dt><dd class="mt-1 text-slate-700">{{ log.ip_address ?: '—' }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">Subject type</dt><dd class="mt-1 text-slate-700">{{ log.subject_type ?: '—' }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">Subject id</dt><dd class="mt-1 break-all text-slate-700">{{ log.subject_id ?: '—' }}</dd></div>
          </dl>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">Message</h3>
            <p class="mt-1 text-slate-700">{{ log.message ?: '—' }}</p>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">Context</h3>
            <pre class="mt-1 max-h-80 overflow-auto rounded-md bg-slate-950 p-3 text-xs leading-relaxed text-slate-100">{{ log.context_json ?: '{}' }}</pre>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">User agent</h3>
            <p class="mt-1 break-words text-xs text-slate-500">{{ log.user_agent ?: '—' }}</p>
          </div>
        </div>
      </aside>
    </div>
  {% endfor %}
{% endblock %}
