{% extends '@admin/base.twig' %}

{% block content %}
  {% set btn_danger = 'inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set input_soft = 'w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20' %}
  {% set messages = {
    'target_empty': 'Choose where visitors should go.',
    'target_scheme': 'Use an address on this site (like /en/about) or a full https:// address.',
    'target_relative': 'Start an address on this site with a slash, for example /en/about.',
    'target_invalid': 'That does not look like a valid web address.',
    'target_missing': 'Nothing exists at that address on this site yet. Choose a page that does.',
    'same': 'That is the address being deleted.',
    'loop': 'This would send visitors around in a circle: that address already leads back here.'
  } %}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4">
    <div class="min-w-0">
      <p class="text-xs text-slate-400"><a class="hover:text-slate-700" href="{{ url('admin/content?type=' ~ type ~ '&lang=' ~ lang) }}">{{ type|title }}</a> /</p>
      <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">Delete “{{ entry_title }}” <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-slate-500">{{ lang }}</span></h1>
      <p class="text-xs text-slate-400">{% if is_public %}This entry is public at <code>{{ public_path }}</code>. Decide what visitors, search engines, and old links find there after it is gone.{% else %}This entry is not public, so nobody can be visiting it.{% endif %}</p>
    </div>
  </header>

  {% if error and messages[error] is defined %}<template data-flash data-type="error">{{ messages[error] }}</template>{% endif %}

  {% if is_public and links %}
    <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="status">
      {{ links }} {{ links == 1 ? 'link' : 'links' }} in other content point{{ links == 1 ? 's' : '' }} to this address. {{ links == 1 ? 'It' : 'They' }} will lead to a "not found" page unless visitors are sent somewhere.
      <a class="font-semibold underline" href="{{ url('admin/search?q=' ~ public_path|url_encode) }}">Find {{ links == 1 ? 'it' : 'them' }}</a>
    </div>
  {% endif %}

  <form method="post" action="{{ url('admin/delete') }}" class="space-y-4">
    {{ csrf_field() }}
    <input type="hidden" name="type" value="{{ type }}">
    <input type="hidden" name="slug" value="{{ slug }}">
    <input type="hidden" name="lang" value="{{ lang }}">

    {% if may_redirect %}
      <fieldset class="rounded-lg border border-slate-200 bg-white p-4">
        <legend class="px-1 text-sm font-semibold text-slate-900">Where should visitors of {{ public_path }} go?</legend>
        <div class="mt-2 space-y-3 text-sm text-slate-700">
          <label class="flex items-start gap-2">
            <input type="radio" name="after" value="none" class="mt-0.5 h-4 w-4" {% if choice == 'none' %}checked{% endif %}>
            <span><span class="font-medium">Nowhere</span><br><span class="text-xs text-slate-400">They see a "not found" page. Right when the content is gone for good and nothing replaces it.</span></span>
          </label>
          {% if archive_path %}
            <label class="flex items-start gap-2">
              <input type="radio" name="after" value="archive" class="mt-0.5 h-4 w-4" {% if choice == 'archive' %}checked{% endif %}>
              <span><span class="font-medium">The list of {{ archive_label|lower }}</span> <code class="text-xs text-slate-500">{{ archive_path }}</code><br><span class="text-xs text-slate-400">A sensible place for content that belonged to a list.</span></span>
            </label>
          {% endif %}
          <label class="flex items-start gap-2">
            <input type="radio" name="after" value="home" class="mt-0.5 h-4 w-4" {% if choice == 'home' %}checked{% endif %}>
            <span><span class="font-medium">The home page</span> <code class="text-xs text-slate-500">{{ home_path }}</code></span>
          </label>
          <div class="flex items-start gap-2">
            <input type="radio" name="after" value="custom" id="after-custom" class="mt-0.5 h-4 w-4" {% if choice == 'custom' %}checked{% endif %}>
            <div class="min-w-0 flex-1">
              <label for="after-custom-target" class="font-medium">Another address</label>
              <input type="text" id="after-custom-target" name="after_target" value="{{ custom_target }}" list="known-paths" placeholder="/en/about or https://example.org/page" class="{{ input_soft }} mt-1" autocomplete="off" spellcheck="false" onfocus="document.getElementById('after-custom').checked = true">
              <datalist id="known-paths">
                {% for path, label in known_paths %}<option value="/{{ path }}">{{ label }}</option>{% endfor %}
              </datalist>
              <p class="mt-1 text-xs text-slate-400">A page on this site (start typing to see them) or another website.</p>
            </div>
          </div>
        </div>
        <p class="mt-3 text-xs text-slate-400">A permanent redirect is added, so search engines pass what they know about the old address on. You can change or remove it later in Redirects.</p>
      </fieldset>
    {% elseif is_public %}
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-600">
        Visitors of <code>{{ public_path }}</code> will see a "not found" page after this. An administrator can add a redirect for it in Redirects.
      </div>
    {% endif %}

    {% if siblings %}
      <p class="text-xs text-slate-400">Only the {{ lang|upper }} version is deleted. The other {{ siblings|length == 1 ? 'language' : 'languages' }} ({{ siblings|join(', ')|upper }}) stay as they are.</p>
    {% endif %}
    <p class="text-xs text-slate-400">The text is kept in the history for 180 days, so it can be brought back from Admin &gt; History.</p>

    <div class="flex flex-wrap items-center gap-2">
      <button type="submit" class="{{ btn_danger }}">Delete</button>
      <a class="{{ btn_secondary }}" href="{{ url('admin/edit?type=' ~ type ~ '&slug=' ~ slug ~ '&lang=' ~ lang) }}">Cancel</a>
    </div>
  </form>
{% endblock %}
