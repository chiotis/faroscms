{% extends '@admin/base.twig' %}
{% set page_heading = 'Content types' %}

{#
  Admin > Content types: every kind of content the site can have (pages and posts, the ready-made ones the theme ships, the ones the site
  made) as a card: its name, how many fields and entries it has, how its list looks, who defines it, and a switch to turn it on or off.
  A type that is on opens its editor; a new one is made from a small form at the top.
#}
{% block content %}
  {% import '@admin/partials/ui.twig' as ui %}

  {% set icons = {
    'pages': '<path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v12a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5M9 13h6M9 17h6"/>',
    'posts': '<path stroke-linecap="round" stroke-linejoin="round" d="M4 5h12a1 1 0 011 1v12a2 2 0 002 2H6a2 2 0 01-2-2V5zM17 9h3v9a2 2 0 01-2 2M8 9h5M8 13h5M8 17h3"/>',
    'projects': '<path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>',
    'books': '<path stroke-linecap="round" stroke-linejoin="round" d="M5 4h10a3 3 0 013 3v13H8a3 3 0 01-3-3V4zM5 17a3 3 0 013-3h10M9 8h5"/>'
  } %}
  {% set fallback_icon = '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3 3 8l9 5 9-5-9-5zM3 13l9 5 9-5"/>' %}
  {% set on_count = types_list|filter(r => r.enabled)|length %}

  <header class="mb-3 flex flex-wrap items-start justify-between gap-3">
    <p class="m-0 max-w-3xl text-xs text-slate-500">The kinds of content the site has: the fields of each one's editor form and how its list page looks. A type that is off is hidden from the admin and the site (its files are kept). What you change is saved in <code class="rounded bg-slate-100 px-1 py-0.5">{{ custom_file }}</code> and survives updates.</p>
  </header>

  {{ ui.flash(saved ? 'Saved.' : '', 'success') }}
  {% if error == 'name' %}{{ ui.flash('Use a new name made of letters, numbers, and dashes. Some names are reserved.', 'error') }}{% endif %}
  {% if toggled == 'on' %}{{ ui.flash(toggled_type|title ~ ' is enabled: it has its own list in the admin and its pages on the site.', 'success') }}{% endif %}
  {% if toggled == 'off' %}{{ ui.flash(toggled_type|title ~ ' is disabled: it is hidden from the admin and the site. Its files are kept, and enabling it again brings it back.', 'success') }}{% endif %}
  {% if error == 'type' %}{{ ui.flash('That type cannot be switched.', 'error') }}{% endif %}
  {% if error == 'settings' %}{{ ui.flash('Could not save the setting. Check that the system database is writable.', 'error') }}{% endif %}
  {% if error == 'write' %}{{ ui.flash('Could not write to the custom/ folder. Check that it is writable.', 'error') }}{% endif %}

  <details class="tr-add mb-3" {% if error == 'name' %}open{% endif %}>
    <summary>New content type</summary>
    <form method="post" class="ct-new">
      {{ csrf_field() }}
      <input type="hidden" name="action" value="create">
      <label>Name (in the address)
        <input type="text" name="name" required pattern="[a-z][a-z0-9-]*" placeholder="events" class="lc-input font-mono" autocomplete="off" spellcheck="false">
      </label>
      <label>Title
        <input type="text" name="label" placeholder="Events" class="lc-input" autocomplete="off">
      </label>
      <button type="submit" class="ct-create">Create</button>
      <p class="tr-note">For example “events” or “team”. It gets its own list in the admin, an archive page at <code>/name</code>, and pages at <code>/name/slug</code>.</p>
    </form>
  </details>

  <p class="tr-count">{{ on_count }} of {{ types_list|length }} {{ types_list|length == 1 ? 'type' : 'types' }} in use</p>

  <ul class="ct-grid" aria-label="Content types">
    {% for row in types_list %}
      <li class="ct-card{{ row.enabled ? '' : ' is-off' }}">
        <div class="ct-top">
          <span class="ct-icon" aria-hidden="true"><svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">{{ (icons[row.type] ?? fallback_icon)|raw }}</svg></span>
          <div class="min-w-0 flex-1">
            <h2 class="ct-name">{{ row.label }}</h2>
            <p class="ct-key"><code>/{{ row.type }}</code>{% if not row.enabled %} <span class="ct-chip">Off</span>{% endif %}</p>
          </div>
          {% if row.switchable %}
            <form method="post" class="ct-switch-form">
              {{ csrf_field() }}
              <input type="hidden" name="action" value="toggle">
              <input type="hidden" name="type" value="{{ row.type }}">
              <input type="hidden" name="enabled" value="{{ row.enabled ? '0' : '1' }}">
              <button type="submit" class="ct-switch" role="switch" aria-checked="{{ row.enabled ? 'true' : 'false' }}"><i aria-hidden="true"></i><span class="sr-only">{{ row.enabled ? 'Disable' : 'Enable' }}<span> {{ row.label }}</span></span></button>
            </form>
          {% else %}
            <span class="ct-always">Always on</span>
          {% endif %}
        </div>
        {% if row.description %}<p class="ct-desc">{{ row.description }}</p>{% endif %}
        <p class="ct-facts">
          <span><b>{{ row.fields }}</b> {{ row.fields == 1 ? 'field' : 'fields' }}</span>
          <span><b>{{ row.items }}</b> {{ row.items == 1 ? 'entry' : 'entries' }}</span>
          <span>{{ row.layout|replace({'_': ' '})|capitalize }} list</span>
        </p>
        <div class="ct-foot">
          <span class="ct-origin">{{ row.origin ? row.origin|replace({'+': ' + '})|capitalize : (row.type == 'pages' ? 'Built in' : 'Default settings') }}</span>
          {% if row.enabled %}
            <span class="ct-links">
              <a href="{{ url('admin/content?type=' ~ row.type) }}">Entries<span class="sr-only"> of {{ row.label }}</span></a>
              <a href="{{ url('admin/content-types?type=' ~ row.type) }}" class="is-main">Edit<span class="sr-only"> {{ row.label }}</span></a>
            </span>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% endblock %}
