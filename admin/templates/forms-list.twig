{% extends '@admin/base.twig' %}
{% set page_heading = 'Forms' %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}
  {% set icon_danger = 'rounded-md p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600' %}

  {{ ui.flash(deleted ? 'Form deleted.' : '', 'success') }}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="truncate text-xs text-slate-400">Build forms, embed them with a shortcode, and review submissions.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {{ ui.filter_button('formFilter', filters_active) }}
      <a class="{{ btn_primary }}" href="{{ url('admin/forms-new?lang=' ~ default_lang) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
        New form
      </a>
    </div>
  </header>

  {% if migration_report %}
    <section class="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" aria-labelledby="migration-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 id="migration-title" class="font-semibold">Forms in more than one language were merged</h2>
          <p class="mt-0.5 text-xs">Each form is now built once, in {{ default_lang|upper }}, and the other languages are translations of it. Look through what could not be matched; the original files are kept in <code>storage/form-translation/copies</code>.</p>
        </div>
        <form method="post" action="{{ url('admin/forms') }}">
          {{ csrf_field() }}
          <button type="submit" name="dismiss_migration_report" value="1" class="rounded-md border border-amber-300 bg-white px-2.5 py-1 text-xs font-medium text-amber-900 hover:bg-amber-100">Dismiss</button>
        </form>
      </div>
      <div class="mt-3 grid gap-3 lg:grid-cols-2">
        {% if migration_report.unmatched %}
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide">Texts without a field to go to ({{ migration_report.unmatched|length }})</h3>
            <ul class="mt-1 grid gap-1 text-xs">
              {% for row in migration_report.unmatched %}
                <li class="rounded bg-white/70 px-2 py-1"><strong>{{ row.form }}</strong> · {{ row.lang|upper }} · <code>{{ row.field }}</code>{% if row.option is defined %} choice <code>{{ row.option }}</code>{% else %}: {{ [row.label|default(''), row.placeholder|default(''), row.help|default('')]|filter(t => t != '')|join(' / ') }}{% endif %}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if migration_report.differing %}
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide">Settings that were different in a copy ({{ migration_report.differing|length }})</h3>
            <ul class="mt-1 grid gap-1 text-xs">
              {% for row in migration_report.differing %}
                <li class="rounded bg-white/70 px-2 py-1"><strong>{{ row.form }}</strong> · {{ row.lang|upper }} · {{ row.setting }}: “{{ row.was is iterable ? '' : row.was }}” in the form, “{{ row.copy is iterable ? '' : row.copy }}” in the copy</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if migration_report.skipped %}
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide">Left as they are</h3>
            <ul class="mt-1 grid gap-1 text-xs">
              {% for row in migration_report.skipped %}<li class="rounded bg-white/70 px-2 py-1"><strong>{{ row.form }}</strong> · {{ row.lang|upper }}: {{ row.reason }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  <div id="formFilter" class="mb-4 rounded-lg border border-slate-200 bg-white p-4 {{ filters_active ? '' : 'hidden' }}">
    <form method="get" action="{{ url('admin/forms') }}" class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Search</span>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Form name or slug" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Status</span>
        <select name="status" class="{{ select_class }}">
          <option value="">All</option>
          <option value="published" {% if filters.status == 'published' %}selected{% endif %}>Published</option>
          <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>Draft</option>
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Sort</span>
        <select name="sort" class="{{ select_class }}">
          <option value="updated" {% if sort == 'updated' %}selected{% endif %}>Recently updated</option>
          <option value="submissions" {% if sort == 'submissions' %}selected{% endif %}>Most submissions</option>
          <option value="name" {% if sort == 'name' %}selected{% endif %}>Name</option>
        </select>
      </label>
      <div class="flex justify-end gap-2 sm:col-span-3">
        <a href="{{ url('admin/forms') }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a>
        <button type="submit" class="{{ btn_primary }}">Apply</button>
      </div>
    </form>
  </div>

  <div class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Forms</p>
      <p class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ totals.forms }}</p>
      <p class="mt-1 text-xs text-slate-400">{{ totals.published }} published</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Submissions</p>
      <p class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ totals.submissions|number_format }}</p>
      <p class="mt-1 text-xs text-slate-400">Stored on this site</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Last 7 days</p>
      <p class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ totals.recent|number_format }}</p>
      <p class="mt-1 text-xs text-slate-400">New submissions</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Languages</p>
      <p class="mt-1.5 text-2xl font-semibold tracking-tight text-slate-900">{{ languages|length }}</p>
      <p class="mt-1 text-xs text-slate-400">{{ languages|map(l => l|upper)|join(' · ') }}</p>
    </div>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-2.5">
      <span class="text-sm font-medium text-slate-700">{{ rows|length }} form{{ rows|length == 1 ? '' : 's' }}</span>
      <span class="hidden text-xs text-slate-400 sm:inline">A form is built once; the other languages are translations of it.</span>
    </div>
    {% if rows is empty %}
      {{ ui.empty_state(filters_active ? 'No forms match these filters' : 'No forms yet', filters_active ? 'Reset the filters to see every form.' : 'Create a form, then embed it on any page with its shortcode.') }}
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium" data-sort="text">Name</th>
              <th class="px-4 py-2 font-medium">Shortcode</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Fields</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Submissions</th>
              <th class="px-4 py-2 font-medium">Languages</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Status</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Updated</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for row in rows %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5" data-sort-value="{{ row.title }}">
                  <a href="{{ url('admin/edit?type=forms&slug=' ~ row.slug ~ '&lang=' ~ row.lang) }}" class="font-medium text-slate-900 hover:text-blue-600">{{ row.title }}</a>
                  <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs text-slate-400">
                    <span>/{{ row.slug }}</span>
                    {% if row.notifications %}<span title="Email notifications enabled">· email</span>{% endif %}
                    {% if not row.stores %}<span class="text-amber-600" title="Submissions are emailed but not stored">· not stored</span>{% endif %}
                  </div>
                </td>
                <td class="px-4 py-2.5">
                  <button type="button" data-copy="{{ row.shortcode }}" class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-600 hover:bg-slate-200" title="Copy shortcode">{{ row.shortcode }}</button>
                </td>
                <td class="px-4 py-2.5 text-slate-600" data-sort-value="{{ row.field_count }}">{{ row.field_count }}</td>
                <td class="px-4 py-2.5" data-sort-value="{{ row.submissions }}">
                  <a href="{{ url('admin/form-submissions?slug=' ~ row.slug) }}" class="font-medium text-slate-700 hover:text-blue-600">{{ row.submissions|number_format }}</a>
                  {% if row.recent > 0 %}<span class="ml-1 text-xs text-emerald-600">+{{ row.recent }} this week</span>{% endif %}
                  {% if row.latest_submission %}<div class="text-[11px] text-slate-400">Last {{ row.latest_submission }}</div>{% endif %}
                </td>
                <td class="px-4 py-2.5">
                  <div class="flex flex-wrap items-center gap-1">
                    <span class="inline-flex h-5 min-w-7 items-center justify-center rounded bg-slate-100 px-1 text-[10px] font-semibold text-slate-600" title="The language the form is built in">{{ row.lang|upper }}</span>
                    {% for code, status in row.translations %}
                      {% if status.missing == 0 %}
                        <a href="{{ url('admin/edit?type=forms&slug=' ~ row.slug ~ '&lang=' ~ default_lang ~ '&translate=' ~ code) }}" class="inline-flex h-5 items-center gap-1 whitespace-nowrap rounded bg-emerald-50 px-1.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100" title="{{ code|upper }} is fully translated">{{ code|upper }}</a>
                      {% else %}
                        <a href="{{ url('admin/edit?type=forms&slug=' ~ row.slug ~ '&lang=' ~ default_lang ~ '&translate=' ~ code) }}" class="inline-flex h-5 items-center gap-1 whitespace-nowrap rounded bg-amber-50 px-1.5 text-[10px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-200 hover:bg-amber-100" title="{{ status.missing }} of {{ status.total }} texts still show the {{ default_lang|upper }} text in {{ code|upper }}">{{ code|upper }} <span class="font-medium">{{ status.missing }} missing</span></a>
                      {% endif %}
                    {% endfor %}
                    {% if row.copies %}<span class="text-[10px] font-medium text-amber-700" title="Older per-language copies of this form: they are folded into it when the site is next opened">{{ row.copies|length }} old {{ row.copies|length == 1 ? 'copy' : 'copies' }}</span>{% endif %}
                  </div>
                </td>
                <td class="px-4 py-2.5" data-sort-value="{{ row.status }}">{{ ui.status_badge(row.status) }}</td>
                <td class="px-4 py-2.5 text-slate-400" data-sort-value="{{ row.updated }}">{{ row.updated|date('Y-m-d H:i') }}</td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center justify-end gap-0.5">
                    <a class="{{ icon_button }}" href="{{ url('admin/form-submissions?slug=' ~ row.slug) }}" title="Submissions" aria-label="Submissions for {{ row.title }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6m16 0v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4m16 0h-4l-2 3h-4l-2-3H4"/></svg>
                    </a>
                    {% if can('exports.manage') %}
                      <a class="{{ icon_button }}" href="{{ url('admin/forms-export?slug=' ~ row.slug ~ '&lang=' ~ row.lang) }}" title="Export CSV" aria-label="Export {{ row.title }} submissions">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16"/></svg>
                      </a>
                    {% endif %}
                    <a class="{{ icon_button }}" href="{{ url('admin/edit?type=forms&slug=' ~ row.slug ~ '&lang=' ~ row.lang) }}" title="Edit" aria-label="Edit {{ row.title }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    </a>
                    <form method="post" action="{{ url('admin/delete') }}" data-confirm="Delete “{{ row.title }}” with all its translations? Its stored submissions are kept." data-confirm-button="Delete">
                      {{ csrf_field() }}
                      <input type="hidden" name="type" value="forms">
                      <input type="hidden" name="slug" value="{{ row.slug }}">
                      <input type="hidden" name="lang" value="{{ row.lang }}">
                      <button type="submit" class="{{ icon_danger }}" title="Delete" aria-label="Delete {{ row.title }}">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
{% endblock %}
