{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Import {{ type|title }}</h1> <p class="mt-1 text-sm text-slate-500">Upload a CSV export and import {{ type }} across all languages.</p> </div> <div class="actions mt-1 flex flex-wrap items-center gap-2"> <a class="{{ btn_muted }}" href="{{ url('admin?type=' ~ type) }}">Back to {{ type|title }}</a> </div> </header> {% if saved %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Import completed.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if error %} <div class="alert mb-4 rounded-md border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{{ error }}</div> {% endif %} <div class="form-section mb-4 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm w-full"> <h3 class="text-xl font-semibold text-slate-900">CSV Upload</h3> <form method="post" enctype="multipart/form-data" class="filters flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm"> <input type="hidden" name="type" value="{{ type }}"> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">CSV file</span> <input type="file" name="csv_file" accept=".csv,text/csv" class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-700"> </label> <button type="submit" class="{{ btn }}">Dry-run Preview</button> </form> {% if source_filename %} <p class="hint text-sm text-slate-500">Source file: {{ source_filename }}</p> {% endif %} </div> {% if preview_rows is not empty %} <div class="form-section grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm mb-4 w-full"> <h3 class="text-xl font-semibold text-slate-900">Preview</h3> <p class="hint text-sm text-slate-500"> Create: {{ preview_summary.create|default(0) }} | Update: {{ preview_summary.update|default(0) }} | Skip: {{ preview_summary.skip|default(0) }} | Errors: {{ preview_summary.error|default(0) }} </p> <div class="table overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm w-full"> <table class="list-table min-w-full table-auto border-collapse text-sm"> <thead> <tr> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Line</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Action</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Title</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Slug</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Lang</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Message</th> </tr> </thead> <tbody> {% for row in preview_rows %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.line }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.action }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.title }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.slug }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.lang }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top">{{ row.message }}</td> </tr> {% endfor %} </tbody> </table> </div> {% set has_changes = (preview_summary.create|default(0)) + (preview_summary.update|default(0)) > 0 %} {% if preview_token and has_changes and (preview_summary.error|default(0)) == 0 %} <form method="post" class="actions flex flex-wrap items-center gap-2 mt-1"> <input type="hidden" name="type" value="{{ type }}"> <input type="hidden" name="apply" value="1"> <input type="hidden" name="preview_token" value="{{ preview_token }}"> <button type="submit" class="{{ btn }}" onclick="return confirm('Apply this import? This will update files in content/{{ type }}.');">Apply Import</button> </form> {% endif %} </div> {% endif %}
{% endblock %}
