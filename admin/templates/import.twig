{% extends '@admin/base.twig' %}

{% block content %}
  {% set primary_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set secondary_btn = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set file_class = 'block w-full cursor-pointer rounded-md border border-slate-300 bg-white text-sm text-slate-700 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20' %}

  <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-slate-900">Import {{ type|title }}</h1>
      <p class="mt-1 text-sm text-slate-500">Upload a CSV and preview changes before writing content files.</p>
    </div>
    <a class="{{ secondary_btn }}" href="{{ url('admin/content?type=' ~ type) }}">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to {{ type|title }}
    </a>
  </header>

  {% if saved %}
    <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>Import completed.</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}
  {% if error %}
    <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">{{ error }}</div>
  {% endif %}

  <section class="mb-4 rounded-lg border border-slate-200 bg-white">
    <div class="border-b border-slate-200 px-4 py-3">
      <h2 class="text-sm font-semibold text-slate-900">CSV upload</h2>
      <p class="mt-0.5 text-xs text-slate-400">Run a dry-run first. No files are changed until you apply a clean preview.</p>
    </div>
    <form method="post" enctype="multipart/form-data" class="flex flex-wrap items-end gap-3 p-4">
      <input type="hidden" name="type" value="{{ type }}">
      <label class="grid min-w-72 flex-1 gap-1 text-sm font-medium text-slate-700">
        CSV file
        <input type="file" name="csv_file" accept=".csv,text/csv" class="{{ file_class }}">
      </label>
      <button type="submit" class="{{ primary_btn }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h10M4 17h7"/>
        </svg>
        Dry-run preview
      </button>
    </form>
    {% if source_filename %}
      <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-500">Source file: {{ source_filename }}</div>
    {% endif %}
  </section>

  {% if preview_rows is not empty %}
    {% set creates = preview_summary.create|default(0) %}
    {% set updates = preview_summary.update|default(0) %}
    {% set skips = preview_summary.skip|default(0) %}
    {% set errors = preview_summary.error|default(0) %}
    {% set has_changes = creates + updates > 0 %}

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Preview</h2>
          <p class="mt-0.5 text-xs text-slate-400">{{ preview_rows|length }} parsed rows from the uploaded CSV.</p>
        </div>
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-medium">
          <span class="rounded bg-emerald-50 px-2 py-1 text-emerald-700 ring-1 ring-emerald-200">Create {{ creates }}</span>
          <span class="rounded bg-blue-50 px-2 py-1 text-blue-700 ring-1 ring-blue-200">Update {{ updates }}</span>
          <span class="rounded bg-slate-100 px-2 py-1 text-slate-600 ring-1 ring-slate-200">Skip {{ skips }}</span>
          <span class="rounded bg-rose-50 px-2 py-1 text-rose-700 ring-1 ring-rose-200">Errors {{ errors }}</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium">Line</th>
              <th class="px-4 py-2 font-medium">Action</th>
              <th class="px-4 py-2 font-medium">Title</th>
              <th class="px-4 py-2 font-medium">Slug</th>
              <th class="px-4 py-2 font-medium">Lang</th>
              <th class="px-4 py-2 font-medium">Message</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for row in preview_rows %}
              {% set action = row.action|default('') %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5 align-top text-slate-500">{{ row.line }}</td>
                <td class="px-4 py-2.5 align-top">
                  <span class="rounded px-1.5 py-0.5 text-xs font-medium {{ action == 'create' ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200' : (action == 'update' ? 'bg-blue-50 text-blue-700 ring-1 ring-blue-200' : (action == 'error' ? 'bg-rose-50 text-rose-700 ring-1 ring-rose-200' : 'bg-slate-100 text-slate-600 ring-1 ring-slate-200')) }}">{{ action }}</span>
                </td>
                <td class="px-4 py-2.5 align-top text-slate-900">{{ row.title }}</td>
                <td class="px-4 py-2.5 align-top"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{ row.slug }}</code></td>
                <td class="px-4 py-2.5 align-top text-slate-500">{{ row.lang }}</td>
                <td class="px-4 py-2.5 align-top text-slate-500">{{ row.message }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if preview_token and has_changes and errors == 0 %}
        <form method="post" class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 px-4 py-3">
          <input type="hidden" name="type" value="{{ type }}">
          <input type="hidden" name="apply" value="1">
          <input type="hidden" name="preview_token" value="{{ preview_token }}">
          <button type="submit" class="{{ primary_btn }}" onclick="return confirm('Apply this import? This will update files in content/{{ type }}.');">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Apply import
          </button>
        </form>
      {% endif %}
    </section>
  {% endif %}
{% endblock %}
