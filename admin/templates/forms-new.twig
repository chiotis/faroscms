{#
  Where a new form starts: a ready-made form to build on (see src/FormTemplates.php), or a blank one. The choice opens the
  form builder with that form's fields, button, messages and emails in place; nothing is saved until Save is pressed.
#}
{% extends '@admin/base.twig' %}
{% set page_heading = 'New form' %}

{% block content %}
  {% set icons = {
    'blank': '<path stroke-linecap="round" d="M12 5v14M5 12h14"/>',
    'mail': '<path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18v12H3zM3 7l9 6 9-6"/>',
    'bell': '<path stroke-linecap="round" stroke-linejoin="round" d="M6 8a6 6 0 1112 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 004 0"/>',
    'tag': '<path stroke-linecap="round" stroke-linejoin="round" d="M11 3H5a2 2 0 00-2 2v6l9 9a2 2 0 002.8 0l4.6-4.6a2 2 0 000-2.8L11 3zM7 7h.01"/>',
    'calendar': '<path stroke-linecap="round" stroke-linejoin="round" d="M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1zM4 10h16M8 3v4M16 3v4"/>',
    'star': '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/>',
    'help': '<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM9.5 9.5a2.5 2.5 0 015 0c0 1.5-2.5 2-2.5 3.5M12 17h.01"/>',
    'heart': '<path stroke-linecap="round" stroke-linejoin="round" d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>'
  } %}
  {% set primary_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set secondary_btn = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}

  <header class="mb-5 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm text-slate-500">Choose a form to start from. You can change everything afterwards.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      {% if languages|length > 1 %}
        <div class="inline-flex rounded-md border border-slate-300 bg-white p-0.5" role="group" aria-label="Language of the new form">
          {% for code in languages %}
            <a href="{{ url('admin/forms-new?lang=' ~ code) }}" class="rounded px-2.5 py-1 text-xs font-semibold no-underline {{ code == lang ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100' }}"{% if code == lang %} aria-current="true"{% endif %}>{{ code|upper }}</a>
          {% endfor %}
        </div>
      {% endif %}
      <a class="{{ secondary_btn }}" href="{{ url('admin/forms') }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Back to forms
      </a>
    </div>
  </header>

  <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Form templates">
    {% for template in templates %}
      <li>
        <a href="{{ url('admin/new?type=forms&lang=' ~ lang ~ '&template=' ~ template.id) }}" class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-blue-400 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600">
          {# A sketch of the form: a bar for each field, as wide as the field is. #}
          <div class="flex min-h-[8.5rem] flex-wrap content-start gap-1.5 rounded-lg border border-slate-100 bg-slate-50 p-3 text-slate-300" aria-hidden="true">
            {% if template.fields is empty %}
              <div class="flex w-full flex-1 items-center justify-center rounded-md border-2 border-dashed border-slate-300 py-6 text-slate-400">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">{{ icons.blank|raw }}</svg>
              </div>
            {% else %}
              {% for field in template.fields|slice(0, 7) %}
                {% set basis = field.width == 'half' ? 'w-[calc(50%-0.2rem)]' : (field.width == 'third' ? 'w-[calc(33%-0.2rem)]' : (field.width == 'two-thirds' ? 'w-[calc(66%-0.2rem)]' : 'w-full')) %}
                {% if field.type == 'heading' %}
                  <div class="mt-1 h-2 w-1/3 rounded-full bg-slate-400"></div><div class="w-full"></div>
                {% elseif field.type == 'textarea' %}
                  <div class="h-8 {{ basis }} rounded border border-slate-200 bg-white"></div>
                {% elseif field.type == 'checkbox' %}
                  <div class="flex {{ basis }} items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm border border-slate-300 bg-white"></span><span class="h-1.5 w-2/3 rounded-full bg-slate-200"></span></div>
                {% elseif field.type == 'radio' or field.type == 'checkboxes' %}
                  <div class="flex {{ basis }} flex-wrap gap-1.5"><span class="h-2.5 w-2.5 rounded-full border border-slate-300 bg-white"></span><span class="h-2.5 w-2.5 rounded-full border border-slate-300 bg-white"></span><span class="h-2.5 w-2.5 rounded-full border border-slate-300 bg-white"></span></div>
                {% else %}
                  <div class="h-4 {{ basis }} rounded border border-slate-200 bg-white"></div>
                {% endif %}
              {% endfor %}
              <div class="mt-1 h-4 w-16 rounded bg-blue-500"></div>
            {% endif %}
          </div>
          <div class="mt-3 flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">{{ (icons[template.icon] ?? icons.blank)|raw }}</svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-slate-900 group-hover:text-blue-700">{{ template.name }}</span>
              <span class="mt-0.5 block text-xs leading-5 text-slate-500">{{ template.description }}</span>
              {% if template.fields is not empty %}<span class="mt-1.5 block text-[11px] font-medium text-slate-500">{{ template.fields|filter(f => f.type not in ['heading', 'paragraph'])|length }} fields</span>{% endif %}
            </span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
{% endblock %}
