{% extends '@admin/base.twig' %}
{% set page_heading = 'Redirects' %}

{#
  Admin > Redirects: old addresses that lead to new ones, and the addresses visitors asked for that were not found. A quick form to add
  one (or to change the one being edited), a way to add many, the figures, filters, and a compact row for each redirect: the old
  address, an arrow, the new one, what is notable about it, how often it was used, and the switch, Edit and Delete. A plain form (the
  rows carry their own small forms for the switch and Delete, and one bulk form); admin-redirects.js only selects all and counts.
#}
{% block content %}
  {% import '@admin/partials/ui.twig' as ui %}

  {% set messages = {
    'source_empty': 'Enter the old address.',
    'source_admin': 'The admin area cannot be redirected.',
    'source_files': 'Uploaded files and theme assets cannot be redirected.',
    'target_empty': 'Enter where visitors should go.',
    'target_scheme': 'Use an address on this site (like /en/about) or a full https:// address.',
    'target_relative': 'Start an address on this site with a slash, for example /en/about.',
    'target_invalid': 'That does not look like a valid web address.',
    'same': 'The old and the new address are the same.',
    'loop': 'This would send visitors around in a circle: the new address already leads back to the old one.',
    'code': 'Choose permanent or temporary.',
    'duplicate': 'There is already a redirect from that address. Edit it instead.',
    'source_has_page': 'A page already exists at the old address, so the redirect would never be used. Rename or delete that page first.',
    'store': 'The system database is not available, so nothing was saved.'
  } %}
  {% set link = 'font-medium text-blue-700 hover:underline' %}
  {% set off_count = stats.total - stats.active %}

  <header class="mb-3 flex flex-col gap-2">
    <p class="m-0 text-xs text-slate-500">Old addresses that lead to new ones. They are made for you when you change the address of a page, and you can add your own. Visitors and search engines follow them without noticing.</p>
    <nav class="flex gap-1 border-b border-slate-200" aria-label="Redirect sections">
      <a href="{{ url('admin/redirects') }}" class="border-b-2 px-3 py-2 text-sm font-medium {{ tab == 'redirects' ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' }}" {% if tab == 'redirects' %}aria-current="page"{% endif %}>Redirects <span class="ml-1 rounded bg-slate-100 px-1.5 text-xs text-slate-500">{{ stats.total }}</span></a>
      <a href="{{ url('admin/redirects?tab=missing') }}" class="border-b-2 px-3 py-2 text-sm font-medium {{ tab == 'missing' ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' }}" {% if tab == 'missing' %}aria-current="page"{% endif %}>Not found <span class="ml-1 rounded {{ missing_total > 0 ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-500' }} px-1.5 text-xs">{{ missing_total }}</span></a>
    </nav>
  </header>

  {% if done == 'added' %}{{ ui.flash('Redirect added.', 'success') }}{% endif %}
  {% if done == 'updated' %}{{ ui.flash('Saved.', 'success') }}{% endif %}
  {% if done == 'deleted' %}{{ ui.flash(done_count ~ ' ' ~ (done_count == 1 ? 'redirect' : 'redirects') ~ ' deleted.', 'success') }}{% endif %}
  {% if done == 'ignored' %}{{ ui.flash('Removed from the list.', 'success') }}{% endif %}
  {% if done == 'cleared' %}{{ ui.flash('List cleared.', 'success') }}{% endif %}
  {% if error and messages[error] is defined %}{{ ui.flash(messages[error], 'error') }}{% endif %}

  {% if tab == 'redirects' %}
    <div class="an-kpis rd-kpis">
      {% for card in [['Redirects', stats.total], ['Turned on', stats.active], ['Visits followed', stats.hits], ['Never used', stats.unused]] %}
        <div class="an-kpi"><span>{{ card[0] }}</span><strong>{{ card[1]|number_format }}</strong></div>
      {% endfor %}
    </div>

    <section id="add" class="rd-add lc-card rounded-xl border border-slate-200 bg-white" aria-labelledby="rd-h-add">
      <h2 id="rd-h-add" class="rd-title">{{ form.id ? 'Edit redirect' : 'Add a redirect' }}</h2>
      <form method="post" action="{{ url('admin/redirects') }}#add" autocomplete="off">
        {{ csrf_field() }}
        <input type="hidden" name="do" value="{{ form.id ? 'update' : 'add' }}">
        {% if form.id %}<input type="hidden" name="id" value="{{ form.id }}">{% endif %}
        <div class="rd-line">
          <label class="rd-from"><span class="sr-only">Old address</span>
            <input type="text" name="source" value="{{ form.source }}" placeholder="/old-page" class="lc-input font-mono" required spellcheck="false">
          </label>
          <span class="rd-arrow" aria-hidden="true">→</span>
          <label class="rd-to"><span class="sr-only">Send visitors to</span>
            <input type="text" name="target" value="{{ form.target }}" list="knownPaths" placeholder="/new-page or https://example.com" class="lc-input font-mono" required spellcheck="false">
            <datalist id="knownPaths">{% for path, title in known_paths %}<option value="/{{ path }}">{{ title }}</option>{% endfor %}</datalist>
          </label>
          <label class="rd-code"><span class="sr-only">Type</span>
            <select name="code" class="lc-input lc-select" title="Permanent: the page moved for good and search engines switch to the new address. Temporary: the old address will be used again.">
              <option value="301" {{ form.code == 301 ? 'selected' : '' }}>Permanent (301)</option>
              <option value="302" {{ form.code == 302 ? 'selected' : '' }}>Temporary (302)</option>
            </select>
          </label>
          <label class="rd-note"><span class="sr-only">Note</span>
            <input type="text" name="note" value="{{ form.note }}" maxlength="300" placeholder="Note (optional)" class="lc-input">
          </label>
          {% if form.id %}
            <label class="seo-flag rd-on"><input type="checkbox" name="enabled" value="1" {{ form.enabled ? 'checked' : '' }}><span><strong>Turned on</strong></span></label>
          {% endif %}
          <button type="submit" class="ct-create">{{ form.id ? 'Save' : 'Add' }}</button>
          {% if form.id %}<a class="ct-pill" href="{{ url('admin/redirects') }}">Cancel</a>{% endif %}
        </div>
        <p class="seo-help rd-help">The old address is the part after your domain (a pasted full address of this site is fine). Start typing the new one to pick a page, or enter a full address of another website. <strong class="font-medium text-slate-700">Permanent</strong> tells search engines the page moved for good.</p>
      </form>
    </section>

    <details class="tr-add mb-3" {% if import_report %}open{% endif %}>
      <summary>Add many at once</summary>
      <form method="post" action="{{ url('admin/redirects') }}" class="rd-many">
        {{ csrf_field() }}
        <input type="hidden" name="do" value="import">
        <label><span class="rd-many-label">One redirect per line: old address, then new address</span>
          <textarea name="lines" rows="5" class="lc-input font-mono" placeholder="/old-services /en/services&#10;/blog/2019/hello https://example.com/hello 302" spellcheck="false"></textarea>
        </label>
        <p class="tr-note m-0">Separate with a space, a comma, a tab, or <code>-&gt;</code>. Add 301 or 302 at the end to choose the type (default 301). Up to 500 lines. Lines starting with # are ignored.</p>
        <div><button type="submit" class="ct-create">Add these</button></div>
        {% if import_report %}
          <div class="rd-report" role="status">
            <p class="m-0 font-medium text-slate-900">{{ import_report.added }} added{% if import_report.skipped %}, {{ import_report.skipped|length }} skipped{% endif %}.</p>
            {% if import_report.skipped %}
              <ul class="m-0 mt-1 list-none space-y-0.5 p-0 text-xs text-slate-600">
                {% for s in import_report.skipped|slice(0, 20) %}<li>Line {{ s.line }}: <code>{{ s.text }}</code> — {{ messages[s.reason]|default(s.reason) }}</li>{% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      </form>
    </details>

    <div class="rd-tools">
      <form method="get" action="{{ url('admin/redirects') }}" role="search" class="tr-search">
        <span class="sr-only">Search the redirects</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/></svg>
        <input type="search" name="q" value="{{ filters.q }}" placeholder="Search by address or note" class="lc-input" aria-label="Search by address or note">
        {% if filters.origin %}<input type="hidden" name="origin" value="{{ filters.origin }}">{% endif %}
        {% if filters.state %}<input type="hidden" name="state" value="{{ filters.state }}">{% endif %}
      </form>
      <nav class="an-seg" aria-label="Show">
        {% for key, label in {'': 'All', 'unused': 'Never used', 'off': 'Turned off'} %}
          <a href="{{ url('admin/redirects?' ~ {q: filters.q, origin: filters.origin, state: key}|url_encode) }}"{% if filters.state == key %} aria-current="true"{% endif %}>{{ label }}{% if key == 'unused' %} <em>{{ stats.unused }}</em>{% elseif key == 'off' %} <em>{{ off_count }}</em>{% endif %}</a>
        {% endfor %}
      </nav>
      <nav class="an-seg" aria-label="Made by">
        {% for key, label in {'': 'Anyone', 'auto': 'Automatic', 'manual': 'By hand'} %}
          <a href="{{ url('admin/redirects?' ~ {q: filters.q, origin: key, state: filters.state}|url_encode) }}"{% if filters.origin == key %} aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
      </nav>
    </div>

    {% if rows %}
      <form method="post" action="{{ url('admin/redirects') }}" id="bulkForm" data-rd-bulk>
        {{ csrf_field() }}
        <input type="hidden" name="do" value="bulk_delete">
        <section class="lc-card rounded-xl border border-slate-200 bg-white" aria-label="Redirects">
          <div class="rd-head">
            <label class="rd-check"><input type="checkbox" data-rd-all aria-label="Select all on this page"></label>
            <span>{{ total }} {{ total == 1 ? 'redirect' : 'redirects' }}{% if pages > 1 %} · page {{ page }} of {{ pages }}{% endif %}</span>
            <span class="rd-selected" data-rd-selected hidden></span>
            <button type="submit" class="rd-bulk" data-rd-bulk-button data-confirm="Delete the selected redirects?" data-confirm-button="Delete" hidden>Delete selected</button>
          </div>
          <ul class="rd-list">
            {% for r in rows %}
              <li class="rd-row{{ r.enabled ? '' : ' is-off' }}">
                <label class="rd-check"><input type="checkbox" name="ids[]" value="{{ r.id }}" aria-label="Select /{{ r.source }}"></label>
                <div class="rd-paths">
                  <div class="rd-pair">
                    <code class="rd-old">/{{ r.source }}</code>
                    <span class="rd-arrow" aria-hidden="true">→</span>
                    <code class="rd-new">{{ r.target }}</code>
                  </div>
                  <div class="rd-chips">
                    <span class="rd-chip {{ r.status_code == 301 ? 'is-perm' : 'is-temp' }}" title="{{ r.status_code == 301 ? 'The page moved for good' : 'The old address will be used again' }}">{{ r.status_code == 301 ? 'Permanent' : 'Temporary' }}</span>
                    <span class="rd-chip {{ r.origin == 'auto' ? 'is-auto' : '' }}">{{ r.origin == 'auto' ? 'Automatic' : 'By hand' }}</span>
                    {% if not r.enabled %}<span class="rd-chip is-off">Off</span>{% endif %}
                    {% if r.shadowed %}<span class="rd-chip is-warn" title="A page exists at this address, so visitors see the page and this redirect is not used.">Not used: a page exists here</span>{% endif %}
                    {% if r.target_state == 'missing' %}<span class="rd-chip is-bad">Nothing at the new address</span>{% endif %}
                    {% if r.target_state == 'loop' %}<span class="rd-chip is-bad">Loop</span>{% endif %}
                    {% if r.target_state == 'chain' %}<span class="rd-chip is-warn">Continues through another redirect</span>{% endif %}
                    {% if r.target_state == 'external' %}<span class="rd-chip">Another website</span>{% endif %}
                    {% if rows[0].links is not null and r.links %}<a class="rd-chip is-warn" href="{{ url('admin/links?ids=' ~ r.id) }}" title="Review and update the links that still use this address">{{ r.links }} {{ r.links == 1 ? 'link' : 'links' }} to update</a>{% endif %}
                    {% if r.note %}<span class="rd-note-text">{{ r.note }}</span>{% endif %}
                  </div>
                </div>
                <div class="rd-use" title="{{ r.last_hit_at ? 'Last used ' ~ r.last_hit_at|slice(0, 10) : 'Never used' }}"><b>{{ r.hits|number_format }}</b><small>{{ r.hits == 1 ? 'visit' : 'visits' }}{% if r.last_hit_at %} · {{ r.last_hit_at|slice(0, 10) }}{% endif %}</small></div>
                <div class="rd-actions">
                  <a class="ct-pill" href="{{ url('admin/redirects?edit=' ~ r.id) }}#add">Edit<span class="sr-only"> /{{ r.source }}</span></a>
                  <button type="submit" form="rf{{ r.id }}" name="do" value="toggle" class="ct-switch" role="switch" aria-checked="{{ r.enabled ? 'true' : 'false' }}"><i aria-hidden="true"></i><span class="sr-only">{{ r.enabled ? 'Turn off' : 'Turn on' }}<span> /{{ r.source }}</span></span></button>
                  <button type="submit" form="rf{{ r.id }}" name="do" value="delete" class="rd-delete" data-confirm="Delete the redirect from /{{ r.source }}? Visitors using that address will see a Not found page." data-confirm-button="Delete" title="Delete"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6M14 11v6M6 7l1 12a1 1 0 001 1h8a1 1 0 001-1l1-12M9 7V4h6v3"/></svg><span class="sr-only">Delete /{{ r.source }}</span></button>
                </div>
              </li>
            {% endfor %}
          </ul>
        </section>
      </form>
      {% for r in rows %}
        <form id="rf{{ r.id }}" method="post" action="{{ url('admin/redirects') }}" class="hidden">{{ csrf_field() }}<input type="hidden" name="id" value="{{ r.id }}"></form>
      {% endfor %}
      {% if pages > 1 %}
        <nav class="mt-3 flex gap-2" aria-label="Pages">
          {% if page > 1 %}<a class="ct-pill" href="{{ url('admin/redirects?' ~ {q: filters.q, origin: filters.origin, state: filters.state, page: page - 1}|url_encode) }}">Previous</a>{% endif %}
          {% if page < pages %}<a class="ct-pill" href="{{ url('admin/redirects?' ~ {q: filters.q, origin: filters.origin, state: filters.state, page: page + 1}|url_encode) }}">Next</a>{% endif %}
        </nav>
      {% endif %}
    {% else %}
      <div class="rd-empty">
        {% if filters.q or filters.origin or filters.state %}No redirects match these filters.{% else %}No redirects yet. They appear here when you change a page's address, or you can add one above.{% endif %}
      </div>
    {% endif %}
  {% else %}
    <p class="mb-3 text-xs text-slate-500">Addresses visitors asked for that do not exist, most asked first. Broken links from other websites or old bookmarks show up here. Add a redirect to send them somewhere useful, or remove the ones that are only noise (bots probing for files, for example).</p>
    <div class="rd-tools">
      <form method="get" action="{{ url('admin/redirects') }}" role="search" class="tr-search">
        <span class="sr-only">Search the addresses</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/></svg>
        <input type="hidden" name="tab" value="missing">
        <input type="search" name="q" value="{{ filters.q }}" placeholder="Search by address" class="lc-input" aria-label="Search by address">
      </form>
      {% if missing_total > 0 %}
        <form method="post" action="{{ url('admin/redirects?tab=missing') }}" class="ml-auto">
          {{ csrf_field() }}<input type="hidden" name="do" value="missing_clear">
          <button type="submit" class="rd-bulk is-visible" data-confirm="Clear the whole list? It fills up again as visitors hit missing addresses." data-confirm-button="Clear">Clear the list</button>
        </form>
      {% endif %}
    </div>
    {% if missing %}
      <section class="lc-card rounded-xl border border-slate-200 bg-white" aria-label="Addresses not found">
        <ul class="rd-list">
          {% for m in missing %}
            <li class="rd-row is-missing">
              <div class="rd-paths">
                <div class="rd-pair"><code class="rd-old">/{{ m.path }}</code></div>
                <div class="rd-chips">
                  {% if m.suggestion %}<span class="rd-note-text">Looks like <code>{{ m.suggestion }}</code>?</span>{% endif %}
                  <span class="rd-note-text">{% if m.last_referrer %}Came from {{ m.last_referrer }}{% else %}No page sent them{% endif %}</span>
                </div>
              </div>
              <div class="rd-use"><b>{{ m.hits|number_format }}</b><small>{{ m.hits == 1 ? 'time' : 'times' }} · {{ m.last_seen_at|slice(0, 10) }}</small></div>
              <div class="rd-actions">
                <a class="ct-pill rd-create" href="{{ url('admin/redirects?' ~ {source: m.path, target: m.suggestion}|url_encode) }}#add">Create redirect<span class="sr-only"> from /{{ m.path }}</span></a>
                <form method="post" action="{{ url('admin/redirects?tab=missing') }}" class="m-0">
                  {{ csrf_field() }}<input type="hidden" name="do" value="missing_delete"><input type="hidden" name="path" value="{{ m.path }}">
                  <button type="submit" class="ct-pill cursor-pointer">Ignore<span class="sr-only"> /{{ m.path }}</span></button>
                </form>
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <div class="rd-empty">Nothing here. Addresses that visitors could not find will be listed as they happen.</div>
    {% endif %}
  {% endif %}
  <script src="{{ asset('js/admin-redirects.js') }}" defer></script>
{% endblock %}
