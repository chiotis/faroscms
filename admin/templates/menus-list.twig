{% extends '@admin/base.twig' %}

{% block content %}
  {% set action_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set icon_btn = 'inline-flex items-center justify-center rounded-md p-1.5 text-slate-400 no-underline hover:bg-slate-100 hover:text-slate-700' %}

  <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-slate-900">Menus</h1>
      <p class="mt-1 text-sm text-slate-500">Manage navigation menus and multilingual labels.</p>
    </div>
    <a class="{{ action_btn }}" href="{{ url('admin/menus-new') }}">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
      </svg>
      New menu
    </a>
  </header>

  {% if saved %}
    <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>Menu saved.</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}
  {% if created %}
    <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>Menu created.</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}
  {% if deleted %}
    <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>Menu deleted.</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}

  <section class="rounded-lg border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-2.5">
      <span class="text-sm font-medium text-slate-700">{{ rows|length }} {{ rows|length == 1 ? 'menu' : 'menus' }}</span>
    </div>

    {% if rows is empty %}
      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
          </svg>
        </div>
        <h2 class="mt-3 text-sm font-semibold text-slate-900">No menus yet</h2>
        <p class="mt-1 max-w-sm text-sm text-slate-400">Create a menu to control site navigation.</p>
        <a class="{{ action_btn }} mt-4" href="{{ url('admin/menus-new') }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
          </svg>
          New menu
        </a>
      </div>
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium" data-sort="text">Title</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Key</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Updated</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for row in rows %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5">
                  <a href="{{ url('admin/menus-edit?key=' ~ row.key) }}" class="font-medium text-slate-900 no-underline hover:text-blue-600">{{ row.title }}</a>
                </td>
                <td class="px-4 py-2.5">
                  <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{ row.key }}</code>
                </td>
                <td class="px-4 py-2.5 text-slate-500">{{ row.updated ?: 'Never' }}</td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center justify-end">
                    <a class="{{ icon_btn }}" href="{{ url('admin/menus-edit?key=' ~ row.key) }}" title="Edit {{ row.title }}" aria-label="Edit {{ row.title }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/>
                      </svg>
                    </a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
{% endblock %}
