{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Menus</h1> <p class="mt-1 text-sm text-slate-500">Manage menu definitions and multilingual labels in one place.</p> </div> <div class="actions mt-1 flex flex-wrap items-center gap-2"> <a class="{{ btn }}" href="{{ url('admin/menus-new') }}">+ New Menu</a> </div> </header> {% if saved %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu saved.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if created %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu created.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if deleted %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu deleted.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} <div class="table overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm w-full"> {% if rows is empty %} <div class="row empty p-5 text-sm text-slate-500">No menus yet.</div> {% else %} <table class="list-table min-w-full table-auto border-collapse text-sm"> <thead> <tr> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Key</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Title</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Updated</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-right font-semibold text-slate-700"></th> </tr> </thead> <tbody> {% for row in rows %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900">{{ row.key }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900">{{ row.title }}</td> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900">{{ row.updated }}</td> <td class="table-actions border-b border-slate-200 px-4 py-3 text-right align-top whitespace-nowrap"> <a class="{{ btn }}" href="{{ url('admin/menus-edit?key=' ~ row.key) }}">Edit</a> </td> </tr> {% endfor %} </tbody> </table> {% endif %} </div>
{% endblock %}
