<!doctype html>
<html lang="en"{% for name, value in attributes %} {{ name }}="{{ value }}"{% endfor %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Buttons and links</title>
  <link rel="stylesheet" href="{{ theme_asset('css/site.css') }}">
  <style>
    /* Only the specimen's arrangement. The two panels carry the tokens of light and of dark, so both show whatever the page's mode is. */
    .spec { display: grid; gap: var(--space-m); padding: var(--space-m) 0; }
    @media (min-width: 900px) { .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .spec-panel { display: grid; gap: var(--space-s); padding: var(--space-m); border: 1px solid var(--color-border); border-radius: var(--radius-m); background: var(--color-bg); color: var(--color-text); }
    .spec-panel h2 { margin: 0; font-size: var(--step-1); }
    .spec-grid { display: grid; grid-template-columns: auto repeat(4, minmax(0, auto)); gap: var(--space-xs) var(--space-s); align-items: center; justify-content: start; }
    .spec-grid > span:not(.spec-head) { font-size: var(--step--1); color: var(--color-muted); }
    .spec-head { font-size: var(--step--2); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--color-muted); }
    @media (max-width: 640px) { .spec-grid { grid-template-columns: repeat(2, minmax(0, auto)); } .spec-head, .spec-grid > span:not(.spec-head) { grid-column: 1 / -1; } }
    .mode-light {
      color-scheme: light;
      --color-bg: var(--n-bg); --color-surface: var(--n-surface); --color-surface-2: var(--n-surface-2); --color-text: var(--n-text); --color-muted: var(--n-muted);
      --color-border: var(--n-border); --color-border-strong: var(--n-border-strong);
      --accent: var(--accent-l); --accent-hover: var(--accent-l-hover); --accent-soft: var(--accent-l-soft); --accent-contrast: var(--accent-contrast-l); --color-focus: var(--accent-l);
    }
    .mode-dark {
      color-scheme: dark;
      --color-bg: var(--d-bg); --color-surface: var(--d-surface); --color-surface-2: var(--d-surface-2); --color-text: var(--d-text); --color-muted: var(--d-muted);
      --color-border: var(--d-border); --color-border-strong: var(--d-border-strong);
      --accent: var(--accent-d); --accent-hover: var(--accent-d-hover); --accent-soft: var(--accent-d-soft); --accent-contrast: var(--accent-contrast-d); --color-focus: var(--accent-d);
    }
  </style>
  <style id="faros-branding">{{ branding_css()|raw }}</style>
  {% set custom_css = custom_asset('css/custom.css') %}
  {% if custom_css %}<link rel="stylesheet" href="{{ custom_css }}">{% endif %}
</head>
<body class="theme-body">
  <main class="container">
    <div class="spec">
      {% for mode in ['light', 'dark'] %}
        <section class="spec-panel mode-{{ mode }}" aria-label="{{ mode == 'light' ? 'Light mode' : 'Dark mode' }}">
          <h2>{{ mode == 'light' ? 'Light' : 'Dark' }}</h2>
          <div class="spec-grid">
            <span class="spec-head" aria-hidden="true"></span>
            <span class="spec-head">Normal</span><span class="spec-head">Hover</span><span class="spec-head">Focus</span><span class="spec-head">Disabled</span>
            {% for style in [['btn-primary', 'Primary'], ['btn-secondary', 'Secondary'], ['btn-text', 'Text']] %}
              <span>{{ style[1] }}</span>
              <button type="button" class="btn {{ style[0] }}">{{ style[1] }}</button>
              <button type="button" class="btn {{ style[0] }}" data-state="hover" tabindex="-1">{{ style[1] }}</button>
              <button type="button" class="btn {{ style[0] }}" data-state="focus" tabindex="-1">{{ style[1] }}</button>
              <button type="button" class="btn {{ style[0] }}" disabled>{{ style[1] }}</button>
            {% endfor %}
          </div>
          <div class="prose">
            <p>Good links are easy to spot: <a href="about:srcdoc#links">a text link</a> inside a sentence, and <a href="about:srcdoc#links">another one</a> to hover.</p>
          </div>
        </section>
      {% endfor %}
    </div>
  </main>
</body>
</html>
