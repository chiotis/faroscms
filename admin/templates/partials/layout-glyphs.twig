{#
  The small pictures of the layout cards (Theme > Single Layouts and Archive Layouts): one for each style of title area and
  each layout of a list. They are drawn in the colour of the text, so they follow the state of the tile they are in.
    {{ glyphs.title('split') }}    {{ glyphs.archive('cards') }}    {{ glyphs.header('split') }}    {{ glyphs.footer('mega') }}
#}
{% macro title(name) %}
  <svg class="h-6 w-9" viewBox="0 0 36 24" fill="currentColor" aria-hidden="true">
    <rect x=".75" y=".75" width="34.5" height="22.5" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.5"/>
    {% if name == 'centered' %}
      <rect x="2.5" y="2.5" width="31" height="13" rx="1.5" fill-opacity=".14"/>
      <rect x="11" y="4.5" width="14" height="2" rx="1"/><rect x="13.5" y="7.6" width="9" height="1.5" rx=".75" fill-opacity=".5"/>
      <rect x="10" y="10.8" width="16" height="3" rx="1" fill-opacity=".45"/>
      <rect x="5" y="18" width="26" height="1.5" rx=".75" fill-opacity=".35"/>
    {% elseif name == 'split' %}
      <rect x="2.5" y="2.5" width="31" height="10" rx="1.5" fill-opacity=".14"/>
      <rect x="5" y="4.8" width="12" height="2" rx="1"/><rect x="5" y="8.2" width="8" height="1.5" rx=".75" fill-opacity=".5"/>
      <rect x="21" y="4.2" width="10" height="6" rx="1" fill-opacity=".45"/>
      <rect x="5" y="15.5" width="26" height="1.5" rx=".75" fill-opacity=".35"/><rect x="5" y="19" width="20" height="1.5" rx=".75" fill-opacity=".35"/>
    {% elseif name == 'cover' %}
      <rect x="2.5" y="2.5" width="31" height="12" rx="1.5" fill-opacity=".6"/>
      <rect x="5" y="5.6" width="13" height="2" rx="1" fill="#fff"/><rect x="5" y="9" width="8" height="1.5" rx=".75" fill="#fff" fill-opacity=".7"/>
      <rect x="5" y="17.5" width="26" height="1.5" rx=".75" fill-opacity=".35"/>
    {% elseif name == 'minimal' %}
      <rect x="5" y="4.5" width="19" height="3.2" rx="1.6"/>
      <rect x="5" y="12" width="26" height="1.5" rx=".75" fill-opacity=".35"/><rect x="5" y="15.5" width="26" height="1.5" rx=".75" fill-opacity=".35"/><rect x="5" y="19" width="16" height="1.5" rx=".75" fill-opacity=".35"/>
    {% else %}
      <rect x="2.5" y="2.5" width="31" height="9" rx="1.5" fill-opacity=".14"/>
      <rect x="5" y="4.6" width="12" height="2" rx="1"/><rect x="5" y="8" width="8" height="1.5" rx=".75" fill-opacity=".5"/>
      <rect x="5" y="15" width="26" height="1.5" rx=".75" fill-opacity=".35"/><rect x="5" y="18.5" width="20" height="1.5" rx=".75" fill-opacity=".35"/>
    {% endif %}
  </svg>
{% endmacro %}

{% macro archive(name) %}
  <svg class="h-6 w-9" viewBox="0 0 36 24" fill="currentColor" aria-hidden="true">
    <rect x=".75" y=".75" width="34.5" height="22.5" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.5"/>
    {% if name == 'list' %}
      {% for y in [5, 10, 15, 20] %}<rect x="5" y="{{ y - 1 }}" width="2" height="2" rx="1"/><rect x="9" y="{{ y - 0.75 }}" width="22" height="1.5" rx=".75" fill-opacity=".45"/>{% endfor %}
    {% elseif name == 'compact' %}
      {% for y in [4, 10, 16] %}<rect x="4" y="{{ y }}" width="6" height="5" rx="1" fill-opacity=".45"/><rect x="12" y="{{ y + 0.5 }}" width="19" height="1.5" rx=".75"/><rect x="12" y="{{ y + 3 }}" width="13" height="1.2" rx=".6" fill-opacity=".4"/>{% endfor %}
    {% elseif name == 'overlay' %}
      {% for x in [3, 19] %}{% for y in [3, 12.5] %}<rect x="{{ x }}" y="{{ y }}" width="14" height="8.5" rx="1.5" fill-opacity=".45"/><rect x="{{ x + 2 }}" y="{{ y + 5.4 }}" width="8" height="1.5" rx=".75" fill="#fff"/>{% endfor %}{% endfor %}
    {% elseif name == 'featured' %}
      <rect x="3" y="3" width="17" height="18" rx="1.5" fill-opacity=".45"/>
      {% for y in [4, 10, 16] %}<rect x="23" y="{{ y }}" width="10" height="1.5" rx=".75"/><rect x="23" y="{{ y + 2.6 }}" width="7" height="1.2" rx=".6" fill-opacity=".4"/>{% endfor %}
    {% elseif name == 'magazine' %}
      <rect x="3" y="3" width="20" height="11" rx="1.5" fill-opacity=".45"/>
      <rect x="25" y="3" width="8" height="5" rx="1" fill-opacity=".3"/><rect x="25" y="9.2" width="8" height="4.8" rx="1" fill-opacity=".3"/>
      {% for x in [3, 14, 25] %}<rect x="{{ x }}" y="16.5" width="8" height="4.5" rx="1" fill-opacity=".3"/>{% endfor %}
    {% elseif name == 'map' %}
      <rect x="3" y="3" width="19" height="18" rx="1.5" fill-opacity=".16"/>
      <path d="M5 17 10 11l4 3 6-8" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="10" cy="11" r="1.8"/><circle cx="17" cy="8" r="1.8"/>
      {% for y in [3.5, 9.5, 15.5] %}<rect x="24.5" y="{{ y }}" width="8.5" height="5" rx="1" fill-opacity=".4"/>{% endfor %}
    {% elseif name == 'editorial' %}
      <rect x="3" y="3" width="13" height="18" rx="1.5" fill-opacity=".45"/>
      <rect x="19" y="4" width="12" height="2" rx="1"/>
      {% for y in [8, 11.5, 15, 18.5] %}<rect x="19" y="{{ y }}" width="14" height="1.2" rx=".6" fill-opacity=".4"/>{% endfor %}
    {% else %}
      {% for x in [3, 13.5, 24] %}<rect x="{{ x }}" y="3.5" width="9" height="17" rx="1.5" fill-opacity=".12"/><rect x="{{ x + 1 }}" y="4.5" width="7" height="6" rx="1" fill-opacity=".45"/><rect x="{{ x + 1 }}" y="12.5" width="6" height="1.5" rx=".75"/><rect x="{{ x + 1 }}" y="15.5" width="7" height="1.2" rx=".6" fill-opacity=".4"/>{% endfor %}
    {% endif %}
  </svg>
{% endmacro %}

{# A header, as a bar at the top of a page: brand (a bold bar), menu (small bars), tools (dots), button (a block). #}
{% macro header(name) %}
  <svg class="h-6 w-9" viewBox="0 0 36 24" fill="currentColor" aria-hidden="true">
    <rect x=".75" y=".75" width="34.5" height="22.5" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.5"/>
    {% if name == 'menu_left' %}
      <rect x="4" y="5" width="6" height="2.4" rx="1.2"/><rect x="13" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="18" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="23" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><circle cx="30.5" cy="6.2" r="1.3" fill-opacity=".5"/>
    {% elseif name == 'split' %}
      <rect x="4" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="9" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="15" y="5" width="6" height="2.4" rx="1.2"/><circle cx="26.5" cy="6.2" r="1.3" fill-opacity=".5"/><rect x="29" y="4.8" width="3.5" height="2.8" rx="1" fill-opacity=".7"/>
    {% elseif name == 'centered' %}
      <rect x="15" y="4" width="6" height="2.4" rx="1.2"/><circle cx="31" cy="5.2" r="1.3" fill-opacity=".5"/>
      <rect x="2.5" y="9.5" width="31" height=".8" fill-opacity=".3"/><rect x="9" y="12" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="14" y="12" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="19" y="12" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="24" y="12" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/>
    {% elseif name == 'stacked' %}
      <rect x="4" y="4" width="6" height="2.4" rx="1.2"/><circle cx="29" cy="5.2" r="1.3" fill-opacity=".5"/><rect x="31" y="4" width="2" height="2.4" rx="1" fill-opacity=".7"/>
      <rect x="2.5" y="9" width="31" height="5" fill-opacity=".16"/><rect x="5" y="10.8" width="3.5" height="1.6" rx=".8" fill-opacity=".6"/><rect x="10" y="10.8" width="3.5" height="1.6" rx=".8" fill-opacity=".6"/><rect x="15" y="10.8" width="3.5" height="1.6" rx=".8" fill-opacity=".6"/>
    {% elseif name == 'minimal' %}
      <rect x="4" y="5" width="6" height="2.4" rx="1.2"/><rect x="27" y="4.6" width="5" height="0.9" rx=".45"/><rect x="27" y="6.3" width="5" height="0.9" rx=".45"/><rect x="27" y="8" width="5" height="0.9" rx=".45"/>
    {% elseif name == 'minimal_center' %}
      <rect x="4" y="4.6" width="5" height="0.9" rx=".45"/><rect x="4" y="6.3" width="5" height="0.9" rx=".45"/><rect x="4" y="8" width="5" height="0.9" rx=".45"/><rect x="15" y="5" width="6" height="2.4" rx="1.2"/><circle cx="30.5" cy="6.2" r="1.3" fill-opacity=".5"/>
    {% else %}
      <rect x="4" y="5" width="6" height="2.4" rx="1.2"/><rect x="16" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="21" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="26" y="5.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><circle cx="32" cy="6.2" r="1.1" fill-opacity=".5"/>
    {% endif %}
    <rect x="4" y="{{ name in ['centered', 'stacked'] ? 17 : 12 }}" width="28" height="1.5" rx=".75" fill-opacity=".25"/><rect x="4" y="{{ name in ['centered', 'stacked'] ? 20 : 15.5 }}" width="20" height="1.5" rx=".75" fill-opacity=".25"/>
  </svg>
{% endmacro %}

{# A footer, as the bottom of a page: brand, columns of links, the line at the very bottom. #}
{% macro footer(name) %}
  <svg class="h-6 w-9" viewBox="0 0 36 24" fill="currentColor" aria-hidden="true">
    <rect x=".75" y=".75" width="34.5" height="22.5" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.5"/>
    {% if name == 'mega' %}
      <rect x="4" y="5" width="6" height="2.4" rx="1.2"/><rect x="4" y="9" width="7" height="1.2" rx=".6" fill-opacity=".4"/>
      {% for x in [14, 20, 26, 32] %}<rect x="{{ x }}" y="4.6" width="3.4" height="1.2" rx=".6"/><rect x="{{ x }}" y="8" width="3.4" height="1" rx=".5" fill-opacity=".4"/><rect x="{{ x }}" y="10.6" width="3.4" height="1" rx=".5" fill-opacity=".4"/><rect x="{{ x }}" y="13.2" width="3.4" height="1" rx=".5" fill-opacity=".4"/>{% endfor %}
    {% elseif name == 'simple' %}
      <rect x="4" y="6" width="6" height="2.4" rx="1.2"/><rect x="16" y="6.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="21" y="6.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="26" y="6.4" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/>
    {% elseif name == 'bar' %}
      <rect x="4" y="9" width="9" height="1.6" rx=".8" fill-opacity=".5"/><rect x="17" y="9" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="22" y="9" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><circle cx="30.5" cy="9.8" r="1.3" fill-opacity=".5"/>
    {% elseif name == 'centered' %}
      <rect x="15" y="4" width="6" height="2.4" rx="1.2"/><rect x="12" y="8" width="12" height="1.2" rx=".6" fill-opacity=".4"/>
      <rect x="9" y="11.5" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="14" y="11.5" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="19" y="11.5" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/><rect x="24" y="11.5" width="3.5" height="1.6" rx=".8" fill-opacity=".5"/>
    {% else %}
      <rect x="4" y="5" width="6" height="2.4" rx="1.2"/><rect x="4" y="9" width="9" height="1.2" rx=".6" fill-opacity=".4"/>
      {% for x in [18, 26] %}<rect x="{{ x }}" y="4.6" width="5" height="1.2" rx=".6"/><rect x="{{ x }}" y="8" width="6" height="1" rx=".5" fill-opacity=".4"/><rect x="{{ x }}" y="10.6" width="6" height="1" rx=".5" fill-opacity=".4"/><rect x="{{ x }}" y="13.2" width="6" height="1" rx=".5" fill-opacity=".4"/>{% endfor %}
    {% endif %}
    <rect x="2.5" y="17.6" width="31" height=".8" fill-opacity=".3"/><rect x="4" y="19.6" width="10" height="1.2" rx=".6" fill-opacity=".4"/><circle cx="31" cy="20.2" r="1.1" fill-opacity=".4"/>
  </svg>
{% endmacro %}
