{#
  The real site beside the settings, in a frame (Theme > Branding, Header, Footer). admin-preview.js keeps it in step with the
  choices that are not saved yet. It needs the address of the page to show (preview_url; without one the frame starts empty and the
  script draws it, as the content editor does with preview_title and preview_note for its own texts).
#}
<aside class="bp-preview" aria-label="Preview">
  {% if branding_samples_url|default('') %}
    <div class="lc-seg" role="radiogroup" aria-label="Preview content">
      <label><input type="radio" name="bp_view_branding" value="site" checked data-bp-view><span>Site</span></label>
      <label><input type="radio" name="bp_view_branding" value="styles" data-bp-view data-url="{{ branding_samples_url }}"><span>Style samples</span></label>
      {% if branding_specimen_url|default('') %}<label><input type="radio" name="bp_view_branding" value="specimen" data-bp-view data-url="{{ branding_specimen_url }}" data-title="Buttons and links"><span>Buttons and links</span></label>{% endif %}
    </div>
  {% endif %}
  <div class="bp-bar">
    <div class="lc-seg" role="radiogroup" aria-label="Size of the preview">
      <label><input type="radio" name="bp_size_{{ preview_key|default('entry') }}" value="1280" checked data-bp-size><span>Computer</span></label>
      <label><input type="radio" name="bp_size_{{ preview_key|default('entry') }}" value="820" data-bp-size><span>Tablet</span></label>
      <label><input type="radio" name="bp_size_{{ preview_key|default('entry') }}" value="390" data-bp-size><span>Phone</span></label>
    </div>
    <div class="lc-seg" role="radiogroup" aria-label="Colour mode of the preview">
      <label><input type="radio" name="bp_mode_{{ preview_key|default('entry') }}" value="" checked data-bp-mode><span>Auto</span></label>
      <label><input type="radio" name="bp_mode_{{ preview_key|default('entry') }}" value="light" data-bp-mode><span>Light</span></label>
      <label><input type="radio" name="bp_mode_{{ preview_key|default('entry') }}" value="dark" data-bp-mode><span>Dark</span></label>
    </div>
    <button type="button" class="bp-reload" data-bp-reload>Reload</button>
  </div>
  <div class="bp-stage" data-bp-stage>
    <iframe class="bp-frame" data-bp-frame{% if preview_url|default('') %} src="{{ preview_url }}" loading="lazy"{% endif %} title="{{ preview_title|default('Preview of the site') }}"></iframe>
  </div>
  <p class="bp-note">{{ preview_note|default(branding_samples_url|default('') ? 'Preview the site or a sample of its headings, text, buttons, cards and form fields with your unsaved choices.' : 'The real site, with your unsaved choices. Links inside it work; the choices stay while you look around.') }}</p>
</aside>
