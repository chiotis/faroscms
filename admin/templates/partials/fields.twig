{#
  Form controls for FieldSchema definitions (theme settings and content type fields).
  field: a normalized definition from FieldSchema::normalize(); name: the input name; value: current value.
#}
{% macro field(field, name, value) %}
  {% set control = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
  {% set span = field.span == 'full' ? ' col-span-full' : '' %}
  {% if field.type == 'toggle' %}
    <label class="flex items-start justify-between gap-4 rounded-md border border-slate-100 px-3 py-2.5{{ span }}">
      <span>
        <span class="block text-sm font-medium text-slate-800">{{ field.label }}</span>
        {% if field.help %}<span class="block text-xs text-slate-400">{{ field.help }}</span>{% endif %}
      </span>
      <input type="checkbox" name="{{ name }}" value="1" {% if value %}checked{% endif %} class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
    </label>
  {% else %}
    <label class="block{{ span }}">
      <span class="mb-1 block text-sm font-medium text-slate-700">{{ field.label }}</span>
      {% if field.type == 'select' %}
        <select name="{{ name }}" class="{{ control }}">
          {% for option_value, option_label in field.options %}
            <option value="{{ option_value }}" {% if value ~ '' == option_value ~ '' %}selected{% endif %}>{{ option_label }}</option>
          {% endfor %}
        </select>
      {% elseif field.type == 'textarea' %}
        <textarea name="{{ name }}" rows="3" placeholder="{{ field.placeholder }}" class="{{ control }}">{{ value }}</textarea>
      {% elseif field.type == 'markdown' %}
        <textarea name="{{ name }}" rows="6" placeholder="{{ field.placeholder }}" class="{{ control }}">{{ value }}</textarea>
      {% elseif field.type == 'date' %}
        <input type="date" name="{{ name }}" value="{{ value }}" class="{{ control }}">
      {% elseif field.type == 'decimal' %}
        <input type="number" step="any" name="{{ name }}" value="{{ value }}"{% if field.min is not null %} min="{{ field.min }}"{% endif %}{% if field.max is not null %} max="{{ field.max }}"{% endif %} placeholder="{{ field.placeholder }}" class="{{ control }}">
      {% elseif field.type == 'number' %}
        <input type="number" name="{{ name }}" value="{{ value }}"{% if field.min is not null %} min="{{ field.min }}"{% endif %}{% if field.max is not null %} max="{{ field.max }}"{% endif %} placeholder="{{ field.placeholder }}" class="{{ control }}">
      {% elseif field.type == 'color' %}
        <span class="flex items-center gap-2">
          <span class="h-8 w-8 shrink-0 rounded-md border border-slate-200" style="background: {{ value ?: 'transparent' }};" aria-hidden="true"></span>
          <input type="text" name="{{ name }}" value="{{ value }}" placeholder="{{ field.placeholder }}" class="{{ control }}">
        </span>
      {% else %}
        <input type="{{ field.type == 'email' ? 'email' : 'text' }}" name="{{ name }}" value="{{ value }}" placeholder="{{ field.placeholder }}" class="{{ control }}">
      {% endif %}
      {% if field.help %}<span class="mt-1 block text-xs text-slate-400">{{ field.help }}</span>{% endif %}
    </label>
  {% endif %}
{% endmacro %}
