{#
  Theme > Branding > Typography: the overrides of H1, H2, H3, the lead paragraph and small text (a step of the scale, weight, line
  height, letter spacing) and the weight and paragraph spacing of text. H4 to H6 follow the scale. Included by theme-branding.twig,
  which has d (the schema of design), vd (its values) and pd (the field name prefix). BrandingTypography.php makes the CSS.
#}
{% import '@admin/partials/layout-controls.twig' as c %}
{% set rows = [['h1', 'H1'], ['h2', 'H2'], ['h3', 'H3'], ['lead', 'Lead'], ['small', 'Small']] %}
{% set columns = [['step', 'Size'], ['weight', 'Weight'], ['leading', 'Line'], ['tracking', 'Spacing']] %}
<details class="bp-sub">
  <summary>Sizes per element <small>H1, H2, H3, lead, small</small></summary>
  <table class="bp-colours bp-matrix">
    <caption class="sr-only">Overrides for headings, the lead paragraph and small text. Theme keeps the design of the theme. The size is a step of the type scale, so it stays fluid; H4 to H6 follow the scale.</caption>
    <thead><tr><th scope="col"><span class="sr-only">Element</span></th>{% for col in columns %}<th scope="col">{{ col[1] }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for row in rows %}
        <tr>
          <th scope="row">{{ row[1] }}</th>
          {% for col in columns %}
            {% set key = row[0] ~ '_' ~ col[0] %}
            <td>
              {% if d[key] is defined %}
                <select name="{{ pd ~ key }}]" class="lc-input lc-select" aria-label="{{ d[key].label }}">
                  {% for option, text in d[key].options %}<option value="{{ option }}"{% if option ~ '' == vd[key] ~ '' %} selected{% endif %}>{{ option == 'auto' ? 'Theme' : (col[0] == 'step' ? option : text) }}</option>{% endfor %}
                </select>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="m-0 mt-1 text-[11px] leading-4 text-slate-500">Size is a step of the scale (5 largest, 0 the text), so it stays fluid and follows the Text size and Heading scale above. Headings 4 to 6 follow the scale.</p>
</details>
<dl class="m-0 space-y-2.5">
  {% for key in ['body_weight', 'paragraph_space'] %}
    {% if d[key] is defined %}{{ c.choice(d[key], pd ~ key ~ ']', vd[key], 'select', {}) }}{% endif %}
  {% endfor %}
</dl>
