                  <input type="text" name="form_fields[field_0][placeholder]" placeholder="Placeholder" class="{{ input_class }}">
                  <input type="text" name="form_fields[field_0][options]" placeholder="Option 1, Option 2" class="{{ input_class }}">
                  <input type="text" name="form_fields[field_0][default]" placeholder="Default value" class="{{ input_class }}">
