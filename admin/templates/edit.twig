{% extends '@admin/base.twig' %}
{% set page_heading = 'Edit ' ~ (type ends with 's' ? type|slice(0, -1) : type)|title %}

{% block content %}
  {% set singular = type ends with 's' ? type|slice(0, -1) : type %}
  {% set card = 'lc-card en-card' %}
  {% set tab_class = 'tab-button shrink-0 border-b-2 border-transparent px-3 py-2 text-sm font-medium text-slate-500 transition hover:text-slate-800' %}
  {% set primary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set secondary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set danger_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm transition hover:bg-red-50' %}
  {% set icon_button_class = 'rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700' %}
  {% set is_home = slug and type == 'pages' and slug == site.home_page and lang == site.languages.default %}

  {% if saved and not restored %}
    <template data-flash data-type="success">Saved.</template>
  {% endif %}
  {% if restored %}
    <template data-flash data-type="success">Version restored. The text it replaced is kept in the history.</template>
  {% endif %}
  {% if deleted %}
    <template data-flash data-type="success">Deleted.</template>
  {% endif %}
  {% if address_changed %}
    <template data-flash data-type="success">Address changed. The old address now leads here.</template>
  {% endif %}
  {% if front_matter_error %}
    <div class="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900" role="alert">
      <strong class="font-semibold">The front matter of this file cannot be read.</strong>
      Until it is fixed the page is treated as a draft and is not shown on the site. Correct the YAML in the <em>Advanced</em> tab and save.
      <span class="mt-1 block font-mono text-xs text-red-800">{{ front_matter_error }}</span>
    </div>
  {% endif %}
  {% if link_fix %}
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="status">
      <span>{{ link_fix.count }} {{ link_fix.count == 1 ? 'link' : 'links' }} in other content still {{ link_fix.count == 1 ? 'uses' : 'use' }} the old address. {{ link_fix.count == 1 ? 'It works' : 'They work' }} through the redirect, but pointing {{ link_fix.count == 1 ? 'it' : 'them' }} at the new address is better.</span>
      <a class="font-semibold text-amber-900 underline" href="{{ url('admin/links?ids=' ~ link_fix.ids) }}">Review and update</a>
    </div>
  {% endif %}
  {% if address_taken %}
    <template data-flash data-type="warning">The address "{{ address_taken }}" is already used or reserved, so "{{ slug }}" was used instead.</template>
  {% endif %}
  {% if notice == 'storage' %}
    <template data-flash data-type="warning">Saved, but the picture you uploaded was not stored: the storage limit is reached. Delete files you no longer need, or ask the super admin to raise the limit.</template>
  {% endif %}
  {% if notice == 'html' %}
    <template data-flash data-type="warning">Saved. Raw HTML is only available to administrators, so the HTML you typed is shown as plain text. Use Markdown for formatting.</template>
  {% endif %}

  <form method="post" action="{{ url('admin/save') }}" class="editor space-y-3" enctype="multipart/form-data">
    {{ csrf_field() }}
    <input type="hidden" name="type" value="{{ type }}">
    <input type="hidden" name="translation_id" value="{{ meta_form.translation_id }}">
    <input type="hidden" name="original_slug" value="{{ slug }}">
    <input type="hidden" name="original_lang" value="{{ lang }}">

    <header class="en-head">
      <p class="en-crumb">
        <a href="{{ url('admin/content?type=' ~ type) }}">{{ type_definition.label|default(type|title) }}</a>
        <span aria-hidden="true">/</span>
        <strong>{{ meta_form.title ?: title_from_slug }}</strong>
        <span class="en-chip">{{ lang }}</span>
        <span class="en-chip {{ meta_form.status == 'draft' ? 'is-draft' : 'is-live' }}" data-status-pill>{{ meta_form.status == 'draft' ? 'Draft' : 'Published' }}</span>
        <span data-nonindex-pill class="en-chip is-noindex{% if not meta_form.seo_noindex %} hidden{% endif %}">Non-indexed</span>
      </p>
    </header>

    <div class="en-tabs" role="tablist">
      <button type="button" class="{{ tab_class }} active" role="tab" data-tab="basics">Content</button>
      {% if type_fields is not empty %}
        <button type="button" class="{{ tab_class }}" role="tab" data-tab="details">{{ type_definition.singular }} details</button>
      {% endif %}
      {% if block_editor_json %}
        <button type="button" class="{{ tab_class }}" role="tab" data-tab="blocks">Blocks <span data-block-count class="tab-count"></span></button>
      {% endif %}
      <button type="button" class="{{ tab_class }}" role="tab" data-tab="media">Media</button>
      {% if type != 'pages' %}
        <button type="button" class="{{ tab_class }}" role="tab" data-tab="taxonomies">Taxonomies</button>
        <button type="button" class="{{ tab_class }}" role="tab" data-tab="custom">Custom Fields</button>
      {% endif %}
      <button type="button" class="{{ tab_class }}" role="tab" data-tab="seo">SEO</button>
      <button type="button" class="{{ tab_class }}" role="tab" data-tab="translations">Translations</button>
      {% if address.exists %}
        <button type="button" class="{{ tab_class }}" role="tab" data-tab="history">History{% if history_total %} <span class="tab-count">{{ history_total }}</span>{% endif %}</button>
      {% endif %}
      <button type="button" class="{{ tab_class }}" role="tab" data-tab="advanced">Advanced</button>
    </div>

    <div class="tab-panel active en-grid" data-panel="basics">
      <div class="en-main">
        <section class="{{ card }}">
          <label class="sr-only" for="en-title">Title</label>
          <input id="en-title" type="text" name="title" value="{{ meta_form.title }}" placeholder="Title" class="en-title" autocomplete="off">
          <div class="en-address" data-address>
            <span class="en-address-label" id="addressLabel">Web address</span>
            {% if not address.exists %}
              {# New content: the address is made from the title. A new translation keeps the address it inherits. #}
              <input type="hidden" name="slug" value="{{ slug }}" data-address-value>
              <p class="en-address-line" aria-labelledby="addressLabel"><span class="text-slate-400">{{ address.prefix }}</span><strong data-address-preview data-fixed="{{ slug ? '1' : '0' }}">{{ slug ?: '…' }}</strong></p>
              <p class="en-help">{% if slug %}Same address as the other languages.{% else %}Made from the title when you save, with Greek letters converted to Latin. You can change it afterwards.{% endif %}</p>
            {% elseif address.locked %}
              <input type="hidden" name="slug" value="{{ slug }}">
              <p class="en-address-line" aria-labelledby="addressLabel"><span class="text-slate-400">{{ address.prefix }}</span><strong>{{ slug }}</strong></p>
              <p class="en-help">The home page keeps its address. Choose another home page in Settings if you want a different one.</p>
            {% else %}
              <div class="en-address-row">
                <p class="en-address-line" aria-labelledby="addressLabel"><span class="text-slate-400">{{ address.prefix }}</span><strong data-address-current>{{ slug }}</strong></p>
                <button type="button" class="en-link" data-address-edit aria-expanded="false" aria-controls="addressPanel">Change</button>
              </div>
              <div id="addressPanel" class="en-address-panel hidden" data-address-panel>
                <label class="block">
                  <span class="en-address-label">New address</span>
                  <input type="text" name="slug" value="{{ slug }}" class="lc-input" data-address-value data-original="{{ slug }}" autocomplete="off" spellcheck="false">
                </label>
                <p class="en-help">Letters, numbers, and dashes. Greek letters are converted to Latin. The old address keeps working: visitors and search engines are sent to the new one automatically (permanent redirect), and menu links are updated.</p>
                {% if address.siblings %}
                  <label class="en-check">
                    <input type="checkbox" name="rename_translations" value="1" checked class="{{ checkbox_class }}">
                    <span>Change the address of the other languages too ({{ address.siblings|join(', ')|upper }}). Recommended: translations, menus, and language links expect the same address.</span>
                  </label>
                {% endif %}
              </div>
              {% if address.old_addresses %}
                <p class="en-help">
                  Old addresses that lead here:
                  {% for r in address.old_addresses %}<code>/{{ r.source }}</code>{% if r.hits > 0 %} <span>({{ r.hits }} visits)</span>{% endif %} {% endfor %}
                  <a class="en-link" href="{{ url('admin/redirects') }}">Manage redirects</a>
                </p>
              {% endif %}
            {% endif %}
          </div>
        </section>

        <section class="{{ card }} ed-card" aria-labelledby="ed-h-body">
          <div class="en-card-head">
            <h2 id="ed-h-body" class="en-card-title">Main content</h2>
            <span class="ed-modes" role="group" aria-label="How to edit">
              <button type="button" data-ed-mode="visual" aria-pressed="false" hidden>Visual</button>
              <button type="button" data-ed-mode="markdown" aria-pressed="true">Markdown</button>
            </span>
          </div>
          <div class="ed" data-editor data-mode="markdown" data-endpoint="{{ url('admin/markdown-visual') }}" data-raw-html="{{ can('content.raw_html') ? '1' : '0' }}">
            <div class="ed-tools" data-ed-tools hidden></div>
            <div class="ed-tools ed-md-tools" data-md-toolbar>
              <button type="button" class="ed-text" title="Heading 2" data-action="h2">H2</button>
              <button type="button" class="ed-text" title="Heading 3" data-action="h3">H3</button>
              <button type="button" class="ed-text" title="Bold" data-action="bold"><strong>B</strong></button>
              <button type="button" class="ed-text" title="Italic" data-action="italic"><em>I</em></button>
              {% if can('content.raw_html') %}<button type="button" class="ed-text" title="Underline (written as HTML)" data-action="underline"><u>U</u></button>{% endif %}
              <button type="button" class="ed-text" title="Strikethrough" data-action="strike"><s>S</s></button>
              <button type="button" class="ed-text" title="Link" data-action="link">Link</button>
              <button type="button" class="ed-text" title="Bulleted list" data-action="ul">List</button>
              <button type="button" class="ed-text" title="Numbered list" data-action="ol">Ordered</button>
              <button type="button" class="ed-text" title="Quote" data-action="quote">Quote</button>
              <button type="button" class="ed-text" title="Code" data-action="code">Code</button>
              <button type="button" class="ed-text" title="Image" data-action="image">Image</button>
              {% if can('content.raw_html') %}
                <select class="ed-format" data-action="snippet" aria-label="Insert a snippet">
                  <option value="">Snippet</option>
                  <option value="iframe">Embed iframe</option>
                  <option value="button">Button</option>
                </select>
              {% endif %}
            </div>
            <div class="ed-surface" data-ed-surface contenteditable="true" role="textbox" aria-multiline="true" aria-label="Main content" hidden></div>
            <textarea name="body" rows="18" data-md-body aria-label="Main content (Markdown)" class="ed-source">{{ body }}</textarea>
            <p class="ed-foot"><span data-ed-words></span><span class="ed-note" data-ed-note role="status"></span><span>Saved as Markdown</span></p>
          </div>
        </section>

        <section class="{{ card }}">
          <label class="en-card-title" for="en-excerpt">Excerpt</label>
          <p class="en-help m-0">A short summary for lists and, when there is no SEO description, for search.</p>
          <textarea id="en-excerpt" name="excerpt" rows="2" class="lc-input mt-1.5">{{ meta_form.excerpt }}</textarea>
        </section>
      </div>

      <aside class="en-side">
        <section class="{{ card }} en-publish" aria-labelledby="en-h-publish">
          <h2 id="en-h-publish" class="en-card-title">Publish</h2>
          <div class="en-fields">
            <label class="en-field"><span>Status</span>
              <select name="status" class="lc-input lc-select" data-status-select>
                <option value="published" {% if meta_form.status == 'published' %}selected{% endif %}>Published</option>
                <option value="draft" {% if meta_form.status == 'draft' %}selected{% endif %}>Draft</option>
              </select>
            </label>
            <label class="en-field"><span>Language</span>
              <select name="lang" class="lc-input lc-select">
                {% for l in languages %}<option value="{{ l }}" {% if l == lang %}selected{% endif %}>{{ l }}</option>{% endfor %}
              </select>
            </label>
            {% if page_templates is not empty and page_templates|length > 1 %}
              {% set current_template = meta_form.template|default('') ?: 'default' %}
              <label class="en-field is-wide"><span>Template</span>
                <select name="template" class="lc-input lc-select" data-template-select>
                  {% for key, template in page_templates %}
                    <option value="{{ key }}" data-description="{{ template.description }}" {% if current_template == key %}selected{% endif %}>{{ template.label }}</option>
                  {% endfor %}
                  {% if current_template not in page_templates|keys %}
                    <option value="{{ current_template }}" selected>{{ current_template }} (not available)</option>
                  {% endif %}
                </select>
                <small data-template-description>{{ page_templates[current_template].description ?? '' }}</small>
              </label>
            {% endif %}
            <label class="en-field"><span>Date</span>
              <input type="text" name="date" value="{{ meta_form.date }}" placeholder="{{ site.date_format|default('d/m/Y') }}" class="lc-input">
            </label>
            <label class="en-field"><span>Author</span>
              <input type="text" name="author" value="{{ meta_form.author }}" placeholder="Author" class="lc-input">
            </label>
            <label class="lc-chip en-visible" title="Show this entry in listings and navigation-aware views"><input type="checkbox" name="visible" value="1" {% if meta_form.visible %}checked{% endif %}><span>Visible in lists and menus</span></label>
          </div>
        </section>
        {% if opening.layouts|default([]) is not empty or opening.transparent|default([]) is not empty or opening.parallax|default([]) is not empty %}
          <section class="{{ card }}" data-opening aria-labelledby="en-h-opening">
            <h2 id="en-h-opening" class="en-card-title">Title area</h2>
            <p class="en-help m-0">For this entry only. Leave them on “Follow settings” to use what Theme settings > Single Layouts say for its content type. A page that starts with a Hero block uses that block as its opening.</p>
            <div class="en-fields">
              {% if opening.layouts is not empty %}
                <label class="en-field is-wide"><span>Title area</span>
                  <select name="hero_layout" class="lc-input lc-select">
                    <option value="">Follow settings ({{ opening.layouts[opening.type_layout]|default(opening.type_layout) }})</option>
                    {% for key, label in opening.layouts %}
                      <option value="{{ key }}" {% if meta_form.hero_layout|default('') == key %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}
              {% if opening.transparent is not empty %}
                <label class="en-field is-wide"><span>Transparent over an opening hero</span>
                  <select name="header_transparent" class="lc-input lc-select">
                    <option value="">Follow settings ({{ opening.transparent[opening.type_transparent]|default(opening.type_transparent) }})</option>
                    {% for key, label in opening.transparent %}
                      <option value="{{ key }}" {% if meta_form.header_transparent|default('') == key %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}
              {% if opening.parallax|default([]) is not empty %}
                <label class="en-field is-wide"><span>Parallax picture</span>
                  <select name="hero_parallax" class="lc-input lc-select">
                    <option value="">Follow settings ({{ opening.parallax[opening.type_parallax]|default(opening.type_parallax) }})</option>
                    {% for key, label in opening.parallax %}
                      <option value="{{ key }}" {% if meta_form.hero_parallax|default('') == key %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                  </select>
                  <small>The picture of a Default or Cover title area moves slower than the page.</small>
                </label>
              {% endif %}
            </div>
          </section>
        {% endif %}
      </aside>
    </div>

    {% if block_editor_json %}
      <div class="tab-panel hidden space-y-3" data-panel="blocks">
        <input type="hidden" name="blocks_json" value="" data-block-editor-output>
        <input type="hidden" name="blocks_editor" value="" data-block-editor-flag>
        <div data-block-editor class="space-y-3">
          <p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">The block editor needs JavaScript. The page's blocks are kept unchanged when you save.</p>
        </div>
        <script type="application/json" id="block-editor-data">{{ block_editor_json|raw }}</script>
      </div>
    {% endif %}

    <div class="tab-panel hidden" data-panel="media">
      <section class="{{ card }}" aria-labelledby="en-h-image">
        <h2 id="en-h-image" class="en-card-title">Main image</h2>
        <p class="en-help m-0">Pick from the media library or upload a new image.</p>
        <div class="en-image">
          <div id="main-image-preview" class="en-image-preview {{ main_image ? '' : 'hidden' }}">
            <img id="main-image-preview-img" src="{{ main_image }}" alt="Main image preview">
          </div>
          <div class="en-image-fields">
            <label class="en-field is-wide"><span>Image address</span>
              <input id="main-image-input" type="text" name="main_image" value="{{ main_image }}" placeholder="/uploads/your-image.jpg" class="lc-input">
            </label>
            <div class="en-actions">
              <button type="button" data-media-picker-toggle class="{{ secondary_button_class }}">Media Library</button>
              <label class="{{ secondary_button_class }} cursor-pointer">
                Upload image
                <input id="main-image-upload" type="file" name="main_image_upload" accept="image/*" class="hidden">
              </label>
              <button type="button" data-main-image-clear class="{{ secondary_button_class }}">Clear</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    {% if type_fields is not empty %}
      {% import '@admin/partials/fields.twig' as content_fields %}
      <div class="tab-panel hidden" data-panel="details">
        <input type="hidden" name="details_present" value="1">
        <section class="{{ card }}" aria-labelledby="en-h-details">
          <h2 id="en-h-details" class="en-card-title">{{ type_definition.singular }} details</h2>
          <p class="en-help m-0">{{ type_definition.description ?: 'Fields defined for this content type. They are shown on the page and can be used to filter the archive.' }}</p>
          <div class="en-details">
            {% for key, field in type_fields %}
              {{ content_fields.field(field, 'details[' ~ key ~ ']', type_values[key]|default(field.type == 'toggle' ? false : '')) }}
            {% endfor %}
          </div>
        </section>
      </div>
    {% endif %}

    {% if type != 'pages' %}
      <div class="tab-panel hidden space-y-3" data-panel="taxonomies">
        {% for taxonomy in taxonomies %}
          {% set selected_terms = meta_form.taxonomy_terms[taxonomy.name]|default([]) %}
          <section class="{{ card }}" aria-labelledby="en-h-tax-{{ taxonomy.name }}">
            <h2 id="en-h-tax-{{ taxonomy.name }}" class="en-card-title">{{ taxonomy.title }}</h2>
            {% if taxonomy.terms is empty %}
              <p class="en-help m-0">No terms defined yet. Add terms in <a class="en-link" href="{{ url('admin/taxonomies?taxonomy=' ~ taxonomy.name) }}">Taxonomies</a>.</p>
            {% else %}
              <div class="en-chips">
                {% for term in taxonomy.terms %}
                  {% set label = term.labels[lang]|default('') %}
                  {% if label == '' %}
                    {% set label = taxonomy_label(taxonomy.name, term.id, null) %}
                  {% endif %}
                  <label class="lc-chip"><input type="checkbox" name="taxonomy_terms[{{ taxonomy.name }}][]" value="{{ term.id }}" {% if term.id in selected_terms %}checked{% endif %}><span>{{ label }}</span></label>
                {% endfor %}
              </div>
            {% endif %}
          </section>
        {% endfor %}
      </div>
    {% endif %}

    {# Shown for every type (a page has no tab for it, but keeps the custom fields it was saved with). #}
    <div class="tab-panel hidden" data-panel="custom">
      <section class="{{ card }}" aria-labelledby="en-h-custom">
        <h2 id="en-h-custom" class="en-card-title">Custom fields</h2>
        <p class="en-help m-0">Extra front matter saved under <code>custom_fields</code>.</p>
        <div class="en-custom" data-custom-fields>
          {% for field in meta_form.custom_fields|default([{'key': '', 'value': ''}]) %}
            <div class="custom-field-row en-custom-row">
              <input type="text" name="custom_keys[]" aria-label="Field name" placeholder="field_name" value="{{ field.key }}" class="lc-input">
              <textarea name="custom_values[]" rows="1" aria-label="Field value" placeholder="Value" class="lc-input">{{ field.value }}</textarea>
              <button type="button" class="en-remove js-remove-field" aria-label="Remove field">Remove</button>
            </div>
          {% endfor %}
        </div>
        <button type="button" class="{{ secondary_button_class }} js-add-field mt-2">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
          Add field
        </button>
        <template data-custom-template>
          <div class="custom-field-row en-custom-row">
            <input type="text" name="custom_keys[]" aria-label="Field name" placeholder="field_name" class="lc-input">
            <textarea name="custom_values[]" rows="1" aria-label="Field value" placeholder="Value" class="lc-input"></textarea>
            <button type="button" class="en-remove js-remove-field" aria-label="Remove field">Remove</button>
          </div>
        </template>
      </section>
    </div>

    <div class="tab-panel hidden space-y-3" data-panel="seo">
      <section class="{{ card }}" aria-labelledby="en-h-seo">
        <h2 id="en-h-seo" class="en-card-title">Search results</h2>
        <p class="en-help m-0">How this entry looks in search, and what search engines may do with it. Site-wide rules are in <a class="en-link" href="{{ url('admin/seo') }}">SEO</a>.</p>
        <div class="en-serp" data-serp aria-hidden="true">
          <span class="en-serp-url" data-serp-url>{{ site.base_url|default('')|replace({'https://': '', 'http://': ''})|trim('/') }}/{{ slug }}</span>
          <strong data-serp-title>{{ meta_form.seo_title ?: meta_form.title }}</strong>
          <span data-serp-description>{{ meta_form.seo_description ?: meta_form.excerpt }}</span>
        </div>
        <div class="en-rows">
          <div class="seo-row"><label class="seo-label" for="en-seo-title">SEO title</label><input id="en-seo-title" type="text" name="seo_title" value="{{ meta_form.seo_title }}" placeholder="{{ meta_form.title ?: 'SEO title' }}" class="lc-input" data-serp-source="title" data-count="30,60,70" data-count-from='input[name="title"]' data-count-label="the title"></div>
          <div class="seo-row"><label class="seo-label" for="en-seo-description">Description</label><textarea id="en-seo-description" name="seo_description" rows="2" class="lc-input" data-serp-source="description" data-count="70,160,180" data-count-from='textarea[name="excerpt"]' data-count-label="the excerpt">{{ meta_form.seo_description }}</textarea></div>
          <div class="seo-row"><label class="seo-label" for="en-seo-canonical">Canonical URL</label><input id="en-seo-canonical" type="text" name="seo_canonical" value="{{ meta_form.seo_canonical }}" placeholder="https://example.com/path" class="lc-input"></div>
          <label class="lc-chip en-noindex"><input type="checkbox" name="seo_noindex" value="1" {% if meta_form.seo_noindex %}checked{% endif %}><span>Keep out of search (adds noindex)</span></label>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="en-h-og">
        <h2 id="en-h-og" class="en-card-title">When the link is shared</h2>
        <p class="en-help m-0">What shows on social networks and in messages. Each left empty follows the search title, description and the main image.</p>
        <div class="en-rows">
          <div class="seo-row"><label class="seo-label" for="en-og-title">Title</label><input id="en-og-title" type="text" name="seo_og_title" value="{{ meta_form.seo_og_title }}" placeholder="Defaults to SEO title" class="lc-input" data-count="30,70,90" data-count-from='#en-seo-title|input[name="title"]' data-count-label="the search title|the title"></div>
          <div class="seo-row"><label class="seo-label" for="en-og-image">Image</label><input id="en-og-image" type="text" name="seo_og_image" value="{{ meta_form.seo_og_image }}" placeholder="{{ main_image ?: '/uploads/your-image.jpg' }}" class="lc-input"></div>
          <div class="seo-row"><label class="seo-label" for="en-og-description">Description</label><textarea id="en-og-description" name="seo_og_description" rows="2" class="lc-input" data-count="60,200,250" data-count-from='#en-seo-description|textarea[name="excerpt"]' data-count-label="the search description|the excerpt">{{ meta_form.seo_og_description }}</textarea></div>
        </div>
      </section>
    </div>

    <div class="tab-panel hidden" data-panel="translations">
      <section class="{{ card }}" aria-labelledby="en-h-trans">
        <h2 id="en-h-trans" class="en-card-title">Translations</h2>
        <p class="en-help m-0">The same entry in the other languages.</p>
        <ul class="en-list">
          {% for t in translations %}
            <li>
              <span class="en-chip">{{ t.lang }}</span>
              <div class="min-w-0">
                {% if t.exists %}
                  <strong>{{ t.title }}</strong>
                  <small>/{{ t.slug }}</small>
                {% else %}
                  <strong class="is-muted">Not created yet</strong>
                  <small>/{{ t.slug }}</small>
                {% endif %}
              </div>
              {% if t.exists %}
                <a class="{{ secondary_button_class }}" href="{{ url(t.edit_url) }}">Edit</a>
              {% else %}
                <a class="{{ primary_button_class }}" href="{{ url(t.create_url) }}">Create</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </section>
    </div>

    {% if address.exists %}
      <div class="tab-panel hidden" data-panel="history">
        <section class="{{ card }}" aria-labelledby="en-h-history">
          <h2 id="en-h-history" class="en-card-title">History</h2>
          <p class="en-help m-0">Earlier versions of this item. Open one to see what changed and to restore it.</p>
          {% if history %}
            <ul class="en-list">
              {% for h in history %}
                <li>
                  <div class="min-w-0">
                    <strong>{{ h.action_label }}</strong>
                    <small>{{ h.when }}{% if h.actor %} · {{ h.actor }}{% endif %}</small>
                  </div>
                  <a class="en-link" href="{{ url('admin/revisions?id=' ~ h.id) }}">View changes</a>
                </li>
              {% endfor %}
            </ul>
            {% if history_total > history|length %}
              <p class="en-help">Showing the latest {{ history|length }} of {{ history_total }}.</p>
            {% endif %}
            <a class="en-link" href="{{ url('admin/revisions?type=' ~ type ~ '&slug=' ~ slug ~ '&lang=' ~ lang) }}">All versions</a>
          {% else %}
            <p class="en-help">No versions are kept yet. The first one is recorded when you save.</p>
          {% endif %}
        </section>
      </div>
    {% endif %}

    <div class="tab-panel hidden" data-panel="advanced">
      <section class="{{ card }}" aria-labelledby="en-h-front">
        <h2 id="en-h-front" class="en-card-title">Front matter</h2>
        <p class="en-help m-0">Advanced YAML merged with the standard fields.{% if block_editor_json %} Blocks are edited in the Blocks tab.{% endif %}</p>
        <textarea name="frontmatter" rows="16" aria-label="Front matter (YAML)" class="lc-input mt-1.5 font-mono text-[13px] leading-6">{{ frontmatter }}</textarea>
      </section>
    </div>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
        {% if front_url %}
          <a class="{{ secondary_button_class }}" href="{{ front_url }}" target="_blank" rel="noopener">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3"/></svg>
            Preview
          </a>
        {% endif %}
        {% if slug and not is_home %}
          {% if address.exists and type != 'forms' and meta_form.status == 'published' %}
            {# A public entry: the next page asks where its visitors should go. #}
            <a class="{{ danger_button_class }}" href="{{ url('admin/delete?type=' ~ type ~ '&slug=' ~ slug ~ '&lang=' ~ lang) }}">Delete</a>
          {% else %}
            <button type="submit" class="{{ danger_button_class }}" formaction="{{ url('admin/delete') }}" formmethod="post" data-confirm="Delete this item?" data-confirm-button="Delete">Delete</button>
          {% endif %}
        {% endif %}
      {% endblock %}
      {% block actions %}
        <button type="submit" class="{{ primary_button_class }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      {% endblock %}
    {% endembed %}
  </form>

  <script src="{{ asset('js/admin-entry.js') }}" defer></script>
  <script src="{{ asset('js/admin-editor.js') }}" defer></script>
  <script src="{{ asset('js/admin-seo-count.js') }}" defer></script>
  {% if block_editor_json %}
    {% include '@admin/partials/icon-library.twig' %}
    <script src="{{ asset('js/admin-blocks.js') }}"></script>
  {% endif %}

  <script>
    (function () {
      var box = document.querySelector('[data-address]');
      if (!box) return;
      // Same rules as the server (src/Slug.php), used only to show a preview: the server decides the real address.
      var greek = {α:'a',β:'v',γ:'g',δ:'d',ε:'e',ζ:'z',η:'i',θ:'th',ι:'i',κ:'k',λ:'l',μ:'m',ν:'n',ξ:'x',ο:'o',π:'p',ρ:'r',σ:'s',τ:'t',υ:'y',φ:'f',χ:'ch',ψ:'ps',ω:'o',ϊ:'i',ϋ:'y'};
      var stress = {'ά':'α','έ':'ε','ή':'η','ί':'ι','ό':'ο','ύ':'υ','ώ':'ω','ς':'σ','ΐ':'ϊ','ΰ':'ϋ'};
      var latin = {'à':'a','á':'a','â':'a','ã':'a','ä':'a','å':'a','æ':'ae','ç':'c','è':'e','é':'e','ê':'e','ë':'e','ì':'i','í':'i','î':'i','ï':'i','ñ':'n','ò':'o','ó':'o','ô':'o','õ':'o','ö':'o','ø':'o','œ':'oe','ù':'u','ú':'u','û':'u','ü':'u','ý':'y','ÿ':'y','ß':'ss','š':'s','ž':'z','č':'c','ł':'l','ğ':'g','ş':'s','ı':'i'};
      var voicelessAfter = ['κ','ξ','π','σ','τ','φ','χ','ψ'];
      function slugFromText(text) {
        text = String(text).trim().toLowerCase();
        text = text.replace(/[άέήίόύώςΐΰ]/g, function (m) { return stress[m]; }).replace(/[À-ſ]/g, function (m) { return latin[m] || m; });
        var chars = Array.from(text), out = '';
        for (var i = 0; i < chars.length; i++) {
          var c = chars[i], next = chars[i + 1] || '', after = chars[i + 2] || '', pair = c + next;
          var start = i === 0 || !greek[chars[i - 1]];
          var voiceless = after === '' || voicelessAfter.indexOf(after) !== -1 || !greek[after];
          var d = null;
          switch (pair) {
            case 'ου': d = 'ou'; break; case 'ει': d = 'ei'; break; case 'οι': d = 'oi'; break; case 'αι': d = 'ai'; break; case 'υι': d = 'yi'; break;
            case 'αυ': d = voiceless ? 'af' : 'av'; break; case 'ευ': d = voiceless ? 'ef' : 'ev'; break; case 'ηυ': d = voiceless ? 'if' : 'iv'; break;
            case 'μπ': d = start ? 'b' : 'mp'; break; case 'ντ': d = start ? 'd' : 'nt'; break; case 'γκ': d = start ? 'g' : 'gk'; break;
            case 'γγ': d = 'ng'; break; case 'γξ': d = 'nx'; break; case 'γχ': d = 'nch'; break;
          }
          if (d !== null) { out += d; i++; continue; }
          out += greek[c] !== undefined ? greek[c] : c;
        }
        out = out.replace(/[^a-z0-9\-_]+/g, '-').replace(/-{2,}/g, '-').replace(/^[-_]+|[-_]+$/g, '');
        if (out.length > 80) {
          var cut = out.slice(0, 80), dash = cut.lastIndexOf('-');
          out = (dash > 20 ? cut.slice(0, dash) : cut).replace(/[-_]+$/, '');
        }
        return out;
      }
      window.farosSlug = slugFromText;

      var preview = box.querySelector('[data-address-preview]');
      var title = document.querySelector('input[name="title"]');
      if (preview && title && preview.getAttribute('data-fixed') === '0') {
        var show = function () { preview.textContent = slugFromText(title.value) || '…'; };
        title.addEventListener('input', show);
      }

      var toggle = box.querySelector('[data-address-edit]');
      var panel = box.querySelector('[data-address-panel]');
      if (toggle && panel) {
        var field = panel.querySelector('[data-address-value]');
        var current = box.querySelector('[data-address-current]');
        toggle.addEventListener('click', function () {
          var open = panel.classList.toggle('hidden') === false;
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.textContent = open ? 'Cancel' : 'Change';
          if (open) { field.focus(); field.select(); } else { field.value = field.getAttribute('data-original'); current.textContent = field.value; }
        });
        field.addEventListener('input', function () { current.textContent = field.value.trim() === '' ? field.getAttribute('data-original') : slugFromText(field.value); });
      }
    })();
  </script>
{% endblock %}
