"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Auto-reply subject <input type="text" name="form_notifications[auto_reply_subject]" value="{{ form_notifications.auto_reply_subject }}" class="{{ input_class }}"> </label> </div> <label class="block"> Auto-reply message <textarea name="form_notifications[auto_reply_message]" rows="4" class="{{ textarea_class }}">{{ form_notifications.auto_reply_message }}</textarea> </label> </div> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Storage & success</h3> <div class="section-grid grid-2 grid grid-cols-1 gap-4 md:grid-cols-2"> <label class="checkbox-field flex items-center gap-2 pt-2"> <span>Store submissions</span> <input type="checkbox" name="form_store_submissions" value="1" {% if form_settings.store_submissions %}checked{% endif %} class="{{ checkbox_class }}"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Redirect URL <input type="text" name="form_redirect_url" value="{{ form_settings.redirect_url }}" placeholder="/thank-you" class="{{ input_class }}"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Submit button label <input type="text" name="form_submit_label" value="{{ form_settings.submit_label }}" placeholder="Submit" class="{{ input_class }}"> </label> </div> <label class="block"> Success message <textarea name="form_success_message" rows="3" class="{{ textarea_class }}">{{ form_settings.success_message }}</textarea> </label> </div> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Anti-spam</h3> <div class="section-grid grid-2 grid grid-cols-1 gap-4 md:grid-cols-2"> <label class="grid gap-1 text-sm font-medium text-slate-700"> Honeypot field <input type="text" name="form_honeypot" value="{{ form_settings.honeypot }}" placeholder="website" class="{{ input_class }}"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Rate limit (seconds) <input type="number" name="form_rate_limit_seconds" value="{{ form_settings.rate_limit_seconds }}" min="0" class="{{ input_class }}"> </label> </div> </div> </div> <div class="tab-panel hidden" data-panel="submissions"> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <div class="form-section-header flex items-center justify-between gap-3"> <h3 class="text-sm font-semibold text-slate-900">Submissions</h3> {% if slug %} <a class="pill-button pill-button-muted inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 border border-slate-300 bg-white text-slate-700 hover:bg-slate-100" href="{{ url('admin/forms-export?slug=' ~ slug ~ '&lang=' ~ lang) }}">Export CSV</a> {% endif %} </div> {% if form_submissions is empty %} <p class="hint text-sm text-slate-500">No submissions yet.</p> {% else %} <div class="form-submissions grid gap-3"> {% for submission in form_submissions %} <details class="submission-item grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3"> <summary> <span>{{ submission.title }}</span> <span class="submission-meta text-xs text-slate-500">{{ submission.submitted_at }}</span> </summary> <div class="submission-fields mt-3 grid gap-2"> {% for row in submission.fields %} <div class="submission-field flex flex-wrap items-start justify-between gap-3 border-t border-slate-200 pt-2"> <strong>{{ row.label }}</strong> <span>{{ row.value }}</span> </div> {% endfor %} </div> </details> {% endfor %} </div> {% endif %} </div> </div> {% endif %} <div class="tab-panel hidden" data-panel="seo"> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Search metadata</h3> <div class="section-grid grid grid-cols-1 gap-4"> <label class="grid gap-1 text-sm font-medium text-slate-700"> SEO title <input type="text" name="seo_title" value="{{ meta_form.seo_title }}" placeholder="SEO title" class="{{ input_class }}"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Canonical URL <input type="text" name="seo_canonical" value="{{ meta_form.seo_canonical }}" placeholder="https://example.com/path" class="{{ input_class }}"> </label> </div> <label class="block"> SEO description <textarea name="seo_description" rows="4" class="{{ textarea_class }}">{{ meta_form.seo_description }}</textarea> </label> </div> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Indexing</h3> <label class="checkbox-field flex items-center gap-2 pt-2"> <span class="label-row inline-flex items-center gap-2">Noindex <span class="help-tip inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] text-slate-500" data-tip="Prevent search engines from indexing this page.">?</span></span> <input type="checkbox" name="seo_noindex" value="1" {% if meta_form.seo_noindex %}checked{% endif %} class="{{ checkbox_class }}"> </label> </div> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Open Graph</h3> <div class="section-grid grid grid-cols-1 gap-4"> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">OG title <span class="help-tip inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] text-slate-500" data-tip="Defaults to the SEO title if left empty.">?</span></span> <input type="text" name="seo_og_title" value="{{ meta_form.seo_og_title }}" placeholder="Defaults to SEO title" class="{{ input_class }}"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">OG image <span class="help-tip inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] text-slate-500" data-tip="Defaults to the main image if left empty.">?</span></span> <input type="text" name="seo_og_image" value="{{ meta_form.seo_og_image }}" placeholder="{{ main_image ?: '/uploads/your-image.jpg' }}" class="{{ input_class }}"> </label> </div> <label class="block"> <span class="label-row inline-flex items-center gap-2">OG description <span class="help-tip inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] text-slate-500" data-tip="Defaults to the SEO description if left empty.">?</span></span> <textarea name="seo_og_description" rows="4" class="{{ textarea_class }}">{{ meta_form.seo_og_description }}</textarea> </label> </div> </div> {% if not is_form %} <div class="tab-panel hidden" data-panel="custom"> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Custom Fields</h3> <p class="hint text-sm text-slate-500">Add any extra fields here. They are saved under <code>custom_fields</code> in front matter.</p> <div class="custom-fields grid gap-3" data-custom-fields> {% if meta_form.custom_fields is not empty %} {% for field in meta_form.custom_fields %} <div class="custom-field-row grid grid-cols-1 items-start gap-2 md:grid-cols-[1fr_2fr_auto]"> <input type="text" name="custom_keys[]" placeholder="field_name" value="{{ field.key }}" class="{{ input_class }}"> <textarea name="custom_values[]" rows="2" placeholder="Value" class="{{ textarea_class }}">{{ field.value }}</textarea> <button type="button" class="pill-button danger js-remove-field inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 border-0 bg-rose-600 hover:bg-rose-500">Remove</button> </div> {% endfor %} {% else %} <div class="custom-field-row grid grid-cols-1 items-start gap-2 md:grid-cols-[1fr_2fr_auto]"> <input type="text" name="custom_keys[]" placeholder="field_name" class="{{ input_class }}"> <textarea name="custom_values[]" rows="2" placeholder="Value" class="{{ textarea_class }}"></textarea> <button type="button" class="pill-button danger js-remove-field inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 border-0 bg-rose-600 hover:bg-rose-500">Remove</button> </div> {% endif %} </div> <button type="button" class="pill-button js-add-field inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">+ Add field</button> </div> </div> {% endif %} <div class="tab-panel hidden" data-panel="translations"> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Translations</h3> <div class="translations-list grid gap-3"> {% for t in translations %} <div class="translation-row grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3"> <div class="translation-lang font-semibold text-slate-900">{{ t.lang|upper }}</div> <div class="translation-meta grid gap-1"> {% if t.exists %} <div class="translation-title font-medium text-slate-900">{{ t.title }}</div> <div class="translation-slug text-sm text-slate-500">/{{ t.slug }}</div> {% else %} <div class="translation-empty text-sm text-slate-500">Not created yet.</div> <div class="translation-slug text-sm text-slate-500">/{{ t.slug }}</div> {% endif %} </div> <div class="translation-actions flex justify-end"> {% if t.exists %} <a class="inline-flex items-center justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700" href="{{ url(t.edit_url) }}">Edit</a> {% else %} <a class="inline-flex items-center justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700" href="{{ url(t.create_url) }}">Create</a> {% endif %} </div> </div> {% endfor %} </div> <p class="hint text-sm text-slate-500">Translations stay linked via <code>translation_id</code>, even if slugs differ.</p> </div> </div> <div class="tab-panel hidden" data-panel="advanced"> <div class="form-section mb-4 w-full grid gap-3 rounded-lg border border-slate-200 bg-white p-4"> <h3 class="text-sm font-semibold text-slate-900">Front matter (YAML)</h3> <label class="block"> <span class="label-row inline-flex items-center gap-2">Advanced YAML <span class="help-tip inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 text-[10px] text-slate-500" data-tip="Standard fields are saved from the inputs above. Custom Fields tab may overwrite overlapping keys.">?</span></span> <textarea name="frontmatter" rows="14" class="{{ textarea_class }} font-mono text-[13px] leading-6">{{ frontmatter }}</textarea> </label> </div> </div> </form> <script> (function () { const buttons = document.querySelectorAll('.tab-button'); const panels = document.querySelectorAll('.tab-panel'); const noindexToggle = document.querySelector('input[name="seo_noindex"]'); const noindexPill = document.querySelector('[data-nonindex-pill]'); const addFieldButton = document.querySelector('.js-add-field'); const fieldsContainer = document.querySelector('[data-custom-fields]'); const addFormFieldButton = document.querySelector('.js-add-form-field'); const formFieldsContainer = document.querySelector('[data-form-fields]'); const formFieldOptions = `{% for option in form_field_types %}<option value="{{ option }}">{{ option }}</option>{% endfor %}`; const mdToolbar = document.querySelector('[data-md-toolbar]'); const mdBody = document.querySelector('[data-md-body]'); buttons.forEach((button) => { button.addEventListener('click', () => { const target = button.getAttribute('data-tab'); buttons.forEach((btn) => btn.classList.toggle('active', btn === button)); panels.forEach((panel) => { panel.classList.toggle('active', panel.getAttribute('data-panel') === target); }); }); }); const insertAtSelection = (before, after = '') => { if (!mdBody) return; const start = mdBody.selectionStart || 0; const end = mdBody.selectionEnd || 0; const value = mdBody.value || ''; const selected = value.slice(start, end); const replacement = before + selected + after; mdBody.value = value.slice(0, start) + replacement + value.slice(end); const cursor = start + before.length; mdBody.focus(); if (selected.length) { mdBody.selectionStart = cursor; mdBody.selectionEnd = cursor + selected.length; } else { mdBody.selectionStart = mdBody.selectionEnd = cursor; } }; const prefixLines = (prefix, numbered = false) => { if (!mdBody) return; const start = mdBody.selectionStart || 0; const end = mdBody.selectionEnd || 0; const value = mdBody.value || ''; const selection = value.slice(start, end); if (selection === '') { const lineStart = value.lastIndexOf('\n', start - 1) + 1; mdBody.value = value.slice(0, lineStart) + prefix + value.slice(lineStart); const newPos = start + prefix.length; mdBody.focus(); mdBody.selectionStart = mdBody.selectionEnd = newPos; return; } const lines = selection.split('\n'); const updated = lines.map((line, idx) => { if (numbered) { return `${idx + 1}. ${line}`; } return prefix + line; }).join('\n'); mdBody.value = value.slice(0, start) + updated + value.slice(end); mdBody.focus(); mdBody.selectionStart = start; mdBody.selectionEnd = start + updated.length; }; const insertSnippet = (type) => { if (!mdBody) return; if (type === 'iframe') { const snippet = '<iframe src="PASTE_URL_HERE" width="100%" height="800" frameborder="0"></iframe>'; insertAtSelection(snippet, ''); return; } if (type === 'button') { const snippet = '<a class="btn" href="#">Button</a>'; insertAtSelection(snippet, ''); } }; if (mdToolbar && mdBody) { mdToolbar.addEventListener('click', (event) => { const target = event.target.closest('[data-action]'); if (!target) return; const action = target.getAttribute('data-action'); if (!action) return; switch (action) { case 'h2': prefixLines('## '); break; case 'h3': prefixLines('### '); break; case 'h4': prefixLines('#### '); break; case 'h5': prefixLines('##### '); break; case 'h6': prefixLines('###### '); break; case 'bold': insertAtSelection('**', '**'); break; case 'italic': insertAtSelection('*', '*'); break; case 'underline': insertAtSelection('<u>', '</u>'); break; case 'strike': insertAtSelection('~~', '~~'); break; case 'link': { const url = prompt('Enter URL'); if (url === null) return; const start = mdBody.selectionStart || 0; const end = mdBody.selectionEnd || 0; const text = mdBody.value.slice(start, end) || 'link text'; const snippet = `[${text}](${url})`; insertAtSelection(snippet, ''); break; } case 'ul': prefixLines('- '); break; case 'ol': prefixLines('', true); break; case 'quote': prefixLines('> '); break; case 'code': insertAtSelection('`', '`'); break; case 'image': { const url = prompt('Enter image URL'); if (url === null) return; const alt = prompt('Enter alt text') || 'image'; const snippet = `![${alt}](${url})`; insertAtSelection(snippet, ''); break; } } }); const snippetSelect = mdToolbar.querySelector('[data-action="snippet"]'); if (snippetSelect) { snippetSelect.addEventListener('change', (event) => { const value = event.target.value; if (value) { insertSnippet(value); event.target.value = ''; } }); } } const bindRemoveButton = (button) => { if (!button) { return; } button.addEventListener('click', () => { const row = button.closest('.custom-field-row'); if (row) { row.remove(); } }); }; if (addFieldButton && fieldsContainer) { addFieldButton.addEventListener('click', () => { const row = document.createElement('div'); row.className = 'custom-field-row'; row.innerHTML = ` <input type="text" name="custom_keys[]" placeholder="field_name" class="{{ input_class }}"> <textarea