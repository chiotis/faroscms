                      </select>
                    </label>
                    <label class="flex items-center gap-2 pt-6 text-sm text-slate-700">
                      <input type="checkbox" name="form_fields[{{ field_id }}][required]" value="1" {% if field.required %}checked{% endif %} class="{{ checkbox_class }}">
                      Required
                    </label>
                  </div>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Placeholder</span>
                      <input type="text" name="form_fields[{{ field_id }}][placeholder]" value="{{ field.placeholder }}" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Options</span>
                      <input type="text" name="form_fields[{{ field_id }}][options]" value="{{ field.options }}" placeholder="Option 1, Option 2" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Default value</span>
                      <input type="text" name="form_fields[{{ field_id }}][default]" value="{{ field.default }}" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Help text</span>
                      <input type="text" name="form_fields[{{ field_id }}][help]" value="{{ field.help }}" class="{{ input_class }}">
                    </label>
                  </div>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Rows</span>
                      <input type="number" name="form_fields[{{ field_id }}][rows]" value="{{ field.rows }}" min="1" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Min</span>
                      <input type="text" name="form_fields[{{ field_id }}][min]" value="{{ field.min }}" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Max</span>
                      <input type="text" name="form_fields[{{ field_id }}][max]" value="{{ field.max }}" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Step</span>
