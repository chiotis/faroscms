                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Name</span>
                      <input type="text" name="form_fields[{{ field_id }}][name]" value="{{ field.name }}" placeholder="field_name" class="{{ input_class }}">
                    </label>
                    <label class="block">
                      <span class="mb-1 block text-sm font-medium text-slate-700">Type</span>
                      <select name="form_fields[{{ field_id }}][type]" class="{{ select_class }}">
                        {% for option in form_field_types %}
                          <option value="{{ option }}" {% if option == field.type %}selected{% endif %}>{{ option }}</option>
