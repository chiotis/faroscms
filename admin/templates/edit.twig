{% extends '@admin/base.twig' %}

{% block content %}
  {% set singular = type ends with 's' ? type|slice(0, -1) : type %}
  {% set is_form = type == 'forms' %}
  {% set section_class = 'rounded-lg border border-slate-200 bg-white p-4' %}
  {% set section_header_class = 'mb-3 border-b border-slate-100 pb-3' %}
  {% set tab_class = 'tab-button shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-medium text-slate-500 transition hover:text-slate-800' %}
  {% set primary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set secondary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set danger_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm transition hover:bg-red-50' %}
  {% set icon_button_class = 'rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700' %}
  {% set is_home = slug and type == 'pages' and slug == site.home_page and lang == site.languages.default %}

  {% if saved and not restored %}
    <template data-flash data-type="success">Saved.</template>
  {% endif %}
  {% if restored %}
    <template data-flash data-type="success">Version restored. The text it replaced is kept in the history.</template>
  {% endif %}
  {% if deleted %}
    <template data-flash data-type="success">Deleted.</template>
  {% endif %}
  {% if address_changed %}
    <template data-flash data-type="success">Address changed. The old address now leads here.</template>
  {% endif %}
  {% if link_fix %}
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="status">
      <span>{{ link_fix.count }} {{ link_fix.count == 1 ? 'link' : 'links' }} in other content still {{ link_fix.count == 1 ? 'uses' : 'use' }} the old address. {{ link_fix.count == 1 ? 'It works' : 'They work' }} through the redirect, but pointing {{ link_fix.count == 1 ? 'it' : 'them' }} at the new address is better.</span>
      <a class="font-semibold text-amber-900 underline" href="{{ url('admin/links?ids=' ~ link_fix.ids) }}">Review and update</a>
    </div>
  {% endif %}
  {% if address_taken %}
    <template data-flash data-type="warning">The address "{{ address_taken }}" is already used or reserved, so "{{ slug }}" was used instead.</template>
  {% endif %}
  {% if notice == 'html' %}
    <template data-flash data-type="warning">Saved. Raw HTML is only available to administrators, so the HTML you typed is shown as plain text. Use Markdown for formatting.</template>
  {% endif %}

  <form method="post" action="{{ url('admin/save') }}" class="editor space-y-4" enctype="multipart/form-data">
    {{ csrf_field() }}
    <input type="hidden" name="type" value="{{ type }}">
    <input type="hidden" name="translation_id" value="{{ meta_form.translation_id }}">
    <input type="hidden" name="original_slug" value="{{ slug }}">
    <input type="hidden" name="original_lang" value="{{ lang }}">

    <div class="flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">Edit {{ singular|title }}</h1>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <span class="truncate text-xs text-slate-400">{{ meta_form.title ?: title_from_slug }}</span>
          <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-slate-500">{{ lang }}</span>
          <span data-nonindex-pill class="{% if not meta_form.seo_noindex %}hidden {% endif %}inline-flex items-center rounded-full bg-pink-100 px-2 py-0.5 text-[10px] font-semibold uppercase text-pink-700">Non-indexed</span>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {% if front_url %}
          <a class="{{ secondary_button_class }}" href="{{ front_url }}" target="_blank" rel="noopener">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3"/></svg>
            Preview
          </a>
        {% endif %}
        {% if slug and not is_home %}
          {% if address.exists and type != 'forms' and meta_form.status == 'published' %}
            {# A public entry: the next page asks where its visitors should go. #}
            <a class="{{ danger_button_class }}" href="{{ url('admin/delete?type=' ~ type ~ '&slug=' ~ slug ~ '&lang=' ~ lang) }}">Delete</a>
          {% else %}
            <button type="submit" class="{{ danger_button_class }}" formaction="{{ url('admin/delete') }}" formmethod="post" data-confirm="Delete this item?" data-confirm-button="Delete">Delete</button>
          {% endif %}
        {% endif %}
        <button type="submit" class="{{ primary_button_class }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      </div>
    </div>

    <div class="overflow-x-auto border-b border-slate-200">
      <div class="flex min-w-max gap-1" role="tablist">
        <button type="button" class="{{ tab_class }} active" data-tab="basics">Basics</button>
        {% if type_fields is not empty %}
          <button type="button" class="{{ tab_class }}" data-tab="details">{{ type_definition.singular }} details</button>
        {% endif %}
        {% if block_editor_json %}
          <button type="button" class="{{ tab_class }}" data-tab="blocks">Blocks <span data-block-count class="ml-1 rounded-full bg-slate-100 px-1.5 text-[11px] font-semibold text-slate-600"></span></button>
        {% endif %}
        {% if is_form %}
          <button type="button" class="{{ tab_class }}" data-tab="fields">Fields</button>
          <button type="button" class="{{ tab_class }}" data-tab="notifications">Notifications</button>
          <button type="button" class="{{ tab_class }}" data-tab="submissions">Submissions</button>
        {% else %}
          <button type="button" class="{{ tab_class }}" data-tab="media">Media</button>
          {% if type != 'pages' %}
            <button type="button" class="{{ tab_class }}" data-tab="taxonomies">Taxonomies</button>
          {% endif %}
          <button type="button" class="{{ tab_class }}" data-tab="custom">Custom Fields</button>
        {% endif %}
        <button type="button" class="{{ tab_class }}" data-tab="seo">SEO</button>
        <button type="button" class="{{ tab_class }}" data-tab="translations">Translations</button>
        {% if address.exists %}
          <button type="button" class="{{ tab_class }}" data-tab="history">History{% if history_total %} <span class="ml-1 rounded-full bg-slate-100 px-1.5 text-[11px] font-semibold text-slate-600">{{ history_total }}</span>{% endif %}</button>
        {% endif %}
        <button type="button" class="{{ tab_class }}" data-tab="advanced">Advanced</button>
      </div>
    </div>

    <div class="tab-panel active grid grid-cols-1 gap-4 xl:grid-cols-3" data-panel="basics">
      <div class="space-y-4 xl:col-span-2">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h3 class="text-sm font-semibold text-slate-900">Content</h3>
            <p class="mt-0.5 text-xs text-slate-400">Core title, slug, summary and Markdown body.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Title</span>
              <input type="text" name="title" value="{{ meta_form.title }}" placeholder="Title" class="{{ input_class }}">
            </label>
            <div class="block sm:col-span-2" data-address>
              <span class="mb-1 block text-sm font-medium text-slate-700" id="addressLabel">Web address</span>
              {% if not address.exists %}
                {# New content: the address is made from the title. A new translation keeps the address it inherits. #}
                <input type="hidden" name="slug" value="{{ slug }}" data-address-value>
                <p class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600" aria-labelledby="addressLabel">
                  <span class="text-slate-400">{{ address.prefix }}</span><span class="font-medium text-slate-900" data-address-preview data-fixed="{{ slug ? '1' : '0' }}">{{ slug ?: '…' }}</span>
                </p>
                <p class="mt-1 text-xs text-slate-400">{% if slug %}Same address as the other languages.{% else %}Made from the title when you save, with Greek letters converted to Latin. You can change it afterwards.{% endif %}</p>
              {% elseif address.locked %}
                <input type="hidden" name="slug" value="{{ slug }}">
                <p class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600" aria-labelledby="addressLabel"><span class="text-slate-400">{{ address.prefix }}</span><span class="font-medium text-slate-900">{{ slug }}</span></p>
                <p class="mt-1 text-xs text-slate-400">{{ is_form ? 'A form keeps its address because stored submissions and pages that embed it refer to it.' : 'The home page keeps its address. Choose another home page in Settings if you want a different one.' }}</p>
              {% else %}
                <div class="flex items-center gap-2">
                  <p class="min-w-0 flex-1 truncate rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600" aria-labelledby="addressLabel"><span class="text-slate-400">{{ address.prefix }}</span><span class="font-medium text-slate-900" data-address-current>{{ slug }}</span></p>
                  <button type="button" class="{{ secondary_button_class }}" data-address-edit aria-expanded="false" aria-controls="addressPanel">Change</button>
                </div>
                <div id="addressPanel" class="mt-2 hidden rounded-md border border-amber-200 bg-amber-50 p-3" data-address-panel>
                  <label class="block">
                    <span class="mb-1 block text-sm font-medium text-slate-700">New address</span>
                    <input type="text" name="slug" value="{{ slug }}" class="{{ input_class }}" data-address-value data-original="{{ slug }}" autocomplete="off" spellcheck="false">
                  </label>
                  <p class="mt-1 text-xs text-slate-600">Letters, numbers, and dashes. Greek letters are converted to Latin. The old address keeps working: visitors and search engines are sent to the new one automatically (permanent redirect), and menu links are updated.</p>
                  {% if address.siblings %}
                    <label class="mt-2 flex items-start gap-2 text-sm text-slate-700">
                      <input type="checkbox" name="rename_translations" value="1" checked class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600">
                      <span>Change the address of the other languages too ({{ address.siblings|join(', ')|upper }}). Recommended: translations, menus, and language links expect the same address.</span>
                    </label>
                  {% endif %}
                </div>
                {% if address.old_addresses %}
                  <p class="mt-2 text-xs text-slate-500">
                    Old addresses that lead here:
                    {% for r in address.old_addresses %}<code class="mx-0.5 rounded bg-slate-100 px-1 py-0.5">/{{ r.source }}</code>{% if r.hits > 0 %}<span class="text-slate-400">({{ r.hits }} visits)</span>{% endif %}{% endfor %}
                    <a class="ml-1 font-medium text-blue-600 hover:text-blue-700" href="{{ url('admin/redirects') }}">Manage redirects</a>
                  </p>
                {% endif %}
              {% endif %}
            </div>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Language</span>
              <select name="lang" class="{{ select_class }}">
                {% for l in languages %}
                  <option value="{{ l }}" {% if l == lang %}selected{% endif %}>{{ l }}</option>
                {% endfor %}
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Excerpt</span>
              <textarea name="excerpt" rows="3" class="{{ textarea_class }}">{{ meta_form.excerpt }}</textarea>
            </label>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h3 class="text-sm font-semibold text-slate-900">Main Content</h3>
            <p class="mt-0.5 text-xs text-slate-400">Markdown body used by the public template.</p>
          </div>
          <div class="mb-0 flex flex-wrap items-center gap-1.5 rounded-t-md border border-b-0 border-slate-300 bg-slate-50 px-2 py-2 text-slate-500" data-md-toolbar>
            <button type="button" class="{{ icon_button_class }}" title="Heading 2" data-action="h2">H2</button>
            <button type="button" class="{{ icon_button_class }}" title="Heading 3" data-action="h3">H3</button>
            <button type="button" class="{{ icon_button_class }}" title="Bold" data-action="bold"><strong>B</strong></button>
            <button type="button" class="{{ icon_button_class }}" title="Italic" data-action="italic"><em>I</em></button>
            <button type="button" class="{{ icon_button_class }}" title="Underline" data-action="underline"><u>U</u></button>
            <button type="button" class="{{ icon_button_class }}" title="Strike" data-action="strike"><s>S</s></button>
            <button type="button" class="{{ icon_button_class }}" title="Link" data-action="link">Link</button>
            <button type="button" class="{{ icon_button_class }}" title="List" data-action="ul">List</button>
            <button type="button" class="{{ icon_button_class }}" title="Ordered list" data-action="ol">Ordered</button>
            <button type="button" class="{{ icon_button_class }}" title="Quote" data-action="quote">Quote</button>
            <button type="button" class="{{ icon_button_class }}" title="Code" data-action="code">Code</button>
            <button type="button" class="{{ icon_button_class }}" title="Image" data-action="image">Image</button>
            <select class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-600" data-action="snippet">
              <option value="">Snippet</option>
              <option value="iframe">Embed iframe</option>
              <option value="button">Button</option>
            </select>
          </div>
          <textarea name="body" rows="18" data-md-body class="{{ textarea_class }} rounded-t-none font-mono text-[13px] leading-6">{{ body }}</textarea>
        </div>
      </div>

      <div class="space-y-4">
        <div class="sticky top-4 space-y-4 lg:top-6">
          <div class="{{ section_class }}">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">Publish</h3>
            <div class="grid gap-3">
              <label class="block">
                <span class="mb-1 block text-sm font-medium text-slate-700">Status</span>
                <select name="status" class="{{ select_class }}">
                  <option value="published" {% if meta_form.status == 'published' %}selected{% endif %}>Published</option>
                  <option value="draft" {% if meta_form.status == 'draft' %}selected{% endif %}>Draft</option>
                </select>
              </label>
              {% if page_templates is not empty and page_templates|length > 1 %}
                {% set current_template = meta_form.template|default('') ?: 'default' %}
                <label class="block">
                  <span class="mb-1 block text-sm font-medium text-slate-700">Template</span>
                  <select name="template" class="{{ select_class }}" data-template-select>
                    {% for key, template in page_templates %}
                      <option value="{{ key }}" data-description="{{ template.description }}" {% if current_template == key %}selected{% endif %}>{{ template.label }}</option>
                    {% endfor %}
                    {% if current_template not in page_templates|keys %}
                      <option value="{{ current_template }}" selected>{{ current_template }} (not available)</option>
                    {% endif %}
                  </select>
                  <span class="mt-1 block text-xs text-slate-400" data-template-description>{{ page_templates[current_template].description ?? '' }}</span>
                </label>
              {% endif %}
              <label class="block">
                <span class="mb-1 block text-sm font-medium text-slate-700">Date</span>
                <input type="text" name="date" value="{{ meta_form.date }}" placeholder="{{ site.date_format|default('d/m/Y') }}" class="{{ input_class }}">
              </label>
              <label class="block">
                <span class="mb-1 block text-sm font-medium text-slate-700">Author</span>
                <input type="text" name="author" value="{{ meta_form.author }}" placeholder="Author" class="{{ input_class }}">
              </label>
              <label class="flex items-start justify-between gap-4 rounded-md border border-slate-200 bg-slate-50 px-3 py-2.5">
                <span>
                  <span class="block text-sm font-medium text-slate-800">Visible</span>
                  <span class="block text-xs text-slate-400">Show this entry in listings and navigation-aware views.</span>
                </span>
                <input type="checkbox" name="visible" value="1" {% if meta_form.visible %}checked{% endif %} class="{{ checkbox_class }} mt-0.5">
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if block_editor_json %}
      <div class="tab-panel hidden space-y-3" data-panel="blocks">
        <input type="hidden" name="blocks_json" value="" data-block-editor-output>
        <input type="hidden" name="blocks_editor" value="" data-block-editor-flag>
        <div data-block-editor class="space-y-3">
          <p class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">The block editor needs JavaScript. The page's blocks are kept unchanged when you save.</p>
        </div>
        <script type="application/json" id="block-editor-data">{{ block_editor_json|raw }}</script>
      </div>
    {% endif %}

    {% if not is_form %}
      <div class="tab-panel hidden space-y-4" data-panel="media">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h3 class="text-sm font-semibold text-slate-900">Main Image</h3>
            <p class="mt-0.5 text-xs text-slate-400">Pick from the media library or upload a new image.</p>
          </div>
          <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_220px]">
            <div class="grid gap-3">
              <label class="block">
                <span class="mb-1 block text-sm font-medium text-slate-700">Image URL</span>
                <input id="main-image-input" type="text" name="main_image" value="{{ main_image }}" placeholder="/uploads/your-image.jpg" class="{{ input_class }}">
              </label>
              <div class="flex flex-wrap items-center gap-2">
                <button type="button" data-media-picker-toggle class="{{ secondary_button_class }}">Media Library</button>
                <label class="{{ secondary_button_class }} cursor-pointer">
                  Upload image
                  <input id="main-image-upload" type="file" name="main_image_upload" accept="image/*" class="hidden">
                </label>
                <button type="button" data-main-image-clear class="{{ secondary_button_class }}">Clear</button>
              </div>
            </div>
            <div id="main-image-preview" class="{{ main_image ? '' : 'hidden' }} overflow-hidden rounded-md border border-slate-200 bg-slate-50">
              <img id="main-image-preview-img" src="{{ main_image }}" alt="Main image preview" class="h-40 w-full object-cover">
            </div>
          </div>
          <div id="media-picker-panel" class="mt-4 hidden rounded-md border border-slate-200 bg-slate-50 p-3">
            <div class="mb-3 text-sm font-semibold text-slate-700">Choose Existing Image</div>
            {% if media_picker_images is empty %}
              <p class="text-sm text-slate-500">No images in library yet. Upload one above.</p>
            {% else %}
              <div class="grid grid-cols-2 gap-3 md:grid-cols-4 xl:grid-cols-6">
                {% for media_item in media_picker_images %}
                  <button type="button" class="group overflow-hidden rounded-md border border-slate-200 bg-white text-left" data-media-pick="{{ media_item.direct_url }}">
                    <img src="{{ media_item.thumbnail_url ?: media_item.direct_url }}" alt="{{ media_item.original_name }}" class="h-24 w-full object-cover">
                    <span class="block truncate px-2 py-1 text-[11px] text-slate-600" title="{{ media_item.original_name }}">{{ media_item.original_name }}</span>
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      {% if type_fields is not empty %}
        {% import '@admin/partials/fields.twig' as content_fields %}
        <div class="tab-panel hidden space-y-4" data-panel="details">
          <input type="hidden" name="details_present" value="1">
          <div class="{{ section_class }}">
            <div class="{{ section_header_class }}">
              <h3 class="text-sm font-semibold text-slate-900">{{ type_definition.singular }} details</h3>
              <p class="mt-0.5 text-xs text-slate-400">{{ type_definition.description ?: 'Fields defined for this content type. They are shown on the page and can be used to filter the archive.' }}</p>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              {% for key, field in type_fields %}
                {{ content_fields.field(field, 'details[' ~ key ~ ']', type_values[key]|default(field.type == 'toggle' ? false : '')) }}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}

      {% if type != 'pages' %}
        <div class="tab-panel hidden space-y-4" data-panel="taxonomies">
          {% for taxonomy in taxonomies %}
            {% set selected_terms = meta_form.taxonomy_terms[taxonomy.name]|default([]) %}
            <div class="{{ section_class }}">
              <div class="{{ section_header_class }}">
                <h3 class="text-sm font-semibold text-slate-900">{{ taxonomy.title }}</h3>
                <p class="mt-0.5 text-xs text-slate-400">Assign taxonomy terms for this entry.</p>
              </div>
              {% if taxonomy.terms is empty %}
                <p class="text-sm text-slate-500">No terms defined yet. Add terms in <a class="text-blue-600 hover:text-blue-700" href="{{ url('admin/taxonomies?taxonomy=' ~ taxonomy.name) }}">Taxonomies</a>.</p>
              {% else %}
                <div class="grid gap-2">
                  {% for term in taxonomy.terms %}
                    {% set label = term.labels[lang]|default('') %}
                    {% if label == '' %}
                      {% set label = taxonomy_label(taxonomy.name, term.id, null) %}
                    {% endif %}
                    <label class="flex items-center gap-2 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                      <input type="checkbox" name="taxonomy_terms[{{ taxonomy.name }}][]" value="{{ term.id }}" {% if term.id in selected_terms %}checked{% endif %} class="{{ checkbox_class }}">
                      <span>{{ label }}</span>
                    </label>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="tab-panel hidden space-y-4" data-panel="custom">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h3 class="text-sm font-semibold text-slate-900">Custom Fields</h3>
            <p class="mt-0.5 text-xs text-slate-400">Extra front matter saved under custom_fields.</p>
          </div>
          <div class="grid gap-3" data-custom-fields>
            {% if meta_form.custom_fields is not empty %}
              {% for field in meta_form.custom_fields %}
                <div class="custom-field-row grid grid-cols-1 items-start gap-2 md:grid-cols-[1fr_2fr_auto]">
                  <input type="text" name="custom_keys[]" placeholder="field_name" value="{{ field.key }}" class="{{ input_class }}">
                  <textarea name="custom_values[]" rows="2" placeholder="Value" class="{{ textarea_class }}">{{ field.value }}</textarea>
                  <button type="button" class="{{ danger_button_class }} js-remove-field">Remove</button>
                </div>
              {% endfor %}
            {% else %}
              <div class="custom-field-row grid grid-cols-1 items-start gap-2 md:grid-cols-[1fr_2fr_auto]">
                <input type="text" name="custom_keys[]" placeholder="field_name" class="{{ input_class }}">
                <textarea name="custom_values[]" rows="2" placeholder="Value" class="{{ textarea_class }}"></textarea>
                <button type="button" class="{{ danger_button_class }} js-remove-field">Remove</button>
              </div>
            {% endif %}
          </div>
          <button type="button" class="{{ secondary_button_class }} js-add-field mt-3">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
            Add field
          </button>
        </div>
      </div>
    {% endif %}

