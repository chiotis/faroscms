  <script>
    (function () {
      const buttons = document.querySelectorAll('.tab-button');
      const panels = document.querySelectorAll('.tab-panel');
      const noindexToggle = document.querySelector('input[name="seo_noindex"]');
      const noindexPill = document.querySelector('[data-nonindex-pill]');
      const addFieldButton = document.querySelector('.js-add-field');
      const fieldsContainer = document.querySelector('[data-custom-fields]');
      const addFormFieldButton = document.querySelector('.js-add-form-field');
      const formFieldsContainer = document.querySelector('[data-form-fields]');
      const formFieldOptions = `{% for option in form_field_types %}<option value="{{ option }}">{{ option }}</option>{% endfor %}`;
      const mdToolbar = document.querySelector('[data-md-toolbar]');
      const mdBody = document.querySelector('[data-md-body]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-tab');
          buttons.forEach((btn) => btn.classList.toggle('active', btn === button));
          panels.forEach((panel) => {
            const on = panel.getAttribute('data-panel') === target;
            panel.classList.toggle('active', on);
            panel.classList.toggle('hidden', !on);
          });
        });
      });

      const insertAtSelection = (before, after = '') => {
        if (!mdBody) return;
        const start = mdBody.selectionStart || 0;
        const end = mdBody.selectionEnd || 0;
        const value = mdBody.value || '';
        const selected = value.slice(start, end);
        const replacement = before + selected + after;
        mdBody.value = value.slice(0, start) + replacement + value.slice(end);
        const cursor = start + before.length;
        mdBody.focus();
        if (selected.length) {
          mdBody.selectionStart = cursor;
          mdBody.selectionEnd = cursor + selected.length;
        } else {
          mdBody.selectionStart = mdBody.selectionEnd = cursor;
        }
      };

      const prefixLines = (prefix, numbered = false) => {
        if (!mdBody) return;
        const start = mdBody.selectionStart || 0;
        const end = mdBody.selectionEnd || 0;
        const value = mdBody.value || '';
        const selection = value.slice(start, end);
        if (selection === '') {
          const lineStart = value.lastIndexOf('\n', start - 1) + 1;
          mdBody.value = value.slice(0, lineStart) + prefix + value.slice(lineStart);
          const newPos = start + prefix.length;
          mdBody.focus();
          mdBody.selectionStart = mdBody.selectionEnd = newPos;
          return;
        }
        const lines = selection.split('\n');
        const updated = lines.map((line, idx) => numbered ? `${idx + 1}. ${line}` : prefix + line).join('\n');
        mdBody.value = value.slice(0, start) + updated + value.slice(end);
        mdBody.focus();
        mdBody.selectionStart = start;
        mdBody.selectionEnd = start + updated.length;
      };

      const insertSnippet = (type) => {
        if (!mdBody) return;
        if (type === 'iframe') {
          insertAtSelection('<iframe src="PASTE_URL_HERE" width="100%" height="800" frameborder="0"></iframe>');
        }
        if (type === 'button') {
          insertAtSelection('<a class="btn" href="#">Button</a>');
        }
      };

      if (mdToolbar && mdBody) {
        mdToolbar.addEventListener('click', (event) => {
          const target = event.target.closest('[data-action]');
          if (!target) return;
          const action = target.getAttribute('data-action');
          switch (action) {
            case 'h2': prefixLines('## '); break;
            case 'h3': prefixLines('### '); break;
            case 'bold': insertAtSelection('**', '**'); break;
            case 'italic': insertAtSelection('*', '*'); break;
            case 'underline': insertAtSelection('<u>', '</u>'); break;
            case 'strike': insertAtSelection('~~', '~~'); break;
            case 'ul': prefixLines('- '); break;
            case 'ol': prefixLines('', true); break;
            case 'quote': prefixLines('> '); break;
            case 'code': insertAtSelection('`', '`'); break;
            case 'link': {
              const url = prompt('Enter URL');
              if (url !== null) {
                const start = mdBody.selectionStart || 0;
                const end = mdBody.selectionEnd || 0;
                const text = mdBody.value.slice(start, end) || 'link text';
                insertAtSelection(`[${text}](${url})`);
              }
              break;
            }
            case 'image': {
              const url = prompt('Enter image URL');
              if (url !== null) {
                const alt = prompt('Enter alt text') || 'image';
                insertAtSelection(`![${alt}](${url})`);
              }
              break;
            }
          }
        });
        const snippetSelect = mdToolbar.querySelector('[data-action="snippet"]');
        if (snippetSelect) {
          snippetSelect.addEventListener('change', (event) => {
            const value = event.target.value;
            if (value) {
              insertSnippet(value);
              event.target.value = '';
            }
          });
        }
      }

      const bindRemoveButton = (button) => {
        if (!button) return;
        button.addEventListener('click', () => {
          const row = button.closest('.custom-field-row');
          if (row) row.remove();
        });
      };

      if (addFieldButton && fieldsContainer) {
        addFieldButton.addEventListener('click', () => {
          const row = document.createElement('div');
          row.className = 'custom-field-row grid grid-cols-1 items-start gap-2 md:grid-cols-[1fr_2fr_auto]';
          row.innerHTML = `
            <input type="text" name="custom_keys[]" placeholder="field_name" class="{{ input_class }}">
            <textarea name="custom_values[]" rows="2" placeholder="Value" class="{{ textarea_class }}"></textarea>
            <button type="button" class="{{ danger_button_class }} js-remove-field">Remove</button>
          `;
          fieldsContainer.appendChild(row);
          bindRemoveButton(row.querySelector('.js-remove-field'));
        });
      }

      if (addFormFieldButton && formFieldsContainer) {
        let formFieldIndex = formFieldsContainer.querySelectorAll('[data-form-field]').length || 0;
        const createFormFieldRow = (id) => {
          const row = document.createElement('div');
          row.className = 'form-field-row grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3';
          row.setAttribute('data-form-field', '1');
          row.innerHTML = `
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
              <label class="block"><span class="mb-1 block text-sm font-medium text-slate-700">Label</span><input type="text" name="form_fields[${id}][label]" placeholder="Label" class="{{ input_class }}"></label>
              <label class="block"><span class="mb-1 block text-sm font-medium text-slate-700">Name</span><input type="text" name="form_fields[${id}][name]" placeholder="field_name" class="{{ input_class }}"></label>
              <label class="block"><span class="mb-1 block text-sm font-medium text-slate-700">Type</span><select name="form_fields[${id}][type]" class="{{ select_class }}">${formFieldOptions}</select></label>
              <label class="flex items-center gap-2 pt-6 text-sm text-slate-700"><input type="checkbox" name="form_fields[${id}][required]" value="1" class="{{ checkbox_class }}"> Required</label>
            </div>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
              <input type="text" name="form_fields[${id}][placeholder]" placeholder="Placeholder" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][options]" placeholder="Option 1, Option 2" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][default]" placeholder="Default value" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][help]" placeholder="Help text" class="{{ input_class }}">
            </div>
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
              <input type="number" name="form_fields[${id}][rows]" value="4" min="1" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][min]" placeholder="Min" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][max]" placeholder="Max" class="{{ input_class }}">
              <input type="text" name="form_fields[${id}][step]" placeholder="Step" class="{{ input_class }}">
            </div>
            <div class="flex justify-end"><button type="button" class="{{ danger_button_class }} js-remove-form-field">Remove</button></div>
          `;
          return row;
        };
        addFormFieldButton.addEventListener('click', () => {
          const id = `field_${formFieldIndex++}`;
          formFieldsContainer.appendChild(createFormFieldRow(id));
        });
        formFieldsContainer.addEventListener('click', (event) => {
          const removeButton = event.target.closest('.js-remove-form-field');
          if (removeButton) {
            const row = removeButton.closest('.form-field-row');
            if (row) row.remove();
          }
        });
      }

      const syncNoindexPill = () => {
        if (!noindexPill) return;
        const enabled = !!(noindexToggle && noindexToggle.checked);
        noindexPill.classList.toggle('hidden', !enabled);
      };
      if (noindexToggle) noindexToggle.addEventListener('change', syncNoindexPill);
      syncNoindexPill();

      const mainImageInput = document.getElementById('main-image-input');
      const mainImagePreview = document.getElementById('main-image-preview');
      const mainImagePreviewImg = document.getElementById('main-image-preview-img');
      const mediaPickerToggle = document.querySelector('[data-media-picker-toggle]');
      const mediaPickerPanel = document.getElementById('media-picker-panel');
      const clearMainImageButton = document.querySelector('[data-main-image-clear]');
      const mainImageUploadInput = document.getElementById('main-image-upload');

      const syncMainImagePreview = () => {
        if (!mainImageInput || !mainImagePreview || !mainImagePreviewImg) return;
        const value = (mainImageInput.value || '').trim();
        if (value === '') {
          mainImagePreview.classList.add('hidden');
          mainImagePreviewImg.setAttribute('src', '');
          return;
        }
        mainImagePreviewImg.setAttribute('src', value);
        mainImagePreview.classList.remove('hidden');
      };

      if (mediaPickerToggle && mediaPickerPanel) {
        mediaPickerToggle.addEventListener('click', () => {
          mediaPickerPanel.classList.toggle('hidden');
        });
      }
      if (mainImageInput) mainImageInput.addEventListener('input', syncMainImagePreview);
      if (clearMainImageButton && mainImageInput) {
        clearMainImageButton.addEventListener('click', () => {
          mainImageInput.value = '';
          syncMainImagePreview();
        });
      }
      if (mainImageUploadInput && mainImagePreviewImg && mainImagePreview) {
        mainImageUploadInput.addEventListener('change', () => {
          const file = mainImageUploadInput.files && mainImageUploadInput.files[0];
          if (!file) return;
          mainImageInput.value = '';
          mainImagePreviewImg.setAttribute('src', URL.createObjectURL(file));
          mainImagePreview.classList.remove('hidden');
        });
      }
      document.querySelectorAll('[data-media-pick]').forEach((button) => {
        button.addEventListener('click', () => {
          const url = button.getAttribute('data-media-pick') || '';
          if (!url || !mainImageInput) return;
          mainImageInput.value = url;
          syncMainImagePreview();
          if (mediaPickerPanel) mediaPickerPanel.classList.add('hidden');
        });
      });
      syncMainImagePreview();

      document.querySelectorAll('.js-remove-field').forEach(bindRemoveButton);
    })();
  </script>
