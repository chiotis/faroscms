<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>{{ title|default('Admin') }} - FarosCMS</title>
  <link rel="stylesheet" href="{{ url('assets/css/admin.build.css') }}">
  <link rel="stylesheet" href="{{ url('assets/css/app.css') }}">
</head>
<body class="h-full bg-slate-100 font-sans text-slate-800 antialiased">
  {% set current_type = current_type|default('pages') %}
  {% set types = types|default([]) %}
  {% set section = admin_section|default('content') %}
  {% set current_user = user|default(null) %}
  {% set display_name = current_user.display_name|default(current_user.username|default('Admin')) %}
  {% set role = current_user.role|default('admin') %}
  {% set initials = display_name|split(' ')|map(part => part|first)|join('')|slice(0, 2)|upper %}
  {% set nav_base = 'group flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium transition' %}
  {% set nav_active = 'bg-slate-900 text-white' %}
  {% set nav_idle = 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %}
  {% set is_content_section = section == 'content' %}
  {% set page_context = is_content_section ? current_type|title : section|title %}
  {% set storage_summary = admin_storage_summary|default({'label': 'local', 'percent': 0}) %}
  {% set notifications = admin_notifications|default([]) %}
  {% set unread_notifications = admin_notification_unread_count|default(0) %}
  {% set admin_current_url = admin_current_url|default('/admin') %}

  <div class="flex h-full">
    <div data-sidebar-backdrop class="fixed inset-0 z-30 hidden bg-slate-900/40 lg:hidden"></div>

    <aside data-sidebar class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 lg:static lg:translate-x-0">
      <div class="flex h-14 shrink-0 items-center gap-2.5 border-b border-slate-200 px-4">
        <span class="min-w-0 truncate text-sm font-semibold tracking-tight text-slate-900" title="{{ site.title|default('FarosCMS') }}">{{ site.title|default('FarosCMS') }}</span>
        {% if admin_update_available|default(false) and can('updates.manage') %}
          <a href="{{ url('admin/updates') }}" class="ml-auto inline-flex shrink-0 items-center gap-1 rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-medium text-blue-700 ring-1 ring-inset ring-blue-200 hover:bg-blue-100" title="FarosCMS {{ admin_update_latest }} is available">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>FarosCMS v{{ admin_version|default('base') }}
          </a>
        {% else %}
          <span class="ml-auto shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium text-slate-500" title="Installed FarosCMS version">FarosCMS v{{ admin_version|default('base') }}</span>
        {% endif %}
        <button type="button" data-sidebar-close class="ml-1 rounded p-1 text-slate-400 hover:bg-slate-100 lg:hidden" aria-label="Close sidebar">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <nav class="scroll-thin flex-1 overflow-y-auto px-3 py-3">
        {% if can('dashboard.view') %}
          <p class="px-2 pb-1.5 pt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Overview</p>
          <a href="{{ url('admin') }}" class="{{ nav_base }} {{ section == 'dashboard' ? nav_active : nav_idle }}"{% if section == 'dashboard' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'dashboard' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"/></svg>
            Dashboard
          </a>
        {% endif %}

        {% if can('content.manage') or can('media.manage') %}
          <p class="px-2 pb-1.5 pt-3 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Content</p>
        {% endif %}
        {% if can('content.manage') %}
          {% set type_icons = {
            'pages': '<path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v12a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5M9 13h6M9 17h6"/>',
            'posts': '<path stroke-linecap="round" stroke-linejoin="round" d="M4 5h12a1 1 0 011 1v12a2 2 0 002 2H6a2 2 0 01-2-2V5zM17 9h3v9a2 2 0 01-2 2M8 9h5M8 13h5M8 17h3"/>',
            'projects': '<path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>'
          } %}
          {% for t in types %}
            {% if t != 'forms' %}
              {% set type_active = is_content_section and t == current_type %}
              <a href="{{ url('admin/content?type=' ~ t) }}" class="{{ nav_base }} {{ type_active ? nav_active : nav_idle }}"{% if type_active %} aria-current="page"{% endif %}>
                <svg class="h-4 w-4 {{ type_active ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">{{ (type_icons[t] ?? '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h10"/>')|raw }}</svg>
                {{ t|title }}
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if can('media.manage') %}
          <a href="{{ url('admin/media') }}" class="{{ nav_base }} {{ section == 'media' ? nav_active : nav_idle }}"{% if section == 'media' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'media' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7a2 2 0 012-2h4l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H6a2 2 0 01-2-2V7z"/></svg>
            Media
          </a>
        {% endif %}

        <p class="px-2 pb-1.5 pt-3 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Manage</p>
        {% if can('forms.manage') %}
          <a href="{{ url('admin/forms') }}" class="{{ nav_base }} {{ section == 'forms' ? nav_active : nav_idle }}"{% if section == 'forms' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'forms' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            Forms
          </a>
        {% endif %}
        {% if can('menus.manage') %}
          <a href="{{ url('admin/menus') }}" class="{{ nav_base }} {{ section == 'menus' ? nav_active : nav_idle }}"{% if section == 'menus' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'menus' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            Menus
          </a>
        {% endif %}
        {% if can('taxonomies.manage') %}
          <a href="{{ url('admin/taxonomies') }}" class="{{ nav_base }} {{ section == 'taxonomies' ? nav_active : nav_idle }}"{% if section == 'taxonomies' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'taxonomies' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3H5a2 2 0 00-2 2v6l9 9a2 2 0 002.8 0l4.6-4.6a2 2 0 000-2.8L11 3zM7 7h.01"/></svg>
            Taxonomies
          </a>
        {% endif %}

        {% if can('content.manage') %}
          <a href="{{ url('admin/revisions') }}" class="{{ nav_base }} {{ section == 'history' ? nav_active : nav_idle }}"{% if section == 'history' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'history' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 109-9 9 9 0 00-6.7 3M3 4v4h4M12 7v5l3 2"/></svg>
            History
          </a>
        {% endif %}

        <p class="px-2 pb-1.5 pt-3 text-[10px] font-semibold uppercase tracking-wider text-slate-400">System</p>
        {% if can('users.manage') or can('roles.manage') %}
          {# One entry for users and roles; the tabs inside pick which. #}
          {% set in_people = section in ['users', 'roles'] %}
          <a href="{{ url(can('users.manage') ? 'admin/users' : 'admin/roles') }}" class="{{ nav_base }} {{ in_people ? nav_active : nav_idle }}"{% if in_people %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ in_people ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 14a4 4 0 10-8 0M12 7a3 3 0 110 0M3 20a6 6 0 0118 0"/></svg>
            Users &amp; Roles
          </a>
        {% endif %}
        {% if can('activity.manage') or can('email_logs.manage') %}
          {# One entry for both logs; the tabs inside pick which. #}
          {% set in_logs = section in ['activity', 'email_logs'] %}
          <a href="{{ url(can('activity.manage') ? 'admin/activity-logs' : 'admin/email-logs') }}" class="{{ nav_base }} {{ in_logs ? nav_active : nav_idle }}"{% if in_logs %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ in_logs ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6M9 12h6M9 17h3M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
            Logs
          </a>
        {% endif %}
        {% if can('backups.manage') %}
          <a href="{{ url('admin/backups') }}" class="{{ nav_base }} {{ section == 'backups' ? nav_active : nav_idle }}"{% if section == 'backups' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'backups' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3zM4 7v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg>
            Backups
          </a>
        {% endif %}
        {% if can('updates.manage') %}
          <a href="{{ url('admin/updates') }}" class="{{ nav_base }} {{ section == 'updates' ? nav_active : nav_idle }}"{% if section == 'updates' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'updates' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M20 9A8 8 0 006.2 5.3M4 15a8 8 0 0013.8 3.7"/></svg>
            Updates
          </a>
        {% endif %}
        {% if can('settings.manage') %}
          <a href="{{ url('admin/settings') }}" class="{{ nav_base }} {{ section == 'settings' ? nav_active : nav_idle }}"{% if section == 'settings' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'settings' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-2.82 1.17V21a2 2 0 11-4 0v-.09A1.65 1.65 0 007 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 14a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 7.51l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6h.09A1.65 1.65 0 0011 3.09V3a2 2 0 114 0v.09a1.65 1.65 0 002.51 1.51h.09a1.65 1.65 0 011.82.33l.06.06a2 2 0 11-2.83 2.83"/></svg>
            Settings
          </a>
        {% endif %}
        {% if can('settings.manage') %}
          <a href="{{ url('admin/content-types') }}" class="{{ nav_base }} {{ section == 'content-types' ? nav_active : nav_idle }}">
            <svg class="h-4 w-4 {{ section == 'content-types' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3 3 8l9 5 9-5-9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5"/></svg>
            Content types
          </a>
        {% endif %}
        {% if can('redirects.manage') %}
          <a href="{{ url('admin/redirects') }}" class="{{ nav_base }} {{ section == 'redirects' ? nav_active : nav_idle }}"{% if section == 'redirects' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'redirects' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h13M13 7l5 5-5 5M4 6v12"/></svg>
            Redirects
          </a>
        {% endif %}
        {% if can('translations.manage') %}
          <a href="{{ url('admin/translations') }}" class="{{ nav_base }} {{ section == 'translations' ? nav_active : nav_idle }}"{% if section == 'translations' %} aria-current="page"{% endif %}>
            <svg class="h-4 w-4 {{ section == 'translations' ? 'text-white/80' : 'text-slate-400 group-hover:text-slate-600' }}" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2c0 4.418-2.686 8-6 8m4-3c0 2.21 2.91 4 6.5 4M14 21l4.5-9 4.5 9m-7.65-2h6.3"/></svg>
            Translations
          </a>
        {% endif %}
      </nav>

      <div class="shrink-0 border-t border-slate-200 p-3">
        <a href="{{ url('') }}" target="_blank" rel="noopener" class="mb-2 flex items-center justify-center rounded-md border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50">View site</a>
        <div class="rounded-md bg-slate-50 p-2.5">
          <div class="flex items-center justify-between text-[11px] font-medium text-slate-500">
            <span>Storage</span><span class="{{ storage_summary.level|default('ok') == 'danger' ? 'font-semibold text-red-600' : (storage_summary.level|default('ok') == 'warn' ? 'font-semibold text-orange-600' : '') }}">{{ storage_summary.label }}</span>
          </div>
          <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="Storage used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ storage_summary.percent|default(0) }}">
            <div class="h-full rounded-full transition-all {{ storage_summary.level|default('ok') == 'danger' ? 'bg-red-500' : (storage_summary.level|default('ok') == 'warn' ? 'bg-orange-500' : 'bg-slate-900') }}" style="width: {{ storage_summary.percent|default(0) }}%"></div>
          </div>
        </div>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="sticky top-0 z-20 flex h-14 shrink-0 items-center gap-3 border-b border-slate-200 bg-white/90 px-4 backdrop-blur">
        <button type="button" data-toggle="sidebar" class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 lg:hidden" aria-label="Open sidebar">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <div class="min-w-0">
          <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">{{ page_heading|default(title|default(page_context)) }}</h1>
        </div>

        <div class="ml-auto flex items-center gap-2">
          {% if can('content.manage') %}
            <form method="get" action="{{ url('admin/search') }}" class="hidden md:block" role="search">
              <label class="relative block">
                <span class="sr-only">Search content</span>
                <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"/></svg>
                <input type="search" name="q" value="{{ section == 'search' ? query|default('') : '' }}" placeholder="Search content…" class="w-48 rounded-md border border-slate-200 bg-slate-50 py-1.5 pl-8 pr-2 text-sm text-slate-700 placeholder:text-slate-400 focus:w-64 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/5">
              </label>
            </form>
          {% endif %}
          {% if can('notifications.manage') %}
            <div data-dropdown class="relative">
              <button type="button" data-dropdown-trigger class="relative rounded-md p-1.5 text-slate-500 hover:bg-slate-100" aria-label="Notifications">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0a3 3 0 11-6 0"/></svg>
                {% if unread_notifications > 0 %}
                  <span class="absolute right-1 top-1 h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                {% endif %}
              </button>
              <div data-dropdown-menu class="absolute right-0 z-30 mt-1.5 hidden w-80 max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-md border border-slate-200 bg-white shadow-lg">
                <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-3 py-2.5">
                  <div class="flex min-w-0 items-center gap-2">
                    <p class="text-sm font-semibold text-slate-900">Notifications</p>
                    {% if unread_notifications > 0 %}
                      <span class="rounded-full bg-blue-100 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700">{{ unread_notifications }} new</span>
                    {% endif %}
                  </div>
                  {% if unread_notifications > 0 %}
                    <form method="post" action="{{ url('admin/notifications-read-all') }}">
                      {{ csrf_field() }}
                      <input type="hidden" name="return_to" value="{{ admin_current_url }}">
                      <button type="submit" class="text-xs font-medium text-blue-600 hover:text-blue-700">Mark all read</button>
                    </form>
                  {% endif %}
                </div>
                <div class="scroll-thin max-h-80 divide-y divide-slate-50 overflow-y-auto">
                  {% if notifications is empty %}
                    <div class="px-3 py-8 text-center text-sm text-slate-400">No notifications.</div>
                  {% else %}
                    {% for notification in notifications %}
                      {% set is_unread = notification.is_read|default(0) == 0 %}
                      {% set severity = notification.severity|default('info') %}
                      {% set tone = severity == 'error' ? 'bg-red-50 text-red-600' : (severity == 'warning' ? 'bg-amber-50 text-amber-600' : (severity == 'success' ? 'bg-emerald-50 text-emerald-600' : 'bg-blue-50 text-blue-600')) %}
                      {% set target_url = notification.target_url|default(admin_current_url) ?: admin_current_url %}
                      <form method="post" action="{{ url('admin/notification-read') }}">
                        {{ csrf_field() }}
                        <input type="hidden" name="id" value="{{ notification.id }}">
                        <input type="hidden" name="target_url" value="{{ target_url }}">
                        <button type="submit" class="flex w-full gap-2.5 px-3 py-2.5 text-left hover:bg-slate-50 {{ is_unread ? 'bg-blue-50/30' : '' }}">
                          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full {{ tone }}">
                            {% if severity == 'error' %}
                              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 4.4L2.8 17.3A2 2 0 004.5 20h15a2 2 0 001.7-2.7L13.7 4.4a2 2 0 00-3.4 0z"/></svg>
                            {% elseif severity == 'warning' %}
                              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v5m0 4h.01M4 19h16L12 4 4 19z"/></svg>
                            {% elseif severity == 'success' %}
                              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {% else %}
                              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 3a9 9 0 110 18 9 9 0 010-18z"/></svg>
                            {% endif %}
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="flex items-start justify-between gap-2">
                              <span class="truncate text-sm font-medium text-slate-800">{{ notification.title }}</span>
                              {% if is_unread %}
                                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                              {% endif %}
                            </span>
                            <span class="block truncate text-xs text-slate-500">{{ notification.body|default('') }}</span>
                            <span class="mt-0.5 block text-[11px] text-slate-400">{{ notification.created_at }}</span>
                          </span>
                        </button>
                      </form>
                    {% endfor %}
                  {% endif %}
                </div>
                <a href="{{ url('admin/activity-logs?subject_type=notification') }}" class="block border-t border-slate-100 px-3 py-2 text-center text-xs font-medium text-slate-600 hover:bg-slate-50">View notification activity</a>
              </div>
            </div>
          {% endif %}

          <div class="mx-1 h-6 w-px bg-slate-200"></div>

          <div data-dropdown class="relative">
            <button type="button" data-dropdown-trigger class="flex items-center gap-2 rounded-md px-1.5 py-1 hover:bg-slate-100">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white">{{ initials ?: 'AD' }}</span>
              <span class="hidden text-left sm:block">
                <span class="block text-xs font-semibold leading-tight text-slate-900">{{ display_name }}</span>
                <span class="block text-[10px] leading-tight text-slate-400">{{ role }}</span>
              </span>
              <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 9l6 6 6-6"/></svg>
            </button>
            <div data-dropdown-menu class="absolute right-0 z-30 mt-1.5 hidden w-52 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
              <div class="border-b border-slate-100 px-3 py-2">
                <p class="text-sm font-medium text-slate-900">{{ display_name }}</p>
                <p class="truncate text-xs text-slate-400">{{ current_user.username|default('admin') }}</p>
              </div>
              <a href="{{ url('admin/users-edit?id=' ~ current_user.id|default(0)) }}" class="block px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50">Your profile</a>
              {% if can('settings.manage') %}
                <a href="{{ url('admin/settings') }}" class="block px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50">Settings</a>
                <a href="{{ url('admin/system') }}" class="block px-3 py-1.5 text-sm hover:bg-slate-50 {{ section == 'system' ? 'font-medium text-slate-900' : 'text-slate-600' }}"{% if section == 'system' %} aria-current="page"{% endif %}>System</a>
              {% endif %}
              <div class="my-1 border-t border-slate-100"></div>
              <form method="post" action="{{ url('admin/logout') }}">
                {{ csrf_field() }}
                <button type="submit" class="block w-full px-3 py-1.5 text-left text-sm text-red-600 hover:bg-red-50">Sign out</button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <main class="scroll-thin flex-1 overflow-y-auto p-4 lg:p-6">
        {% if admin_default_password|default(false) %}
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            <span><strong class="font-semibold">Default password in use.</strong> This account still uses the password shipped with FarosCMS. Change it before this site is reachable by anyone else.</span>
            <a href="{{ url('admin/users-edit?id=' ~ current_user.id|default(0)) }}" class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700">Change password</a>
          </div>
        {% endif %}
        {% if storage_summary.level|default('ok') == 'danger' %}
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert" data-storage-alert>
            <span><strong class="font-semibold">Storage {{ storage_summary.full ? 'is full' : 'is almost full' }}.</strong> {{ storage_summary.label }} is in use ({{ storage_summary.percent_of_limit }}% of the limit).{% if storage_summary.full %} New uploads are blocked until space is freed{% if can('limits.manage') %} or the limit is raised{% else %} or the limit is raised by the super admin{% endif %}.{% else %} Free some space{% if can('limits.manage') %} or raise the limit{% else %} or ask the super admin to raise the limit{% endif %} before it runs out.{% endif %}</span>
            {% if can('limits.manage') %}
              <a href="{{ url('admin/settings?tab=limits') }}" class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700">Change the limit</a>
            {% elseif admin_storage_contact %}
              <a href="{{ admin_storage_contact.href }}" class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700">Contact {{ admin_storage_contact.name }}</a>
            {% endif %}
          </div>
        {% endif %}
        {% set input_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
        {% set select_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
        {% set textarea_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
        {% set checkbox_class = 'h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400' %}
        {% set file_class = 'block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-700' %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>

  <div data-toast-host class="pointer-events-none fixed bottom-4 right-4 z-50 flex w-80 max-w-[calc(100vw-2rem)] flex-col gap-2"></div>

  <script src="{{ url('assets/js/admin.js') }}"></script>
  <script src="{{ url('assets/js/admin-icons.js') }}" defer></script>
  <script>
    (function () {
      const syncTabState = () => {
        const buttons = document.querySelectorAll('.tab-button');
        const panels = document.querySelectorAll('.tab-panel');

        buttons.forEach((button) => {
          const active = button.classList.contains('active');
          button.classList.toggle('bg-slate-200', active);
          button.classList.toggle('border-slate-400', active);
          button.classList.toggle('text-slate-900', active);
          button.classList.toggle('bg-white', !active);
          button.classList.toggle('border-slate-300', !active);
          button.classList.toggle('text-slate-600', !active);
        });

        panels.forEach((panel) => {
          const active = panel.classList.contains('active');
          panel.classList.toggle('hidden', !active);
          panel.classList.toggle('block', active);
        });
      };

      const setupHelpTips = () => {
        const tips = document.querySelectorAll('.help-tip[data-tip]');
        if (!tips.length) return;

        let flyout = document.getElementById('admin-help-tip-flyout');
        if (!flyout) {
          flyout = document.createElement('div');
          flyout.id = 'admin-help-tip-flyout';
          flyout.className = 'pointer-events-none fixed z-[999] hidden max-w-xs rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-700 shadow';
          document.body.appendChild(flyout);
        }

        tips.forEach((tip) => {
          if (tip.dataset.helpBound === '1') return;
          tip.dataset.helpBound = '1';

          const show = () => {
            flyout.textContent = tip.getAttribute('data-tip') || '';
            const rect = tip.getBoundingClientRect();
            flyout.style.left = `${Math.round(rect.left + rect.width / 2)}px`;
            flyout.style.top = `${Math.round(rect.top - 10)}px`;
            flyout.style.transform = 'translate(-50%, -100%)';
            flyout.classList.remove('hidden');
          };

          const hide = () => flyout.classList.add('hidden');

          tip.addEventListener('mouseenter', show);
          tip.addEventListener('focus', show);
          tip.addEventListener('mouseleave', hide);
          tip.addEventListener('blur', hide);
        });
      };

      const setupMetaImageTooltips = () => {
        const icons = document.querySelectorAll('.meta-icon');
        icons.forEach((icon) => {
          if (icon.dataset.tooltipBound === '1') return;
          const tooltip = icon.querySelector('.meta-tooltip');
          if (!tooltip) return;
          icon.dataset.tooltipBound = '1';

          const show = (event) => {
            const x = event.clientX || icon.getBoundingClientRect().right;
            const y = event.clientY || (icon.getBoundingClientRect().top + icon.getBoundingClientRect().height / 2);
            tooltip.style.left = `${x + 12}px`;
            tooltip.style.top = `${y}px`;
            tooltip.style.transform = 'translateY(-50%)';
            tooltip.classList.remove('hidden');
            tooltip.classList.add('block');
          };

          const move = (event) => {
            tooltip.style.left = `${event.clientX + 12}px`;
            tooltip.style.top = `${event.clientY}px`;
          };

          const hide = () => {
            tooltip.classList.add('hidden');
            tooltip.classList.remove('block');
          };

          icon.addEventListener('mouseenter', show);
          icon.addEventListener('mousemove', move);
          icon.addEventListener('mouseleave', hide);
          icon.addEventListener('blur', hide);
        });
      };

      syncTabState();
      setupHelpTips();
      setupMetaImageTooltips();

      document.addEventListener('click', (event) => {
        if (event.target.closest('.tab-button')) {
          requestAnimationFrame(syncTabState);
        }
      });
    })();
  </script>
</body>
</html>
