<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title|default('Admin') }}</title>
  <script>
    window.tailwind = window.tailwind || {};
    window.tailwind.config = {
      safelist: [
        'hidden',
        'block',
        'bg-slate-200',
        'bg-white',
        'border-slate-400',
        'border-slate-300',
        'text-slate-900',
        'text-slate-600'
      ]
    };
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
  <div class="min-h-screen">
    <aside class="fixed inset-y-0 left-0 z-30 flex w-[240px] flex-col border-r border-slate-800 bg-[#071538] text-slate-100">
      <div class="border-b border-slate-800 px-4 py-5">
        <div class="text-3xl font-semibold leading-[0.95] tracking-tight">{{ site.title|default('FarosCMS') }}</div>
      </div>

      <nav class="grid flex-1 content-start gap-2 overflow-y-auto px-2 py-4">
        {% set current_type = current_type|default('pages') %}
        {% set types = types|default([]) %}
        {% set section = admin_section|default('content') %}

        {% if types is empty %}
          <a
            class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'content' and current_type == 'pages' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}"
            href="{{ url('admin?type=pages') }}"
          >Pages</a>
        {% else %}
          {% for t in types %}
            <a
              class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'content' and t == current_type %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}"
              href="{{ url('admin?type=' ~ t) }}"
            >{{ t|title }}</a>
          {% endfor %}
        {% endif %}

        <a class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'menus' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}" href="{{ url('admin/menus') }}">Menus</a>
        <a class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'taxonomies' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}" href="{{ url('admin/taxonomies') }}">Taxonomies</a>
        <a class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'media' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}" href="{{ url('admin/media') }}">Media Library</a>
        <a class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'settings' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}" href="{{ url('admin/settings') }}">Settings</a>
        <a class="block rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition {% if section == 'translations' %}bg-slate-600/60 text-white{% else %}text-slate-100 hover:bg-slate-700/60 hover:text-white{% endif %}" href="{{ url('admin/translations') }}">Translations</a>
      </nav>

      <div class="shrink-0 border-t border-slate-800 px-2 py-3">
        <div class="grid gap-1">
          <a class="block rounded-lg px-6 py-3 text-base font-medium text-slate-100 no-underline transition hover:bg-slate-700/60 hover:text-white" href="{{ url('') }}" target="_blank" rel="noopener">View site</a>
          <a class="block rounded-lg px-6 py-3 text-base font-medium text-slate-100 no-underline transition hover:bg-slate-700/60 hover:text-white" href="{{ url('admin/logout') }}">Logout</a>
        </div>
      </div>
    </aside>

    <main class="ml-[240px] min-w-0 overflow-x-hidden bg-slate-100 px-5 py-5 pr-24 md:px-6 md:pr-28">
      {% set input_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
      {% set select_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
      {% set textarea_class = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
      {% set checkbox_class = 'h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400' %}
      {% set file_class = 'block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-700' %}
      {% block content %}{% endblock %}
    </main>
  </div>

  <aside class="fixed inset-y-0 right-0 z-40 w-[76px] border-l border-slate-200 bg-white">
    <div class="flex h-full flex-col items-center justify-end gap-3 px-2 py-4">
      <a
        href="{{ url('admin/translations') }}"
        class="inline-flex h-12 w-12 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-700 shadow-sm transition hover:bg-slate-100"
        title="Translations"
        aria-label="Translations"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 5h7"></path>
          <path d="M7.5 3v2c0 4-1.5 7-4 9"></path>
          <path d="M3.5 14c2.5 1.5 5 2 7.5 2"></path>
          <path d="M14 5h6"></path>
          <path d="M17 5v14"></path>
          <path d="m14 14 3-5 3 5"></path>
        </svg>
      </a>
      <a
        href="{{ url('admin/settings') }}"
        class="inline-flex h-12 w-12 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-700 shadow-sm transition hover:bg-slate-100"
        title="Settings"
        aria-label="Settings"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true"><path d="M6.17071 18C6.58254 16.8348 7.69378 16 9 16C10.3062 16 11.4175 16.8348 11.8293 18H22V20H11.8293C11.4175 21.1652 10.3062 22 9 22C7.69378 22 6.58254 21.1652 6.17071 20H2V18H6.17071ZM12.1707 11C12.5825 9.83481 13.6938 9 15 9C16.3062 9 17.4175 9.83481 17.8293 11H22V13H17.8293C17.4175 14.1652 16.3062 15 15 15C13.6938 15 12.5825 14.1652 12.1707 13H2V11H12.1707ZM6.17071 4C6.58254 2.83481 7.69378 2 9 2C10.3062 2 11.4175 2.83481 11.8293 4H22V6H11.8293C11.4175 7.16519 10.3062 8 9 8C7.69378 8 6.58254 7.16519 6.17071 6H2V4H6.17071ZM9 6C9.55228 6 10 5.55228 10 5C10 4.44772 9.55228 4 9 4C8.44772 4 8 4.44772 8 5C8 5.55228 8.44772 6 9 6ZM15 13C15.5523 13 16 12.5523 16 12C16 11.4477 15.5523 11 15 11C14.4477 11 14 11.4477 14 12C14 12.5523 14.4477 13 15 13ZM9 20C9.55228 20 10 19.5523 10 19C10 18.4477 9.55228 18 9 18C8.44772 18 8 18.4477 8 19C8 19.5523 8.44772 20 9 20Z"></path></svg>
      </a>
      <a
        href="{{ url('admin/logout') }}"
        class="inline-flex h-12 w-12 items-center justify-center rounded-md border border-slate-300 bg-white text-slate-700 shadow-sm transition hover:bg-slate-100"
        title="Logout"
        aria-label="Logout"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <path d="m16 17 5-5-5-5"></path>
          <path d="M21 12H9"></path>
        </svg>
      </a>
    </div>
  </aside>

  <script>
    (function () {
      const syncTabState = () => {
        const buttons = document.querySelectorAll('.tab-button');
        const panels = document.querySelectorAll('.tab-panel');

        buttons.forEach((button) => {
          const active = button.classList.contains('active');
          button.classList.toggle('bg-slate-200', active);
          button.classList.toggle('border-slate-400', active);
          button.classList.toggle('text-slate-900', active);
          button.classList.toggle('bg-white', !active);
          button.classList.toggle('border-slate-300', !active);
          button.classList.toggle('text-slate-600', !active);
        });

        panels.forEach((panel) => {
          const active = panel.classList.contains('active');
          panel.classList.toggle('hidden', !active);
          panel.classList.toggle('block', active);
        });
      };

      const setupHelpTips = () => {
        const tips = document.querySelectorAll('.help-tip[data-tip]');
        if (!tips.length) return;

        let flyout = document.getElementById('admin-help-tip-flyout');
        if (!flyout) {
          flyout = document.createElement('div');
          flyout.id = 'admin-help-tip-flyout';
          flyout.className = 'pointer-events-none fixed z-[999] hidden max-w-xs rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-700 shadow';
          document.body.appendChild(flyout);
        }

        tips.forEach((tip) => {
          if (tip.dataset.helpBound === '1') return;
          tip.dataset.helpBound = '1';

          const show = () => {
            flyout.textContent = tip.getAttribute('data-tip') || '';
            const rect = tip.getBoundingClientRect();
            flyout.style.left = `${Math.round(rect.left + rect.width / 2)}px`;
            flyout.style.top = `${Math.round(rect.top - 10)}px`;
            flyout.style.transform = 'translate(-50%, -100%)';
            flyout.classList.remove('hidden');
          };

          const hide = () => flyout.classList.add('hidden');

          tip.addEventListener('mouseenter', show);
          tip.addEventListener('focus', show);
          tip.addEventListener('mouseleave', hide);
          tip.addEventListener('blur', hide);
        });
      };

      const setupMetaImageTooltips = () => {
        const icons = document.querySelectorAll('.meta-icon');
        icons.forEach((icon) => {
          if (icon.dataset.tooltipBound === '1') return;
          const tooltip = icon.querySelector('.meta-tooltip');
          if (!tooltip) return;
          icon.dataset.tooltipBound = '1';

          const show = (event) => {
            const x = event.clientX || icon.getBoundingClientRect().right;
            const y = event.clientY || (icon.getBoundingClientRect().top + icon.getBoundingClientRect().height / 2);
            tooltip.style.left = `${x + 12}px`;
            tooltip.style.top = `${y}px`;
            tooltip.style.transform = 'translateY(-50%)';
            tooltip.classList.remove('hidden');
            tooltip.classList.add('block');
          };

          const move = (event) => {
            tooltip.style.left = `${event.clientX + 12}px`;
            tooltip.style.top = `${event.clientY}px`;
          };

          const hide = () => {
            tooltip.classList.add('hidden');
            tooltip.classList.remove('block');
          };

          icon.addEventListener('mouseenter', show);
          icon.addEventListener('mousemove', move);
          icon.addEventListener('mouseleave', hide);
          icon.addEventListener('blur', hide);
        });
      };

      syncTabState();
      setupHelpTips();
      setupMetaImageTooltips();

      document.addEventListener('click', (event) => {
        if (event.target.closest('.tab-button')) {
          requestAnimationFrame(syncTabState);
        }
      });
    })();
  </script>
</body>
</html>
