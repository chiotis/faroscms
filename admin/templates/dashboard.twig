{% extends '@admin/base.twig' %}

{#
  Admin > Dashboard: what to do next (the shortcuts), the figures that matter, what needs attention (DashboardAttention), the
  visitors of the last 90 days when the site's own analytics are on, then the recent content, drafts, activity and the health of
  the system. Each part is for the people who may see it; an editor's dashboard is about content only.
#}
{% block content %}
  {% import '@admin/partials/analytics-parts.twig' as an %}
  {% import '@admin/partials/dashboard-parts.twig' as dp %}

  {% set card = 'lc-card rounded-xl border border-slate-200 bg-white' %}
  {% set card_title = 'm-0 text-sm font-semibold text-slate-900' %}
  {% set link = 'text-xs font-medium text-blue-700 hover:underline' %}
  {% set btn = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set btn_primary = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set status = dashboard.system_status.status %}
  {% set status_color = status == 'error' ? 'text-red-700' : (status == 'warning' ? 'text-amber-700' : 'text-emerald-700') %}
  {% set status_dot = status == 'error' ? 'bg-red-500' : (status == 'warning' ? 'bg-amber-500' : 'bg-emerald-500') %}
  {% set hour = 'now'|date('G') %}
  {% set who = (user.display_name|default(user.username|default('')))|split(' ')|first %}
  {% set attention = dashboard.attention %}
  {% set shown = 6 %}

  <header class="db-bar">
    <p class="db-hello"><strong>{{ hour < 12 ? 'Good morning' : (hour < 18 ? 'Good afternoon' : 'Good evening') }}{{ who ? ', ' ~ who : '' }}</strong><span>{{ 'now'|date('l j F') }}</span></p>
    <div class="flex flex-wrap gap-2">
      {% for c in create %}<a class="{{ loop.first ? btn_primary : btn }}" href="{{ url('admin/new?type=' ~ c.type) }}"><span aria-hidden="true">+</span> {{ c.label|title }}</a>{% endfor %}
    </div>
  </header>

  <div class="db-tiles">
    <a class="db-tile" href="{{ url('admin/content') }}">
      <span>Content entries</span>
      <strong>{{ dashboard.content_total }}</strong>
      <small>{{ dashboard.content_published }} published · {{ dashboard.content_draft }} {{ dashboard.content_draft == 1 ? 'draft' : 'drafts' }}</small>
    </a>
    {% if can('forms.manage') and dashboard.submissions_week is not null %}
    <a class="db-tile" href="{{ url('admin/forms') }}">
      <span>Form submissions</span>
      <strong>{{ dashboard.submissions_week }}</strong>
      <small>in the last 7 days</small>
    </a>
    {% endif %}
    {% if can('settings.manage') %}
    {% set st = dashboard.storage %}
    {% set st_text = st.level == 'danger' ? 'text-red-600' : (st.level == 'warn' ? 'text-orange-600' : 'text-slate-900') %}
    <a class="db-tile" href="{{ url('admin/system') }}">
      <span>Storage</span>
      <strong class="{{ st_text }}">{{ st.percent_of_limit ?? st.percent }}%</strong>
      <div class="db-bar-track" role="progressbar" aria-label="Storage used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ st.percent }}">
        <div class="h-full rounded-full transition-all {{ st.level == 'danger' ? 'bg-red-500' : (st.level == 'warn' ? 'bg-orange-500' : 'bg-slate-900') }}" style="width: {{ st.percent }}%"></div>
      </div>
      <small>{{ st.used_human }} used · {% if st.limit %}Limit {{ st.limit_human }}{% else %}{{ st.disk_free_human }} free disk{% endif %}</small>
    </a>
    {% endif %}
    {% if can('backups.manage') %}
    <a class="db-tile" href="{{ url('admin/backups') }}">
      <span>Backups</span>
      <strong>{{ dashboard.backups_total }}</strong>
      <small>{{ dashboard.last_backup ? 'Last ' ~ dashboard.last_backup.created_at : 'None yet' }}</small>
    </a>
    {% endif %}
    {% if can('settings.manage') %}
    <a class="db-tile" href="{{ url('admin/system') }}">
      <span>System status</span>
      <strong class="{{ status_color }}">{{ dashboard.system_status.label }}</strong>
      <small><i class="db-dot {{ status_dot }}" aria-hidden="true"></i>{{ dashboard.system_status.detail }}</small>
    </a>
    {% endif %}
  </div>

  <section class="{{ card }} db-attn" aria-labelledby="db-h-attn">
    <div class="db-head">
      <h2 id="db-h-attn" class="{{ card_title }}">Needs attention{% if attention %} <span class="db-count">{{ attention|length }}</span>{% endif %}</h2>
    </div>
    {% if attention is empty %}
      <p class="db-clear"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Nothing needs your attention right now.</p>
    {% else %}
      <ul class="db-items">
        {% for a in attention|slice(0, shown) %}{{ dp.item(a) }}{% endfor %}
      </ul>
      {% if attention|length > shown %}
        <details class="db-more">
          <summary>Show {{ attention|length - shown }} more</summary>
          <ul class="db-items">{% for a in attention|slice(shown) %}{{ dp.item(a) }}{% endfor %}</ul>
        </details>
      {% endif %}
    {% endif %}
  </section>

  {% if analytics %}
    {% set report = analytics.report %}
    <section class="{{ card }} db-an" aria-labelledby="db-h-an">
      <div class="db-head">
        <h2 id="db-h-an" class="{{ card_title }}">Visitors, last 90 days</h2>
        <span class="db-head-side"><span class="an-pulse" aria-hidden="true"></span>{{ analytics.now.visitors }} on the site now · <a class="{{ link }}" href="{{ url('admin/analytics') }}">Open reports</a></span>
      </div>
      {% if report.empty %}
        <p class="db-an-empty">No visits were counted in the last 90 days. The counting script is on every public page; visits of signed-in people, robots and visitors who ask not to be tracked are left out. <a class="{{ link }}" href="{{ url('admin/analytics') }}">Open the reports</a></p>
      {% else %}
        <div class="db-an-body">
          <div class="db-an-main">
            {{ an.kpis(report) }}
            <div class="db-an-legend an-legend"><i class="is-visitors"></i>Visitors <i class="is-views"></i>Page views <span>The change is against the 90 days before.</span></div>
            {{ an.chart(report) }}
          </div>
          <div class="db-an-side">
            {% for kind, name in {'page': 'Top pages', 'channel': 'Where they come from'} %}
              {% set list = report.lists[kind] %}
              <h3 class="db-sub">{{ name }}</h3>
              {% if list.rows is empty %}
                <p class="an-none">Nothing counted yet.</p>
              {% else %}
                <ul class="an-list">
                  {% for row in list.rows|slice(0, 5) %}
                    <li class="an-row"><span class="an-bar" style="width: {{ row.pct }}%"></span><span class="an-label" title="{{ row.label }}">{% if kind == 'page' and row.key != '(other)' %}<a href="{{ url(row.key|trim('/')) }}" target="_blank" rel="noopener">{{ row.label }}</a>{% else %}{{ row.label }}{% endif %}</span><span class="an-num">{{ row.visitors|number_format }}</span></li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </section>
  {% endif %}

  <div class="db-grid">
    <div class="db-col">
      <section class="{{ card }}" aria-labelledby="db-h-recent">
        <div class="db-head">
          <h2 id="db-h-recent" class="{{ card_title }}">Recent content</h2>
          <a class="{{ link }}" href="{{ url('admin/content') }}">All content</a>
        </div>
        {% if dashboard.content_types|length > 1 %}
          <p class="db-types">{% for row in dashboard.content_types %}<a class="ct-pill" href="{{ url('admin/content?type=' ~ row.type) }}">{{ row.type|title }} <b>{{ row.count }}</b>{% if row.draft %} <small>· {{ row.draft }} {{ row.draft == 1 ? 'draft' : 'drafts' }}</small>{% endif %}</a>{% endfor %}</p>
        {% endif %}
        {% if dashboard.recent_content is empty %}
          <p class="db-none">No content yet.</p>
        {% else %}
          <ul class="db-list">
            {% for item in dashboard.recent_content %}
              <li>
                <div class="min-w-0">
                  <a class="db-title" href="{{ url('admin/edit?type=' ~ item.type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}">{{ item.title }}</a>
                  <p class="db-meta">{{ item.type }} · {{ item.lang|upper }} · {{ item.updated_at }}</p>
                </div>
                <span class="db-badge {{ item.status == 'draft' ? 'is-draft' : 'is-live' }}">{{ item.status }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      {% if can('activity.manage') %}
      <section class="{{ card }}" aria-labelledby="db-h-activity">
        <div class="db-head">
          <h2 id="db-h-activity" class="{{ card_title }}">Recent activity</h2>
          <a class="{{ link }}" href="{{ url('admin/activity-logs') }}">View all</a>
        </div>
        {% if dashboard.recent_activity is empty %}
          <p class="db-none">No activity yet.</p>
        {% else %}
          <ul class="db-list">
            {% for log in dashboard.recent_activity %}
              <li>
                <div class="min-w-0">
                  <p class="db-title is-plain">{{ log.message ?: log.action }}</p>
                  <p class="db-meta"><code>{{ log.action }}</code> · {{ log.actor_username ?: 'system' }}{% if log.subject_id %} · {{ log.subject_id }}{% endif %}</p>
                </div>
                <time class="db-time" datetime="{{ log.created_at }}">{{ log.created_at|date('j M, H:i') }}</time>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
      {% endif %}
    </div>

    <div class="db-col">
      {% if dashboard.drafts %}
      <section class="{{ card }}" aria-labelledby="db-h-drafts">
        <div class="db-head">
          <h2 id="db-h-drafts" class="{{ card_title }}">Drafts to finish <span class="db-count">{{ dashboard.drafts_total }}</span></h2>
          {% if dashboard.drafts_total > dashboard.drafts|length %}<a class="{{ link }}" href="{{ url('admin/content?status=draft') }}">All drafts</a>{% endif %}
        </div>
        <ul class="db-list">
          {% for item in dashboard.drafts %}
            {% set age = (('now'|date('U')) - item.mtime) // 86400 %}
            <li>
              <div class="min-w-0">
                <a class="db-title" href="{{ url('admin/edit?type=' ~ item.type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}">{{ item.title }}</a>
                <p class="db-meta">{{ item.type }} · {{ item.lang|upper }}</p>
              </div>
              <span class="db-time{{ age >= 30 ? ' is-old' : '' }}">{{ age < 1 ? 'today' : (age == 1 ? '1 day' : age ~ ' days') }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% if can('email_logs.manage') %}
      <section class="{{ card }}" aria-labelledby="db-h-mail">
        <div class="db-head">
          <h2 id="db-h-mail" class="{{ card_title }}">Recent emails</h2>
          <a class="{{ link }}" href="{{ url('admin/email-logs') }}">All</a>
        </div>
        {% if dashboard.recent_emails is empty %}
          <p class="db-none">No email attempts yet.</p>
        {% else %}
          <ul class="db-list">
            {% for email in dashboard.recent_emails %}
              {% set email_ok = email.status == 'sent' %}
              <li>
                <div class="min-w-0">
                  <p class="db-title is-plain">{{ email.subject ?: 'No subject' }}</p>
                  <p class="db-meta">{{ email.recipient }}</p>
                </div>
                <span class="db-badge {{ email_ok ? 'is-live' : 'is-bad' }}">{{ email.status }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
      {% endif %}

      {% if can('settings.manage') %}
      <section class="{{ card }}" aria-labelledby="db-h-system">
        <div class="db-head">
          <h2 id="db-h-system" class="{{ card_title }}">System checks</h2>
          <a class="{{ link }}" href="{{ url('admin/system') }}">System</a>
        </div>
        <dl class="db-dl is-checks">
          {% for check in dashboard.system_checks %}
            {% set check_class = check.status == 'error' ? 'text-red-700' : (check.status == 'warning' ? 'text-amber-700' : 'text-emerald-700') %}
            <div><dt>{{ check.label }}</dt><dd class="{{ check_class }}" title="{{ check.value }}">{{ check.value }}</dd></div>
          {% endfor %}
          {% if can('updates.manage') %}
            <div>
              <dt>FarosCMS</dt>
              <dd class="{{ admin_update_available|default(false) ? 'text-blue-700' : 'text-emerald-700' }}"><a href="{{ url('admin/updates') }}" class="hover:underline">{{ admin_update_available|default(false) ? 'Update ' ~ admin_update_latest ~ ' available' : 'v' ~ admin_version|default('base') }}</a></dd>
            </div>
          {% endif %}
        </dl>
      </section>
      {% endif %}
    </div>
  </div>
{% endblock %}
