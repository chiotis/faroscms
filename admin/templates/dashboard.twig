{% extends '@admin/base.twig' %}

{% block content %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set status = dashboard.system_status.status %}
  {% set status_color = status == 'error' ? 'text-red-700' : (status == 'warning' ? 'text-amber-700' : 'text-emerald-700') %}
  {% set status_dot = status == 'error' ? 'bg-red-500' : (status == 'warning' ? 'bg-amber-500' : 'bg-emerald-500') %}
  {% set default_lang = site.languages.default|default('en') %}

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Content entries</p>
      <div class="mt-1.5 flex items-end justify-between">
        <span class="text-2xl font-semibold tracking-tight text-slate-900">{{ dashboard.content_total }}</span>
        <span class="mb-0.5 text-xs font-medium text-slate-500">{{ dashboard.content_published }} published</span>
      </div>
      <p class="mt-1 text-xs text-slate-400">{{ dashboard.content_draft }} drafts</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Users</p>
      <div class="mt-1.5 flex items-end justify-between">
        <span class="text-2xl font-semibold tracking-tight text-slate-900">{{ dashboard.users_total }}</span>
        <span class="mb-0.5 text-xs font-medium text-emerald-600">{{ dashboard.users_active }} active</span>
      </div>
      <p class="mt-1 text-xs text-slate-400">SQLite user store</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Backups</p>
      <div class="mt-1.5 flex items-end justify-between">
        <span class="text-2xl font-semibold tracking-tight text-slate-900">{{ dashboard.backups_total }}</span>
        <span class="mb-0.5 text-xs font-medium text-slate-500">local</span>
      </div>
      <p class="mt-1 truncate text-xs text-slate-400">{{ dashboard.last_backup ? dashboard.last_backup.created_at : 'Never created' }}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">System status</p>
      <div class="mt-1.5 flex items-end justify-between">
        <span class="truncate text-2xl font-semibold tracking-tight {{ status_color }}">{{ dashboard.system_status.label }}</span>
        <span class="mb-2 h-2 w-2 rounded-full {{ status_dot }}"></span>
      </div>
      <p class="mt-1 text-xs text-slate-400">{{ dashboard.system_status.detail }}</p>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white xl:col-span-2">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Recent activity</h2>
        <a href="{{ url('admin/activity-logs') }}" class="text-xs font-medium text-blue-600 hover:text-blue-700">View all</a>
      </div>
      {% if dashboard.recent_activity is empty %}
        <div class="px-4 py-10 text-center text-sm text-slate-400">No activity yet.</div>
      {% else %}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 text-left text-xs font-medium text-slate-400">
                <th class="px-4 py-2 font-medium">Event</th>
                <th class="px-4 py-2 font-medium">Actor</th>
                <th class="px-4 py-2 font-medium">Subject</th>
                <th class="px-4 py-2 font-medium">Time</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              {% for log in dashboard.recent_activity %}
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-2.5">
                    <span class="font-mono text-xs text-slate-500">{{ log.action }}</span>
                    <div class="truncate text-xs text-slate-400">{{ log.message ?: '—' }}</div>
                  </td>
                  <td class="px-4 py-2.5 text-slate-700">{{ log.actor_username ?: 'system' }}</td>
                  <td class="px-4 py-2.5">
                    <div class="text-slate-600">{{ log.subject_type ?: '—' }}</div>
                    <div class="max-w-40 truncate text-xs text-slate-400">{{ log.subject_id ?: '' }}</div>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2.5 text-slate-400">{{ log.created_at }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    <div class="space-y-4">
      <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Recent emails</h2>
          <a href="{{ url('admin/email-logs') }}" class="text-xs font-medium text-blue-600 hover:text-blue-700">All</a>
        </div>
        {% if dashboard.recent_emails is empty %}
          <div class="px-4 py-8 text-center text-sm text-slate-400">No email attempts yet.</div>
        {% else %}
          <ul class="divide-y divide-slate-50">
            {% for email in dashboard.recent_emails %}
              {% set email_ok = email.status == 'sent' %}
              <li class="flex items-center gap-3 px-4 py-2.5">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full {{ email_ok ? 'bg-emerald-500' : 'bg-red-500' }}"></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm text-slate-700">{{ email.subject ?: 'No subject' }}</p>
                  <p class="truncate text-xs text-slate-400">{{ email.recipient }}</p>
                </div>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ email_ok ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-red-50 text-red-700 ring-red-200' }}">{{ email.status }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-slate-900">Storage</h2>
          <span class="text-xs font-medium text-slate-400">{{ dashboard.storage.percent }}%</span>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-200">
          <div class="h-full rounded-full bg-slate-900" style="width: {{ dashboard.storage.percent }}%"></div>
        </div>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between"><dt class="text-slate-500">Used</dt><dd class="font-medium text-slate-900">{{ dashboard.storage.used_human }}</dd></div>
          <div class="flex justify-between"><dt class="text-slate-500">Free disk</dt><dd class="font-medium text-slate-900">{{ dashboard.storage.disk_free_human }}</dd></div>
        </dl>
      </div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Content by type</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium">Type</th>
              <th class="px-4 py-2 text-right font-medium">Entries</th>
              <th class="px-4 py-2 text-right font-medium">Drafts</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for row in dashboard.content_types %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5"><a class="font-medium text-slate-800 hover:text-blue-600" href="{{ url('admin/content?type=' ~ row.type) }}">{{ row.type|title }}</a></td>
                <td class="px-4 py-2.5 text-right text-slate-700">{{ row.count }}</td>
                <td class="px-4 py-2.5 text-right text-slate-500">{{ row.draft }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Recent content</h2>
      </div>
      {% if dashboard.recent_content is empty %}
        <div class="px-4 py-8 text-center text-sm text-slate-400">No content yet.</div>
      {% else %}
        <ul class="divide-y divide-slate-50">
          {% for item in dashboard.recent_content %}
            <li class="px-4 py-2.5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <a class="block truncate text-sm font-medium text-slate-800 hover:text-blue-600" href="{{ url('admin/edit?type=' ~ item.type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}">{{ item.title }}</a>
                  <p class="mt-0.5 text-xs text-slate-400">{{ item.type }} / {{ item.lang|upper }} / {{ item.updated_at }}</p>
                </div>
                <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ item.status == 'draft' ? 'bg-slate-100 text-slate-600 ring-slate-200' : 'bg-emerald-50 text-emerald-700 ring-emerald-200' }}">{{ item.status }}</span>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">System checks</h2>
      </div>
      <dl class="divide-y divide-slate-50">
        {% for check in dashboard.system_checks %}
          {% set check_class = check.status == 'error' ? 'text-red-700' : (check.status == 'warning' ? 'text-amber-700' : 'text-emerald-700') %}
          <div class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
            <dt class="text-slate-500">{{ check.label }}</dt>
            <dd class="max-w-48 truncate text-right font-medium {{ check_class }}">{{ check.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  </div>

  <div class="mt-4 rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="mb-3 text-sm font-semibold text-slate-900">Quick actions</h2>
    <div class="flex flex-wrap gap-2">
      {% if can('content.manage') %}
        <a class="{{ btn_primary }}" href="{{ url('admin/new?type=pages&lang=' ~ default_lang) }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
          New page
        </a>
        <a class="{{ btn_secondary }}" href="{{ url('admin/content') }}">Content</a>
      {% endif %}
      {% if can('media.manage') %}
        <a class="{{ btn_secondary }}" href="{{ url('admin/media') }}">Media</a>
      {% endif %}
      {% if can('users.manage') %}
        <a class="{{ btn_secondary }}" href="{{ url('admin/users-edit') }}">Add user</a>
      {% endif %}
      {% if can('settings.manage') %}
        <a class="{{ btn_secondary }}" href="{{ url('admin/settings?tab=backup') }}">Backups</a>
        <a class="{{ btn_secondary }}" href="{{ url('admin/settings?tab=smtp') }}">Email settings</a>
      {% endif %}
      {% if can('activity.manage') %}
        <a class="{{ btn_secondary }}" href="{{ url('admin/activity-logs') }}">Activity logs</a>
      {% endif %}
    </div>
  </div>
{% endblock %}
