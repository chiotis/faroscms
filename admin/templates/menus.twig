{% macro menu_item(item, languages, input_class, quiet_danger_btn) %}
  <div class="menu-item-row grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Level
        <select name="menu_depth[]" class="{{ input_class }}">
          <option value="1" {% if item.depth|default('1') == '1' %}selected{% endif %}>1 (Top)</option>
          <option value="2" {% if item.depth|default('1') == '2' %}selected{% endif %}>2 (Child)</option>
          <option value="3" {% if item.depth|default('1') == '3' %}selected{% endif %}>3 (Grandchild)</option>
        </select>
      </label>
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Label key
        <input type="text" name="menu_label_key[]" value="{{ item.label_key|default('') }}" placeholder="nav.main.home" class="{{ input_class }}">
      </label>
      {% for l in languages %}
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Label {{ l|upper }}
          <input type="text" name="menu_label_lang[{{ l }}][]" value="{{ item.labels[l]|default('') }}" placeholder="{{ l|upper }} label" class="{{ input_class }}">
        </label>
      {% endfor %}
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        URL
        <input type="text" name="menu_url[]" value="{{ item.url|default('') }}" placeholder="about or https://example.com" class="{{ input_class }}">
      </label>
    </div>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Class
        <input type="text" name="menu_class[]" value="{{ item.class|default('') }}" placeholder="nav-cta" class="{{ input_class }}">
      </label>
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Target
        <input type="text" name="menu_target[]" value="{{ item.target|default('') }}" placeholder="_blank" class="{{ input_class }}">
      </label>
      <div class="flex items-end">
        <button type="button" class="{{ quiet_danger_btn }} js-remove-menu-item">Remove</button>
      </div>
    </div>
  </div>
{% endmacro %}

{% extends '@admin/base.twig' %}
{% set page_heading = 'Edit menu' %}

{% block content %}
  {% import _self as menu_forms %}
  {% set primary_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set secondary_btn = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set quiet_danger_btn = 'inline-flex items-center gap-1.5 rounded-md border border-rose-200 bg-white px-3 py-1.5 text-sm font-medium text-rose-600 shadow-sm hover:bg-rose-50' %}
  {% set input_class = 'w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20' %}

  <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="mt-1 text-sm text-slate-500">
        <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{ menu_key }}</code>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a class="{{ secondary_btn }}" href="{{ url('admin/menus') }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to menus
      </a>
      <a class="{{ primary_btn }}" href="{{ url('admin/menus-new') }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
        </svg>
        New menu
      </a>
    </div>
  </header>

  {% if saved %}
    <template data-flash data-type="success">Menu saved.</template>
  {% endif %}
  {% if created %}
    <template data-flash data-type="success">Menu created.</template>
  {% endif %}
  {% if deleted %}
    <template data-flash data-type="success">Menu deleted.</template>
  {% endif %}
  {% if error %}
    <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">{{ error }}</div>
  {% endif %}

  <form method="post" class="grid gap-4">
    {{ csrf_field() }}
    <input type="hidden" name="key" value="{{ menu_key }}">

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Menu details</h2>
      </div>
      <div class="grid gap-4 p-4 md:grid-cols-2">
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Menu key
          <input type="text" value="{{ menu_key }}" readonly class="{{ input_class }} bg-slate-100">
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Menu title
          <input type="text" name="menu_title" value="{{ menu_title }}" class="{{ input_class }}">
        </label>
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Items</h2>
          <p class="mt-0.5 text-xs text-slate-400">Level controls nesting up to three levels. Keep child items below their parent.</p>
        </div>
        <button type="button" class="{{ secondary_btn }} js-add-menu-item">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
          </svg>
          Add item
        </button>
      </div>

      <div data-menu-items class="grid gap-3 p-4">
        {% for item in menu_items %}
          {{ menu_forms.menu_item(item, languages, input_class, quiet_danger_btn) }}
        {% endfor %}
      </div>
    </section>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
      <button type="submit" name="menu_action" value="delete" class="{{ quiet_danger_btn }}" data-confirm="Delete this menu?" data-confirm-button="Delete">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/>
        </svg>
        Delete
      </button>
      {% endblock %}
      {% block actions %}
      <button type="submit" name="menu_action" value="save" class="{{ primary_btn }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save menu
      </button>
      {% endblock %}
    {% endembed %}
  </form>

  <template data-menu-item-template>
    {% set item = { depth: '1', label_key: '', labels: {}, url: '', class: '', target: '' } %}
    {{ menu_forms.menu_item(item, languages, input_class, quiet_danger_btn) }}
  </template>

  <script>
    (function () {
      const container = document.querySelector('[data-menu-items]');
      const template = document.querySelector('[data-menu-item-template]');
      const addButton = document.querySelector('.js-add-menu-item');
      if (!container || !template || !addButton) return;

      const bindRemove = (button) => {
        button.addEventListener('click', () => {
          const row = button.closest('.menu-item-row');
          if (row) row.remove();
        });
      };

      container.querySelectorAll('.js-remove-menu-item').forEach(bindRemove);
      addButton.addEventListener('click', () => {
        const fragment = template.content.cloneNode(true);
        const removeButton = fragment.querySelector('.js-remove-menu-item');
        if (removeButton) bindRemove(removeButton);
        container.appendChild(fragment);
      });
    })();
  </script>
{% endblock %}
