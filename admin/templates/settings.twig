{% extends '@admin/base.twig' %}
{% set page_heading = 'Settings' %}

{% block content %}
  {% set tab_button_class = 'tab-button shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-medium text-slate-500 transition hover:text-slate-800' %}
  {% set panel_class = 'tab-panel space-y-4' %}
  {% set section_class = 'rounded-lg border border-slate-200 bg-white p-4' %}
  {% set section_header_class = 'mb-3 border-b border-slate-100 pb-3' %}
  {% set secondary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set primary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set danger_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm transition hover:bg-red-50' %}

  {% macro secret_input(name, is_set, input_class, empty_placeholder) %}
    <input type="password" id="{{ name }}" name="{{ name }}" value="" autocomplete="new-password" placeholder="{{ is_set ? 'Saved. Leave blank to keep it.' : empty_placeholder }}" class="{{ input_class }}">
    {% if is_set %}
      <span class="mt-1 flex items-center gap-1.5 text-xs text-slate-400">
        <input type="checkbox" name="clear_secret[]" value="{{ name }}" class="h-3.5 w-3.5 rounded border-slate-300">
        Remove the saved value
      </span>
    {% endif %}
  {% endmacro %}

  {% import _self as local %}
  {% import '@admin/partials/ui.twig' as ui %}
  {% import '@admin/partials/fields.twig' as fields %}

  {% if saved %}
    {{ ui.flash('Saved.', 'success') }}
  {% endif %}
  {% if test_status == 'ok' %}
    {{ ui.flash('Test email sent.', 'success') }}
  {% elseif test_status == 'fail' %}
    {{ ui.flash('Test email failed. Check your SMTP/SES settings.', 'error') }}
  {% elseif test_status == 'missing' %}
    {{ ui.flash('Please enter a test recipient email.', 'error') }}
  {% endif %}
  {% if backup_status == 'ok' %}
    {{ ui.flash(backup_message ?: 'Backup action completed.', 'success') }}
  {% elseif backup_status == 'warn' %}
    {{ ui.flash(backup_message ?: 'Backup saved locally, but the remote upload failed.', 'warning') }}
  {% elseif backup_status == 'fail' %}
    {{ ui.flash(backup_message ?: 'Backup action failed.', 'error') }}
  {% endif %}
  {% if settings_error %}
    {{ ui.flash(settings_error, 'error') }}
  {% endif %}
  {% if storage_measured and storage.used_human is defined %}
    {{ ui.flash('Storage measured again: ' ~ storage.used_human ~ ' used.', 'success') }}
  {% endif %}

  <form method="post" class="space-y-4">
    {{ csrf_field() }}
    <input type="hidden" name="active_tab" value="{{ active_tab }}" data-active-tab-input>

    <div class="flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <p class="truncate text-xs text-slate-400">Configure your FarosCMS installation</p>
      </div>
    </div>

    <div>
      <div class="mb-4 overflow-x-auto border-b border-slate-200">
        <div class="flex min-w-max gap-1" role="tablist">
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'basics' %} active{% endif %}" data-tab="basics">General</button>
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'smtp' %} active{% endif %}" data-tab="smtp">Email / SMTP</button>
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'auth' %} active{% endif %}" data-tab="auth">Auth</button>
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'backup' %} active{% endif %}" data-tab="backup">Backups</button>
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'updates' %} active{% endif %}" data-tab="updates">Updates</button>
          <button type="button" class="{{ tab_button_class }}{% if active_tab == 'apis' %} active{% endif %}" data-tab="apis">APIs</button>
          {% if can('limits.manage') %}<button type="button" class="{{ tab_button_class }}{% if active_tab == 'limits' %} active{% endif %}" data-tab="limits">Limits</button>{% endif %}
        </div>
      </div>

      {% if can('limits.manage') %}
      <div class="{{ panel_class }}{% if active_tab != 'limits' %} hidden{% else %} active{% endif %}" data-panel="limits">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Storage</h2>
            <p class="mt-0.5 text-xs text-slate-400">How much space this site may use. Only a super admin sees this. The bar in the sidebar and on the dashboard follows it: orange from 80%, red from 90%, when everyone in the admin is shown a message, and at 100% new uploads are blocked.</p>
          </div>
          {% set limit_mb = settings_form.storage_limit_mb %}
          {% set as_gb = limit_mb >= 1024 and limit_mb % 1024 == 0 %}
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Storage limit</span>
              <input type="number" name="storage_limit_value" value="{{ as_gb ? limit_mb // 1024 : limit_mb }}" min="0" step="any" class="{{ input_class }}" aria-describedby="storage-limit-help">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Unit</span>
              <select name="storage_limit_unit" class="{{ select_class }}">
                <option value="mb"{% if not as_gb %} selected{% endif %}>MB</option>
                <option value="gb"{% if as_gb %} selected{% endif %}>GB</option>
              </select>
            </label>
            <div class="text-sm">
              <span class="mb-1 block font-medium text-slate-700">Used now</span>
              <p class="rounded-md bg-slate-50 px-3 py-2 {{ storage.level == 'danger' ? 'text-red-700' : (storage.level == 'warn' ? 'text-orange-700' : 'text-slate-700') }}">{{ storage.used_human }}{% if storage.limit %} of {{ storage.limit_human }} ({{ storage.percent_of_limit }}%){% endif %}</p>
            </div>
          </div>
          <p id="storage-limit-help" class="mt-2 text-xs text-slate-400">The default is 1 GB. Enter 0 for no limit. What counts: uploads {{ storage.parts.uploads }}, content {{ storage.parts.content }}, and the system database and backups {{ storage.parts.system }}.</p>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400" id="storage-measured">
            <span>Measured {{ storage.measured_at|date('Y-m-d H:i') }}. Measured again automatically every 12 hours; uploads and deletions in Media count at once.</span>
            <button type="submit" form="storage-recalculate" class="font-medium text-slate-600 underline hover:text-slate-900">Recalculate now</button>
          </p>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">File uploads</h2>
            <p class="mt-0.5 text-xs text-slate-400">What can be added to the media library (and as a main image while editing). A file that is too big or of a kind that is not ticked is refused with the reason.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Largest file (MB)</span>
              <input type="number" name="upload_limit_mb" value="{{ settings_form.upload_limit_mb }}" min="0" step="1" class="{{ input_class }}" aria-describedby="upload-limit-help">
            </label>
            <p id="upload-limit-help" class="text-xs text-slate-400 sm:col-span-2 sm:self-end">The default is 20 MB. Enter 0 to allow what the server allows.{% if server_upload_mb %} This server takes at most <strong class="font-semibold text-slate-600">{{ server_upload_mb }} MB</strong> in one upload (PHP <code class="rounded bg-slate-100 px-1 py-0.5">upload_max_filesize</code> and <code class="rounded bg-slate-100 px-1 py-0.5">post_max_size</code>), so a higher number here does not go beyond that.{% endif %}</p>
          </div>
          <fieldset class="mt-4">
            <legend class="mb-2 text-sm font-medium text-slate-700">Kinds of file allowed</legend>
            <input type="hidden" name="upload_types_present" value="1">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
              {% for key, group in upload_groups %}
                <label class="flex items-start gap-2.5 rounded-md border border-slate-200 px-3 py-2.5">
                  <input type="checkbox" name="upload_types[]" value="{{ key }}" {% if key in settings_form.upload_types %}checked{% endif %} class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                  <span>
                    <span class="block text-sm font-medium text-slate-800">{{ group.label }}</span>
                    <span class="block text-xs text-slate-400">{{ group.help }}</span>
                  </span>
                </label>
              {% endfor %}
            </div>
            <p class="mt-2 text-xs text-slate-400">Only harmless kinds of file can be allowed at all: programs, scripts, and web pages are never accepted, whatever is ticked. At least one kind stays ticked.</p>
          </fieldset>
        </div>
      </div>
      {% endif %}

      <div class="{{ panel_class }}{% if active_tab != 'basics' %} hidden{% else %} active{% endif %}" data-panel="basics">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Site Identity</h2>
            <p class="mt-0.5 text-xs text-slate-400">Basic information used across the public site and admin.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Site name</span>
              <input type="text" name="title" value="{{ settings_form.title }}" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Tagline</span>
              <input type="text" name="tagline" value="{{ settings_form.tagline }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Base URL</span>
              <input type="text" name="base_url" value="{{ settings_form.base_url }}" placeholder="https://example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Home page</span>
              <input type="text" name="home_page" value="{{ settings_form.home_page }}" class="{{ input_class }}">
            </label>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Localization</h2>
            <p class="mt-0.5 text-xs text-slate-400">Default language, available locales and date formatting.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Default language</span>
              <input type="text" name="languages_default" value="{{ settings_form.languages_default }}" placeholder="el" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Available languages</span>
              <input type="text" name="languages_available" value="{{ settings_form.languages_available }}" placeholder="el, en" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Date format</span>
              <input type="text" name="date_format" value="{{ settings_form.date_format }}" placeholder="d/m/Y" class="{{ input_class }}">
            </label>
          </div>
        </div>

        {% if can('seo.manage') %}
          <div class="{{ section_class }}">
            <div class="{{ section_header_class }}">
              <h2 class="text-sm font-semibold text-slate-900">Search engines</h2>
              <p class="mt-0.5 text-xs text-slate-400">Titles, descriptions, the sitemap, robots.txt and the rest of how the site meets search engines are in <a href="{{ url('admin/seo') }}" class="font-medium text-blue-700 hover:underline">SEO</a>.</p>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'smtp' %} hidden{% else %} active{% endif %}" data-panel="smtp">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Mailer</h2>
            <p class="mt-0.5 text-xs text-slate-400">Outgoing email identity and provider.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Provider</span>
              <select name="mail_driver" class="{{ select_class }}">
                <option value="smtp" {% if settings_form.mail_driver == 'smtp' %}selected{% endif %}>SMTP</option>
                <option value="ses" {% if settings_form.mail_driver == 'ses' %}selected{% endif %}>AWS SES</option>
              </select>
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Test recipient</span>
              <input type="text" name="test_email_to" placeholder="you@example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">From email</span>
              <input type="text" name="mail_from" value="{{ settings_form.mail_from }}" placeholder="no-reply@example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">From name</span>
              <input type="text" name="mail_from_name" value="{{ settings_form.mail_from_name }}" placeholder="FarosCMS" class="{{ input_class }}">
            </label>
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 border-t border-slate-100 pt-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-500 ring-1 ring-inset ring-slate-200">Configured in YAML</span>
            <button type="submit" class="{{ secondary_button_class }}" name="send_test" value="1">Send test email</button>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">SMTP Configuration</h2>
            <p class="mt-0.5 text-xs text-slate-400">Server credentials used when SMTP is selected.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Host</span>
              <input type="text" name="smtp_host" value="{{ settings_form.smtp_host }}" placeholder="smtp.example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Port</span>
              <input type="number" name="smtp_port" value="{{ settings_form.smtp_port }}" placeholder="587" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Username</span>
              <input type="text" name="smtp_user" value="{{ settings_form.smtp_user }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Password</span>
              {{ local.secret_input('smtp_pass', settings_form.smtp_pass_set, input_class, '') }}
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Encryption</span>
              <select name="smtp_encryption" class="{{ select_class }}">
                <option value="" {% if settings_form.smtp_encryption == '' %}selected{% endif %}>None</option>
                <option value="tls" {% if settings_form.smtp_encryption == 'tls' %}selected{% endif %}>TLS</option>
                <option value="ssl" {% if settings_form.smtp_encryption == 'ssl' %}selected{% endif %}>SSL</option>
              </select>
            </label>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">AWS SES</h2>
            <p class="mt-0.5 text-xs text-slate-400">Credentials used when AWS SES is selected.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Access key</span>
              <input type="text" name="ses_key" value="{{ settings_form.ses_key }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Secret key</span>
              {{ local.secret_input('ses_secret', settings_form.ses_secret_set, input_class, '') }}
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Region</span>
              <input type="text" name="ses_region" value="{{ settings_form.ses_region }}" placeholder="eu-central-1" class="{{ input_class }}">
            </label>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'auth' %} hidden{% else %} active{% endif %}" data-panel="auth">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Google Sign-In</h2>
            <p class="mt-0.5 text-xs text-slate-400">Allow existing FarosCMS users to sign in with matching Google accounts.</p>
          </div>
          <label class="flex items-start justify-between gap-4 py-2.5">
            <span>
              <span class="block text-sm font-medium text-slate-800">Enable Google Sign-In</span>
              <span class="block text-xs text-slate-400">Users must already exist in FarosCMS with the same email address.</span>
            </span>
            <span class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center">
              <input type="checkbox" name="google_enabled" value="1" {% if settings_form.google_enabled %}checked{% endif %} class="peer sr-only">
              <span class="h-5 w-9 rounded-full bg-slate-200 transition peer-checked:bg-blue-600"></span>
              <span class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></span>
            </span>
          </label>
          <div class="mt-3 grid grid-cols-1 gap-3 border-t border-slate-100 pt-3 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Google Client ID</span>
              <input type="text" name="google_client_id" value="{{ settings_form.google_client_id }}" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Google Client Secret</span>
              {{ local.secret_input('google_client_secret', settings_form.google_client_secret_set, input_class, '') }}
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Allowed domain</span>
              <input type="text" name="google_allowed_domain" value="{{ settings_form.google_allowed_domain }}" placeholder="example.com" class="{{ input_class }}">
              <span class="mt-1 block text-xs text-slate-400">Leave empty to allow any Google account that matches an active FarosCMS user email.</span>
            </label>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'backup' %} hidden{% else %} active{% endif %}" data-panel="backup">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Backup Schedule</h2>
            <p class="mt-0.5 text-xs text-slate-400">Automated local snapshot policy.</p>
          </div>
          <label class="flex items-start justify-between gap-4 py-2.5">
            <span>
              <span class="block text-sm font-medium text-slate-800">Enable automatic backups</span>
              <span class="block text-xs text-slate-400">Create local restore points on the selected schedule.</span>
            </span>
            <span class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center">
              <input type="checkbox" name="backup_auto_enabled" value="1" {% if settings_form.backup_auto_enabled %}checked{% endif %} class="peer sr-only">
              <span class="h-5 w-9 rounded-full bg-slate-200 transition peer-checked:bg-blue-600"></span>
              <span class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></span>
            </span>
          </label>
          <div class="mt-3 grid grid-cols-1 gap-3 border-t border-slate-100 pt-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Frequency</span>
              <select name="backup_schedule" data-backup-schedule class="{{ select_class }}">
                <option value="daily" {% if settings_form.backup_schedule == 'daily' %}selected{% endif %}>Daily</option>
                <option value="weekly" {% if settings_form.backup_schedule == 'weekly' %}selected{% endif %}>Weekly</option>
                <option value="monthly" {% if settings_form.backup_schedule == 'monthly' %}selected{% endif %}>Monthly</option>
              </select>
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Retention</span>
              <input type="number" min="1" name="backup_keep_local" value="{{ settings_form.backup_keep_local }}" class="{{ input_class }}">
            </label>
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 border-t border-slate-100 pt-3">
            <p class="text-sm text-slate-500">Last automatic backup: {{ settings_form.backup_last_run ?: 'Never' }}</p>
            <a href="{{ url('admin/backups') }}" class="{{ secondary_button_class }}">Manage backups</a>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Remote Storage</h2>
            <p class="mt-0.5 text-xs text-slate-400">S3-compatible destination for offsite copies, including AWS S3, Backblaze B2, Cloudflare R2, Wasabi, DigitalOcean Spaces, and MinIO.</p>
          </div>
          <label class="flex items-start justify-between gap-4 py-2.5">
            <span>
              <span class="block text-sm font-medium text-slate-800">Enable remote storage</span>
              <span class="block text-xs text-slate-400">Keep an offsite destination configured for backup uploads.</span>
            </span>
            <span class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center">
              <input type="checkbox" name="backup_remote_enabled" value="1" {% if settings_form.backup_remote_enabled %}checked{% endif %} class="peer sr-only">
              <span class="h-5 w-9 rounded-full bg-slate-200 transition peer-checked:bg-blue-600"></span>
              <span class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></span>
            </span>
          </label>
          <div class="mt-3 grid grid-cols-1 gap-3 border-t border-slate-100 pt-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Provider</span>
              <select name="backup_remote_provider" class="{{ select_class }}">
                <option value="custom" {% if settings_form.backup_remote_provider == 'custom' %}selected{% endif %}>Custom S3-compatible</option>
                <option value="aws_s3" {% if settings_form.backup_remote_provider == 'aws_s3' %}selected{% endif %}>AWS S3</option>
                <option value="backblaze_b2" {% if settings_form.backup_remote_provider == 'backblaze_b2' %}selected{% endif %}>Backblaze B2</option>
                <option value="cloudflare_r2" {% if settings_form.backup_remote_provider == 'cloudflare_r2' %}selected{% endif %}>Cloudflare R2</option>
                <option value="wasabi" {% if settings_form.backup_remote_provider == 'wasabi' %}selected{% endif %}>Wasabi</option>
                <option value="digitalocean_spaces" {% if settings_form.backup_remote_provider == 'digitalocean_spaces' %}selected{% endif %}>DigitalOcean Spaces</option>
                <option value="minio" {% if settings_form.backup_remote_provider == 'minio' %}selected{% endif %}>MinIO</option>
              </select>
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Endpoint</span>
              <input type="url" name="backup_remote_endpoint" value="{{ settings_form.backup_remote_endpoint }}" placeholder="https://s3.us-west-004.backblazeb2.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Region</span>
              <input type="text" name="backup_remote_region" value="{{ settings_form.backup_remote_region }}" placeholder="us-west-004" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Bucket</span>
              <input type="text" name="backup_remote_bucket" value="{{ settings_form.backup_remote_bucket }}" placeholder="faroscms-backups" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Access key / key ID</span>
              <input type="text" name="backup_remote_access_key" value="{{ settings_form.backup_remote_access_key }}" autocomplete="off" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Secret key</span>
              {{ local.secret_input('backup_remote_secret_key', settings_form.backup_remote_secret_key_set, input_class, '') }}
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Path prefix</span>
              <input type="text" name="backup_remote_prefix" value="{{ settings_form.backup_remote_prefix }}" placeholder="sites/main" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Remote retention</span>
              <input type="number" min="1" name="backup_remote_keep" value="{{ settings_form.backup_remote_keep }}" class="{{ input_class }}">
            </label>
          </div>
          <div class="mt-3 flex flex-col gap-3 border-t border-slate-100 pt-3 sm:flex-row sm:items-center sm:justify-between">
            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
              <input type="checkbox" name="backup_remote_path_style" value="1" {% if settings_form.backup_remote_path_style %}checked{% endif %} class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
              Use path-style URLs
            </label>
            <button type="submit" name="test_remote_backup" value="1" class="{{ secondary_button_class }}">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Test connection
            </button>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'updates' %} hidden{% else %} active{% endif %}" data-panel="updates">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Update Source</h2>
            <p class="mt-0.5 text-xs text-slate-400">GitHub repository the Updates screen looks at, and installs new versions from.</p>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Repository</span>
              <input type="text" name="update_repository" value="{{ settings_form.update_repository }}" placeholder="chiotis/faroscms" class="{{ input_class }}">
            </label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-slate-700">Branch</span>
              <input type="text" name="update_branch" value="{{ settings_form.update_branch }}" placeholder="main" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">VERSION URL</span>
              <input type="url" name="update_version_url" value="{{ settings_form.update_version_url }}" placeholder="https://raw.githubusercontent.com/chiotis/faroscms/main/VERSION" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">CHANGELOG URL</span>
              <input type="url" name="update_changelog_url" value="{{ settings_form.update_changelog_url }}" placeholder="https://raw.githubusercontent.com/chiotis/faroscms/main/CHANGELOG.md" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Package URL</span>
              <input type="url" name="update_package_url" value="{{ settings_form.update_package_url }}" placeholder="https://github.com/chiotis/faroscms/archive/refs/heads/main.zip" class="{{ input_class }}">
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">Release manifest URL</span>
              <input type="url" name="update_release_url" value="{{ settings_form.update_release_url }}" placeholder="https://github.com/chiotis/faroscms/releases/latest/download/release.json" class="{{ input_class }}">
              <span class="mt-1 block text-xs text-slate-400">Where the package to install is described (its version, size and checksum). Leave blank to use the latest release of the repository above.</span>
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1 block text-sm font-medium text-slate-700">GitHub token</span>
              {{ local.secret_input('update_github_token', settings_form.update_github_token_set, input_class, 'Required only for private repositories') }}
              <span class="mt-1 block text-xs text-slate-400">Needed when the repository is private. Leave blank to keep the existing token.</span>
            </label>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'apis' %} hidden{% else %} active{% endif %}" data-panel="apis">
        {% if youtube_status == 'ok' %}
          {{ ui.flash(youtube_message ?: 'The key works.', 'success') }}
        {% elseif youtube_status == 'fail' %}
          {{ ui.flash(youtube_message ?: 'The key did not work.', 'error') }}
        {% endif %}
        <section class="lc-card en-card" aria-labelledby="api-h-youtube">
          <div class="en-card-head">
            <h2 id="api-h-youtube" class="en-card-title">YouTube</h2>
            <span class="en-chip {{ settings_form.youtube_key_set ? 'is-live' : 'is-draft' }}">{{ settings_form.youtube_key_set ? 'Key saved' : 'No key' }}</span>
          </div>
          <p class="en-help m-0">Used by the <strong>YouTube playlist</strong> block. Without a key a playlist shows its 15 newest videos, from YouTube's public feed. With a key it shows up to 50, with their lengths.</p>
          <div class="en-rows">
            <div class="seo-row">
              <label class="seo-label" for="youtube_key">API key</label>
              <div>{{ local.secret_input('youtube_key', settings_form.youtube_key_set, 'lc-input', 'AIza…') }}</div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="youtube_cache_hours">Keep a playlist for</label>
              <div>
                <select id="youtube_cache_hours" name="youtube_cache_hours" class="lc-input lc-select">
                  {% for hours, label in {'1': '1 hour', '6': '6 hours', '24': '1 day', '72': '3 days'} %}
                    <option value="{{ hours }}"{% if settings_form.youtube_cache_hours == hours %} selected{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
                <p class="seo-help">A playlist is fetched again after this long. A page never waits for YouTube, and if YouTube cannot be asked the last copy is shown.</p>
              </div>
            </div>
          </div>
          <div class="en-actions mt-2">
            <button type="submit" name="youtube_test" value="1" class="{{ secondary_button_class }}"{% if not settings_form.youtube_key_set %} title="Save a key first, or type one and press this button"{% endif %}>Save and test the key</button>
          </div>
          <details class="en-details-note">
            <summary>How to get a key</summary>
            <ol>
              <li>In the <a class="en-link" href="https://console.cloud.google.com/" target="_blank" rel="noopener">Google Cloud console</a>, make a project (or use one you have).</li>
              <li>Under <em>APIs &amp; Services &gt; Library</em>, switch on <em>YouTube Data API v3</em>.</li>
              <li>Under <em>Credentials</em>, make an <em>API key</em> and, to be safe, limit it to that API (and to this server's address if it has a fixed one). Keys limited to websites do not work here: the site asks YouTube from the server.</li>
              <li>Paste it above and press <em>Save and test the key</em>. A key has a daily quota of 10,000 units; a playlist costs about 3, once for as long as it is kept.</li>
            </ol>
            <p class="seo-help">The key is kept in the site's system database and is never sent to the browser. Only public and unlisted playlists can be shown.</p>
          </details>
        </section>
        <section class="lc-card en-card" aria-labelledby="api-h-maps">
          <div class="en-card-head">
            <h2 id="api-h-maps" class="en-card-title">Maps</h2>
            <span class="en-chip {{ settings_form.maps_tiles_url ? 'is-live' : 'is-draft' }}">{{ settings_form.maps_tiles_url ? 'Own tiles' : 'OpenStreetMap' }}</span>
          </div>
          <p class="en-help m-0">Used by the maps of the <strong>Map</strong> block, of archives with the Map layout, and of the pages of points, routes and businesses. The map itself is drawn by the visitor's browser, from the tiles below.</p>
          <div class="en-rows">
            <div class="seo-row">
              <label class="seo-label" for="maps_load">Load a map</label>
              <div>
                <select id="maps_load" name="maps_load" class="lc-input lc-select">
                  <option value="click"{% if settings_form.maps_load != 'auto' %} selected{% endif %}>When the visitor asks for it</option>
                  <option value="auto"{% if settings_form.maps_load == 'auto' %} selected{% endif %}>As soon as it comes into view</option>
                </select>
                <p class="seo-help">Loading a map tells the tile server the visitor's address. "When the visitor asks" makes no request to anyone until then.</p>
              </div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="maps_tiles_url">Tile address</label>
              <div>
                <input type="text" id="maps_tiles_url" name="maps_tiles_url" value="{{ settings_form.maps_tiles_url }}" class="lc-input" placeholder="https://tile.openstreetmap.org/{z}/{x}/{y}.png" autocomplete="off">
                <p class="seo-help">Leave empty for OpenStreetMap's own tiles, which are meant for light use. A busy site should use a provider (MapTiler, Thunderforest, Stadia…) or its own server: paste its address here, with <code>{z}</code>, <code>{x}</code> and <code>{y}</code> in it. It must start with https://.</p>
              </div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="maps_attribution">Credit</label>
              <div>
                <input type="text" id="maps_attribution" name="maps_attribution" value="{{ settings_form.maps_attribution }}" class="lc-input" placeholder="© MapTiler © OpenStreetMap contributors" autocomplete="off">
                <p class="seo-help">Shown in the corner of every map. Your provider says what it must say; plain text and links only.</p>
              </div>
            </div>
          </div>
        </section>
      </div>

    </div>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
        <a href="{{ url('admin/settings?tab=' ~ active_tab) }}" class="{{ secondary_button_class }}">Discard</a>
      {% endblock %}
      {% block actions %}
        <button type="submit" class="{{ primary_button_class }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      {% endblock %}
    {% endembed %}
  </form>
  {% if can('limits.manage') %}
  <form id="storage-recalculate" method="post" action="/admin/settings?tab=limits" hidden>
    {{ csrf_field() }}
    <input type="hidden" name="storage_action" value="recalculate">
  </form>
  {% endif %}

  <script>
    (function () {
      const buttons = document.querySelectorAll('.tab-button');
      const panels = document.querySelectorAll('.tab-panel');
      const activeTabInput = document.querySelector('[data-active-tab-input]');
      const backupToggle = document.querySelector('input[name="backup_auto_enabled"]');
      const backupSchedule = document.querySelector('[data-backup-schedule]');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-tab');
          buttons.forEach((item) => item.classList.toggle('active', item === button));
          panels.forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-panel') === target);
          });
          if (activeTabInput && target) {
            activeTabInput.value = target;
          }
        });
      });

      const syncBackupScheduleState = () => {
        if (!backupToggle || !backupSchedule) return;
        backupSchedule.disabled = !backupToggle.checked;
      };

      if (backupToggle && backupSchedule) {
        backupToggle.addEventListener('change', syncBackupScheduleState);
        syncBackupScheduleState();
      }
    })();
  </script>
{% endblock %}
