{% extends '@admin/base.twig' %}
{% set page_heading = 'Restore backup' %}

{% block content %}
  {% set secondary_button = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set danger_button = 'inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-red-700 disabled:cursor-not-allowed disabled:bg-red-300' %}
  {% set manifest = verification.manifest|default({}) %}
  {% set can_restore = verification.ok and (scopes|filter(s => s.available)|length > 0) %}

  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="mt-1 truncate font-mono text-xs text-slate-500">{{ filename }}</p>
    </div>
    <a href="{{ url('admin/backups') }}" class="{{ secondary_button }}">Back to backups</a>
  </div>

  {% if error %}
    <template data-flash data-type="error">{{ error }}</template>
  {% endif %}

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
    <div class="space-y-4 xl:col-span-2">
      <div class="rounded-lg border {{ verification.ok ? (verification.has_manifest ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50') : 'border-red-200 bg-red-50' }} p-4">
        <p class="text-sm font-semibold {{ verification.ok ? (verification.has_manifest ? 'text-emerald-900' : 'text-amber-900') : 'text-red-900' }}">{{ verification.message }}</p>
        {% if verification.errors is not empty %}
          <ul class="mt-2 max-h-48 space-y-0.5 overflow-y-auto font-mono text-xs text-red-800">
            {% for problem in verification.errors %}
              <li>{{ problem }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <form method="post" action="{{ url('admin/backups') }}" class="rounded-lg border border-slate-200 bg-white">
        {{ csrf_field() }}
        <input type="hidden" name="backup_action" value="restore">
        <input type="hidden" name="filename" value="{{ filename }}">

        <div class="border-b border-slate-200 px-4 py-3">
          <h2 class="text-sm font-semibold text-slate-900">Areas to restore</h2>
          <p class="mt-0.5 text-xs text-slate-400">Each selected area replaces the live one completely. Code is never restored from backups.</p>
        </div>
        <div class="divide-y divide-slate-50">
          {% for scope in scopes %}
            <label class="flex items-start gap-3 px-4 py-3 {{ scope.available ? 'cursor-pointer hover:bg-slate-50' : 'opacity-50' }}">
              <input type="checkbox" name="scopes[]" value="{{ scope.key }}" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if scope.checked %}checked{% endif %} {% if not scope.available %}disabled{% endif %}>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-3">
                  <span class="text-sm font-medium text-slate-800">{{ scope.label }}</span>
                  <span class="text-xs text-slate-400">{{ scope.available ? scope.count ~ ' file' ~ (scope.count == 1 ? '' : 's') : 'Not in archive' }}</span>
                </span>
                <span class="block text-xs text-slate-500">{{ scope.description }}</span>
                {% if scope.key == 'database' and scope.available %}
                  <span class="mt-1 block text-xs text-amber-700">Users, settings, and logs return to the archive's state. You will be signed out if your account is not in it.</span>
                {% endif %}
              </span>
            </label>
          {% endfor %}
        </div>

        <div class="space-y-3 border-t border-slate-200 px-4 py-4">
          {% if verification.ok and not verification.has_manifest %}
            <label class="flex items-start gap-2 text-sm text-amber-800">
              <input type="checkbox" name="ack_unverified" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300">
              I understand this archive has no checksum manifest, so its contents cannot be verified.
            </label>
          {% endif %}
          <label class="block">
            <span class="mb-1 block text-sm font-medium text-slate-700">Type the archive name to confirm</span>
            <input type="text" name="confirm_filename" autocomplete="off" spellcheck="false" placeholder="{{ filename }}" class="{{ input_class }} font-mono text-xs">
          </label>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs text-slate-500">A full safety snapshot of the current site is created before anything changes.</p>
            <button type="submit" class="{{ danger_button }}" {% if not can_restore %}disabled{% endif %}>Restore selected areas</button>
          </div>
        </div>
      </form>
    </div>

    <div class="space-y-4">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">Archive</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Type</dt><dd class="font-medium text-slate-900">{{ (manifest.type|default(snapshot.type|default('full')))|title }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Reason</dt><dd class="font-medium text-slate-900">{{ manifest.reason|default('unknown')|replace({'-': ' '})|capitalize }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Created</dt><dd class="max-w-40 truncate text-right font-medium text-slate-900">{{ manifest.created_at is defined ? manifest.created_at|date('Y-m-d H:i') : (snapshot.created_at|default('')) }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">FarosCMS version</dt><dd class="font-medium text-slate-900">{{ manifest.version|default('unknown') }}{% if manifest.version is defined and manifest.version != current_version %} <span class="text-xs text-amber-600">(now {{ current_version }})</span>{% endif %}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Size</dt><dd class="font-medium text-slate-900">{{ snapshot.size_human|default('') }}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-slate-500">Checksums</dt><dd class="font-medium text-slate-900">{{ verification.has_manifest ? verification.checked ~ ' verified' : 'none' }}</dd></div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-slate-900">What happens</h2>
        <ol class="mt-2 list-decimal space-y-1 pl-4 text-xs leading-relaxed text-slate-600">
          <li>The archive is verified again.</li>
          <li>A full safety snapshot of the current site is written to the backups list.</li>
          <li>Selected areas are extracted to <code class="rounded bg-slate-100 px-1">storage/restore/</code>.</li>
          <li>Each live area is moved aside and replaced. If any step fails, every area is put back.</li>
          <li>The replaced data stays in <code class="rounded bg-slate-100 px-1">storage/restore/…/previous</code>.</li>
        </ol>
      </div>
    </div>
  </div>
{% endblock %}
