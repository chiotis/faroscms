<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
  <div class="min-h-screen grid place-items-center p-6">
    <form method="post" class="w-full max-w-sm rounded-md border border-slate-300 bg-white p-8 shadow grid gap-4">
      <h1 class="m-0 text-2xl font-bold">Admin Login</h1>
      {% if error %}
        <div class="rounded-lg border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{{ error }}</div>
      {% endif %}
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Username
        <input type="text" name="username" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-emerald-400">
      </label>
      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Password
        <input type="password" name="password" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:ring-2 focus:ring-emerald-400">
      </label>
      <button type="submit" class="inline-flex items-center justify-center rounded-md bg-slate-800 px-4 py-2.5 font-semibold text-white transition hover:bg-slate-700">Sign in</button>
    </form>
  </div>
</body>
</html>
