{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">New Menu</h1> <p class="mt-1 text-sm text-slate-500">Create a new menu key. You can optionally clone an existing menu structure.</p> </div> <div class="actions mt-1 flex flex-wrap items-center gap-2"> <a class="{{ btn_muted }}" href="{{ url('admin/menus') }}">Back to Menus</a> </div> </header> {% if error %} <div class="alert mb-4 rounded-md border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{{ error }}</div> {% endif %} <form method="post" class="editor"> <div class="form-section mb-4 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm w-full"> <h3 class="text-xl font-semibold text-slate-900">Menu</h3> <div class="section-grid grid grid-cols-1 gap-4 md:grid-cols-2"> <label class="grid gap-1 text-sm font-medium text-slate-700"> Menu key <input type="text" name="new_key" value="{{ new_key }}" placeholder="services-menu" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Menu title <input type="text" name="new_title" value="{{ new_title }}" placeholder="Services Menu" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Clone from existing (optional) <select name="source_key" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> <option value="">None</option> {% for key in menu_keys %} <option value="{{ key }}" {% if key == source_key %}selected{% endif %}>{{ key }}</option> {% endfor %} </select> </label> </div> </div> <div class="actions mt-4 flex flex-wrap items-center gap-2 mt-1"> <button type="submit" class="{{ btn }}">Create menu</button> </div> </form>
{% endblock %}
