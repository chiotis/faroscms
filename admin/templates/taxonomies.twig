{% macro term_row(term, languages, input_class, remove_btn, kind) %}
  <tr class="hover:bg-slate-50" data-term-row data-used="{{ term.used|default(0) }}">
    {% for langCode in languages %}
      <td class="px-4 py-2.5 align-top">
        <input type="text" name="term_label[{{ langCode }}][]" value="{{ term.labels[langCode]|default('') }}" placeholder="{{ langCode|upper }} name" class="{{ input_class }}">
      </td>
    {% endfor %}
    <td class="px-4 py-2.5 align-top">
      <input type="hidden" name="term_id[]" value="{{ term.id|default('') }}">
      <input type="text" name="term_slug[]" value="{{ term.slug|default('') }}" placeholder="{{ term.id ? '' : 'made from the name' }}" class="{{ input_class }}" autocomplete="off" spellcheck="false" data-term-slug data-original="{{ term.slug|default('') }}">
      {% if term.id %}<p class="mt-1 hidden text-xs text-amber-700" data-term-slug-note>The old address /{{ kind }}/{{ term.slug }} will keep working and lead here.</p>{% endif %}
    </td>
    <td class="px-4 py-2.5 align-top text-xs text-slate-500">
      {% if term.id %}{{ term.used|default(0) }} {{ term.used|default(0) == 1 ? 'entry' : 'entries' }}{% else %}<span class="text-slate-300">new</span>{% endif %}
    </td>
    <td class="px-4 py-2.5 text-right align-top">
      <button type="button" class="{{ remove_btn }} js-remove-taxonomy-row" title="Remove term" aria-label="Remove term">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/>
        </svg>
      </button>
    </td>
  </tr>
{% endmacro %}

{% extends '@admin/base.twig' %}

{% block content %}
  {% import _self as taxonomy_forms %}
  {% set primary_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set secondary_btn = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set remove_btn = 'inline-flex items-center justify-center rounded-md p-1.5 text-rose-500 hover:bg-rose-50 hover:text-rose-600' %}
  {% set input_class = 'w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20' %}

  <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-slate-900">Taxonomies</h1>
      <p class="mt-1 text-sm text-slate-500">Terms, their names in each language, and how each taxonomy's pages look.</p>
    </div>
    <form method="get" class="flex flex-wrap items-center gap-2">
      <label class="sr-only" for="taxonomy-select">Taxonomy</label>
      <select id="taxonomy-select" name="taxonomy" class="{{ input_class }} min-w-44">
        {% for name in taxonomy_names %}
          <option value="{{ name }}" {% if name == taxonomy %}selected{% endif %}>{{ name|title }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="{{ secondary_btn }}">Apply</button>
    </form>
  </header>

  {% if saved %}<template data-flash data-type="success">Saved.{% if moved %} {{ moved }} address{{ moved == 1 ? '' : 'es' }} changed: the old {{ moved == 1 ? 'one keeps' : 'ones keep' }} working (see Redirects).{% endif %}</template>{% endif %}
  {% if removed and orphaned %}<template data-flash data-type="warning">{{ removed }} term{{ removed == 1 ? '' : 's' }} removed, but {{ orphaned }} {{ orphaned == 1 ? 'entry is' : 'entries are' }} still filed under {{ removed == 1 ? 'it' : 'them' }}. The entries keep the old term in their files, and the term no longer has a page.</template>{% endif %}
  {% if error %}
    <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">{{ error }}</div>
  {% endif %}

  <form method="post" class="grid gap-4">
    {{ csrf_field() }}
    <input type="hidden" name="taxonomy" value="{{ taxonomy }}">

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">Taxonomy details</h2>
      </div>
      <div class="grid gap-4 p-4 md:grid-cols-2">
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Taxonomy key
          <input type="text" value="{{ taxonomy }}" readonly class="{{ input_class }} bg-slate-100">
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Taxonomy title
          <input type="text" name="taxonomy_title" value="{{ taxonomy_title }}" class="{{ input_class }}">
        </label>
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Terms</h2>
          <p class="mt-0.5 text-xs text-slate-400">Type the name in each language. The address is made from it (Greek letters become Latin), and you can change it later: the old address keeps working. Entries are filed under a term by an internal id that never changes.</p>
        </div>
        <button type="button" class="{{ secondary_btn }} js-add-taxonomy-row">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
          </svg>
          Add term
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              {% for langCode in languages %}
                <th class="px-4 py-2 font-medium">Name {{ langCode|upper }}</th>
              {% endfor %}
              <th class="px-4 py-2 font-medium">Address (/{{ taxonomy_kind }}/…)</th>
              <th class="px-4 py-2 font-medium">Used by</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody data-taxonomy-rows class="divide-y divide-slate-50">
            {% if taxonomy_terms is empty %}
              {% set empty_term = { id: '', slug: '', labels: {} } %}
              {{ taxonomy_forms.term_row(empty_term, languages, input_class, remove_btn, taxonomy_kind) }}
            {% else %}
              {% for term in taxonomy_terms %}
                {{ taxonomy_forms.term_row(term, languages, input_class, remove_btn, taxonomy_kind) }}
              {% endfor %}
            {% endif %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white">
      <div class="border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-900">How its pages look</h2>
        <p class="mt-0.5 text-xs text-slate-400">Applies to the page of every {{ taxonomy_kind }} in this taxonomy (for example /{{ taxonomy_kind }}/{{ (taxonomy_terms|first).slug|default('name') }}). Only what you change is stored; the rest follows the defaults.</p>
      </div>
      <div class="p-4">
        {% include '@admin/partials/archive-settings.twig' with {
          archive: archive, layouts: layouts, orders: orders, filter_names: other_taxonomies,
          title_placeholder: 'Default: "' ~ (taxonomy_kind == 'category' ? 'Category' : 'Tag') ~ ': Name"',
          title_hint: 'Write {term} where the name should appear, for example "Articles about {term}".',
          filter_note: 'Visitors can narrow the list of a ' ~ taxonomy_kind ~ ' page by these.'
        } only %}
        {% if listable_types|length > 1 %}
          <fieldset class="mt-3">
            <legend class="text-sm font-medium text-slate-700">Content listed</legend>
            <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700">
              {% for type in listable_types %}
                <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive[types][]" value="{{ type }}"{% if not archive.types or type in archive.types %} checked{% endif %} class="h-4 w-4 rounded border-slate-300"> {{ type_labels[type] }}</label>
              {% endfor %}
            </div>
            <p class="mt-1 text-xs text-slate-400">Which kinds of content appear on these pages. All of them by default.</p>
          </fieldset>
        {% endif %}
      </div>
    </section>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}      {% endblock %}
      {% block actions %}
      <button type="submit" class="{{ primary_btn }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save taxonomy
      </button>
      {% endblock %}
    {% endembed %}
  </form>

  <template data-taxonomy-row-template>
    {% set empty_term = { id: '', slug: '', labels: {} } %}
    {{ taxonomy_forms.term_row(empty_term, languages, input_class, remove_btn, taxonomy_kind) }}
  </template>

  <script>
    (function () {
      const body = document.querySelector('[data-taxonomy-rows]');
      const template = document.querySelector('[data-taxonomy-row-template]');
      const add = document.querySelector('.js-add-taxonomy-row');
      if (!body || !template || !add) return;

      const bindRemove = (button) => {
        button.addEventListener('click', () => {
          const row = button.closest('tr');
          if (!row) return;
          const used = parseInt(row.dataset.used || '0', 10);
          if (used > 0 && !window.confirm('This term is used by ' + used + ' ' + (used === 1 ? 'entry' : 'entries') + '. Remove it anyway? The entries keep the old term in their files, and its page disappears.')) return;
          row.remove();
        });
      };
      body.addEventListener('input', (event) => {
        const field = event.target.closest('[data-term-slug]');
        const note = field && field.closest('td').querySelector('[data-term-slug-note]');
        if (note) note.classList.toggle('hidden', field.value.trim() === '' || field.value.trim() === field.dataset.original);
      });

      body.querySelectorAll('.js-remove-taxonomy-row').forEach(bindRemove);
      add.addEventListener('click', () => {
        const fragment = template.content.cloneNode(true);
        const removeButton = fragment.querySelector('.js-remove-taxonomy-row');
        if (removeButton) bindRemove(removeButton);
        body.appendChild(fragment);
      });
    })();
  </script>
{% endblock %}
