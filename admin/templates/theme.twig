{% extends '@admin/base.twig' %}
{% set page_heading = 'Theme' %}

{% block content %}
  {% set tab_button_class = 'tab-button shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-medium text-slate-500 transition hover:text-slate-800' %}
  {% set section_class = 'rounded-lg border border-slate-200 bg-white p-4' %}
  {% set section_header_class = 'mb-3 border-b border-slate-100 pb-3' %}
  {% set secondary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set primary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set grid_columns = {1: '', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4', 5: 'sm:grid-cols-2 lg:grid-cols-5'} %}
  {% import '@admin/partials/ui.twig' as ui %}
  {% import '@admin/partials/fields.twig' as fields %}

  {% if saved %}
    {{ ui.flash('Saved.', 'success') }}
  {% endif %}
  {% if theme_status == 'fail' %}
    {{ ui.flash(theme_message ?: 'Theme settings could not be saved.', 'error') }}
  {% endif %}

  <form method="post" class="space-y-4">
    {{ csrf_field() }}
    <input type="hidden" name="active_tab" value="{{ active_tab }}" data-active-tab-input>

    {% if theme_tabs is empty %}
      <p class="rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-500">This theme has no options to set.</p>
    {% else %}
      <div>
        <div class="mb-4 overflow-x-auto border-b border-slate-200">
          <div class="flex min-w-max gap-1" role="tablist" aria-label="Theme sections">
            {% for key in theme_tabs %}
              <button type="button" role="tab" class="{{ tab_button_class }}{% if active_tab == key %} active{% endif %}" data-tab="{{ key }}" aria-selected="{{ active_tab == key ? 'true' : 'false' }}">{{ tab_labels[key] ?? theme_schema[key].label }}</button>
            {% endfor %}
          </div>
        </div>

        {% for key in theme_tabs %}
          {% if key == 'single_layouts' or key == 'archive_layouts' %}
            <div class="tab-panel space-y-4{% if active_tab != key %} hidden{% else %} active{% endif %}" data-panel="{{ key }}" role="tabpanel">
              {% include key == 'single_layouts' ? '@admin/partials/theme-single.twig' : '@admin/partials/theme-archives.twig' %}
            </div>
          {% elseif key == 'branding' %}
            {# Appearance, Brand and Design together (partials/theme-branding.twig). #}
            <div class="tab-panel space-y-4{% if active_tab != key %} hidden{% else %} active{% endif %}" data-panel="{{ key }}" role="tabpanel">
              {% include '@admin/partials/theme-branding.twig' with {schema: theme_schema, values: theme_values, info: branding} %}
            </div>
          {% elseif key in ['header', 'footer'] and theme_schema[key].fields.layout is defined %}
            {# Header and Footer are cards with a picture of the result (partials/theme-header.twig, theme-footer.twig). #}
            <div class="tab-panel space-y-4{% if active_tab != key %} hidden{% else %} active{% endif %}" data-panel="{{ key }}" role="tabpanel">
              {% include key == 'header' ? '@admin/partials/theme-header.twig' : '@admin/partials/theme-footer.twig' with {section: theme_schema[key], values: theme_values[key]} %}
            </div>
          {% else %}
          {% set section = theme_schema[key] %}
          {% set visible_fields = section.fields|filter(field => not field.hidden) %}
          <div class="tab-panel space-y-4{% if active_tab != key %} hidden{% else %} active{% endif %}" data-panel="{{ key }}" role="tabpanel">
            <div class="{{ section_class }}">
              <div class="{{ section_header_class }}">
                <h2 class="text-sm font-semibold text-slate-900">{{ section.label }}</h2>
                {% if section.description %}
                  <p class="mt-0.5 text-xs text-slate-400">{{ section.description }}</p>
                {% endif %}
              </div>
              <div class="grid grid-cols-1 gap-3 {{ grid_columns[section.columns] ?? 'sm:grid-cols-2' }}">
                {% for field in visible_fields %}
                  {{ fields.field(field, 'theme_settings[' ~ section.key ~ '][' ~ field.key ~ ']', theme_values[section.key][field.key] ?? field.default) }}
                {% endfor %}
              </div>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="flex flex-col gap-1 rounded-lg border border-slate-200 bg-white px-4 py-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <span><span class="font-semibold text-slate-800">{{ theme_info.label }}</span>{% if theme_info.version %} <span class="text-slate-400">v{{ theme_info.version }}</span>{% endif %} · options declared in <code class="rounded bg-slate-100 px-1 py-0.5 text-[11px]">themes/{{ theme_info.name }}/theme.yaml</code></span>
      <span>Site overrides: <code class="rounded bg-slate-100 px-1 py-0.5 text-[11px]">custom/</code> {{ theme_info.custom_dir ? 'in use' : 'not created yet' }}</span>
    </div>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
        <a href="{{ url('admin/theme?tab=' ~ active_tab) }}" class="{{ secondary_button_class }}">Discard</a>
      {% endblock %}
      {% block actions %}
        <button type="submit" class="{{ primary_button_class }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      {% endblock %}
    {% endembed %}
  </form>
  {% include '@admin/partials/icon-library.twig' %}
  <script src="{{ asset('js/admin-layouts.js') }}" defer></script>

  <script>
    (function () {
      const buttons = document.querySelectorAll('.tab-button');
      const panels = document.querySelectorAll('.tab-panel');
      const activeTabInput = document.querySelector('[data-active-tab-input]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.getAttribute('data-tab');
          buttons.forEach((item) => {
            item.classList.toggle('active', item === button);
            item.setAttribute('aria-selected', item === button ? 'true' : 'false');
          });
          panels.forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-panel') === target);
          });
          if (activeTabInput && target) activeTabInput.value = target;
        });
      });
    })();
  </script>
{% endblock %}
