{% extends '@admin/base.twig' %}

{% block content %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}
  {% set icon_danger = 'rounded-md p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600' %}
  {% set total_active = users|filter(u => u.status == 'active')|length %}
  {% set total_inactive = users|filter(u => u.status == 'inactive')|length %}

  {% if saved %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-sm text-emerald-800 shadow-sm">
      <span class="mt-px flex-1">Saved.</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% endif %}
  {% if deleted %}
    <div data-toast class="pointer-events-auto fixed right-4 top-4 z-[999] flex w-80 max-w-[calc(100vw-2rem)] items-start gap-3 rounded-md border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-sm text-emerald-800 shadow-sm">
      <span class="mt-px flex-1">User deactivated.</span>
      <button type="button" data-toast-dismiss class="text-current/60 hover:text-current">&times;</button>
    </div>
  {% endif %}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">Users</h1>
      <p class="truncate text-xs text-slate-400">Manage admin and member accounts.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-toggle="filter" data-target="userFilter" class="{{ btn_secondary }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4"/></svg>
        Filter
      </button>
      <a href="{{ url('admin/users-edit') }}" class="{{ btn_primary }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
        Add user
      </a>
    </div>
  </header>

  <div id="userFilter" class="mb-4 hidden rounded-lg border border-slate-200 bg-white p-4">
    <form method="get" class="grid grid-cols-1 gap-3 sm:grid-cols-4">
      <label class="block sm:col-span-2">
        <span class="mb-1 block text-sm font-medium text-slate-700">Search</span>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Name, username or email..." class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Role</span>
        <select name="role" class="{{ select_class }}">
          <option value="">All roles</option>
          {% for role in ['superadmin', 'admin', 'user'] %}
            <option value="{{ role }}" {% if filters.role == role %}selected{% endif %}>{{ role }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Status</span>
        <select name="status" class="{{ select_class }}">
          <option value="">All</option>
          {% for status in ['active', 'inactive'] %}
            <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status|title }}</option>
          {% endfor %}
        </select>
      </label>
      <div class="flex items-end justify-end gap-2 sm:col-span-4">
        <a href="{{ url('admin/users') }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a>
        <button type="submit" class="{{ btn_primary }}">Apply filters</button>
      </div>
    </form>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
      <span class="text-sm font-medium text-slate-700">{{ users|length }} users</span>
      <div class="flex gap-4 text-xs text-slate-400">
        <span><span class="font-medium text-emerald-600">{{ total_active }}</span> active</span>
        <span><span class="font-medium text-slate-500">{{ total_inactive }}</span> inactive</span>
      </div>
    </div>

    {% if users is empty %}
      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 14a4 4 0 10-8 0M12 7a3 3 0 110 0M3 20a6 6 0 0118 0"/></svg>
        </div>
        <h3 class="mt-3 text-sm font-semibold text-slate-900">No users match</h3>
        <p class="mt-1 max-w-sm text-sm text-slate-400">Adjust filters or add a new user.</p>
      </div>
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium">Name</th>
              <th class="px-4 py-2 font-medium">Email</th>
              <th class="px-4 py-2 font-medium">Role</th>
              <th class="px-4 py-2 font-medium">Status</th>
              <th class="px-4 py-2 font-medium">Last login</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for account in users %}
              {% set label = account.display_name ?: account.username %}
              {% set initials = label|split(' ')|map(part => part|first)|join('')|slice(0, 2)|upper %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5">
                  <div class="flex items-center gap-2.5">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-900 text-[11px] font-semibold text-white">{{ initials ?: 'U' }}</span>
                    <a href="{{ url('admin/users-edit?id=' ~ account.id) }}" class="font-medium text-slate-900 hover:text-blue-600">{{ label }}</a>
                  </div>
                  <div class="mt-0.5 text-xs text-slate-400">{{ account.username }}</div>
                </td>
                <td class="px-4 py-2.5 text-slate-600">{{ account.email ?: '—' }}</td>
                <td class="px-4 py-2.5">
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {% if account.role == 'superadmin' %}bg-violet-50 text-violet-700 ring-violet-200{% elseif account.role == 'admin' %}bg-blue-50 text-blue-700 ring-blue-200{% else %}bg-slate-100 text-slate-600 ring-slate-200{% endif %}">{{ account.role }}</span>
                </td>
                <td class="px-4 py-2.5">
                  <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {% if account.status == 'active' %}bg-emerald-50 text-emerald-700 ring-emerald-200{% else %}bg-slate-100 text-slate-500 ring-slate-200{% endif %}">{{ account.status }}</span>
                </td>
                <td class="px-4 py-2.5 text-slate-400">{{ account.last_login_at ?: 'Never' }}</td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center justify-end gap-0.5">
                    <a class="{{ icon_button }}" href="{{ url('admin/users-edit?id=' ~ account.id) }}" title="Edit {{ label }}" aria-label="Edit {{ label }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    </a>
                    {% if account.id != user.id|default(0) and account.status == 'active' %}
                      <form method="post" action="{{ url('admin/users-delete') }}" class="inline" onsubmit="return confirm('Deactivate this user?');">
                        <input type="hidden" name="id" value="{{ account.id }}">
                        <button type="submit" class="{{ icon_danger }}" title="Deactivate {{ label }}" aria-label="Deactivate {{ label }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M18.36 6.64A9 9 0 1 1 12 3v9"/></svg>
                        </button>
                      </form>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
{% endblock %}
