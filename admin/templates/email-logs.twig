{% extends '@admin/base.twig' %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  {% set filters_active = filters|filter(v => v != '')|length > 0 %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50' %}
  {% set btn_danger = 'inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-red-700' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}

  {% if cleared is not null %}
    <template data-flash data-type="success">Cleared {{ cleared }} email logs.</template>
  {% endif %}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">Email logs</h1>
      <p class="truncate text-xs text-slate-400">Delivery attempts for SMTP and SES emails.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {{ ui.filter_button('emailLogFilter', filters_active) }}
      <form method="post" data-confirm="Clear all email logs?" data-confirm-button="Clear logs">
        {{ csrf_field() }}
        <input type="hidden" name="email_log_action" value="clear">
        <button type="submit" class="{{ btn_danger }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/></svg>
          Clear logs
        </button>
      </form>
    </div>
  </header>

  <div id="emailLogFilter" class="mb-4 rounded-lg border border-slate-200 bg-white p-4 {{ filters_active ? '' : 'hidden' }}">
    <form method="get" class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Status</span>
        <select name="status" class="{{ select_class }}">
          <option value="">All statuses</option>
          {% for status in ['sent', 'failed'] %}
            <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status|title }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Provider</span>
        <select name="provider" class="{{ select_class }}">
          <option value="">All providers</option>
          {% for provider in providers %}
            <option value="{{ provider }}" {% if filters.provider == provider %}selected{% endif %}>{{ provider|upper }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block xl:col-span-2">
        <span class="mb-1 block text-sm font-medium text-slate-700">Recipient</span>
        <input type="text" name="recipient" value="{{ filters.recipient }}" placeholder="name@example.com" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">From</span>
        <input type="date" name="date_from" value="{{ filters.date_from }}" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">To</span>
        <input type="date" name="date_to" value="{{ filters.date_to }}" class="{{ input_class }}">
      </label>
      <label class="block xl:col-span-2">
        <span class="mb-1 block text-sm font-medium text-slate-700">Search</span>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Subject, error, context..." class="{{ input_class }}">
      </label>
      <div class="flex items-end justify-end gap-2 sm:col-span-2 xl:col-span-4">
        <a href="{{ url('admin/email-logs') }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a>
        <button type="submit" class="{{ btn_primary }}">Apply filters</button>
      </div>
    </form>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
      <span class="text-sm font-medium text-slate-700">{{ total_logs }} email logs</span>
      <form method="get" class="flex items-center gap-2 text-xs text-slate-500">
        {% for key, value in filters %}
          {% if value %}
            <input type="hidden" name="{{ key }}" value="{{ value }}">
          {% endif %}
        {% endfor %}
        <span>Rows</span>
        <select name="per_page" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-600 focus:border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900/5" onchange="this.form.submit()">
          {% for option in per_page_options %}
            <option value="{{ option }}" {% if per_page == option %}selected{% endif %}>{{ option }}</option>
          {% endfor %}
        </select>
      </form>
    </div>

    {% if logs is empty %}
      {{ filters_active
        ? ui.empty_state('No email logs match these filters', 'Reset the filters to see every delivery attempt.')
        : ui.empty_state('No email logs yet', 'SMTP and SES delivery attempts will appear here.') }}
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium" data-sort="text">Time</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Status</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Provider</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Recipient</th>
              <th class="px-4 py-2 font-medium">Subject</th>
              <th class="px-4 py-2 font-medium">Error</th>
              <th class="px-4 py-2 text-right font-medium">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for log in logs %}
              <tr class="hover:bg-slate-50">
                <td class="whitespace-nowrap px-4 py-2.5 text-slate-500">{{ log.created_at }}</td>
                <td class="px-4 py-2.5">{{ ui.status_badge(log.status) }}</td>
                <td class="px-4 py-2.5"><span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{ log.provider ?: 'none' }}</span></td>
                <td class="max-w-56 px-4 py-2.5"><div class="truncate font-medium text-slate-700">{{ log.recipient }}</div></td>
                <td class="max-w-md px-4 py-2.5 text-slate-600"><div class="truncate">{{ log.subject ?: '—' }}</div></td>
                <td class="max-w-sm px-4 py-2.5 text-slate-500"><div class="truncate">{{ log.error_message ?: '—' }}</div></td>
                <td class="px-4 py-2.5 text-right">
                  <button type="button" class="{{ icon_button }}" data-offcanvas-open="email-log-{{ log.id }}" title="View details" aria-label="View details">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {% if total_pages > 1 %}
    <div class="mt-4 flex items-center justify-between text-sm text-slate-500">
      <span>Page {{ page }} of {{ total_pages }}</span>
      <div class="flex gap-2">
        {% set base_query = filters|merge({'per_page': per_page}) %}
        {% if page > 1 %}
          <a class="{{ btn_secondary }}" href="{{ url('admin/email-logs?' ~ (base_query|merge({'page': page - 1})|url_encode)) }}">Previous</a>
        {% endif %}
        {% if page < total_pages %}
          <a class="{{ btn_secondary }}" href="{{ url('admin/email-logs?' ~ (base_query|merge({'page': page + 1})|url_encode)) }}">Next</a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% for log in logs %}
    <div id="email-log-{{ log.id }}" data-offcanvas-root hidden>
      <div data-offcanvas-backdrop class="fixed inset-0 z-40 bg-slate-900/40"></div>
      <aside data-offcanvas class="fixed right-0 top-0 z-50 h-full w-full max-w-lg translate-x-full overflow-y-auto bg-white shadow-xl transition-transform duration-300">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <div>
            <h2 class="text-sm font-semibold text-slate-900">{{ log.subject ?: 'Email attempt' }}</h2>
            <p class="mt-0.5 text-xs text-slate-400">{{ log.created_at }}</p>
          </div>
          <button type="button" data-offcanvas-close class="rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="space-y-4 p-5 text-sm">
          <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div><dt class="text-xs font-medium uppercase text-slate-400">Status</dt><dd class="mt-1 text-slate-700">{{ log.status }}</dd></div>
            <div><dt class="text-xs font-medium uppercase text-slate-400">Provider</dt><dd class="mt-1 text-slate-700">{{ log.provider ?: 'none' }}</dd></div>
            <div class="sm:col-span-2"><dt class="text-xs font-medium uppercase text-slate-400">Recipient</dt><dd class="mt-1 break-all text-slate-700">{{ log.recipient }}</dd></div>
          </dl>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">Subject</h3>
            <p class="mt-1 text-slate-700">{{ log.subject ?: '—' }}</p>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">Error</h3>
            <p class="mt-1 text-slate-700">{{ log.error_message ?: '—' }}</p>
          </div>
          <div>
            <h3 class="text-xs font-medium uppercase text-slate-400">Context</h3>
            <pre class="mt-1 max-h-80 overflow-auto rounded-md bg-slate-950 p-3 text-xs leading-relaxed text-slate-100">{{ log.context_json ?: '{}' }}</pre>
          </div>
        </div>
      </aside>
    </div>
  {% endfor %}
{% endblock %}
