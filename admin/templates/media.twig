{% extends '@admin/base.twig' %}
{% set page_heading = 'Files' %}

{#
  Admin > Media: the files of the site. A line to upload (drop files anywhere on it), a bar to find them (the kind, the search, in use or
  not, a tag, grid or list), and the files as thumbnails (the usual view) or as a list. A click on a file opens its details in a window:
  a preview, its address, the alt text and tags to edit, where it is used, and Delete. Select several to tag or delete them together.
  Everything is a plain form (as MediaAdmin reads it); admin-media.js drops files, selects, copies an address and opens the window.
#}

{# Where a file is used: "Unused", or a small list that opens on click. #}
{% macro used_in(places) %}
  {% if places is empty %}
    <span class="md-use is-none">Unused</span>
  {% else %}
    <details class="md-use-list">
      <summary class="md-use is-used">Used in {{ places|length }} {{ places|length == 1 ? 'place' : 'places' }}</summary>
      <ul>
        {% for place in places|slice(0, 8) %}<li><a href="{{ url(place.url) }}">{{ place.label }}</a></li>{% endfor %}
        {% if places|length > 8 %}<li class="text-slate-400">and {{ places|length - 8 }} more</li>{% endif %}
      </ul>
    </details>
  {% endif %}
{% endmacro %}

{# The icon of a file that has no picture, in the colour of its kind. #}
{% macro kind_icon(kind) %}
  <span class="md-kind is-{{ kind }}" aria-hidden="true">
    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      {% if kind == 'video' %}<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h11a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1zM16 10l5-3v10l-5-3"/>
      {% elseif kind == 'audio' %}<path stroke-linecap="round" stroke-linejoin="round" d="M9 18V6l10-2v12M9 18a3 3 0 11-6 0 3 3 0 016 0zM19 16a3 3 0 11-6 0 3 3 0 016 0z"/>
      {% elseif kind == 'archive' %}<path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16v4H4zM6 11v8h12v-8M10 15h4"/>
      {% else %}<path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5M9 13h6M9 17h6"/>{% endif %}
    </svg>
  </span>
{% endmacro %}

{# The form fields every form of one list needs, so a person lands on the same list after saving. #}
{% macro state(type, tag, q, usage, view_mode, per_page, page) %}
  <input type="hidden" name="_state_type" value="{{ type }}">
  <input type="hidden" name="_state_tag" value="{{ tag }}">
  <input type="hidden" name="_state_q" value="{{ q }}">
  <input type="hidden" name="_state_usage" value="{{ usage }}">
  <input type="hidden" name="_state_view" value="{{ view_mode }}">
  <input type="hidden" name="_state_per_page" value="{{ per_page }}">
  <input type="hidden" name="_state_page" value="{{ page }}">
{% endmacro %}

{# What the window of a file shows; kept in a template and copied into the window when the file is opened. #}
{% macro detail(item, type, tag, q, usage, view_mode, per_page, page) %}
  {% import _self as m %}
  <div class="md-d">
    <div class="md-d-preview">
      {% if item.kind == 'image' and item.direct_url %}<img src="{{ item.direct_url }}" alt="{{ item.alt }}">{% else %}{{ m.kind_icon(item.kind) }}{% endif %}
    </div>
    <div class="md-d-body">
      <h2 class="md-d-name">{{ item.original_name }}</h2>
      <p class="md-d-meta">{{ item.kind|title }} · {{ item.mime_type }} · {{ item.size_human }} · {{ item.created_at_display }}</p>
      <div class="md-d-url">
        <input type="text" readonly value="{{ item.direct_url }}" aria-label="Address of the file" onclick="this.select()">
        <button type="button" class="md-btn" data-copy-url="{{ item.direct_url }}">Copy</button>
        <a class="md-btn" href="{{ item.direct_url }}" target="_blank" rel="noopener">Open</a>
      </div>
      <form method="post" action="{{ url('admin/media') }}" class="md-d-form">
        {{ csrf_field() }}
        <input type="hidden" name="media_action" value="save_tags">
        <input type="hidden" name="id" value="{{ item.id }}">
        {{ m.state(type, tag, q, usage, view_mode, per_page, page) }}
        {% if item.kind == 'image' %}
          <label>Alt text<input type="text" name="alt" value="{{ item.alt }}" class="lc-input" placeholder="What the image shows (read by screen readers and search engines)"></label>
        {% endif %}
        <label>Tags<input type="text" name="tags" value="{{ item.tags_csv }}" class="lc-input" placeholder="news, hero, brochure"></label>
        <div><button type="submit" class="md-save">Save</button></div>
      </form>
      <div class="md-d-used"><span>Used in</span>
        {% if item.places is empty %}<em>Nothing points at this file.</em>
        {% else %}<ul>{% for place in item.places|slice(0, 8) %}<li><a href="{{ url(place.url) }}">{{ place.label }}</a></li>{% endfor %}{% if item.places|length > 8 %}<li>and {{ item.places|length - 8 }} more</li>{% endif %}</ul>{% endif %}
      </div>
      <form method="post" action="{{ url('admin/media') }}" class="md-d-delete" data-confirm="{{ item.places ? 'This file is used in ' ~ item.places_sentence ~ '. Deleting it leaves a broken image or link there. Delete it anyway?' : 'Delete this media item?' }}" data-confirm-button="Delete">
        {{ csrf_field() }}
        <input type="hidden" name="media_action" value="delete">
        {% if item.places %}<input type="hidden" name="confirm_used" value="1">{% endif %}
        <input type="hidden" name="id" value="{{ item.id }}">
        {{ m.state(type, tag, q, usage, view_mode, per_page, page) }}
        <button type="submit" class="md-del">Delete this file</button>
      </form>
    </div>
  </div>
{% endmacro %}

{% block content %}
  {% import '@admin/partials/ui.twig' as ui %}
  {% import _self as m %}

  {% set summary_from = total_items > 0 ? ((page - 1) * per_page) + 1 : 0 %}
  {% set summary_to = total_items > 0 ? ((page - 1) * per_page) + (items|length) : 0 %}
  {% set keep = {type: type, tag: tag, q: q, usage: usage, per_page: per_page, view: view_mode} %}
  {% set filtering = q is not empty or tag is not empty or usage is not empty or type != 'all' %}

  <header class="mb-3">
    <p class="m-0 text-xs text-slate-500">The pictures, documents and other files of the site. Click a file for its details; drop files on the upload line to add them.</p>
  </header>

  {{ ui.flash(success, 'success') }}
  {{ ui.flash(error, 'error') }}

  <form id="media-upload-form" method="post" action="{{ url('admin/media') }}" enctype="multipart/form-data" class="media-dropzone md-upload">
    {{ csrf_field() }}
    <input type="hidden" name="media_action" value="upload">
    {{ m.state(type, tag, q, usage, view_mode, per_page, page) }}
    <span class="md-upload-icon" aria-hidden="true"><svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg></span>
    <span class="md-upload-text"><strong>Drop files to upload</strong><small>{% if max_upload_mb %}max {{ max_upload_mb }} MB per file{% else %}no size limit{% endif %}</small></span>
    <input id="media-upload-input" type="file" name="upload_file[]" multiple required accept="{{ upload_accept }}" title="Allowed: {{ upload_kinds }}" aria-label="Files to upload" class="md-file">
    <label class="md-upload-tags"><span class="sr-only">Tags</span><input type="text" name="upload_tags" class="lc-input" placeholder="Tags: news, hero, brochure"></label>
    <button type="submit" class="md-save"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0l-4 4m4-4l4 4M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"/></svg>Upload</button>
  </form>

  <div data-media-scope>
    <div class="md-bar">
      <nav class="an-seg" aria-label="Kind of file">
        {% for mediaType in types_available %}
          <a href="{{ url('admin/media?' ~ keep|merge({type: mediaType})|url_encode) }}"{% if mediaType == type %} aria-current="true"{% endif %}>{{ mediaType|title }}</a>
        {% endfor %}
      </nav>
      <form method="get" action="{{ url('admin/media') }}" role="search" class="tr-search md-search">
        <span class="sr-only">Search files</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M21 21l-4.3-4.3M11 18a7 7 0 110-14 7 7 0 010 14z"/></svg>
        <input type="search" name="q" value="{{ q }}" aria-label="Search files" placeholder="Search by name or tag" class="lc-input">
        <input type="hidden" name="type" value="{{ type }}"><input type="hidden" name="view" value="{{ view_mode }}"><input type="hidden" name="tag" value="{{ tag }}"><input type="hidden" name="usage" value="{{ usage }}"><input type="hidden" name="per_page" value="{{ per_page }}">
      </form>
      <nav class="an-seg" aria-label="Use">
        <a href="{{ url('admin/media?' ~ keep|merge({usage: ''})|url_encode) }}"{% if usage == '' %} aria-current="true"{% endif %}>Any</a>
        <a href="{{ url('admin/media?' ~ keep|merge({usage: 'used'})|url_encode) }}"{% if usage == 'used' %} aria-current="true"{% endif %} title="Files a page, post, menu or setting points at">In use</a>
        <a href="{{ url('admin/media?' ~ keep|merge({usage: 'unused'})|url_encode) }}"{% if usage == 'unused' %} aria-current="true"{% endif %} title="Files nothing points at">Unused{% if unused_total > 0 %} <em>{{ unused_total }}</em>{% endif %}</a>
      </nav>
      {% if available_tags %}
        <form method="get" action="{{ url('admin/media') }}" class="md-tag">
          <input type="hidden" name="type" value="{{ type }}"><input type="hidden" name="view" value="{{ view_mode }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="usage" value="{{ usage }}"><input type="hidden" name="per_page" value="{{ per_page }}">
          <select name="tag" class="lc-input lc-select" aria-label="Tag" onchange="this.form.submit()">
            <option value="">All tags</option>
            {% for availableTag in available_tags %}<option value="{{ availableTag }}" {% if availableTag == tag %}selected{% endif %}>{{ availableTag }}</option>{% endfor %}
          </select>
        </form>
      {% endif %}
      <nav class="an-seg md-views" aria-label="View">
        <a href="{{ url('admin/media?' ~ keep|merge({view: 'thumbs'})|url_encode) }}" title="Thumbnails"{% if view_mode == 'thumbs' %} aria-current="true"{% endif %}><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v6H4zM14 15h6v6h-6z"/></svg><span class="sr-only">Thumbnails</span></a>
        <a href="{{ url('admin/media?' ~ keep|merge({view: 'list'})|url_encode) }}" title="List"{% if view_mode == 'list' %} aria-current="true"{% endif %}><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg><span class="sr-only">List</span></a>
      </nav>
    </div>

    <section class="hidden md-bulk" id="media-bulk-panel" aria-label="Selected files">
      <div class="md-bulk-info">
        <strong><span id="media-selected-count">0</span> selected</strong>
        <label class="md-bulk-all"><input id="media-apply-all-filtered" type="checkbox"> All {{ total_items }} of this list</label>
      </div>
      <form id="media-bulk-tags-form" method="post" action="{{ url('admin/media') }}" class="md-bulk-form">
        {{ csrf_field() }}
        <input type="hidden" name="media_action" value="bulk_tags">
        <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
        <input type="hidden" name="_filter_type" value="{{ type }}">
        <input type="hidden" name="_filter_tag" value="{{ tag }}">
        <input type="hidden" name="_filter_q" value="{{ q }}">
        <input type="hidden" name="_filter_usage" value="{{ usage }}">
        {{ m.state(type, tag, q, usage, view_mode, per_page, page) }}
        <div data-selected-ids></div>
        <label><span class="sr-only">Add tags</span><input type="text" name="tags" class="lc-input" placeholder="Add tags: promo, homepage"></label>
        <button type="submit" class="md-btn">Save tags</button>
      </form>
      <form id="media-bulk-delete-form" method="post" action="{{ url('admin/media') }}" data-confirm="Delete the selected files? Files that are in use are kept." data-confirm-button="Delete">
        {{ csrf_field() }}
        <input type="hidden" name="media_action" value="bulk_delete">
        <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
        <input type="hidden" name="_filter_type" value="{{ type }}">
        <input type="hidden" name="_filter_tag" value="{{ tag }}">
        <input type="hidden" name="_filter_q" value="{{ q }}">
        <input type="hidden" name="_filter_usage" value="{{ usage }}">
        {{ m.state(type, tag, q, usage, view_mode, per_page, page) }}
        <div data-selected-ids></div>
        <button type="submit" class="md-del">Delete selected</button>
      </form>
    </section>

    <div class="md-strip">
      <label class="md-check"><input id="media-select-all" type="checkbox" aria-label="Select all on this page"></label>
      <span data-media-count>{{ total_items }} {{ total_items == 1 ? 'file' : 'files' }}{% if filtering %} found{% endif %}</span>
      {% if filtering %}<a class="md-reset" href="{{ url('admin/media') }}">Clear filters</a>{% endif %}
    </div>

    {% if items is empty %}
      <div class="md-empty">
        <span class="md-empty-icon" aria-hidden="true"><svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4-4a2 2 0 013 0l5 5M14 14l1-1a2 2 0 013 0l2 2M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM9 9h.01"/></svg></span>
        <h2>{{ filtering ? 'No files match' : 'No files uploaded' }}</h2>
        <p>{{ filtering ? 'Change the search or the filters to see more.' : 'Drop ' ~ upload_kinds ~ ' on the upload line above to use them across content.' }}</p>
      </div>
    {% elseif view_mode == 'list' %}
      <section class="md-listbox lc-card rounded-xl border border-slate-200 bg-white" aria-label="Files">
        <div class="overflow-x-auto">
          <table class="md-table" data-sortable>
            <caption class="sr-only">Files</caption>
            <thead>
              <tr>
                <th class="w-8"><span class="sr-only">Select</span></th>
                <th data-sort="text">File</th>
                <th data-sort="text">Type</th>
                <th data-sort="number">Size</th>
                <th>Used</th>
                <th>Tags</th>
                <th data-sort="text">Added</th>
                <th class="text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {% for item in items %}
                <tr>
                  <td><input type="checkbox" class="media-select-item" value="{{ item.id }}" data-kind="{{ item.kind }}" aria-label="Select {{ item.original_name }}"></td>
                  <td>
                    <button type="button" class="md-file-open" data-md-open="{{ item.id }}">
                      {% if item.kind == 'image' and item.thumbnail_url %}<img src="{{ item.thumbnail_url }}" alt="" class="md-mini">{% else %}<span class="md-mini is-icon">{{ m.kind_icon(item.kind) }}</span>{% endif %}
                      <span class="min-w-0"><b title="{{ item.original_name }}">{{ item.original_name }}</b><small>{{ item.mime_type }}</small></span>
                    </button>
                  </td>
                  <td>{{ item.kind|title }}</td>
                  <td data-sort-value="{{ item.size_bytes|default(0) }}">{{ item.size_human }}</td>
                  <td>{{ m.used_in(item.places) }}</td>
                  <td>{% for t in item.tags_csv|split(',') %}{% if t|trim %}<span class="md-tag">{{ t|trim }}</span>{% endif %}{% endfor %}</td>
                  <td class="text-slate-500">{{ item.created_at_display }}</td>
                  <td class="text-right">
                    <span class="md-row-actions">
                      <button type="button" class="md-icon" data-md-open="{{ item.id }}" title="Details" aria-label="Details of {{ item.original_name }}"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20h4L19 9l-4-4L4 16v4zM13 7l4 4"/></svg></button>
                      <button type="button" class="md-icon" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL of {{ item.original_name }}"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 8h10v10H8zM6 16H5a1 1 0 01-1-1V5a1 1 0 011-1h10a1 1 0 011 1v1"/></svg></button>
                      <a class="md-icon" href="{{ item.direct_url }}" target="_blank" rel="noopener" title="Open file" aria-label="Open {{ item.original_name }}"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/></svg></a>
                    </span>
                    <template data-md-detail="{{ item.id }}">{{ m.detail(item, type, tag, q, usage, view_mode, per_page, page) }}</template>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% else %}
      <ul class="md-grid" aria-label="Files">
        {% for item in items %}
          <li class="md-tile">
            <div class="md-thumb">
              <button type="button" class="md-thumb-btn" data-md-open="{{ item.id }}" aria-label="Details of {{ item.original_name }}">
                {% if item.kind == 'image' and item.thumbnail_url %}<img src="{{ item.thumbnail_url }}" alt="" loading="lazy">{% else %}{{ m.kind_icon(item.kind) }}{% endif %}
              </button>
              <label class="md-pick"><input type="checkbox" class="media-select-item" value="{{ item.id }}" data-kind="{{ item.kind }}" aria-label="Select {{ item.original_name }}"></label>
              {% if item.kind != 'image' %}<span class="md-badge">{{ item.kind|title }}</span>{% endif %}
              <span class="md-quick">
                <button type="button" class="md-icon" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL of {{ item.original_name }}"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 8h10v10H8zM6 16H5a1 1 0 01-1-1V5a1 1 0 011-1h10a1 1 0 011 1v1"/></svg></button>
                <a class="md-icon" href="{{ item.direct_url }}" target="_blank" rel="noopener" title="Open file" aria-label="Open {{ item.original_name }}"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/></svg></a>
              </span>
            </div>
            <div class="md-info">
              <p class="md-name" title="{{ item.original_name }}">{{ item.original_name }}</p>
              <p class="md-meta"><span>{{ item.size_human }}</span><span>{{ item.created_at_display }}</span></p>
              {{ m.used_in(item.places) }}
            </div>
            <template data-md-detail="{{ item.id }}">{{ m.detail(item, type, tag, q, usage, view_mode, per_page, page) }}</template>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="md-foot">
      <div class="flex flex-wrap items-center gap-3">
        <p class="m-0 text-xs text-slate-500">Showing <b class="font-semibold text-slate-700">{{ summary_from }}–{{ summary_to }}</b> of <b class="font-semibold text-slate-700">{{ total_items }}</b></p>
        <form method="get" action="{{ url('admin/media') }}" class="flex items-center gap-1.5">
          <input type="hidden" name="type" value="{{ type }}"><input type="hidden" name="tag" value="{{ tag }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="usage" value="{{ usage }}"><input type="hidden" name="view" value="{{ view_mode }}">
          <label for="media-per-page" class="text-xs text-slate-500">Per page</label>
          <select id="media-per-page" name="per_page" class="lc-input lc-select" onchange="this.form.submit()">
            {% for option in per_page_options %}<option value="{{ option }}" {% if option == per_page %}selected{% endif %}>{{ option }}</option>{% endfor %}
          </select>
        </form>
      </div>
      <nav class="flex items-center gap-1" aria-label="Pages">
        {% set prev_page = page > 1 ? page - 1 : 1 %}
        {% set next_page = page < total_pages ? page + 1 : total_pages %}
        <a class="ct-pill{{ page <= 1 ? ' is-disabled' : '' }}" href="{{ url('admin/media?' ~ keep|merge({page: prev_page})|url_encode) }}"{% if page <= 1 %} aria-disabled="true" tabindex="-1"{% endif %}>Prev</a>
        <span class="md-page">{{ page }}<small> / {{ total_pages }}</small></span>
        <a class="ct-pill{{ page >= total_pages ? ' is-disabled' : '' }}" href="{{ url('admin/media?' ~ keep|merge({page: next_page})|url_encode) }}"{% if page >= total_pages %} aria-disabled="true" tabindex="-1"{% endif %}>Next</a>
      </nav>
    </div>
  </div>

  <div id="media-detail" data-modal hidden class="fixed inset-0 z-[900] flex items-center justify-center p-4">
    <div data-modal-backdrop class="absolute inset-0 bg-slate-900/50"></div>
    <div role="dialog" aria-modal="true" aria-label="Details of the file" class="md-dialog">
      <button type="button" class="md-close" data-modal-close aria-label="Close">×</button>
      <div data-md-body></div>
    </div>
  </div>
  <script src="{{ asset('js/admin-media.js') }}" defer></script>
{% endblock %}
