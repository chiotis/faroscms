{% extends '@admin/base.twig' %}

{% block content %}
  {% set primary_btn = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set secondary_btn = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set icon_btn = 'inline-flex items-center justify-center rounded-md p-1.5 text-slate-400 no-underline hover:bg-slate-100 hover:text-slate-700' %}
  {% set danger_icon_btn = 'inline-flex items-center justify-center rounded-md p-1.5 text-rose-500 hover:bg-rose-50 hover:text-rose-600' %}
  {% set input_class = 'w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20' %}
  {% set select_class = input_class %}
  {% set summary_from = total_items > 0 ? ((page - 1) * per_page) + 1 : 0 %}
  {% set summary_to = total_items > 0 ? ((page - 1) * per_page) + (items|length) : 0 %}
  {% set filters_open = q is not empty or tag is not empty %}

  <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-slate-900">Files</h1>
      <p class="mt-1 text-sm text-slate-500">Uploads and media library.</p>
    </div>
    <button type="button" class="{{ primary_btn }}" data-upload-focus>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
      </svg>
      Upload files
    </button>
  </header>

  {% if success %}
    <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>{{ success }}</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}
  {% if error %}
    <div class="toast fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-rose-300 bg-rose-50 px-3.5 py-2.5 text-rose-800 shadow">
      <span>{{ error }}</span>
      <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">x</button>
    </div>
  {% endif %}

  <form id="media-upload-form" method="post" action="{{ url('admin/media') }}" enctype="multipart/form-data" class="mb-4 rounded-lg border-2 border-dashed border-slate-200 bg-white p-6 text-center">
    {{ csrf_field() }}
    <input type="hidden" name="media_action" value="upload">
    <input type="hidden" name="_state_type" value="{{ type }}">
    <input type="hidden" name="_state_tag" value="{{ tag }}">
    <input type="hidden" name="_state_q" value="{{ q }}">
    <input type="hidden" name="_state_view" value="{{ view_mode }}">
    <input type="hidden" name="_state_per_page" value="{{ per_page }}">
    <input type="hidden" name="_state_page" value="{{ page }}">

    <label class="mx-auto grid max-w-3xl cursor-pointer gap-3">
      <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-slate-100">
        <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
        </svg>
      </span>
      <span>
        <span class="block text-sm font-medium text-slate-700">Drop files to upload</span>
        <span class="block text-xs text-slate-400">or click to browse - max {{ max_upload_mb }} MB per file</span>
      </span>
      <input id="media-upload-input" type="file" name="upload_file[]" multiple required class="mx-auto block w-full max-w-xl cursor-pointer rounded-md border border-slate-300 bg-white text-sm text-slate-700 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
    </label>

    <div class="mx-auto mt-4 flex max-w-3xl flex-wrap items-end justify-center gap-3 text-left">
      <label class="grid min-w-64 flex-1 gap-1 text-sm font-medium text-slate-700">
        Tags
        <input type="text" name="upload_tags" class="{{ input_class }}" placeholder="news, hero, brochure">
      </label>
      <button type="submit" class="{{ primary_btn }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0l-4 4m4-4l4 4M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3"/>
        </svg>
        Upload
      </button>
    </div>
  </form>

  <div data-media-scope class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-col gap-3 border-b border-slate-200 px-4 py-2.5 xl:flex-row xl:items-center xl:justify-between">
      <div class="flex items-center gap-2 overflow-x-auto">
        <span data-media-count class="mr-1 shrink-0 text-sm font-medium text-slate-700">{{ total_items }} {{ total_items == 1 ? 'file' : 'files' }}</span>
        <span class="mx-1 h-4 w-px shrink-0 bg-slate-200"></span>
        {% for mediaType in types_available %}
          <a href="{{ url('admin/media?type=' ~ mediaType ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&per_page=' ~ per_page ~ '&view=' ~ view_mode) }}" class="shrink-0 rounded-md px-2.5 py-1 text-xs font-medium no-underline {{ mediaType == type ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100' }}">{{ mediaType|title }}</a>
        {% endfor %}
      </div>

      <div class="flex flex-wrap items-center gap-2 xl:shrink-0">
        <form method="get" action="{{ url('admin/media') }}" class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="type" value="{{ type }}">
          <input type="hidden" name="view" value="{{ view_mode }}">
          <input type="hidden" name="tag" value="{{ tag }}">
          <input type="hidden" name="per_page" value="{{ per_page }}">
          <div class="relative">
            <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" d="M21 21l-4.3-4.3M11 18a7 7 0 110-14 7 7 0 010 14z"/>
            </svg>
            <input type="search" name="q" value="{{ q }}" placeholder="Search files..." class="w-48 rounded-md border border-slate-200 bg-slate-50 py-1.5 pl-8 pr-3 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900/5">
          </div>
        </form>

        <button type="button" data-toggle="filter" data-target="mediaFilter" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4"/>
          </svg>
          Filter
        </button>

        <div class="flex items-center gap-0.5 rounded-md bg-slate-100 p-0.5">
          <a href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&per_page=' ~ per_page ~ '&view=list') }}" title="List view" class="rounded p-1.5 no-underline {{ view_mode == 'list' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-400 hover:text-slate-700' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </a>
          <a href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&per_page=' ~ per_page ~ '&view=thumbs') }}" title="Grid view" class="rounded p-1.5 no-underline {{ view_mode == 'thumbs' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-400 hover:text-slate-700' }}">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v6H4zM14 15h6v6h-6z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div id="mediaFilter" class="{{ filters_open ? '' : 'hidden' }} border-b border-slate-200 bg-slate-50/50 p-3">
      <form method="get" action="{{ url('admin/media') }}" class="grid grid-cols-1 gap-3 sm:grid-cols-4">
        <input type="hidden" name="view" value="{{ view_mode }}">
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Type
          <select name="type" class="{{ select_class }}">
            {% for mediaType in types_available %}
              <option value="{{ mediaType }}" {% if mediaType == type %}selected{% endif %}>{{ mediaType|title }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Tag
          <select name="tag" class="{{ select_class }}">
            <option value="">All tags</option>
            {% for availableTag in available_tags %}
              <option value="{{ availableTag }}" {% if availableTag == tag %}selected{% endif %}>{{ availableTag }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Per page
          <select name="per_page" class="{{ select_class }}">
            {% for option in per_page_options %}
              <option value="{{ option }}" {% if option == per_page %}selected{% endif %}>{{ option }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Search
          <input type="text" name="q" value="{{ q }}" class="{{ input_class }}" placeholder="Name, mime, tags">
        </label>
        <div class="flex items-end justify-end gap-2 sm:col-span-4">
          <a class="{{ secondary_btn }}" href="{{ url('admin/media') }}">Reset</a>
          <button type="submit" class="{{ primary_btn }}">Apply</button>
        </div>
      </form>
    </div>

    <section class="hidden border-b border-slate-200 bg-slate-50/50 px-4 py-3" id="media-bulk-panel">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-semibold text-slate-700">Bulk actions</p>
          <p class="text-xs text-slate-500"><span id="media-selected-count">0</span> selected</p>
          <label class="mt-2 inline-flex items-center gap-2 text-sm text-slate-700">
            <input id="media-apply-all-filtered" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400">
            Apply to all filtered results
          </label>
        </div>

        <div class="flex flex-wrap items-end gap-2">
          <form id="media-bulk-tags-form" method="post" action="{{ url('admin/media') }}" class="flex flex-wrap items-end gap-2">
            {{ csrf_field() }}
            <input type="hidden" name="media_action" value="bulk_tags">
            <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
            <input type="hidden" name="_filter_type" value="{{ type }}">
            <input type="hidden" name="_filter_tag" value="{{ tag }}">
            <input type="hidden" name="_filter_q" value="{{ q }}">
            <input type="hidden" name="_state_type" value="{{ type }}">
            <input type="hidden" name="_state_tag" value="{{ tag }}">
            <input type="hidden" name="_state_q" value="{{ q }}">
            <input type="hidden" name="_state_view" value="{{ view_mode }}">
            <input type="hidden" name="_state_per_page" value="{{ per_page }}">
            <input type="hidden" name="_state_page" value="{{ page }}">
            <div data-selected-ids></div>
            <label class="grid gap-1 text-sm font-medium text-slate-700">
              Add tags
              <input type="text" name="tags" class="{{ input_class }}" placeholder="promo, homepage">
            </label>
            <button type="submit" class="{{ secondary_btn }}">Save tags</button>
          </form>

          <form id="media-bulk-delete-form" method="post" action="{{ url('admin/media') }}" data-confirm="Delete selected media items?" data-confirm-button="Delete">
            {{ csrf_field() }}
            <input type="hidden" name="media_action" value="bulk_delete">
            <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
            <input type="hidden" name="_filter_type" value="{{ type }}">
            <input type="hidden" name="_filter_tag" value="{{ tag }}">
            <input type="hidden" name="_filter_q" value="{{ q }}">
            <input type="hidden" name="_state_type" value="{{ type }}">
            <input type="hidden" name="_state_tag" value="{{ tag }}">
            <input type="hidden" name="_state_q" value="{{ q }}">
            <input type="hidden" name="_state_view" value="{{ view_mode }}">
            <input type="hidden" name="_state_per_page" value="{{ per_page }}">
            <input type="hidden" name="_state_page" value="{{ page }}">
            <div data-selected-ids></div>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-md bg-rose-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-rose-500">Delete selected</button>
          </form>
        </div>
      </div>
    </section>

    {% if items is empty %}
      <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
          <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-7 5h8a2 2 0 002-2V7l-5-5H7a2 2 0 00-2 2v15a2 2 0 002 2z"/>
          </svg>
        </div>
        <h2 class="mt-3 text-sm font-semibold text-slate-900">No files uploaded</h2>
        <p class="mt-1 max-w-sm text-sm text-slate-400">Upload images, documents and archives to use across content.</p>
        <button type="button" class="{{ primary_btn }} mt-4" data-upload-focus>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
          </svg>
          Upload files
        </button>
      </div>
    {% elseif view_mode == 'list' %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="px-4 py-2 font-medium">
                <input id="media-select-all" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" aria-label="Select all">
              </th>
              <th class="px-4 py-2 font-medium" data-sort="text">File</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Type</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Size</th>
              <th class="px-4 py-2 font-medium">Tags</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Created</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for item in items %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2.5 align-top">
                  <input type="checkbox" class="media-select-item h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" value="{{ item.id }}" data-kind="{{ item.kind }}">
                </td>
                <td class="px-4 py-2.5 align-top">
                  <div class="flex min-w-0 items-center gap-2.5">
                    {% if item.kind == 'image' and item.thumbnail_url %}
                      <img src="{{ item.thumbnail_url }}" alt="{{ item.original_name }}" class="h-8 w-8 rounded-md object-cover">
                    {% else %}
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md {{ item.kind == 'document' ? 'bg-rose-50 text-rose-600' : (item.kind == 'archive' ? 'bg-amber-50 text-amber-600' : (item.kind == 'audio' ? 'bg-emerald-50 text-emerald-600' : (item.kind == 'video' ? 'bg-violet-50 text-violet-600' : 'bg-slate-100 text-slate-500'))) }}">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14 3v5h5"/>
                        </svg>
                      </span>
                    {% endif %}
                    <div class="min-w-0">
                      <p class="max-w-[280px] truncate font-medium text-slate-900" title="{{ item.original_name }}">{{ item.original_name }}</p>
                      <p class="truncate text-xs text-slate-400">{{ item.mime_type }}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-2.5 align-top text-slate-600">{{ item.kind|title }}</td>
                <td class="px-4 py-2.5 align-top text-slate-600" data-sort-value="{{ item.size_bytes|default(0) }}">{{ item.size_human }}</td>
                <td class="px-4 py-2.5 align-top">
                  <form method="post" action="{{ url('admin/media') }}" class="flex flex-wrap items-center gap-2">
                    {{ csrf_field() }}
                    <input type="hidden" name="media_action" value="save_tags">
                    <input type="hidden" name="id" value="{{ item.id }}">
                    <input type="hidden" name="_state_type" value="{{ type }}">
                    <input type="hidden" name="_state_tag" value="{{ tag }}">
                    <input type="hidden" name="_state_q" value="{{ q }}">
                    <input type="hidden" name="_state_view" value="{{ view_mode }}">
                    <input type="hidden" name="_state_per_page" value="{{ per_page }}">
                    <input type="hidden" name="_state_page" value="{{ page }}">
                    <input type="text" name="tags" value="{{ item.tags_csv }}" aria-label="Tags" class="w-44 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="tag1, tag2">
                    {% if item.kind == 'image' %}
                      <input type="text" name="alt" value="{{ item.alt }}" aria-label="Alt text" class="w-56 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="Alt text: what the image shows">
                    {% endif %}
                    <button type="submit" class="{{ icon_btn }}" title="Save" aria-label="Save tags and alt text">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                    </button>
                  </form>
                </td>
                <td class="px-4 py-2.5 align-top text-slate-400">{{ item.created_at_display }}</td>
                <td class="px-4 py-2.5 text-right align-top">
                  <div class="flex items-center justify-end gap-0.5">
                    <a href="{{ item.direct_url }}" target="_blank" rel="noopener" class="{{ icon_btn }}" title="Open file" aria-label="Open file">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/>
                      </svg>
                    </a>
                    <button type="button" class="{{ icon_btn }}" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 8h10v10H8zM6 16H5a1 1 0 01-1-1V5a1 1 0 011-1h10a1 1 0 011 1v1"/>
                      </svg>
                    </button>
                    <form method="post" action="{{ url('admin/media') }}" data-confirm="Delete this media item?" data-confirm-button="Delete" class="inline">
                      {{ csrf_field() }}
                      <input type="hidden" name="media_action" value="delete">
                      <input type="hidden" name="id" value="{{ item.id }}">
                      <input type="hidden" name="_state_type" value="{{ type }}">
                      <input type="hidden" name="_state_tag" value="{{ tag }}">
                      <input type="hidden" name="_state_q" value="{{ q }}">
                      <input type="hidden" name="_state_view" value="{{ view_mode }}">
                      <input type="hidden" name="_state_per_page" value="{{ per_page }}">
                      <input type="hidden" name="_state_page" value="{{ page }}">
                      <button type="submit" class="{{ danger_icon_btn }}" title="Delete" aria-label="Delete">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/>
                        </svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="p-4">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {% for item in items %}
            <article class="group overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:border-slate-300 hover:shadow-sm">
              <div class="relative flex aspect-[4/3] items-center justify-center bg-slate-50 text-slate-500">
                <label class="absolute left-2 top-2 z-10 inline-flex items-center gap-1 rounded bg-white/90 px-1.5 py-0.5 text-xs font-medium text-slate-600 shadow-sm">
                  <input type="checkbox" class="media-select-item h-3.5 w-3.5 rounded border-slate-300 text-slate-900 focus:ring-slate-400" value="{{ item.id }}" data-kind="{{ item.kind }}">
                  Select
                </label>
                {% if item.kind == 'image' and item.thumbnail_url %}
                  <img src="{{ item.thumbnail_url }}" alt="{{ item.original_name }}" class="h-full w-full object-cover">
                {% else %}
                  <svg class="h-9 w-9 opacity-80" fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 011-1z"/>
                  </svg>
                {% endif %}
                <span class="absolute bottom-2 left-2 rounded bg-white/85 px-1.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-slate-500 backdrop-blur">{{ item.kind|title }}</span>
                <div class="absolute right-1.5 top-1.5 flex gap-0.5 opacity-0 transition group-hover:opacity-100">
                  <a href="{{ item.direct_url }}" target="_blank" rel="noopener" class="rounded-md bg-white/90 p-1.5 text-slate-500 shadow-sm hover:text-slate-800" title="Open file" aria-label="Open file">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M20 4l-9 9M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/>
                    </svg>
                  </a>
                  <button type="button" class="rounded-md bg-white/90 p-1.5 text-slate-500 shadow-sm hover:text-slate-800" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 8h10v10H8zM6 16H5a1 1 0 01-1-1V5a1 1 0 011-1h10a1 1 0 011 1v1"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="p-2.5">
                <p class="truncate text-sm font-medium text-slate-900" title="{{ item.original_name }}">{{ item.original_name }}</p>
                <div class="mt-0.5 flex items-center justify-between gap-2 text-xs text-slate-400">
                  <span>{{ item.size_human }}</span>
                  <span>{{ item.created_at_display }}</span>
                </div>
                <form method="post" action="{{ url('admin/media') }}" class="mt-2 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-1.5">
                  {{ csrf_field() }}
                  <input type="hidden" name="media_action" value="save_tags">
                  <input type="hidden" name="id" value="{{ item.id }}">
                  <input type="hidden" name="_state_type" value="{{ type }}">
                  <input type="hidden" name="_state_tag" value="{{ tag }}">
                  <input type="hidden" name="_state_q" value="{{ q }}">
                  <input type="hidden" name="_state_view" value="{{ view_mode }}">
                  <input type="hidden" name="_state_per_page" value="{{ per_page }}">
                  <input type="hidden" name="_state_page" value="{{ page }}">
                  {% if item.kind == 'image' %}
                    <input type="text" name="alt" value="{{ item.alt }}" aria-label="Alt text" class="col-span-2 min-w-0 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="Alt text: what the image shows">
                  {% endif %}
                  <input type="text" name="tags" value="{{ item.tags_csv }}" aria-label="Tags" class="min-w-0 rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" placeholder="tag1, tag2">
                  <button type="submit" class="{{ icon_btn }}" title="Save" aria-label="Save tags and alt text">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                  </button>
                </form>
                <form method="post" action="{{ url('admin/media') }}" data-confirm="Delete this media item?" data-confirm-button="Delete" class="mt-2 text-right">
                  {{ csrf_field() }}
                  <input type="hidden" name="media_action" value="delete">
                  <input type="hidden" name="id" value="{{ item.id }}">
                  <input type="hidden" name="_state_type" value="{{ type }}">
                  <input type="hidden" name="_state_tag" value="{{ tag }}">
                  <input type="hidden" name="_state_q" value="{{ q }}">
                  <input type="hidden" name="_state_view" value="{{ view_mode }}">
                  <input type="hidden" name="_state_per_page" value="{{ per_page }}">
                  <input type="hidden" name="_state_page" value="{{ page }}">
                  <button type="submit" class="{{ danger_icon_btn }}" title="Delete" aria-label="Delete">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m2 0v14a1 1 0 01-1 1H7a1 1 0 01-1-1V6"/>
                    </svg>
                  </button>
                </form>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="flex flex-col gap-3 border-t border-slate-200 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <p class="text-xs text-slate-500">Showing <span class="font-medium text-slate-700">{{ summary_from }}-{{ summary_to }}</span> of <span class="font-medium text-slate-700">{{ total_items }}</span></p>
        <form method="get" action="{{ url('admin/media') }}" class="flex items-center gap-1.5">
          <input type="hidden" name="type" value="{{ type }}">
          <input type="hidden" name="tag" value="{{ tag }}">
          <input type="hidden" name="q" value="{{ q }}">
          <input type="hidden" name="view" value="{{ view_mode }}">
          <label for="media-per-page" class="text-xs text-slate-500">Per page</label>
          <select id="media-per-page" name="per_page" class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-600 focus:border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900/5" onchange="this.form.submit()">
            {% for option in per_page_options %}
              <option value="{{ option }}" {% if option == per_page %}selected{% endif %}>{{ option }}</option>
            {% endfor %}
          </select>
        </form>
      </div>
      <div class="flex items-center gap-1">
        {% set prev_page = page > 1 ? page - 1 : 1 %}
        {% set next_page = page < total_pages ? page + 1 : total_pages %}
        <a class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium no-underline {{ page <= 1 ? 'pointer-events-none text-slate-400' : 'text-slate-600 hover:bg-slate-50' }}" href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&view=' ~ view_mode ~ '&per_page=' ~ per_page ~ '&page=' ~ prev_page) }}">Prev</a>
        <span class="rounded-md border border-slate-200 bg-slate-900 px-2.5 py-1 text-xs font-medium text-white">{{ page }}</span>
        <a class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium no-underline {{ page >= total_pages ? 'pointer-events-none text-slate-400' : 'text-slate-600 hover:bg-slate-50' }}" href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&view=' ~ view_mode ~ '&per_page=' ~ per_page ~ '&page=' ~ next_page) }}">Next</a>
      </div>
    </div>
  </div>

  <div id="media-copy-toast" class="pointer-events-none fixed right-6 top-16 z-[999] hidden rounded-md border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 shadow">
    URL copied
  </div>

  <script>
    (function () {
      const uploadInput = document.getElementById('media-upload-input');
      document.querySelectorAll('[data-upload-focus]').forEach((button) => {
        button.addEventListener('click', () => {
          if (uploadInput) {
            uploadInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            uploadInput.focus();
          }
        });
      });

      const copyToast = document.getElementById('media-copy-toast');
      document.querySelectorAll('[data-copy-url]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy-url') || '';
          if (!value) return;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(value);
            } else {
              const tmp = document.createElement('input');
              tmp.value = value;
              document.body.appendChild(tmp);
              tmp.select();
              document.execCommand('copy');
              tmp.remove();
            }
            if (copyToast) {
              copyToast.classList.remove('hidden');
              setTimeout(() => copyToast.classList.add('hidden'), 1100);
            }
          } catch (_) {}
        });
      });

      const selectedCountNode = document.getElementById('media-selected-count');
      const bulkPanel = document.getElementById('media-bulk-panel');
      const selectAll = document.getElementById('media-select-all');
      const applyAll = document.getElementById('media-apply-all-filtered');
      const checkboxes = Array.from(document.querySelectorAll('.media-select-item'));
      const selectedContainers = Array.from(document.querySelectorAll('[data-selected-ids]'));
      const applyAllInputs = Array.from(document.querySelectorAll('[data-apply-all-input]'));
      const bulkForms = [document.getElementById('media-bulk-tags-form'), document.getElementById('media-bulk-delete-form')].filter(Boolean);

      const getSelectedIds = () => checkboxes.filter((box) => box.checked).map((box) => box.value).filter(Boolean);

      const syncSelection = () => {
        const ids = getSelectedIds();
        if (selectedCountNode) {
          selectedCountNode.textContent = String(ids.length);
        }
        if (bulkPanel) {
          bulkPanel.classList.toggle('hidden', ids.length === 0);
        }
        if (ids.length === 0 && applyAll) {
          applyAll.checked = false;
          applyAllInputs.forEach((input) => {
            input.value = '0';
          });
        }
        if (selectAll) {
          const allChecked = checkboxes.length > 0 && ids.length === checkboxes.length;
          selectAll.checked = allChecked;
          selectAll.indeterminate = ids.length > 0 && !allChecked;
        }
      };

      if (selectAll) {
        selectAll.addEventListener('change', () => {
          checkboxes.forEach((box) => {
            box.checked = selectAll.checked;
          });
          syncSelection();
        });
      }

      checkboxes.forEach((box) => {
        box.addEventListener('change', syncSelection);
      });
      syncSelection();

      if (applyAll) {
        applyAll.addEventListener('change', () => {
          applyAllInputs.forEach((input) => {
            input.value = applyAll.checked ? '1' : '0';
          });
        });
      }

      bulkForms.forEach((form) => {
        form.addEventListener('submit', (event) => {
          const ids = getSelectedIds();
          const applyAllChecked = applyAll ? applyAll.checked : false;
          if (!applyAllChecked && ids.length === 0) {
            event.preventDefault();
            event.stopImmediatePropagation();
            window.adminToast('Select at least one media item.', 'warning');
            return;
          }
          selectedContainers.forEach((container) => {
            if (!container || !container.closest('form') || container.closest('form') !== form) {
              return;
            }
            container.innerHTML = '';
            ids.forEach((id) => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'selected_ids[]';
              input.value = id;
              container.appendChild(input);
            });
          });
        });
      });
    })();
  </script>
{% endblock %}
