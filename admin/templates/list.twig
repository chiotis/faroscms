{% extends '@admin/base.twig' %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  {% set singular = current_type ends with 's' ? current_type|slice(0, -1) : current_type %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}
  {% set icon_danger = 'rounded-md p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600' %}

  {% if deleted and deleted_to %}
    {{ ui.flash('Deleted. Visitors who ask for ' ~ deleted_from ~ ' are sent to ' ~ deleted_to ~ '.', 'success') }}
  {% else %}
    {{ ui.flash(deleted ? 'Deleted.' : '', 'success') }}
  {% endif %}
  {% if deleted and deleted_gone %}
    <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="status">
      Visitors who still ask for <code>{{ deleted_gone }}</code> will see a "not found" page.
      {% if can_redirects %}<a class="font-semibold underline" href="{{ url('admin/redirects?source=' ~ deleted_gone|url_encode) }}#add">Send them somewhere</a>{% endif %}
    </div>
  {% endif %}
  {{ ui.flash(bulk_message, bulk_status == 'ok' ? 'success' : 'error') }}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <h1 class="truncate text-[15px] font-semibold leading-tight text-slate-900">{{ current_type|title }}</h1>
      <p class="truncate text-xs text-slate-400">Manage {{ current_type|title }} content.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {{ ui.filter_button('contentFilter', filters_active) }}
      <a class="{{ btn_secondary }}" href="{{ url('admin/import?type=' ~ current_type) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        Import CSV
      </a>
      <a class="{{ btn_secondary }}" href="{{ url('admin/export?type=' ~ current_type) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 12 4-4m-4 4-4-4M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/></svg>
        Export CSV
      </a>
      <a class="{{ btn_primary }}" href="{{ url('admin/new?type=' ~ current_type ~ '&lang=' ~ lang) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
        New {{ singular|title }}
      </a>
    </div>
  </header>

  <div id="contentFilter" class="mb-4 rounded-lg border border-slate-200 bg-white p-4 {{ filters_active ? '' : 'hidden' }}">
    <form method="get" action="{{ url('admin/content') }}" class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <input type="hidden" name="type" value="{{ current_type }}">
      <input type="hidden" name="lang" value="{{ lang }}">
      <label class="block sm:col-span-2">
        <span class="mb-1 block text-sm font-medium text-slate-700">Search</span>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Title or slug" class="{{ input_class }}">
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-slate-700">Status</span>
        <select name="status" class="{{ select_class }}">
          <option value="">All</option>
          {% for option in status_options %}
            <option value="{{ option }}" {% if filters.status == option %}selected{% endif %}>{{ option|title }}</option>
          {% endfor %}
        </select>
      </label>
      <div class="flex justify-end gap-2 sm:col-span-3">
        <a href="{{ url('admin/content?type=' ~ current_type ~ '&lang=' ~ lang) }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a>
        <button type="submit" class="{{ btn_primary }}">Apply</button>
      </div>
    </form>
  </div>

  <form method="post" action="{{ url('admin/content-bulk') }}" class="rounded-lg border border-slate-200 bg-white" data-bulk-form>
    {{ csrf_field() }}
    <input type="hidden" name="type" value="{{ current_type }}">
    <input type="hidden" name="lang" value="{{ lang }}">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="font-medium text-slate-700">{{ items|length }} {{ filters_active ? 'matching' : '' }} entr{{ items|length == 1 ? 'y' : 'ies' }}</span>
        <span class="mx-1 h-4 w-px bg-slate-200"></span>
        <nav class="flex items-center gap-1" aria-label="Language">
          {% for l in languages %}
            <a href="{{ url('admin/content?' ~ {'type': current_type, 'lang': l}|merge(filters|filter(v => v != ''))|url_encode) }}" class="rounded-md px-2.5 py-1 text-xs font-medium {{ l == lang ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' }}" {% if l == lang %}aria-current="true"{% endif %}>{{ l|upper }}</a>
          {% endfor %}
        </nav>
      </div>
      {% if items is not empty %}
        <div class="flex items-center gap-2">
          <select name="bulk_action" class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700" aria-label="Bulk action">
            <option value="">Bulk action…</option>
            <option value="publish">Publish</option>
            <option value="draft">Move to draft</option>
            <option value="delete">Delete</option>
          </select>
          <button type="submit" class="{{ btn_secondary }}" data-confirm="Apply this action to the selected {{ current_type }}? Deleted items cannot be recovered except from a backup." data-confirm-button="Apply">Apply</button>
        </div>
      {% endif %}
    </div>

    {% if items is empty %}
      {% if filters_active %}
        {{ ui.empty_state('Nothing matches these filters', 'Reset the filters to see every ' ~ singular ~ ' in ' ~ lang|upper ~ '.') }}
      {% else %}
        <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-7 5h8a2 2 0 0 0 2-2V7l-5-5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2z"/></svg>
          </div>
          <h3 class="mt-3 text-sm font-semibold text-slate-900">No content yet</h3>
          <p class="mt-1 max-w-sm text-sm text-slate-400">Create the first {{ singular }} for this language.</p>
          <div class="mt-4">
            <a class="{{ btn_primary }}" href="{{ url('admin/new?type=' ~ current_type ~ '&lang=' ~ lang) }}">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
              New {{ singular|title }}
            </a>
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="w-8 px-4 py-2"><input type="checkbox" data-select-all="selected[]" class="h-4 w-4 rounded border-slate-300" aria-label="Select all"></th>
              <th class="px-4 py-2 font-medium" data-sort="text">Title</th>
              <th class="px-4 py-2 font-medium" data-sort="text">Status</th>
              <th class="px-4 py-2 font-medium">Language</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Updated</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for item in items %}
              {% set status = item.meta.status ?? 'published' %}
              {% set key = item.slug ~ '|' ~ item.lang %}
              {% set is_home = current_type == 'pages' and item.slug == site.home_page and item.lang == site.languages.default %}
              <tr class="group hover:bg-slate-50">
                <td class="px-4 py-2.5"><input type="checkbox" name="selected[]" value="{{ item.slug }}" class="h-4 w-4 rounded border-slate-300" aria-label="Select {{ item.meta.title ?: item.slug }}"></td>
                <td class="px-4 py-2.5" data-sort-value="{{ item.meta.title ?: item.slug }}">
                  <a href="{{ url('admin/edit?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" class="font-medium text-slate-900 no-underline hover:text-blue-600">
                    {{ item.meta.title ?: item.slug }}
                  </a>
                  <div class="mt-0.5 flex items-center gap-2 text-xs text-slate-400">
                    <span>/{{ item.slug }}</span>
                    {% if current_type != 'pages' and item.meta.main_image %}
                      <span class="meta-icon relative inline-flex h-5 w-5 cursor-pointer items-center justify-center rounded border border-slate-200 bg-white text-slate-400" title="Has main image">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4zM8 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM4 16l5-5 4 4 3-3 4 4"/></svg>
                        <span class="meta-tooltip pointer-events-none fixed z-50 hidden rounded-md border border-slate-300 bg-white p-1.5 shadow">
                          <img src="{{ item.meta.main_image }}" alt="Main image preview" class="h-20 w-32 rounded-md object-cover">
                        </span>
                      </span>
                    {% endif %}
                  </div>
                </td>
                <td class="px-4 py-2.5" data-sort-value="{{ status }}">
                  {{ ui.status_badge(status) }}
                  {% if current_type == 'pages' and item.slug == site.home_page %}
                    {{ ui.badge('Home', 'blue') }}
                  {% endif %}
                  {% if item.meta.seo is defined and item.meta.seo.noindex %}
                    {{ ui.badge('Noindex', 'pink') }}
                  {% endif %}
                </td>
                <td class="px-4 py-2.5">
                  <div class="flex flex-wrap items-center gap-1">
                    <span class="inline-flex h-5 min-w-7 items-center justify-center rounded bg-emerald-50 px-1 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">{{ item.lang|upper }}</span>
                    {% for l in translation_langs[key]|default([]) %}
                      <span class="inline-flex h-5 min-w-7 items-center justify-center rounded border border-dashed border-slate-300 px-1 text-[10px] font-semibold text-slate-300">{{ l|upper }}</span>
                    {% endfor %}
                  </div>
                </td>
                <td class="px-4 py-2.5 text-slate-400" data-sort-value="{{ item.mtime }}">{{ item.mtime|date('Y-m-d H:i') }}</td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center justify-end gap-0.5">
                    <a class="{{ icon_button }}" href="{{ url('admin/edit?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" title="Edit {{ item.meta.title ?: item.slug }}" aria-label="Edit {{ item.meta.title ?: item.slug }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    </a>
                    {% if not is_home %}
                      {% if (item.meta.status ?? 'published') == 'published' %}
                        {# A public entry: the next page asks where its visitors should go. #}
                        <a class="{{ icon_danger }}" href="{{ url('admin/delete?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" title="Delete {{ item.meta.title ?: item.slug }}" aria-label="Delete {{ item.meta.title ?: item.slug }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6"/></svg>
                        </a>
                      {% else %}
                        <button type="submit" form="delete-{{ item.slug }}" class="{{ icon_danger }}" title="Delete {{ item.meta.title ?: item.slug }}" aria-label="Delete {{ item.meta.title ?: item.slug }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6"/></svg>
                        </button>
                      {% endif %}
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </form>

  {# Row delete forms sit outside the bulk form because HTML forms cannot nest. #}
  {% for item in items %}
    {% if not (current_type == 'pages' and item.slug == site.home_page and item.lang == site.languages.default) %}
      <form id="delete-{{ item.slug }}" method="post" action="{{ url('admin/delete') }}" data-confirm="Delete “{{ item.meta.title ?: item.slug }}” ({{ item.lang|upper }})?" data-confirm-button="Delete" hidden>
        {{ csrf_field() }}
        <input type="hidden" name="type" value="{{ current_type }}">
        <input type="hidden" name="slug" value="{{ item.slug }}">
        <input type="hidden" name="lang" value="{{ item.lang }}">
      </form>
    {% endif %}
  {% endfor %}
{% endblock %}
