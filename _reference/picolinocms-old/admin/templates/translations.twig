{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Translations</h1> <p class="mt-1 text-sm text-slate-500">Edit theme string translations for {{ lang|upper }}.</p> </div> </header> {% if saved %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Saved.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} <div class="toolbar mb-4"> <form method="get" class="filters flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm"> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">Language</span> <select name="lang" class="w-full min-w-[90px] rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> {% for l in languages %} <option value="{{ l }}" {% if l == lang %}selected{% endif %}>{{ l|upper }}</option> {% endfor %} </select> </label> <button type="submit" class="{{ btn_muted }}">Apply</button> </form> </div> <form method="post" class="translations"> <input type="hidden" name="lang" value="{{ lang }}"> <div class="table overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm w-full"> <table class="list-table translations-table min-w-full table-auto border-collapse text-sm"> <thead> <tr> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Key</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Value</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Default ({{ default_lang|upper }})</th> </tr> </thead> <tbody> {% for key, value in translations %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="keys[]" value="{{ key }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="values[]" value="{{ value }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="muted border-b border-slate-200 px-4 py-3 text-sm text-slate-500">{{ defaults[key] ?? '' }}</td> </tr> {% endfor %} <tr> <td class="px-4 py-3"><input type="text" name="keys[]" placeholder="new.key" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="px-4 py-3"><input type="text" name="values[]" placeholder="New value" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="muted px-4 py-3 text-sm text-slate-500"></td> </tr> </tbody> </table> </div> <div class="actions mt-4 flex flex-wrap items-center gap-2 mt-1"> <button type="submit" class="{{ btn }}">Save</button> </div> </form>
{% endblock %}
