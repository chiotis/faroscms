{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %} {% set btn_danger = 'pill-button danger inline-flex items-center justify-center rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-500' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Taxonomies</h1> <p class="mt-1 text-sm text-slate-500">Manage taxonomy terms for all content types.</p> </div> </header> {% if saved %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Saved.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if error %} <div class="alert mb-4 rounded-md border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{{ error }}</div> {% endif %} <div class="toolbar mb-4"> <form method="get" class="filters flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm"> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">Taxonomy</span> <select name="taxonomy" class="w-full min-w-[140px] rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> {% for name in taxonomy_names %} <option value="{{ name }}" {% if name == taxonomy %}selected{% endif %}>{{ name|title }}</option> {% endfor %} </select> </label> <button type="submit" class="{{ btn_muted }}">Apply</button> </form> </div> <form method="post" class="editor"> <input type="hidden" name="taxonomy" value="{{ taxonomy }}"> <div class="editor-top mb-4 flex items-center justify-between gap-3"> <div></div> <div class="editor-actions flex items-center gap-2"> <button type="submit" class="{{ btn }}">Save</button> </div> </div> <div class="form-section mb-4 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm w-full"> <h3 class="text-xl font-semibold text-slate-900">Basics</h3> <label class="grid gap-1 text-sm font-medium text-slate-700"> Taxonomy title <input type="text" name="taxonomy_title" value="{{ taxonomy_title }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> </div> <div class="form-section grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm mb-4 w-full"> <h3 class="text-xl font-semibold text-slate-900">Terms</h3> <p class="hint text-sm text-slate-500">Use a stable <code>id</code>, a URL-safe <code>slug</code>, and translated labels for each language.</p> <div class="overflow-x-auto rounded-lg border border-slate-200"> <table class="list-table min-w-full table-auto border-collapse text-sm"> <thead> <tr> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">ID</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Slug</th> {% for langCode in languages %} <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Label ({{ langCode|upper }})</th> {% endfor %} <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-right font-semibold text-slate-700"></th> </tr> </thead> <tbody data-taxonomy-rows> {% for term in taxonomy_terms %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_id[]" value="{{ term.id }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_slug[]" value="{{ term.slug }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% for langCode in languages %} <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_label[{{ langCode }}][]" value="{{ term.labels[langCode]|default('') }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% endfor %} <td class="table-actions border-b border-slate-200 px-4 py-3 text-right align-top whitespace-nowrap"> <button type="button" class="{{ btn_danger }} js-remove-taxonomy-row">Remove</button> </td> </tr> {% endfor %} {% if taxonomy_terms is empty %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_id[]" placeholder="news" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_slug[]" placeholder="news" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% for langCode in languages %} <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_label[{{ langCode }}][]" placeholder="Label" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% endfor %} <td class="table-actions border-b border-slate-200 px-4 py-3 text-right align-top whitespace-nowrap"> <button type="button" class="{{ btn_danger }} js-remove-taxonomy-row">Remove</button> </td> </tr> {% endif %} </tbody> </table> </div> <div class="actions mt-2 flex flex-wrap items-center gap-2 mt-1"> <button type="button" class="{{ btn }} js-add-taxonomy-row">+ Add term</button> </div> </div> </form> <script> (function () { const body = document.querySelector('[data-taxonomy-rows]'); const add = document.querySelector('.js-add-taxonomy-row'); if (!body || !add) return; const bindRemove = (button) => { button.addEventListener('click', () => { const row = button.closest('tr'); if (row) row.remove(); }); }; body.querySelectorAll('.js-remove-taxonomy-row').forEach(bindRemove); add.addEventListener('click', () => { const row = document.createElement('tr'); row.innerHTML = ` <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_id[]" placeholder="id" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_slug[]" placeholder="slug" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% for langCode in languages %} <td class="border-b border-slate-200 px-4 py-3 align-top"><input type="text" name="term_label[{{ langCode }}][]" placeholder="Label" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"></td> {% endfor %} <td class="table-actions border-b border-slate-200 px-4 py-3 text-right align-top whitespace-nowrap"> <button type="button" class="{{ btn_danger }} js-remove-taxonomy-row">Remove</button> </td> `; body.appendChild(row); bindRemove(row.querySelector('.js-remove-taxonomy-row')); }); })(); </script>
{% endblock %}
