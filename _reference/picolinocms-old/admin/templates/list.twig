{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %} {% set btn_danger = 'pill-button danger inline-flex items-center justify-center rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-500' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">{{ current_type|title }}</h1> <p class="mt-1 text-sm text-slate-500">Manage {{ current_type|title }} content.</p> </div> <div class="actions mt-1 flex flex-wrap items-center gap-2"> {% if current_type != 'forms' %} <a class="{{ btn_muted }}" href="{{ url('admin/import?type=' ~ current_type) }}">Import CSV</a> <a class="{{ btn_muted }}" href="{{ url('admin/export?type=' ~ current_type) }}">Export CSV</a> {% endif %} {% set singular = current_type ends with 's' ? current_type|slice(0, -1) : current_type %} <a class="{{ btn }}" href="{{ url('admin/new?type=' ~ current_type ~ '&lang=' ~ lang) }}">+ New {{ singular|title }}</a> </div> </header> {% if deleted %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Deleted.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} <div class="toolbar mb-4"> <form method="get" class="filters flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-3 shadow-sm"> <input type="hidden" name="type" value="{{ current_type }}"> <label class="grid gap-1 text-sm font-medium text-slate-700"> <span class="label-row inline-flex items-center gap-2">Language</span> <select name="lang" class="w-full min-w-[90px] rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> {% for l in languages %} <option value="{{ l }}" {% if l == lang %}selected{% endif %}>{{ l }}</option> {% endfor %} </select> </label> <button type="submit" class="{{ btn_muted }}">Apply</button> </form> </div> <div class="table overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm w-full"> {% if items is empty %} <div class="row empty p-5 text-sm text-slate-500">No content yet.</div> {% else %} <table class="list-table min-w-full table-auto border-collapse text-sm"> <thead> <tr> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Title</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Status</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Lang</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Updated</th> <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-right font-semibold text-slate-700"></th> </tr> </thead> <tbody> {% for item in items %} <tr> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900"> {{ item.meta.title }} {% if current_type != 'pages' and item.meta.main_image %} <span class="meta-icon relative ml-2 inline-flex h-[18px] w-[18px] cursor-pointer items-center justify-center rounded-full border border-slate-300 text-slate-500" title="Has main image"> <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3 w-3 fill-current"> <path d="M4 6a2 2 0 0 1 2-2h3l1.2 1.6a2 2 0 0 0 1.6.8H18a2 2 0 0 1 2 2v9.6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6zm2 3a1 1 0 0 0-1 1v7.6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10a1 1 0 0 0-1-1H6zm2 2.2a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm1.5 5.4 2.7-3.2a1 1 0 0 1 1.6 0l2.7 3.2H9.5z"/> </svg> <span class="meta-tooltip pointer-events-none fixed z-50 hidden rounded-md border border-slate-300 bg-white p-1.5 shadow"> <img src="{{ item.meta.main_image }}" alt="Main image preview" class="h-20 w-32 rounded-md object-cover"> </span> </span> {% endif %} </td> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900"> {{ item.meta.status ?? 'published' }} {% if current_type == 'pages' and item.slug == site.home_page %} <span class="pill ml-2 inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">Home</span> {% endif %} {% if item.meta.seo is defined and item.meta.seo.noindex %} <span class="pill pill-warning ml-2 inline-flex items-center rounded-full bg-pink-100 px-2.5 py-1 text-xs font-semibold text-pink-700 bg-blue-100 text-blue-700">Non-Indexed</span> {% endif %} </td> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900"> {{ item.lang }} {% set key = item.slug ~ '|' ~ item.lang %} {% for l in translation_langs[key]|default([]) %} <span class="lang-muted ml-2 opacity-30">{{ l }}</span> {% endfor %} </td> <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-900">{{ item.mtime|date('Y-m-d H:i') }}</td> <td class="table-actions border-b border-slate-200 px-4 py-3 text-right align-top whitespace-nowrap"> <div class="inline-flex items-center gap-2 whitespace-nowrap"> <a class="{{ btn }}" href="{{ url('admin/edit?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}">Edit</a> {% set is_home = current_type == 'pages' and item.slug == site.home_page and item.lang == site.languages.default %} {% if not is_home %} <form method="post" action="{{ url('admin/delete') }}" class="inline" onsubmit="return confirm('Delete this item?');"> <input type="hidden" name="type" value="{{ current_type }}"> <input type="hidden" name="slug" value="{{ item.slug }}"> <input type="hidden" name="lang" value="{{ item.lang }}"> <button type="submit" class="{{ btn_danger }}">Delete</button> </form> {% endif %} </div> </td> </tr> {% endfor %} </tbody> </table> {% endif %} </div>
{% endblock %}
