{% extends '@admin/base.twig' %} {% block content %} {% set btn = 'pill-button inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %} {% set btn_muted = 'pill-button pill-button-muted inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %} {% set btn_danger = 'pill-button danger inline-flex items-center justify-center rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-500' %} <header class="admin-header mb-5 flex flex-wrap items-start justify-between gap-4"> <div> <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Edit Menu</h1> <p class="mt-1 text-sm text-slate-500">{{ menu_key }}</p> </div> <div class="actions mt-1 flex flex-wrap items-center gap-2"> <a class="{{ btn_muted }}" href="{{ url('admin/menus') }}">Back to Menus</a> <a class="{{ btn }}" href="{{ url('admin/menus-new') }}">+ New Menu</a> </div> </header> {% if saved %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu saved.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if created %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu created.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if deleted %} <div class="toast toast-success fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow"> <span>Menu deleted.</span> <button type="button" class="toast-close border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button> </div> {% endif %} {% if error %} <div class="alert mb-4 rounded-md border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-800">{{ error }}</div> {% endif %} <form method="post" class="editor"> <input type="hidden" name="key" value="{{ menu_key }}"> <div class="editor-top mb-4 flex items-center justify-between gap-3"> <div></div> <div class="editor-actions flex items-center gap-2"> <button type="submit" name="menu_action" value="save" class="{{ btn }}">Save</button> <button type="submit" name="menu_action" value="delete" class="{{ btn_danger }}" onclick="return confirm('Delete this menu?');">Delete</button> </div> </div> <div class="form-section mb-4 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm w-full"> <h3 class="text-xl font-semibold text-slate-900">Edit Menu</h3> <div class="section-grid grid grid-cols-1 gap-4 md:grid-cols-2"> <label class="grid gap-1 text-sm font-medium text-slate-700"> Menu key <input type="text" value="{{ menu_key }}" readonly class="w-full rounded-md border border-slate-300 bg-slate-100 px-3 py-2 text-sm text-slate-900 outline-none"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Menu title <input type="text" name="menu_title" value="{{ menu_title }}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> </div> </div> <div class="form-section grid gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm mb-4 w-full"> <h3 class="text-xl font-semibold text-slate-900">Items</h3> <p class="hint text-sm text-slate-500">Set label key plus translated labels directly here. Level controls nesting (max 3 levels). Keep children directly below their parent.</p> <div data-menu-items class="grid gap-3"> {% for item in menu_items %} <div class="menu-item-row grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3"> <div class="form-field-grid grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4"> <label class="grid gap-1 text-sm font-medium text-slate-700"> Level <select name="menu_depth[]" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> <option value="1" {% if item.depth|default('1') == '1' %}selected{% endif %}>1 (Top)</option> <option value="2" {% if item.depth|default('1') == '2' %}selected{% endif %}>2 (Child)</option> <option value="3" {% if item.depth|default('1') == '3' %}selected{% endif %}>3 (Grandchild)</option> </select> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Label key <input type="text" name="menu_label_key[]" value="{{ item.label_key }}" placeholder="nav.main.home" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> {% for l in languages %} <label class="grid gap-1 text-sm font-medium text-slate-700"> Label {{ l|upper }} <input type="text" name="menu_label_lang[{{ l }}][]" value="{{ item.labels[l]|default('') }}" placeholder="{{ l|upper }} label" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> {% endfor %} <label class="grid gap-1 text-sm font-medium text-slate-700"> URL <input type="text" name="menu_url[]" value="{{ item.url }}" placeholder="about or https://example.com" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> </div> <div class="form-field-grid grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4"> <label class="grid gap-1 text-sm font-medium text-slate-700"> Class <input type="text" name="menu_class[]" value="{{ item.class }}" placeholder="nav-cta" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700"> Target <input type="text" name="menu_target[]" value="{{ item.target }}" placeholder="_blank" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="menu-remove-wrap content-end"> <span>&nbsp;</span> <button type="button" class="{{ btn_danger }} js-remove-menu-item">Remove</button> </label> </div> </div> {% endfor %} </div> <div class="actions mt-2 flex flex-wrap items-center gap-2 mt-1"> <button type="button" class="{{ btn }} js-add-menu-item">+ Add item</button> </div> </div> </form> <script> (function () { const container = document.querySelector('[data-menu-items]'); const addButton = document.querySelector('.js-add-menu-item'); if (!container || !addButton) return; const bindRemove = (button) => { button.addEventListener('click', () => { const row = button.closest('.menu-item-row'); if (row) row.remove(); }); }; container.querySelectorAll('.js-remove-menu-item').forEach(bindRemove); addButton.addEventListener('click', () => { const row = document.createElement('div'); row.className = 'menu-item-row grid gap-3 rounded-md border border-slate-200 bg-slate-50 p-3'; row.innerHTML = ` <div class="form-field-grid grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4"> <label class="grid gap-1 text-sm font-medium text-slate-700">Level <select name="menu_depth[]" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> <option value="1" selected>1 (Top)</option> <option value="2">2 (Child)</option> <option value="3">3 (Grandchild)</option> </select> </label> <label class="grid gap-1 text-sm font-medium text-slate-700">Label key <input type="text" name="menu_label_key[]" placeholder="nav.main.home" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> {% for l in languages %} <label class="grid gap-1 text-sm font-medium text-slate-700">Label {{ l|upper }} <input type="text" name="menu_label_lang[{{ l }}][]" placeholder="{{ l|upper }} label" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> {% endfor %} <label class="grid gap-1 text-sm font-medium text-slate-700">URL <input type="text" name="menu_url[]" placeholder="about or https://example.com" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> </div> <div class="form-field-grid grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4"> <label class="grid gap-1 text-sm font-medium text-slate-700">Class <input type="text" name="menu_class[]" placeholder="nav-cta" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="grid gap-1 text-sm font-medium text-slate-700">Target <input type="text" name="menu_target[]" placeholder="_blank" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-300"> </label> <label class="menu-remove-wrap content-end"> <span>&nbsp;</span> <button type="button" class="{{ btn_danger }} js-remove-menu-item">Remove</button> </label> </div> `; container.appendChild(row); bindRemove(row.querySelector('.js-remove-menu-item')); }); })(); </script>
{% endblock %}
