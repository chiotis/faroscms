{% extends '@admin/base.twig' %}

{% block content %}
  {% set btn_primary = 'inline-flex items-center justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white no-underline transition hover:bg-slate-700' %}
  {% set btn_muted = 'inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-100' %}
  {% set btn_danger = 'inline-flex items-center justify-center rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-rose-500' %}
  {% set summary_from = total_items > 0 ? ((page - 1) * per_page) + 1 : 0 %}
  {% set summary_to = total_items > 0 ? ((page - 1) * per_page) + (items|length) : 0 %}

  <header class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Media Library</h1>
      <p class="mt-1 text-sm text-slate-500">Central file and media storage for all modules.</p>
    </div>
    <button
      type="button"
      id="toggle-upload-panel"
      class="{{ btn_muted }}"
      data-upload-toggle
      aria-controls="upload-panel"
      aria-expanded="false"
    >Upload</button>
  </header>

  {% if success %}
    <div class="fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-emerald-300 bg-emerald-50 px-3.5 py-2.5 text-emerald-800 shadow">
      <span>{{ success }}</span>
      <button type="button" class="border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button>
    </div>
  {% endif %}
  {% if error %}
    <div class="fixed right-6 top-5 z-[999] flex items-center gap-3 rounded-md border border-rose-300 bg-rose-50 px-3.5 py-2.5 text-rose-800 shadow">
      <span>{{ error }}</span>
      <button type="button" class="border-0 bg-transparent text-lg leading-none text-current" onclick="this.parentElement.remove()">×</button>
    </div>
  {% endif %}

  <div id="upload-panel" class="mb-5 rounded-lg border border-slate-200 bg-white p-4 shadow-sm {% if not error %}hidden{% endif %}">
    <form method="post" action="{{ url('admin/media') }}" enctype="multipart/form-data" class="grid gap-3 md:grid-cols-3">
      <input type="hidden" name="media_action" value="upload">
      <input type="hidden" name="_state_type" value="{{ type }}">
      <input type="hidden" name="_state_tag" value="{{ tag }}">
      <input type="hidden" name="_state_q" value="{{ q }}">
      <input type="hidden" name="_state_view" value="{{ view_mode }}">
      <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">

      <label class="grid gap-1 text-sm font-medium text-slate-700 md:col-span-2">
        Files
        <input
          type="file"
          name="upload_file[]"
          multiple
          required
          class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-700"
        >
        <span class="text-xs text-slate-500">Max upload size: {{ max_upload_mb }} MB per file.</span>
      </label>

      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Tags
        <input type="text" name="upload_tags" class="{{ input_class }}" placeholder="news, hero, brochure">
      </label>

      <div class="md:col-span-3">
        <button type="submit" class="{{ btn_primary }}">Upload</button>
      </div>
    </form>
  </div>

  {% set filters_open = q is not empty or tag is not empty or type != 'all' %}

  <div class="mb-4 flex flex-wrap items-center justify-end gap-2">
    <button
      type="button"
      data-filter-toggle
      aria-controls="media-filter-panel"
      aria-expanded="{{ filters_open ? 'true' : 'false' }}"
      class="inline-flex items-center justify-center rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold transition"
    >
      Filters
    </button>
    <a
      href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&per_page=' ~ per_page ~ '&view=list') }}"
      class="inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-semibold transition {{ view_mode == 'list' ? 'border-slate-900 bg-slate-900 text-white hover:bg-slate-700' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-100' }}"
    >List</a>
    <a
      href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&per_page=' ~ per_page ~ '&view=thumbs') }}"
      class="inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-semibold transition {{ view_mode == 'thumbs' ? 'border-slate-900 bg-slate-900 text-white hover:bg-slate-700' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-100' }}"
    >Thumbnails</a>
  </div>

  <div id="media-filter-panel" class="mb-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm {% if not filters_open %}hidden{% endif %}">
    <form method="get" action="{{ url('admin/media') }}" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <input type="hidden" name="view" value="{{ view_mode }}">

      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Type
        <select name="type" class="{{ select_class }}">
          {% for mediaType in types_available %}
            <option value="{{ mediaType }}" {% if mediaType == type %}selected{% endif %}>{{ mediaType|title }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Tag
        <select name="tag" class="{{ select_class }}">
          <option value="">All tags</option>
          {% for availableTag in available_tags %}
            <option value="{{ availableTag }}" {% if availableTag == tag %}selected{% endif %}>{{ availableTag }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Search
        <input type="text" name="q" value="{{ q }}" class="{{ input_class }}" placeholder="Name, mime, tags">
      </label>

      <label class="grid gap-1 text-sm font-medium text-slate-700">
        Per page
        <select name="per_page" class="{{ select_class }}">
          {% for option in per_page_options %}
            <option value="{{ option }}" {% if option == per_page %}selected{% endif %}>{{ option }}</option>
          {% endfor %}
        </select>
      </label>

      <div class="flex items-end gap-2">
        <button type="submit" class="{{ btn_muted }}">Apply</button>
        <a class="{{ btn_muted }}" href="{{ url('admin/media') }}">Reset</a>
      </div>
    </form>
  </div>

  <section class="mb-4 hidden rounded-lg border border-slate-200 bg-white p-4 shadow-sm" id="media-bulk-panel">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <p class="text-sm font-semibold text-slate-700">Bulk actions</p>
      <p class="text-xs text-slate-500"><span id="media-selected-count">0</span> selected</p>
    </div>

    <div class="mb-3 flex items-center gap-2 text-sm text-slate-700">
      <input id="media-apply-all-filtered" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400">
      <label for="media-apply-all-filtered">Apply to all filtered results</label>
    </div>

    <div class="flex flex-wrap items-end gap-2">
      <form id="media-bulk-tags-form" method="post" action="{{ url('admin/media') }}" class="flex flex-wrap items-end gap-2">
        <input type="hidden" name="media_action" value="bulk_tags">
        <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
        <input type="hidden" name="_filter_type" value="{{ type }}">
        <input type="hidden" name="_filter_tag" value="{{ tag }}">
        <input type="hidden" name="_filter_q" value="{{ q }}">
        <input type="hidden" name="_state_type" value="{{ type }}">
        <input type="hidden" name="_state_tag" value="{{ tag }}">
        <input type="hidden" name="_state_q" value="{{ q }}">
        <input type="hidden" name="_state_view" value="{{ view_mode }}">
        <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
        <div data-selected-ids></div>
        <label class="grid gap-1 text-sm font-medium text-slate-700">
          Add tags
          <input type="text" name="tags" class="{{ input_class }}" placeholder="promo, homepage">
        </label>
        <button type="submit" class="{{ btn_muted }}">Save tags</button>
      </form>

      <form id="media-bulk-delete-form" method="post" action="{{ url('admin/media') }}" onsubmit="return confirm('Delete selected media items?');">
        <input type="hidden" name="media_action" value="bulk_delete">
        <input type="hidden" name="apply_all_filtered" value="0" data-apply-all-input>
        <input type="hidden" name="_filter_type" value="{{ type }}">
        <input type="hidden" name="_filter_tag" value="{{ tag }}">
        <input type="hidden" name="_filter_q" value="{{ q }}">
        <input type="hidden" name="_state_type" value="{{ type }}">
        <input type="hidden" name="_state_tag" value="{{ tag }}">
        <input type="hidden" name="_state_q" value="{{ q }}">
        <input type="hidden" name="_state_view" value="{{ view_mode }}">
        <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
        <div data-selected-ids></div>
        <button type="submit" class="{{ btn_danger }}">Delete selected</button>
      </form>
    </div>
  </section>

  {% if items is empty %}
    <div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
      No media items found.
    </div>
  {% elseif view_mode == 'list' %}
    <div class="w-full overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full table-auto border-collapse text-sm">
        <thead>
          <tr>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">
              <input id="media-select-all" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" aria-label="Select all">
            </th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Preview</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">File</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Type</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Size</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Tags</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-left font-semibold text-slate-700">Created</th>
            <th class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-right font-semibold text-slate-700">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for item in items %}
            <tr>
              <td class="border-b border-slate-200 px-4 py-3 align-top">
                <input type="checkbox" class="media-select-item h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" value="{{ item.id }}" data-kind="{{ item.kind }}">
              </td>
              <td class="border-b border-slate-200 px-4 py-3 align-top">
                {% if item.kind == 'image' and item.thumbnail_url %}
                  <img src="{{ item.thumbnail_url }}" alt="{{ item.original_name }}" class="h-12 w-12 rounded object-cover">
                {% else %}
                  <div class="flex h-12 w-12 items-center justify-center rounded bg-slate-100 text-slate-500" title="{{ item.kind|title }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M9 2.00318V2H19.9978C20.5513 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5501 3 20.9932V8L9 2.00318ZM5.82918 8H9V4.83086L5.82918 8ZM11 4V9C11 9.55228 10.5523 10 10 10H5V20H19V4H11Z"></path></svg>
                  </div>
                {% endif %}
              </td>
              <td class="border-b border-slate-200 px-4 py-3 align-top">
                <p class="max-w-[280px] truncate font-semibold text-slate-900" title="{{ item.original_name }}">{{ item.original_name }}</p>
                <p class="text-xs text-slate-500">{{ item.mime_type }}</p>
              </td>
              <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-700">{{ item.kind|title }}</td>
              <td class="border-b border-slate-200 px-4 py-3 align-top text-slate-700">{{ item.size_human }}</td>
              <td class="border-b border-slate-200 px-4 py-3 align-top">
                <form method="post" action="{{ url('admin/media') }}" class="flex items-center gap-2">
                  <input type="hidden" name="media_action" value="save_tags">
                  <input type="hidden" name="id" value="{{ item.id }}">
                  <input type="hidden" name="_state_type" value="{{ type }}">
                  <input type="hidden" name="_state_tag" value="{{ tag }}">
                  <input type="hidden" name="_state_q" value="{{ q }}">
                  <input type="hidden" name="_state_view" value="{{ view_mode }}">
                  <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
                  <input type="text" name="tags" value="{{ item.tags_csv }}" class="w-44 rounded border border-slate-300 px-2 py-1 text-xs" placeholder="tag1, tag2">
                  <button type="submit" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" title="Save tags" aria-label="Save tags">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7 19V13H17V19H19V7.82843L16.1716 5H5V19H7ZM4 3H17L21 7V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3ZM9 15V19H15V15H9Z"></path></svg>
                  </button>
                </form>
              </td>
              <td class="border-b border-slate-200 px-4 py-3 align-top whitespace-nowrap text-slate-700">{{ item.created_at_display }}</td>
              <td class="border-b border-slate-200 px-4 py-3 align-top text-right whitespace-nowrap">
                <div class="inline-flex items-center gap-2">
                  <a href="{{ item.direct_url }}" target="_blank" rel="noopener" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" title="Open file" aria-label="Open file">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12.0003 3C17.3924 3 21.8784 6.87976 22.8189 12C21.8784 17.1202 17.3924 21 12.0003 21C6.60812 21 2.12215 17.1202 1.18164 12C2.12215 6.87976 6.60812 3 12.0003 3ZM12.0003 19C16.2359 19 19.8603 16.052 20.7777 12C19.8603 7.94803 16.2359 5 12.0003 5C7.7646 5 4.14022 7.94803 3.22278 12C4.14022 16.052 7.7646 19 12.0003 19ZM12.0003 16.5C9.51498 16.5 7.50026 14.4853 7.50026 12C7.50026 9.51472 9.51498 7.5 12.0003 7.5C14.4855 7.5 16.5003 9.51472 16.5003 12C16.5003 14.4853 14.4855 16.5 12.0003 16.5ZM12.0003 14.5C13.381 14.5 14.5003 13.3807 14.5003 12C14.5003 10.6193 13.381 9.5 12.0003 9.5C10.6196 9.5 9.50026 10.6193 9.50026 12C9.50026 13.3807 10.6196 14.5 12.0003 14.5Z"></path></svg>
                  </a>
                  <button type="button" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M6.9998 6V3C6.9998 2.44772 7.44752 2 7.9998 2H19.9998C20.5521 2 20.9998 2.44772 20.9998 3V17C20.9998 17.5523 20.5521 18 19.9998 18H16.9998V20.9991C16.9998 21.5519 16.5499 22 15.993 22H4.00666C3.45059 22 3 21.5554 3 20.9991L3.0026 7.00087C3.0027 6.44811 3.45264 6 4.00942 6H6.9998ZM5.00242 8L5.00019 20H14.9998V8H5.00242ZM8.9998 6H16.9998V16H18.9998V4H8.9998V6ZM7 11H13V13H7V11ZM7 15H13V17H7V15Z"></path></svg>
                  </button>
                  <form method="post" action="{{ url('admin/media') }}" onsubmit="return confirm('Delete this media item?');" class="inline">
                    <input type="hidden" name="media_action" value="delete">
                    <input type="hidden" name="id" value="{{ item.id }}">
                    <input type="hidden" name="_state_type" value="{{ type }}">
                    <input type="hidden" name="_state_tag" value="{{ tag }}">
                    <input type="hidden" name="_state_q" value="{{ q }}">
                    <input type="hidden" name="_state_view" value="{{ view_mode }}">
                    <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
                    <button type="submit" class="rounded border border-rose-300 px-2 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50" title="Delete" aria-label="Delete">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M17 6H22V8H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V8H2V6H7V3C7 2.44772 7.44772 2 8 2H16C16.5523 2 17 2.44772 17 3V6ZM18 8H6V20H18V8ZM9 11H11V17H9V11ZM13 11H15V17H13V11ZM9 4V6H15V4H9Z"></path></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
      {% for item in items %}
        <article class="grid min-w-0 gap-2 overflow-hidden rounded-lg border border-slate-200 bg-white p-3 shadow-sm">
          <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600">
            <input type="checkbox" class="media-select-item h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-400" value="{{ item.id }}" data-kind="{{ item.kind }}">
            Select
          </label>
          <div class="w-full overflow-hidden rounded-md border border-slate-200 bg-slate-50">
            {% if item.kind == 'image' and item.thumbnail_url %}
              <img src="{{ item.thumbnail_url }}" alt="{{ item.original_name }}" class="block h-40 w-full object-cover">
            {% else %}
              <div class="flex h-40 items-center justify-center text-slate-500" title="{{ item.kind|title }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-9 w-9" aria-hidden="true"><path d="M9 2.00318V2H19.9978C20.5513 2 21 2.45531 21 2.9918V21.0082C21 21.556 20.5551 22 20.0066 22H3.9934C3.44476 22 3 21.5501 3 20.9932V8L9 2.00318ZM5.82918 8H9V4.83086L5.82918 8ZM11 4V9C11 9.55228 10.5523 10 10 10H5V20H19V4H11Z"></path></svg>
              </div>
            {% endif %}
          </div>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-slate-900" title="{{ item.original_name }}">{{ item.original_name }}</p>
            <p class="text-xs text-slate-500">{{ item.size_human }} - {{ item.kind|title }}</p>
          </div>
          <form method="post" action="{{ url('admin/media') }}" class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
            <input type="hidden" name="media_action" value="save_tags">
            <input type="hidden" name="id" value="{{ item.id }}">
            <input type="hidden" name="_state_type" value="{{ type }}">
            <input type="hidden" name="_state_tag" value="{{ tag }}">
            <input type="hidden" name="_state_q" value="{{ q }}">
            <input type="hidden" name="_state_view" value="{{ view_mode }}">
            <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
            <input type="text" name="tags" value="{{ item.tags_csv }}" class="min-w-0 w-full rounded border border-slate-300 px-2 py-1 text-xs" placeholder="tag1, tag2">
            <button type="submit" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" title="Save tags" aria-label="Save tags">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M7 19V13H17V19H19V7.82843L16.1716 5H5V19H7ZM4 3H17L21 7V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3ZM9 15V19H15V15H9Z"></path></svg>
            </button>
          </form>
          <div class="flex flex-wrap items-center gap-2">
            <a href="{{ item.direct_url }}" target="_blank" rel="noopener" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" title="Open file" aria-label="Open file">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12.0003 3C17.3924 3 21.8784 6.87976 22.8189 12C21.8784 17.1202 17.3924 21 12.0003 21C6.60812 21 2.12215 17.1202 1.18164 12C2.12215 6.87976 6.60812 3 12.0003 3ZM12.0003 19C16.2359 19 19.8603 16.052 20.7777 12C19.8603 7.94803 16.2359 5 12.0003 5C7.7646 5 4.14022 7.94803 3.22278 12C4.14022 16.052 7.7646 19 12.0003 19ZM12.0003 16.5C9.51498 16.5 7.50026 14.4853 7.50026 12C7.50026 9.51472 9.51498 7.5 12.0003 7.5C14.4855 7.5 16.5003 9.51472 16.5003 12C16.5003 14.4853 14.4855 16.5 12.0003 16.5ZM12.0003 14.5C13.381 14.5 14.5003 13.3807 14.5003 12C14.5003 10.6193 13.381 9.5 12.0003 9.5C10.6196 9.5 9.50026 10.6193 9.50026 12C9.50026 13.3807 10.6196 14.5 12.0003 14.5Z"></path></svg>
            </a>
            <button type="button" class="rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" data-copy-url="{{ item.direct_url }}" title="Copy URL" aria-label="Copy URL">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M6.9998 6V3C6.9998 2.44772 7.44752 2 7.9998 2H19.9998C20.5521 2 20.9998 2.44772 20.9998 3V17C20.9998 17.5523 20.5521 18 19.9998 18H16.9998V20.9991C16.9998 21.5519 16.5499 22 15.993 22H4.00666C3.45059 22 3 21.5554 3 20.9991L3.0026 7.00087C3.0027 6.44811 3.45264 6 4.00942 6H6.9998ZM5.00242 8L5.00019 20H14.9998V8H5.00242ZM8.9998 6H16.9998V16H18.9998V4H8.9998V6ZM7 11H13V13H7V11ZM7 15H13V17H7V15Z"></path></svg>
            </button>
            <form method="post" action="{{ url('admin/media') }}" onsubmit="return confirm('Delete this media item?');" class="inline">
              <input type="hidden" name="media_action" value="delete">
              <input type="hidden" name="id" value="{{ item.id }}">
              <input type="hidden" name="_state_type" value="{{ type }}">
              <input type="hidden" name="_state_tag" value="{{ tag }}">
              <input type="hidden" name="_state_q" value="{{ q }}">
              <input type="hidden" name="_state_view" value="{{ view_mode }}">
              <input type="hidden" name="_state_per_page" value="{{ per_page }}">
      <input type="hidden" name="_state_page" value="{{ page }}">
              <button type="submit" class="rounded border border-rose-300 px-2 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50" title="Delete" aria-label="Delete">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M17 6H22V8H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V8H2V6H7V3C7 2.44772 7.44772 2 8 2H16C16.5523 2 17 2.44772 17 3V6ZM18 8H6V20H18V8ZM9 11H11V17H9V11ZM13 11H15V17H13V11ZM9 4V6H15V4H9Z"></path></svg>
              </button>
            </form>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  <nav class="mt-4 flex flex-col gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm sm:flex-row sm:items-center sm:justify-between" aria-label="Media pagination">
    <p class="text-sm text-slate-600">
      Showing {{ summary_from }}-{{ summary_to }} of {{ total_items }}
    </p>
    <div class="flex items-center gap-2">
      {% set prev_page = page > 1 ? page - 1 : 1 %}
      {% set next_page = page < total_pages ? page + 1 : total_pages %}
      <a class="{{ btn_muted }} {% if page <= 1 %}pointer-events-none opacity-50{% endif %}" href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&view=' ~ view_mode ~ '&per_page=' ~ per_page ~ '&page=' ~ prev_page) }}">Previous</a>
      <span class="text-sm text-slate-600">Page {{ page }} / {{ total_pages }}</span>
      <a class="{{ btn_muted }} {% if page >= total_pages %}pointer-events-none opacity-50{% endif %}" href="{{ url('admin/media?type=' ~ type ~ '&tag=' ~ tag|url_encode ~ '&q=' ~ q|url_encode ~ '&view=' ~ view_mode ~ '&per_page=' ~ per_page ~ '&page=' ~ next_page) }}">Next</a>
    </div>
  </nav>

  <div id="media-copy-toast" class="pointer-events-none fixed right-6 top-16 z-[999] hidden rounded-md border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 shadow">
    URL copied
  </div>

  <script>
    (function () {
      const uploadToggle = document.querySelector('[data-upload-toggle]');
      const uploadPanel = document.getElementById('upload-panel');
      if (uploadToggle && uploadPanel) {
        uploadToggle.addEventListener('click', () => {
          const hidden = uploadPanel.classList.toggle('hidden');
          uploadToggle.setAttribute('aria-expanded', hidden ? 'false' : 'true');
        });
      }

      const filterToggle = document.querySelector('[data-filter-toggle]');
      const filterPanel = document.getElementById('media-filter-panel');
      const syncFilterToggle = () => {
        if (!filterToggle || !filterPanel) {
          return;
        }
        const isOpen = !filterPanel.classList.contains('hidden');
        filterToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        filterToggle.classList.toggle('border-slate-900', isOpen);
        filterToggle.classList.toggle('bg-slate-900', isOpen);
        filterToggle.classList.toggle('text-white', isOpen);
        filterToggle.classList.toggle('hover:bg-slate-700', isOpen);
        filterToggle.classList.toggle('border-slate-300', !isOpen);
        filterToggle.classList.toggle('bg-white', !isOpen);
        filterToggle.classList.toggle('text-slate-700', !isOpen);
        filterToggle.classList.toggle('hover:bg-slate-100', !isOpen);
      };
      if (filterToggle && filterPanel) {
        filterToggle.addEventListener('click', () => {
          filterPanel.classList.toggle('hidden');
          syncFilterToggle();
        });
        syncFilterToggle();
      }

      const copyToast = document.getElementById('media-copy-toast');
      document.querySelectorAll('[data-copy-url]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy-url') || '';
          if (!value) return;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(value);
            } else {
              const tmp = document.createElement('input');
              tmp.value = value;
              document.body.appendChild(tmp);
              tmp.select();
              document.execCommand('copy');
              tmp.remove();
            }
            if (copyToast) {
              copyToast.classList.remove('hidden');
              setTimeout(() => copyToast.classList.add('hidden'), 1100);
            }
          } catch (_) {}
        });
      });

      const selectedCountNode = document.getElementById('media-selected-count');
      const bulkPanel = document.getElementById('media-bulk-panel');
      const selectAll = document.getElementById('media-select-all');
      const applyAll = document.getElementById('media-apply-all-filtered');
      const checkboxes = Array.from(document.querySelectorAll('.media-select-item'));
      const selectedContainers = Array.from(document.querySelectorAll('[data-selected-ids]'));
      const applyAllInputs = Array.from(document.querySelectorAll('[data-apply-all-input]'));
      const bulkForms = [document.getElementById('media-bulk-tags-form'), document.getElementById('media-bulk-delete-form')].filter(Boolean);

      const getSelectedIds = () => checkboxes.filter((box) => box.checked).map((box) => box.value).filter(Boolean);

      const syncSelection = () => {
        const ids = getSelectedIds();
        if (selectedCountNode) {
          selectedCountNode.textContent = String(ids.length);
        }
        const hasImageSelection = checkboxes.some((box) => box.checked && (box.dataset.kind || '') === 'image');
        if (bulkPanel) {
          bulkPanel.classList.toggle('hidden', !hasImageSelection);
        }
        if (ids.length === 0 && applyAll) {
          applyAll.checked = false;
          applyAllInputs.forEach((input) => {
            input.value = '0';
          });
        }
        if (selectAll) {
          const allChecked = checkboxes.length > 0 && ids.length === checkboxes.length;
          selectAll.checked = allChecked;
          selectAll.indeterminate = ids.length > 0 && !allChecked;
        }
      };

      if (selectAll) {
        selectAll.addEventListener('change', () => {
          checkboxes.forEach((box) => {
            box.checked = selectAll.checked;
          });
          syncSelection();
        });
      }

      checkboxes.forEach((box) => {
        box.addEventListener('change', syncSelection);
      });
      syncSelection();

      if (applyAll) {
        applyAll.addEventListener('change', () => {
          applyAllInputs.forEach((input) => {
            input.value = applyAll.checked ? '1' : '0';
          });
        });
      }

      bulkForms.forEach((form) => {
        form.addEventListener('submit', (event) => {
          const ids = getSelectedIds();
          const applyAllChecked = applyAll ? applyAll.checked : false;
          if (!applyAllChecked && ids.length === 0) {
            event.preventDefault();
            alert('Select at least one media item.');
            return;
          }
          selectedContainers.forEach((container) => {
            if (!container || !container.closest('form') || container.closest('form') !== form) {
              return;
            }
            container.innerHTML = '';
            ids.forEach((id) => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'selected_ids[]';
              input.value = id;
              container.appendChild(input);
            });
          });
        });
      });
    })();
  </script>
{% endblock %}
