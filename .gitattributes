# Auto detect text files and perform LF normalization
* text=auto

# Files the code and the tests read are LF on every machine, so a checkout on Windows does not break them.
*.md text eol=lf
*.php text eol=lf
*.twig text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Never touched.
*.woff2 binary
*.png binary
*.jpg binary
*.docx binary
